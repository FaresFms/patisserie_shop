@using System.Globalization
@using Microsoft.Extensions.Hosting
@using Volo.Abp.AspNetCore.Components.Server.LeptonXLiteTheme.Bundling
@using Volo.Abp.Localization
@using Volo.Abp.AspNetCore.Components.Web.Theming.Bundling
@using MudBlazor
@using patisserie_shop.Localization
@inject IHostEnvironment Env
@inject IStringLocalizer<patisserie_shopResource> L
@{
    var direction = CultureHelper.IsRtl ? "rtl" : "ltr";
    var rtlClass = CultureHelper.IsRtl ? "rtl" : string.Empty;
}

<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.Name" dir="@direction">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@L["AppName"]</title>
    <base href="/" />

    <AbpStyles BundleName="@BlazorLeptonXLiteThemeBundles.Styles.Global" />

    <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet" />
    <link href="patisserie_shop.Blazor.styles.css" rel="stylesheet"/>
    <link href="_content/patisserie_shop.Blazor.Shared/Themes/glass-theme.css" rel="stylesheet" />

    <HeadOutlet @rendermode="InteractiveServer" />

    
</head>
<body class="abp-application-layout @rtlClass">

    <Routes @rendermode="InteractiveServer" />

    <div id="blazor-error-ui">
        @if (Env.IsDevelopment())
        {
            <text>@L["App:UnhandledErrorDevelopment"]</text>
        }
        else if (Env.IsStaging() || Env.IsProduction())
        {
            <text>@L["App:UnhandledError"]</text>
        }
        <a href="" class="reload">@L["App:Reload"]</a>
        <a class="dismiss" role="button" tabindex="0" aria-label="@L["Close"]" title="@L["Close"]">🗙</a>
    </div>
    
    <AbpScripts BundleName="@BlazorLeptonXLiteThemeBundles.Scripts.Global" />

    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
    <script src="js/theme-bridge.js"></script>
    <script src="js/browser-timezone.js"></script>
    <script src="js/pos-print.js"></script>
    <script src="js/report-tools.js"></script>
    <script src="_framework/blazor.web.js"></script>

</body>
</html>
