@using Microsoft.AspNetCore.Components.Authorization
@inherits patisserie_shopComponentBase
@inject NavigationManager Navigation

@if (AuthenticationState.User.Identity?.IsAuthenticated == true)
{
    <section class="route-access-denied" role="alert" aria-labelledby="route-access-denied-title">
        <div class="route-access-denied__card">
            <div class="route-access-denied__mark" aria-hidden="true">
                <SoftIcon Icon="@Icons.Material.Outlined.LockPerson" />
            </div>
            <div class="route-access-denied__code">403</div>
            <h1 id="route-access-denied-title">@L["Account:AccessDeniedTitle"]</h1>
            <p>@L["Account:AccessDeniedDescription"]</p>
            <SoftButton Href="/"
                        Variant="MudBlazor.Variant.Filled"
                        Color="MudBlazor.Color.Primary"
                        StartIcon="@Icons.Material.Filled.Home">
                @L["Account:ReturnHome"]
            </SoftButton>
        </div>
    </section>
}
else
{
    <SoftDonutLoader Fill="true" Label="@L["Account:RedirectingToLogin"]" />
}

@code {
    [Parameter, EditorRequired]
    public AuthenticationState AuthenticationState { get; set; } = default!;

    private bool _redirectStarted;

    protected override void OnAfterRender(bool firstRender)
    {
        if (_redirectStarted || AuthenticationState.User.Identity?.IsAuthenticated == true)
        {
            return;
        }

        _redirectStarted = true;
        var currentUri = new Uri(Navigation.Uri);
        var returnUrl = Uri.EscapeDataString(currentUri.PathAndQuery);
        Navigation.NavigateTo($"/Account/Login?returnUrl={returnUrl}", forceLoad: true);
    }
}
