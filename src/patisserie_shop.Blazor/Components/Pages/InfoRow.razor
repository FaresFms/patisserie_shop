@using MudBlazor

<div class="po-info-row">
    <div class="po-info-label">@Label</div>
    <div class="po-info-value @(Strong ? "po-info-strong" : "")">@Value</div>
</div>

<style>
    .po-info-row {
        display: flex;
        flex-direction: column;
        gap: 3px;
        min-width: 0;
    }

    .po-info-label {
        color: var(--fg-3);
        font-size: 0.74rem;
        font-weight: 600;
    }

    .po-info-value {
        color: var(--fg-1);
        font-size: 0.95rem;
        overflow-wrap: anywhere;
    }
    .po-info-strong { font-size: 1.05rem; font-weight: 700; }
</style>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = default!;
    [Parameter, EditorRequired] public string Value { get; set; } = default!;
    [Parameter] public bool Strong { get; set; }
}
