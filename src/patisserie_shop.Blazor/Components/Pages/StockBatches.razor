@page "/inventory/stock-batches"
@attribute [Authorize(InventoryPermissions.BranchInventory.Default)]
@using System.Threading
@using System.Threading.Tasks
@using Microsoft.AspNetCore.Authorization
@using Volo.Abp.Application.Dtos
@using Volo.Abp.AspNetCore.Components.Web.Theming.Layout
@using Inventory.Branches
@using Inventory.StockBatches
@using Inventory.Permissions
@using Inventory.Localization
@using Color = MudBlazor.Color
@using Variant = MudBlazor.Variant
@using Size = MudBlazor.Size
@using Margin = MudBlazor.Margin
@inherits patisserie_shopComponentBase
@inject IStockBatchAppService StockBatchAppService
@inject IBranchAppService BranchAppService
@inject PageLayout PageLayout
@inject IStringLocalizer<InventoryResource> InvL

@{
    PageLayout.Title = InvL["StockBatches"];
}

<SoftStack Spacing="3">

    <StockSubNav Active="batches" />

    <SoftCard Elevation="2" Class="pa-2 page-flat">
    <div class="page-head">
        <div>
            <h1 class="page-title">@InvL["StockBatches"]</h1>
            <div class="page-sub">@InvL["StockBatchesSubtitle"]</div>
        </div>
        <div class="page-head-actions">
        </div>
    </div>
    <SoftCardContent>
        <div class="toolbar">
            <SoftTextField T="string"
                           Placeholder="@InvL["Filter"]"
                           @bind-Value="_filter"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Adornment="Adornment.Start"
                           AdornmentIcon="@Icons.Material.Filled.Search"
                           OnKeyUp="OnFilterKeyUpAsync"
                           Immediate="true"
                           Class="toolbar-search"
                           Style="min-width: 240px; max-width: 320px;" />

            <div class="filter-chip">
                <SoftLookupSelect TItem="BranchLookupDto" TValue="Guid?"
                                  Items="_branches"
                                  ToValue="@(b => (Guid?)b.Id)"
                                  ToLabel="@(b => b.Name)"
                                  Value="_branchFilter"
                                  ValueChanged="OnBranchChangedAsync"
                                  Label="@InvL["AllBranches"]"
                                  Margin="Margin.Dense"
                                  Clearable="true"
                                  Dense="true" />
            </div>

            <div class="toolbar-right">
                <MudSwitch T="bool"
                           Value="_includeDepleted"
                           ValueChanged="OnIncludeDepletedChangedAsync"
                           Color="Color.Primary"
                           Label="@InvL["ShowDepleted"]" />
                <SoftButton Variant="Variant.Text" Color="Color.Primary"
                            OnClick="ReloadAsync" StartIcon="@Icons.Material.Filled.Refresh">
                    @L["Refresh"]
                </SoftButton>
            </div>
        </div>

        <SoftDataGrid T="StockBatchDto"
                      @ref="_grid"
                      ServerData="LoadServerData"
                      Dense="true"
                      Hover="true"
                      Bordered="false"
                      Striped="true"
                      Loading="_loading"
                      SortMode="SortMode.Single">
            <Columns>
                <TemplateColumn T="StockBatchDto" Title="@InvL["Product"]" SortBy="x => x.ProductName">
                    <CellTemplate>
                        <SoftStack Spacing="0">
                            <SoftText Typo="Typo.body2" Style="font-weight:600;">@context.Item.ProductName</SoftText>
                            <SoftText Typo="Typo.caption" Style="color: var(--fg-3);">@context.Item.ProductSKU</SoftText>
                        </SoftStack>
                    </CellTemplate>
                </TemplateColumn>
                <PropertyColumn T="StockBatchDto" TProperty="string" Property="x => x.BranchName" Title="@InvL["Branch"]" />
                <TemplateColumn T="StockBatchDto" Title="@InvL["BatchNumber"]" SortBy="x => x.BatchNumber">
                    <CellTemplate>
                        <SoftText Typo="Typo.body2" Style="font-family: var(--font-mono); font-size: 12.5px;">@context.Item.BatchNumber</SoftText>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="StockBatchDto" Title="@InvL["ExpiryDate"]" SortBy="x => x.ExpiryDate">
                    <CellTemplate>
                        <SoftText Typo="Typo.body2">@context.Item.ExpiryDate.ToString("MMM d, yyyy")</SoftText>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="StockBatchDto" Title="@InvL["ExpiryStatus"]" Sortable="false">
                    <CellTemplate>
                        @{ var (text, color, variant) = ExpiryChip(context.Item); }
                        <SoftChip T="string" Size="Size.Small" Color="@color" Variant="@variant">@text</SoftChip>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="StockBatchDto" Title="@($"{InvL["QuantityRemaining"]} / {InvL["QuantityReceived"]}")" SortBy="x => x.QuantityRemaining">
                    <CellTemplate>
                        <SoftText Typo="Typo.body2" Style="font-variant-numeric: tabular-nums;">
                            <strong>@context.Item.QuantityRemaining</strong> / @context.Item.QuantityReceived @context.Item.ProductUnit
                        </SoftText>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="StockBatchDto" Title="@InvL["Source"]" SortBy="x => x.SourceType">
                    <CellTemplate>
                        <SoftChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">
                            @InvL[$"BatchSource:{context.Item.SourceType}"]
                        </SoftChip>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <NoRecordsContent>
                <SoftStack AlignItems="AlignItems.Center" Spacing="2" Class="pa-6">
                    <SoftIcon Icon="@Icons.Material.Outlined.Inventory2" Style="font-size: 56px; opacity: 0.4;" />
                    <SoftText Typo="Typo.body1" Color="Color.Default">@InvL["NoBatches"]</SoftText>
                </SoftStack>
            </NoRecordsContent>
            <PagerContent>
                <MudDataGridPager T="StockBatchDto" />
            </PagerContent>
        </SoftDataGrid>
    </SoftCardContent>
    </SoftCard>

</SoftStack>

@code {
    private SoftDataGrid<StockBatchDto> _grid = null!;
    private bool _loading;
    private string? _filter;
    private Guid? _branchFilter;
    private bool _includeDepleted;

    private List<BranchLookupDto> _branches = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _branches = await BranchAppService.GetLookupAsync();
        }
        catch (Exception ex)
        {
            await HandleErrorAsync(ex);
        }
    }

    private async Task<GridData<StockBatchDto>> LoadServerData(GridState<StockBatchDto> state, CancellationToken cancellationToken)
    {
        _loading = true;
        try
        {
            string? sorting = null;
            var sort = state.SortDefinitions.FirstOrDefault();
            if (sort != null)
            {
                sorting = $"{sort.SortBy} {(sort.Descending ? "desc" : "asc")}";
            }

            var result = await StockBatchAppService.GetListAsync(new GetStockBatchesInput
            {
                Filter = _filter,
                BranchId = _branchFilter,
                IncludeDepleted = _includeDepleted,
                SkipCount = state.Page * state.PageSize,
                MaxResultCount = state.PageSize,
                Sorting = sorting // null → server default: ExpiryDate asc (soonest-dying first)
            });

            return new GridData<StockBatchDto>
            {
                Items = result.Items,
                TotalItems = (int)result.TotalCount
            };
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnFilterKeyUpAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await ReloadAsync();
        }
    }

    private async Task OnBranchChangedAsync(Guid? value)
    {
        _branchFilter = value;
        await ReloadAsync();
    }

    private async Task OnIncludeDepletedChangedAsync(bool value)
    {
        _includeDepleted = value;
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        if (_grid != null)
        {
            await _grid.ReloadServerData();
        }
    }

    /// <summary>
    /// Expiry countdown chip: expired = red filled ("Expired Nd ago"); expiring within
    /// 2 days (incl. today) = red outlined; within 5 = amber outlined; else green
    /// outlined ("Nd left"). Expiry day itself still counts as sellable.
    /// </summary>
    private (string Text, Color Color, Variant Variant) ExpiryChip(StockBatchDto item)
    {
        var days = (item.ExpiryDate.Date - DateTime.UtcNow.Date).Days;
        if (days < 0)
        {
            return (string.Format(InvL["Expiry:ExpiredAgo"], -days), Color.Error, Variant.Filled);
        }
        if (days == 0)
        {
            return (InvL["Expiry:Today"], Color.Error, Variant.Outlined);
        }

        var text = string.Format(InvL["Expiry:DaysLeft"], days);
        if (days <= 2) return (text, Color.Error, Variant.Outlined);
        if (days <= 5) return (text, Color.Warning, Variant.Outlined);
        return (text, Color.Success, Variant.Outlined);
    }
}
