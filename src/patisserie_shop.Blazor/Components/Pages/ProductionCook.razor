    private async Task CreateDraftIngredientPurchaseOrdersAsync()
    {
        if (_detail == null || _creatingIngredientPo)
        {
            return;
        }

        _creatingIngredientPo = true;
        try
        {
            var result = await OrderAppService.CreateDraftIngredientPurchaseOrdersAsync(_detail.Id);
            if (result.PurchaseOrderCount == 0)
            {
                Snackbar.Add(ProdL["NoIngredientShortageToPurchase"], Severity.Info);
            }
            else
            {
                Snackbar.Add(
                    ProdL["IngredientPurchaseOrdersCreated", result.PurchaseOrderCount, result.TotalShortageQuantity],
                    Severity.Success);
                SetNextStep(
                    "/operations/purchase-orders",
                    "NextStep:PurchaseOrdersCreated",
                    "Workspace:OpenPurchaseOrders");
            }

            _detail = await OrderAppService.RefreshAvailabilityAsync(_detail.Id);
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            await HandleErrorAsync(ex);
        }
        finally
        {
            _creatingIngredientPo = false;
        }
    }

    private void OpenCompleteForm()
    {
        if (_detail == null) return;

        _completeActualQuantity = _detail.ActualOutputQuantity > 0 ? _detail.ActualOutputQuantity : _detail.PlannedOutputQuantity;
        _completeAcceptedQuantity = _detail.AcceptedQuantity > 0 ? _detail.AcceptedQuantity : _completeActualQuantity;
        _completeRejectedQuantity = _detail.RejectedQuantity;
        _completeExpiryDate = _detail.ExpiryDate;
        if (!string.IsNullOrWhiteSpace(_detail.WasteReason) && ProductionWasteReasons.IsValid(_detail.WasteReason))
        {
            _completeWasteReasonCode = _detail.WasteReason;
            _completeOtherWasteReason = null;
        }
        else
        {
            _completeWasteReasonCode = ProductionWasteReasons.Other;
            _completeOtherWasteReason = _detail.WasteReason;
        }
        _completeOriginalNotes = _detail.Notes;
        _completeInitialDisplayNotes = WithoutMarker(_detail.Notes, ShortageDemoMarker);
        _completeNotes = _completeInitialDisplayNotes;
        _completeVisible = true;
    }

    private async Task CompleteCookAsync()
    {
        if (_detail == null || !CanSubmitCompletion) return;

        try
        {
            _detail = await OrderAppService.CompleteAsync(_detail.Id, new CompleteProductionOrderDto
            {
                ActualOutputQuantity = _completeActualQuantity,
                AcceptedQuantity = _completeAcceptedQuantity,
                RejectedQuantity = _completeRejectedQuantity,
                ExpiryDate = _completeExpiryDate,
                WasteReason = ResolveCompletionWasteReason(),
                Notes = CompletionNotesForSave()
            });
            _completeVisible = false;
            Snackbar.Add(ProdL["CompletedSuccessfully"], Severity.Success);
            SetNextStep(
                "/production/quality-waste#quality",
                "NextStep:QualityReviewRequired",
                "Workspace:OpenQuality");
            CloseDetail();
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            await HandleErrorAsync(ex);
        }
    }

    private string? CompletionNotesForSave()
    {
        if (string.Equals(_completeNotes, _completeInitialDisplayNotes, StringComparison.Ordinal))
        {
            return _completeOriginalNotes;
        }

        var editedNotes = WithoutMarker(_completeNotes, ShortageDemoMarker);
        if (_completeOriginalNotes?.Contains(ShortageDemoMarker, StringComparison.Ordinal) != true)
        {
            return editedNotes;
        }

        return string.IsNullOrWhiteSpace(editedNotes)
            ? ShortageDemoMarker
            : $"{editedNotes} {ShortageDemoMarker}";
    }

    private static string? WithoutMarker(string? notes, string marker)
    {
        if (string.IsNullOrWhiteSpace(notes))
        {
            return notes;
        }

        var visibleNotes = notes.Replace(marker, string.Empty, StringComparison.Ordinal).Trim();
        return visibleNotes.Length == 0 ? null : visibleNotes;
    }

