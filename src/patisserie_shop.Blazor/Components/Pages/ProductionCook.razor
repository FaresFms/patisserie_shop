    private async Task OpenDetailAsync(Guid id)
    {
        _detail = await OrderAppService.GetAsync(id);
        _availableWorkCenters = _controlProfile.WorkCenters
            .Where(center => center.IsActive
                && (!center.KitchenBranchId.HasValue || center.KitchenBranchId == _detail.KitchenBranchId))
            .ToList();
        _selectedWorkCenterCode = _detail.WorkCenterCode
            ?? _availableWorkCenters.FirstOrDefault()?.Code
            ?? string.Empty;
        _selectedShiftCode = _detail.ShiftCode
            ?? _availableShifts.FirstOrDefault()?.Code
            ?? string.Empty;
        _selectedOperatorId = _detail.AssignedOperatorUserId
            ?? _operators.FirstOrDefault()?.Id;
        _completeVisible = false;
        _detailVisible = true;
    }

    private void CloseDetail() => _detailVisible = false;

    private async Task RefreshAvailabilityAsync()
    {
        if (_detail == null) return;

        try
        {
            _detail = await OrderAppService.RefreshAvailabilityAsync(_detail.Id);
            Snackbar.Add(ProdL["SavedSuccessfully"], Severity.Success);
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            await HandleErrorAsync(ex);
        }
    }

    private async Task ScheduleOrderAsync()
    {
        if (_detail == null || !CanSchedule) return;
        var center = _availableWorkCenters.First(item => item.Code == _selectedWorkCenterCode);
        var shift = _availableShifts.First(item => item.Code == _selectedShiftCode);
        var operatorRow = _operators.First(item => item.Id == _selectedOperatorId);

        var now = DateTime.Now;
        var shiftStart = now.Date.Add(shift.StartTime);
        var shiftEnd = now.Date.Add(shift.EndTime);
        if (shiftEnd <= shiftStart)
        {
            shiftEnd = shiftEnd.AddDays(1);
        }
        if (now > shiftEnd)
        {
            shiftStart = shiftStart.AddDays(1);
        }
        else if (now > shiftStart)
        {
            shiftStart = now;
        }

        var hourlyCapacity = Math.Max(1, center.CapacityUnitsPerHour);
        var durationMinutes = Math.Max(
            15,
            (int)Math.Ceiling(_detail.PlannedOutputQuantity / (decimal)hourlyCapacity * 60m));
        try
        {
            _detail = await OrderAppService.ScheduleAsync(_detail.Id, new ScheduleProductionOrderDto
            {
                WorkCenterCode = center.Code,
                ShiftCode = shift.Code,
                ScheduledStartTime = shiftStart,
                ScheduledEndTime = shiftStart.AddMinutes(durationMinutes),
                OperatorUserId = operatorRow.Id,
                OperatorName = operatorRow.Name
            });
            Snackbar.Add(ProdL["OrderScheduled"], Severity.Success);
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            await HandleErrorAsync(ex);
        }
    }

