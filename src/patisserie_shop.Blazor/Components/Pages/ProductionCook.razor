@page "/production/workboard"
@attribute [Authorize(ProductionPermissions.Orders.Default)]
@using System.Threading
@using System.Threading.Tasks
@using Microsoft.AspNetCore.Authorization
@using Production
@using Production.Control
@using Production.Kitchens
@using Production.Localization
@using Production.Orders
@using Production.Permissions
@using Production.Waste
@using Volo.Abp.Application.Dtos
@using Volo.Abp.AspNetCore.Components.Web.Theming.Layout
@using Color = MudBlazor.Color
@using Margin = MudBlazor.Margin
@using Size = MudBlazor.Size
@using Variant = MudBlazor.Variant
@inherits patisserie_shopComponentBase
@inject IProductionOrderAppService OrderAppService
@inject IProductionKitchenAppService KitchenAppService
@inject IProductionControlAppService ControlAppService
@inject IAuthorizationService Authz
@inject PageLayout PageLayout
@inject ISnackbar Snackbar
@inject IStringLocalizer<ProductionResource> ProdL
@inject NavigationManager Navigation

@{
    PageLayout.Title = ProdL["Workspace:workboard:Title"];
}

<ProductionWorkspaceHeader Workspace="workboard" ActiveTab="make">
    <Actions>
        <SoftButton Variant="Variant.Text" Color="Color.Primary"
                    StartIcon="@Icons.Material.Filled.Refresh"
                    OnClick="ReloadAsync">
            @ProdL["Refresh"]
        </SoftButton>
    </Actions>
</ProductionWorkspaceHeader>

<SoftCard Elevation="2" Class="pa-2 page-flat">
    <SoftCardContent>
        @if (_nextStepUrl is not null)
        {
            <SoftAlert Severity="Severity.Success" Variant="Variant.Outlined" Class="production-next-step">
                <div class="production-next-step-content">
                    <span>@ProdL[_nextStepMessageKey!]</span>
                    <SoftButton Variant="Variant.Filled" Color="Color.Primary"
                                StartIcon="@Icons.Material.Filled.ArrowForward"
                                OnClick="@(() => Navigation.NavigateTo(_nextStepUrl))">
                        @ProdL[_nextStepLabelKey!]
                    </SoftButton>
                </div>
            </SoftAlert>
        }

        <div class="production-stage-strip" role="tablist" aria-label="@ProdL["Workspace:OrderStages"]">
            @StageButton("blocked", ProductionOrderStatuses.WaitingForIngredients, ProdL["Workspace:MaterialsBlocked"], Icons.Material.Filled.Inventory)
            @StageButton("ready", ProductionOrderStatuses.ReadyToCook, ProdL["Workspace:ReadyToStart"], Icons.Material.Filled.PlayCircle)
            @StageButton("cooking", ProductionOrderStatuses.InProduction, ProdL["Workspace:CookingNow"], Icons.Material.Filled.LocalFireDepartment)
            @StageButton("completed", ProductionOrderStatuses.Completed, ProdL["Workspace:Produced"], Icons.Material.Filled.TaskAlt)
            @StageButton("all", string.Empty, ProdL["Workspace:AllOrders"], Icons.Material.Filled.History)
            <AuthorizeView Policy="@ProductionPermissions.Dispatch.Default">
                <Authorized>
                    <SoftButton Variant="Variant.Text" Color="Color.Primary"
                                StartIcon="@Icons.Material.Filled.LocalShipping"
                                Class="production-stage-button production-stage-button--handoff"
                                OnClick="@(() => Navigation.NavigateTo("/production/workboard/dispatch"))">
                        @ProdL["Workspace:ReadyToSend"]
                    </SoftButton>
                </Authorized>
            </AuthorizeView>
        </div>

        <div class="toolbar">
            <SoftTextField T="string" @bind-Value="_filter"
                           Placeholder="@ProdL["Filter"]"
                           Variant="Variant.Outlined" Margin="Margin.Dense"
                           Adornment="Adornment.Start"
                           AdornmentIcon="@Icons.Material.Filled.Search"
                           OnKeyUp="OnFilterKeyUpAsync"
                           Immediate="true"
                           Class="toolbar-search"
                           Style="min-width: 220px; max-width: 320px;" />

            <div class="filter-chip">
                <SoftLookupSelect TItem="StatusOption" TValue="string"
                                  Items="_statusOptions"
                                  ToValue="@(s => s.Value)"
                                  ToLabel="@(s => s.Label)"
                                  Value="_statusFilter"
                                  ValueChanged="OnStatusChangedAsync"
                                  Label="@ProdL["Status:All"]"
                                  Margin="Margin.Dense"
                                  Dense="true" />
            </div>

            <div class="filter-chip">
                <SoftLookupSelect TItem="KitchenBranchLookupDto" TValue="Guid?"
                                  Items="_branches"
                                  ToValue="@(b => (Guid?)b.Id)"
                                  ToLabel="@(b => b.Name)"
                                  Value="_branchFilter"
                                  ValueChanged="OnBranchChangedAsync"
                                  Label="@ProdL["KitchenBranch"]"
                                  Margin="Margin.Dense"
                                  Dense="true"
                                  Clearable="true" />
            </div>
        </div>

        <SoftDataGrid T="ProductionOrderListItemDto"
                      @ref="_grid"
                      Class="production-workboard-grid"
                      ServerData="LoadServerData"
                      Dense="true"
                      Hover="true"
                      Bordered="false"
                      Loading="_loading"
                      SortMode="SortMode.Single">
            <Columns>
                <PropertyColumn T="ProductionOrderListItemDto" TProperty="string" Property="x => x.OrderNumber" Title="@ProdL["OrderNumber"]" />
                <PropertyColumn T="ProductionOrderListItemDto" TProperty="string" Property="x => x.FinishedProductName" Title="@ProdL["Product"]" />
                <PropertyColumn T="ProductionOrderListItemDto" TProperty="string" Property="x => x.KitchenBranchName" Title="@ProdL["KitchenBranch"]" />
                <TemplateColumn T="ProductionOrderListItemDto" Title="@ProdL["Status"]" SortBy="x => x.Status">
                    <CellTemplate>@StatusChip(context.Item.Status)</CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="ProductionOrderListItemDto" Title="@ProdL["Priority"]" SortBy="x => x.Priority">
                    <CellTemplate>@PriorityLabel(context.Item.Priority)</CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="ProductionOrderListItemDto" Title="@ProdL["PlannedOutput"]" SortBy="x => x.PlannedOutputQuantity">
                    <CellTemplate>@context.Item.PlannedOutputQuantity @context.Item.Unit</CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="ProductionOrderListItemDto" Title="@ProdL["AcceptedQuantity"]" SortBy="x => x.AcceptedQuantity">
                    <CellTemplate>@context.Item.AcceptedQuantity @context.Item.Unit</CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="ProductionOrderListItemDto" Title="@ProdL["Actions"]" Sortable="false">
                    <CellTemplate>
                        <span class="row-actions">
                            <SoftTooltip Text="@ProdL["OpenOrder"]">
                                <SoftIconButton Icon="@Icons.Material.Filled.Visibility"
                                                Color="Color.Primary"
                                                Size="Size.Small"
                                                OnClick="() => OpenDetailAsync(context.Item.Id)" />
                            </SoftTooltip>
                        </span>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <PagerContent>
                <MudDataGridPager T="ProductionOrderListItemDto" />
            </PagerContent>
        </SoftDataGrid>

        <div class="production-workboard-mobile" aria-live="polite">
            @foreach (var order in _visibleOrders)
            {
                <SoftCard Elevation="1" Class="production-order-card">
                    <SoftCardContent>
                        <div class="production-order-card-head">
                            <div>
                                <div class="production-order-card-product">@order.FinishedProductName</div>
                                <div class="production-order-card-number">@order.OrderNumber</div>
                            </div>
                            @StatusChip(order.Status)
                        </div>
                        <div class="production-order-card-meta">
                            <span><SoftIcon Icon="@Icons.Material.Filled.Store" Size="Size.Small" /> @order.KitchenBranchName</span>
                            <span><SoftIcon Icon="@Icons.Material.Filled.BakeryDining" Size="Size.Small" /> @order.PlannedOutputQuantity @order.Unit</span>
                            <span><SoftIcon Icon="@Icons.Material.Filled.PriorityHigh" Size="Size.Small" /> @PriorityLabel(order.Priority)</span>
                        </div>
                        <SoftButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                                    StartIcon="@Icons.Material.Filled.ArrowForward"
                                    OnClick="@(() => OpenDetailAsync(order.Id))">
                            @PrimaryActionLabel(order.Status)
                        </SoftButton>
                    </SoftCardContent>
                </SoftCard>
            }
        </div>
    </SoftCardContent>
</SoftCard>

@if (_detailVisible && _detail != null)
{
    <div class="glass-modal-backdrop" @onclick="CloseDetail">
        <div class="glass-modal-container glass-modal-container--lg" @onclick:stopPropagation="true">
            <SoftCard Elevation="24" Class="glass-modal">
                <SoftCardHeader Class="pa-4">
                    <CardHeaderContent>
                        <SoftStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <SoftIcon Icon="@Icons.Material.Filled.LocalFireDepartment" Color="Color.Primary" Size="Size.Medium" />
                            <SoftText Typo="Typo.h6">@_detail.OrderNumber</SoftText>
                            @StatusChip(_detail.Status)
                            @if (_detail.Status == ProductionOrderStatuses.Completed)
                            {
                                @QualityChip(_detail.QualityStatus)
                            }
                        </SoftStack>
                    </CardHeaderContent>
                    <CardHeaderActions>
                        <SoftIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="CloseDetail" />
                    </CardHeaderActions>
                </SoftCardHeader>
                <SoftDivider />
                <SoftCardContent Class="pa-4 glass-modal-body">
                    <SoftStack Spacing="3">
                        <div class="stats">
                            <div>
                                <div class="stat-label">@ProdL["Product"]</div>
                                <div class="stat-value">@_detail.FinishedProductSku - @_detail.FinishedProductName</div>
                            </div>
                            <div>
                                <div class="stat-label">@ProdL["KitchenBranch"]</div>
                                <div class="stat-value">@_detail.KitchenBranchName</div>
                            </div>
                            <div>
                                <div class="stat-label">@ProdL["PlannedOutput"]</div>
                                <div class="stat-value">@_detail.PlannedOutputQuantity @_detail.FinishedProductUnit</div>
                            </div>
                            <div>
                                <div class="stat-label">@ProdL["PlannedUnitCost"]</div>
                                <div class="stat-value">@FormatShopMoney(_detail.UnitProductionCost, 2)</div>
                            </div>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(_detail.FormulaAllergens))
                        {
                            <SoftAlert Severity="Severity.Warning" Variant="Variant.Outlined">
                                <strong>@ProdL["Allergens"]:</strong> @_detail.FormulaAllergens
                            </SoftAlert>
                        }

                        @if (_detail.Status is ProductionOrderStatuses.Draft
                            or ProductionOrderStatuses.ReadyToCook
                            or ProductionOrderStatuses.WaitingForIngredients)
                        {
                            <div class="production-schedule-box">
                                <SoftText Typo="Typo.subtitle2">@ProdL["ScheduleAndAssign"]</SoftText>
                                <SoftGrid Spacing="2">
                                    <SoftGridItem xs="12" md="4">
                                        <SoftLookupSelect TItem="ProductionWorkCenterDto" TValue="string"
                                                          Items="_availableWorkCenters" ToValue="@(item => item.Code)"
                                                          ToLabel="@(item => $"{item.Name} · {item.CapacityUnitsPerHour}/h")"
                                                          @bind-Value="_selectedWorkCenterCode" Label="@ProdL["WorkCenter"]"
                                                          Clearable="false" />
                                    </SoftGridItem>
                                    <SoftGridItem xs="12" md="4">
                                        <SoftLookupSelect TItem="ProductionShiftDto" TValue="string"
                                                          Items="_availableShifts" ToValue="@(item => item.Code)"
                                                          ToLabel="@(item => $"{item.Name} · {item.StartTime:hh\\:mm}-{item.EndTime:hh\\:mm}")"
                                                          @bind-Value="_selectedShiftCode" Label="@ProdL["Shift"]"
                                                          Clearable="false" />
                                    </SoftGridItem>
                                    <SoftGridItem xs="12" md="4">
                                        <SoftLookupSelect TItem="ProductionOperatorLookupDto" TValue="Guid?"
                                                          Items="_operators" ToValue="@(item => (Guid?)item.Id)"
                                                          ToLabel="@(item => item.Name)" @bind-Value="_selectedOperatorId"
                                                          Label="@ProdL["Operator"]" Clearable="false" />
                                    </SoftGridItem>
                                </SoftGrid>
                                @if (_detail.ScheduledStartTime.HasValue)
                                {
                                    <SoftText Typo="Typo.caption" Color="Color.Default">
                                        @ProdL["ScheduledFor"] @_detail.ScheduledStartTime.Value.ToString("g") · @_detail.AssignedOperatorName
                                    </SoftText>
                                }
                            </div>
                        }

                        @if (HasShortage)
                        {
                            <SoftAlert Severity="Severity.Warning">@ProdL["Production:205"]</SoftAlert>
                        }

                        <SoftText Typo="Typo.subtitle2">@ProdL["Availability"]</SoftText>
                        <SoftTable T="ProductionIngredientAvailabilityDto" Items="_detail.Availability" Dense="true" Hover="true">
                            <HeaderContent>
                                <MudTh>@ProdL["Ingredient"]</MudTh>
                                <MudTh>@ProdL["RequiredQuantity"]</MudTh>
                                <MudTh>@ProdL["AvailableQuantity"]</MudTh>
                                <MudTh>@ProdL["ShortageQuantity"]</MudTh>
                                <MudTh>@ProdL["Status"]</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd>@context.IngredientSku - @context.IngredientName</MudTd>
                                <MudTd>@context.RequiredQuantity @context.Unit</MudTd>
                                <MudTd>@context.AvailableQuantity @context.Unit</MudTd>
                                <MudTd>@context.ShortageQuantity @context.Unit</MudTd>
                                <MudTd>@AvailabilityChip(context.HasShortage)</MudTd>
                            </RowTemplate>
                        </SoftTable>

                        @if (_detail.IngredientLots.Count > 0 || !string.IsNullOrWhiteSpace(_detail.OutputBatchNumber))
                        {
                            <SoftText Typo="Typo.subtitle2">@ProdL["LotGenealogy"]</SoftText>
                            @if (!string.IsNullOrWhiteSpace(_detail.OutputBatchNumber))
                            {
                                <SoftAlert Severity="Severity.Info" Variant="Variant.Outlined">
                                    @ProdL["OutputLot"]: <strong>@_detail.OutputBatchNumber</strong>
                                </SoftAlert>
                            }
                            <SoftTable T="ProductionIngredientLotDto" Items="_detail.IngredientLots" Dense="true" Hover="true">
                                <HeaderContent>
                                    <MudTh>@ProdL["Ingredient"]</MudTh>
                                    <MudTh>@ProdL["BatchNumber"]</MudTh>
                                    <MudTh>@ProdL["ExpiryDate"]</MudTh>
                                    <MudTh>@ProdL["Quantity"]</MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd>@context.IngredientName</MudTd>
                                    <MudTd>@context.BatchNumber</MudTd>
                                    <MudTd>@context.ExpiryDate.ToString("d")</MudTd>
                                    <MudTd>@context.Quantity</MudTd>
                                </RowTemplate>
                            </SoftTable>
                        }

                        <SoftText Typo="Typo.subtitle2">@ProdL["Ingredients"]</SoftText>
                        <SoftTable T="ProductionOrderIngredientDto" Items="_detail.Ingredients" Dense="true" Hover="true">
                            <HeaderContent>
                                <MudTh>@ProdL["Ingredient"]</MudTh>
                                <MudTh>@ProdL["RequiredQuantity"]</MudTh>
                                <MudTh>@ProdL["Quantity"]</MudTh>
                                <MudTh>@ProdL["LineCost"]</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd>@context.IngredientSku - @context.IngredientName</MudTd>
                                <MudTd>@context.RequiredQuantity @context.Unit</MudTd>
                                <MudTd>@context.ConsumedQuantity @context.Unit</MudTd>
                                <MudTd>@FormatShopMoney(context.TotalCost, 2)</MudTd>
                            </RowTemplate>
                        </SoftTable>

                        @if (_completeVisible)
                        {
                            <SoftDivider />
                            <SoftText Typo="Typo.subtitle2">@ProdL["Completion"]</SoftText>
                            @if (CompletionTotalsMismatch)
                            {
                                <SoftAlert Severity="Severity.Warning">@ProdL["ActualOutput"] = @ProdL["AcceptedQuantity"] + @ProdL["RejectedQuantity"]</SoftAlert>
                            }
                            <SoftGrid>
                                <SoftGridItem xs="12" md="4">
                                    <SoftNumericField T="int" @bind-Value="_completeActualQuantity"
                                                      Label="@ProdL["ActualOutput"]"
                                                      Variant="Variant.Outlined"
                                                      Min="0"
                                                      HideSpinButtons="true" />
                                </SoftGridItem>
                                <SoftGridItem xs="12" md="4">
                                    <SoftNumericField T="int" @bind-Value="_completeAcceptedQuantity"
                                                      Label="@ProdL["AcceptedQuantity"]"
                                                      Variant="Variant.Outlined"
                                                      Min="0"
                                                      HideSpinButtons="true" />
                                </SoftGridItem>
                                <SoftGridItem xs="12" md="4">
                                    <SoftNumericField T="int" @bind-Value="_completeRejectedQuantity"
                                                      Label="@ProdL["RejectedQuantity"]"
                                                      Variant="Variant.Outlined"
                                                      Min="0"
                                                      HideSpinButtons="true" />
                                </SoftGridItem>
                                <SoftGridItem xs="12" md="6">
                                    <SoftDatePicker Label="@ProdL["ExpiryDate"]"
                                                    Date="_completeExpiryDate"
                                                    DateChanged="@(d => _completeExpiryDate = d)"
                                                    Disabled="_completeAcceptedQuantity == 0"
                                                    MinDate="@(_detail.ActualStartTime?.Date ?? DateTime.Today)"
                                                    Variant="Variant.Outlined" />
                                </SoftGridItem>
                                <SoftGridItem xs="12" md="6">
                                    <SoftLookupSelect TItem="WasteReasonOption" TValue="string"
                                                      Items="_reasonOptions"
                                                      ToValue="@(o => o.Value)"
                                                      ToLabel="@(o => o.Label)"
                                                      Value="_completeWasteReasonCode"
                                                      ValueChanged="OnCompleteWasteReasonChanged"
                                                      Label="@ProdL["WasteReason"]"
                                                      Clearable="false"
                                                      Disabled="_completeRejectedQuantity == 0" />
                                </SoftGridItem>
                                @if (_completeRejectedQuantity > 0 && _completeWasteReasonCode == ProductionWasteReasons.Other)
                                {
                                    <SoftGridItem xs="12" md="6">
                                        <SoftTextField T="string" @bind-Value="_completeOtherWasteReason"
                                                       Label="@ProdL["OtherReasonDetails"]"
                                                       Variant="Variant.Outlined" />
                                    </SoftGridItem>
                                }
                                else
                                {
                                    <SoftGridItem xs="12" md="6"></SoftGridItem>
                                }
                                @if (_completeRejectedQuantity > 0
                                    && _completeWasteReasonCode == ProductionWasteReasons.Other
                                    && string.IsNullOrWhiteSpace(_completeOtherWasteReason))
                                {
                                    <SoftGridItem xs="12">
                                        <SoftAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true">
                                            @ProdL["OtherReasonDetailsRequired"]
                                        </SoftAlert>
                                    </SoftGridItem>
                                }
                                <SoftGridItem xs="12">
                                    <SoftTextField T="string" @bind-Value="_completeNotes"
                                                   Label="@ProdL["Notes"]"
                                                   Variant="Variant.Outlined"
                                                   Lines="2" />
                                </SoftGridItem>
                            </SoftGrid>
                        }
                        @if (CookHint() is { Length: > 0 } cookHint)
                        {
                            <SoftAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
                                @cookHint
                            </SoftAlert>
                        }
                    </SoftStack>
                </SoftCardContent>
                <SoftDivider />
                <div class="pa-3 d-flex justify-end flex-wrap" style="gap: 8px;">
                    <SoftButton Variant="Variant.Text" OnClick="CloseDetail">@ProdL["Cancel"]</SoftButton>
                    @if (_detail.Status is not ProductionOrderStatuses.Completed and not ProductionOrderStatuses.Cancelled)
                    {
                        <SoftButton Variant="Variant.Outlined" Color="Color.Primary"
                                    StartIcon="@Icons.Material.Filled.Refresh"
                                    OnClick="RefreshAvailabilityAsync">
                            @ProdL["RefreshAvailability"]
                        </SoftButton>
                    }
                    @if (_canCreateIngredientPo && HasShortage)
                    {
                        <SoftButton Variant="Variant.Outlined" Color="Color.Primary"
                                    StartIcon="@Icons.Material.Filled.AccountTree"
                                    Disabled="_creatingSubProduction"
                                    OnClick="CreateSubProductionAsync">
                            @ProdL["CreateSubProduction"]
                        </SoftButton>
                        <SoftButton Variant="Variant.Outlined" Color="Color.Primary"
                                    StartIcon="@Icons.Material.Filled.ShoppingCart"
                                    Disabled="_creatingIngredientPo"
                                    OnClick="CreateDraftIngredientPurchaseOrdersAsync">
                            @ProdL["CreateDraftIngredientPO"]
                        </SoftButton>
                    }
                    @if (_canSchedule && _detail.Status is ProductionOrderStatuses.Draft
                        or ProductionOrderStatuses.ReadyToCook
                        or ProductionOrderStatuses.WaitingForIngredients)
                    {
                        <SoftButton Variant="Variant.Filled" Color="Color.Primary"
                                    StartIcon="@Icons.Material.Filled.EventAvailable"
                                    Disabled="!CanSchedule"
                                    OnClick="ScheduleOrderAsync">
                            @ProdL["ScheduleOrder"]
                        </SoftButton>
                    }
                    @if (_canCancel && ProductionOrderStatuses.CanCancel(_detail.Status))
                    {
                        <SoftButton Variant="Variant.Outlined" Color="Color.Error"
                                    StartIcon="@Icons.Material.Filled.Cancel"
                                    OnClick="CancelOrderAsync">
                            @ProdL["Cancel"]
                        </SoftButton>
                    }
                    @if (_canStart && _detail.Status == ProductionOrderStatuses.ReadyToCook)
                    {
                        <SoftButton Variant="Variant.Filled" Color="Color.Primary"
                                    StartIcon="@Icons.Material.Filled.PlayArrow"
                                    OnClick="StartCookAsync">
                            @ProdL["StartCook"]
                        </SoftButton>
                    }
                    @if (_canComplete && _detail.Status == ProductionOrderStatuses.InProduction && !_completeVisible)
                    {
                        <SoftButton Variant="Variant.Filled" Color="Color.Primary"
                                    StartIcon="@Icons.Material.Filled.DoneAll"
                                    OnClick="OpenCompleteForm">
                            @ProdL["CompleteCook"]
                        </SoftButton>
                    }
                    @if (_canComplete && _detail.Status == ProductionOrderStatuses.InProduction && _completeVisible)
                    {
                        <SoftButton Variant="Variant.Filled" Color="Color.Primary"
                                    StartIcon="@Icons.Material.Filled.DoneAll"
                                    Disabled="!CanSubmitCompletion"
                                    OnClick="CompleteCookAsync">
                            @ProdL["CompleteCook"]
                        </SoftButton>
                    }
                </div>
            </SoftCard>
        </div>
    </div>
}

@code {
    private SoftDataGrid<ProductionOrderListItemDto>? _grid;
    private bool _loading;
    private bool _canStart;
    private bool _canComplete;
    private bool _canCancel;
    private bool _canSchedule;
    private bool _canCreateIngredientPo;
    private bool _creatingIngredientPo;
    private bool _creatingSubProduction;
    private string? _filter;
    private string _statusFilter = string.Empty;
    private Guid? _branchFilter;
    private List<KitchenBranchLookupDto> _branches = new();
    private List<StatusOption> _statusOptions = new();
    private List<WasteReasonOption> _reasonOptions = new();
    private List<ProductionOrderListItemDto> _visibleOrders = new();
    private string _activeStage = "ready";
    private string? _nextStepUrl;
    private string? _nextStepMessageKey;
    private string? _nextStepLabelKey;

    [Parameter, SupplyParameterFromQuery(Name = "stage")]
    public string? Stage { get; set; }

    private bool _detailVisible;
    private ProductionOrderDto? _detail;
    private ProductionControlProfileDto _controlProfile = new();
    private List<ProductionWorkCenterDto> _availableWorkCenters = new();
    private List<ProductionShiftDto> _availableShifts = new();
    private List<ProductionOperatorLookupDto> _operators = new();
    private string _selectedWorkCenterCode = string.Empty;
    private string _selectedShiftCode = string.Empty;
    private Guid? _selectedOperatorId;

    private bool _completeVisible;
    private int _completeActualQuantity;
    private int _completeAcceptedQuantity;
    private int _completeRejectedQuantity;
    private DateTime? _completeExpiryDate;
    private string _completeWasteReasonCode = ProductionWasteReasons.Other;
    private string? _completeOtherWasteReason;
    private string? _completeNotes;
    private string? _completeOriginalNotes;
    private string? _completeInitialDisplayNotes;

    private const string ShortageDemoMarker = "[DEMO-PRODUCTION-AR-SHORTAGE]";

    private bool HasShortage => _detail?.Availability.Any(x => x.HasShortage) == true;
    private bool CanSchedule => !string.IsNullOrWhiteSpace(_selectedWorkCenterCode)
        && !string.IsNullOrWhiteSpace(_selectedShiftCode)
        && _selectedOperatorId.HasValue;

    private bool CompletionTotalsMismatch =>
        _completeActualQuantity != _completeAcceptedQuantity + _completeRejectedQuantity;

    private bool CanSubmitCompletion =>
        _completeActualQuantity > 0
        && _completeAcceptedQuantity >= 0
        && _completeRejectedQuantity >= 0
        && !CompletionTotalsMismatch
        && (_completeRejectedQuantity == 0
            || _completeWasteReasonCode != ProductionWasteReasons.Other
            || !string.IsNullOrWhiteSpace(_completeOtherWasteReason));

    protected override async Task OnInitializedAsync()
    {
        await LoadShopCurrencyAsync();
        _canStart = await Authz.IsGrantedAsync(ProductionPermissions.Orders.Start);
        _canComplete = await Authz.IsGrantedAsync(ProductionPermissions.Orders.Complete);
        _canCancel = await Authz.IsGrantedAsync(ProductionPermissions.Orders.Cancel);
        _canSchedule = await Authz.IsGrantedAsync(ProductionPermissions.Orders.Schedule);
        _canCreateIngredientPo = await Authz.IsGrantedAsync(ProductionPermissions.Ingredients.CheckAvailability);
        if (_canSchedule)
        {
            _controlProfile = await ControlAppService.GetAsync();
            _availableShifts = _controlProfile.Shifts.Where(shift => shift.IsActive).ToList();
            _operators = await ControlAppService.GetOperatorsAsync();
        }
        _branches = await KitchenAppService.GetAccessibleLookupAsync();
        if (_branches.Count == 1)
        {
            _branchFilter = _branches[0].Id;
        }
        _statusOptions =
        [
            new(string.Empty, ProdL["Status:All"]),
            new(ProductionOrderStatuses.ReadyToCook, ProdL["Status:ReadyToCook"]),
            new(ProductionOrderStatuses.WaitingForIngredients, ProdL["Status:WaitingForIngredients"]),
            new(ProductionOrderStatuses.InProduction, ProdL["Status:InProduction"]),
            new(ProductionOrderStatuses.Completed, ProdL["Status:Completed"]),
            new(ProductionOrderStatuses.Cancelled, ProdL["Status:Cancelled"])
        ];
        ApplyInitialStage();
        _reasonOptions = BuildReasonOptions();
    }

    private async Task<GridData<ProductionOrderListItemDto>> LoadServerData(GridState<ProductionOrderListItemDto> state, CancellationToken cancellationToken)
    {
        _loading = true;
        try
        {
            var sorting = state.SortDefinitions.FirstOrDefault();
            var result = await OrderAppService.GetListAsync(new GetProductionOrdersInput
            {
                Filter = _filter,
                Status = string.IsNullOrWhiteSpace(_statusFilter) ? null : _statusFilter,
                KitchenBranchId = _branchFilter,
                SkipCount = state.Page * state.PageSize,
                MaxResultCount = state.PageSize,
                Sorting = sorting == null ? string.Empty : $"{sorting.SortBy} {(sorting.Descending ? "desc" : "asc")}"
            });
            _visibleOrders = result.Items.ToList();

            return new GridData<ProductionOrderListItemDto>
            {
                Items = result.Items,
                TotalItems = (int)result.TotalCount
            };
        }
        finally
        {
            _loading = false;
        }
    }

