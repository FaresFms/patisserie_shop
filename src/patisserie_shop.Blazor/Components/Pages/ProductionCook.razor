    private RenderFragment StatusChip(string status) => builder =>
    {
        var color = status switch
        {
            ProductionOrderStatuses.ReadyToCook => Color.Success,
            ProductionOrderStatuses.WaitingForIngredients => Color.Warning,
            ProductionOrderStatuses.InProduction => Color.Info,
            ProductionOrderStatuses.Completed => Color.Success,
            ProductionOrderStatuses.Cancelled => Color.Error,
            _ => Color.Default
        };
        var variant = status is ProductionOrderStatuses.Draft or ProductionOrderStatuses.Cancelled
            ? Variant.Outlined
            : Variant.Filled;

        builder.OpenComponent<SoftChip<string>>(0);
        builder.AddAttribute(1, "Color", color);
        builder.AddAttribute(2, "Size", Size.Small);
        builder.AddAttribute(3, "Variant", variant);
        builder.AddAttribute(4, "ChildContent", (RenderFragment)(b => b.AddContent(0, StatusLabel(status))));
        builder.CloseComponent();
    };

    private RenderFragment AvailabilityChip(bool hasShortage) => builder =>
    {
        builder.OpenComponent<SoftChip<string>>(0);
        builder.AddAttribute(1, "Color", hasShortage ? Color.Warning : Color.Success);
        builder.AddAttribute(2, "Size", Size.Small);
        builder.AddAttribute(3, "Variant", hasShortage ? Variant.Filled : Variant.Outlined);
        builder.AddAttribute(4, "ChildContent", (RenderFragment)(b => b.AddContent(0, hasShortage ? ProdL["ShortStock"] : ProdL["EnoughStock"])));
        builder.CloseComponent();
    };

    private RenderFragment QualityChip(string status) => builder =>
    {
        var color = status switch
        {
            ProductionQualityStatuses.Released => Color.Success,
            ProductionQualityStatuses.Held => Color.Warning,
            ProductionQualityStatuses.Rejected => Color.Error,
            _ => Color.Info
        };
        builder.OpenComponent<SoftChip<string>>(0);
        builder.AddAttribute(1, "Color", color);
        builder.AddAttribute(2, "Size", Size.Small);
        builder.AddAttribute(3, "Variant", status == ProductionQualityStatuses.Pending ? Variant.Filled : Variant.Outlined);
        builder.AddAttribute(4, "ChildContent", (RenderFragment)(content =>
            content.AddContent(0, ProdL[$"QualityStatus:{status}"])));
        builder.CloseComponent();
    };

    private string StatusLabel(string status) => status switch
    {
        ProductionOrderStatuses.Draft => ProdL["Status:Draft"],
        ProductionOrderStatuses.ReadyToCook => ProdL["Status:ReadyToCook"],
        ProductionOrderStatuses.WaitingForIngredients => ProdL["Status:WaitingForIngredients"],
        ProductionOrderStatuses.InProduction => ProdL["Status:InProduction"],
        ProductionOrderStatuses.Completed => ProdL["Status:Completed"],
        ProductionOrderStatuses.Cancelled => ProdL["Status:Cancelled"],
        _ => status
    };

    private string PriorityLabel(string priority) => priority switch
    {
        ProductionPriorities.Low => ProdL["Priority:Low"],
        ProductionPriorities.Urgent => ProdL["Priority:Urgent"],
        _ => ProdL["Priority:Normal"]
    };

    private RenderFragment StageButton(string key, string status, string label, string icon) => builder =>
    {
        builder.OpenComponent<SoftButton>(0);
        builder.AddAttribute(1, "Variant", _activeStage == key ? Variant.Filled : Variant.Text);
        builder.AddAttribute(2, "Color", Color.Primary);
        builder.AddAttribute(3, "StartIcon", icon);
        builder.AddAttribute(4, "Class", _activeStage == key
            ? "production-stage-button is-active"
            : "production-stage-button");
        builder.AddAttribute(5, "OnClick", EventCallback.Factory.Create<MouseEventArgs>(
            this,
            () => SelectStageAsync(key, status)));
        builder.AddAttribute(6, "ChildContent", (RenderFragment)(content => content.AddContent(0, label)));
        builder.CloseComponent();
    };

    private async Task SelectStageAsync(string key, string status)
    {
        _activeStage = key;
        _statusFilter = status;
        Navigation.NavigateTo($"/production/workboard?stage={key}", replace: true);
        await ReloadAsync();
    }

    private void ApplyInitialStage()
    {
        _activeStage = Stage?.ToLowerInvariant() switch
        {
            "blocked" => "blocked",
            "cooking" => "cooking",
            "completed" => "completed",
            "all" => "all",
            _ => "ready"
        };

        _statusFilter = _activeStage switch
        {
            "blocked" => ProductionOrderStatuses.WaitingForIngredients,
            "cooking" => ProductionOrderStatuses.InProduction,
            "completed" => ProductionOrderStatuses.Completed,
            "all" => string.Empty,
            _ => ProductionOrderStatuses.ReadyToCook
        };
    }

    private static string StageKeyForStatus(string status) => status switch
    {
        ProductionOrderStatuses.WaitingForIngredients => "blocked",
        ProductionOrderStatuses.ReadyToCook => "ready",
        ProductionOrderStatuses.InProduction => "cooking",
        ProductionOrderStatuses.Completed => "completed",
        _ => "all"
    };

    private string PrimaryActionLabel(string status) => status switch
    {
        ProductionOrderStatuses.WaitingForIngredients => ProdL["Workspace:ResolveMaterials"],
        ProductionOrderStatuses.ReadyToCook => ProdL["StartCook"],
        ProductionOrderStatuses.InProduction => ProdL["CompleteCook"],
        ProductionOrderStatuses.Completed => ProdL["OpenOrder"],
        _ => ProdL["OpenOrder"]
    };

    private void SetNextStep(string url, string messageKey, string labelKey)
    {
        _nextStepUrl = url;
        _nextStepMessageKey = messageKey;
        _nextStepLabelKey = labelKey;
    }

    /// <summary>Plain-language "what happens next" line for the detail modal, per status.</summary>
    private string? CookHint() => _detail?.Status switch
    {
        ProductionOrderStatuses.WaitingForIngredients => ProdL["CookHint:WaitingForIngredients"].Value,
        ProductionOrderStatuses.ReadyToCook => ProdL["CookHint:ReadyToCook"].Value,
        ProductionOrderStatuses.InProduction => ProdL["CookHint:InProduction"].Value,
        ProductionOrderStatuses.Completed => ProdL["CookHint:Completed"].Value,
        _ => null
    };

    private void OnCompleteWasteReasonChanged(string reason)
    {
        _completeWasteReasonCode = reason;
        if (reason != ProductionWasteReasons.Other)
        {
            _completeOtherWasteReason = null;
        }
    }

    private string? ResolveCompletionWasteReason()
    {
        if (_completeRejectedQuantity == 0)
        {
            return null;
        }

        return _completeWasteReasonCode == ProductionWasteReasons.Other
            ? _completeOtherWasteReason?.Trim()
            : _completeWasteReasonCode;
    }

    private List<WasteReasonOption> BuildReasonOptions() =>
    [
        new(ProductionWasteReasons.Burned, ProdL["Reason:Burned"]),
        new(ProductionWasteReasons.UnderBaked, ProdL["Reason:UnderBaked"]),
        new(ProductionWasteReasons.OverBaked, ProdL["Reason:OverBaked"]),
        new(ProductionWasteReasons.ShapeDamaged, ProdL["Reason:ShapeDamaged"]),
        new(ProductionWasteReasons.Dropped, ProdL["Reason:Dropped"]),
        new(ProductionWasteReasons.Contaminated, ProdL["Reason:Contaminated"]),
        new(ProductionWasteReasons.IngredientSpoilage, ProdL["Reason:IngredientSpoilage"]),
        new(ProductionWasteReasons.PackagingDamage, ProdL["Reason:PackagingDamage"]),
        new(ProductionWasteReasons.ExpiredBeforeDispatch, ProdL["Reason:ExpiredBeforeDispatch"]),
        new(ProductionWasteReasons.TestBatch, ProdL["Reason:TestBatch"]),
        new(ProductionWasteReasons.Other, ProdL["Reason:Other"])
    ];

    private sealed record StatusOption(string Value, string Label);
    private sealed record WasteReasonOption(string Value, string Label);
}
