@page "/inventory/branches"
@attribute [Authorize(InventoryPermissions.Branches.Default)]
@using System.Threading
@using System.Threading.Tasks
@using Microsoft.AspNetCore.Authorization
@using Volo.Abp.Application.Dtos
@using Volo.Abp.AspNetCore.Components.Web.Theming.Layout
@using Volo.Abp.Identity
@using Inventory
@using Inventory.Branches
@using Inventory.Permissions
@using Inventory.Localization
@using Color = MudBlazor.Color
@using Variant = MudBlazor.Variant
@using Size = MudBlazor.Size
@using Margin = MudBlazor.Margin
@inherits patisserie_shopComponentBase
@inject IBranchAppService BranchAppService
@inject IIdentityUserAppService IdentityUserAppService
@inject PageLayout PageLayout
@inject ISnackbar Snackbar
@inject IStringLocalizer<InventoryResource> InvL

@{
    PageLayout.Title = InvL["Branches"];
}

<SoftCard Elevation="2" Class="pa-2 page-flat">
    <div class="page-head">
        <div>
            <h1 class="page-title">@InvL["Branches"]</h1>
            <div class="page-sub">@InvL["Branches:Subtitle"]</div>
        </div>
        <div class="page-head-actions">
            @if (_canManage)
            {
                <SoftButton Variant="Variant.Filled"
                            Color="Color.Primary"
                            StartIcon="@Icons.Material.Filled.Add"
                            OnClick="OpenCreateDialog">
                    @InvL["NewBranch"]
                </SoftButton>
            }
        </div>
    </div>
    <SoftCardContent>
        <div class="toolbar">
            <SoftTextField T="string"
                           Placeholder="@InvL["Filter"]"
                           @bind-Value="_filter"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Adornment="Adornment.Start"
                           AdornmentIcon="@Icons.Material.Filled.Search"
                           OnKeyUp="OnFilterKeyUpAsync"
                           Immediate="true"
                           Class="toolbar-search"
                           Style="max-width: 320px;" />
            <div class="toolbar-right">
                <SoftButton Variant="Variant.Text" Color="Color.Primary" OnClick="ReloadAsync" StartIcon="@Icons.Material.Filled.Refresh">
                    @L["Refresh"]
                </SoftButton>
            </div>
        </div>

        <SoftDataGrid T="BranchDto"
                      @ref="_grid"
                      ServerData="LoadServerData"
                      Dense="true"
                      Hover="true"
                      Bordered="false"
                      Striped="true"
                      Loading="_loading"
                      SortMode="SortMode.Single">
            <Columns>
                <PropertyColumn T="BranchDto" TProperty="string" Property="x => x.Name" Title="@InvL["Name"]" />
                <PropertyColumn T="BranchDto" TProperty="string" Property="x => x.Address!" Title="@InvL["Address"]" Sortable="false" />
                <PropertyColumn T="BranchDto" TProperty="string" Property="x => x.Phone!" Title="@InvL["Phone"]" Sortable="false" />
                <PropertyColumn T="BranchDto" TProperty="string" Property="x => x.Email!" Title="@InvL["Email"]" Sortable="false" />
                <TemplateColumn T="BranchDto" Title="@InvL["Manager"]" Sortable="false">
                    <CellTemplate>
                        <SoftText Typo="Typo.body2">@GetManagerName(context.Item.ManagerUserId)</SoftText>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="BranchDto" Title="@InvL["BranchType"]" Sortable="true" SortBy="x => x.BranchType">
                    <CellTemplate>
                        @if (context.Item.BranchType == BranchTypes.MainKitchen)
                        {
                            <SoftChip T="string" Color="Color.Info" Size="Size.Small" Variant="Variant.Filled">@InvL["BranchType:MainKitchen"]</SoftChip>
                        }
                        else
                        {
                            <SoftChip T="string" Color="Color.Default" Size="Size.Small" Variant="Variant.Outlined">@InvL["BranchType:SalesBranch"]</SoftChip>
                        }
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="BranchDto" Title="@InvL["IsActive"]" Sortable="true" SortBy="x => x.IsActive">
                    <CellTemplate>
                        @if (context.Item.IsActive)
                        {
                            <SoftChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Filled">@InvL["IsActive"]</SoftChip>
                        }
                        else
                        {
                            <SoftChip T="string" Color="Color.Default" Size="Size.Small" Variant="Variant.Outlined">-</SoftChip>
                        }
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="BranchDto" Title="@InvL["CreationTime"]" SortBy="x => x.CreationTime">
                    <CellTemplate><BrowserLocalTime Value="@context.Item.CreationTime" Display="BrowserTimeDisplay.DateTime" /></CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="BranchDto" Title="@InvL["Actions"]" Sortable="false">
                    <CellTemplate>
                        <span class="row-actions">
                            @if (_canManage)
                            {
                                <SoftStack Row="true" Spacing="1">
                                    <SoftIconButton Icon="@Icons.Material.Filled.Edit"
                                                    Color="Color.Primary"
                                                    Size="Size.Small"
                                                    OnClick="() => OpenEditDialog(context.Item)" />
                                    <SoftIconButton Icon="@Icons.Material.Filled.Delete"
                                                    Color="Color.Error"
                                                    Size="Size.Small"
                                                    OnClick="() => DeleteAsync(context.Item)" />
                                </SoftStack>
                            }
                        </span>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <PagerContent>
                <MudDataGridPager T="BranchDto" />
            </PagerContent>
        </SoftDataGrid>
    </SoftCardContent>
</SoftCard>

@if (_dialogVisible)
{
    <div class="glass-modal-backdrop" @onclick="CloseDialog">
        <div class="glass-modal-container glass-modal-container--md" @onclick:stopPropagation="true">
            <SoftCard Elevation="24" Class="glass-modal">
                <SoftCardHeader Class="pa-4">
                    <CardHeaderContent>
                        <SoftStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <SoftIcon Icon="@(_editingId.HasValue ? Icons.Material.Filled.Edit : Icons.Material.Filled.AddCircle)"
                                      Color="Color.Primary" Size="Size.Medium" />
                            <SoftText Typo="Typo.h6">
                                @(_editingId.HasValue ? InvL["EditBranch"] : InvL["NewBranch"])
                            </SoftText>
                        </SoftStack>
                    </CardHeaderContent>
                    <CardHeaderActions>
                        <SoftIconButton Icon="@Icons.Material.Filled.Close"
                                        Size="Size.Small"
                                        OnClick="CloseDialog" />
                    </CardHeaderActions>
                </SoftCardHeader>
                <SoftDivider />
                <SoftCardContent Class="pa-4 glass-modal-body">
                    <SoftStack Spacing="4">
                        <div>
                            <SoftText Typo="Typo.overline" Color="Color.Primary">@InvL["BasicInfo"]</SoftText>
                            <SoftDivider Class="mb-3" />
                            <SoftStack Spacing="3">
                                <div dir="rtl">
                                    <SoftTextField T="string"
                                                   Label="@InvL["NameArabic"]"
                                                   @bind-Value="_editNameAr"
                                                   Variant="Variant.Outlined"
                                                   MaxLength="128"
                                                   Required="true"
                                                   Immediate="true" />
                                </div>
                                <div dir="ltr">
                                    <SoftTextField T="string"
                                                   Label="@InvL["NameEnglish"]"
                                                   @bind-Value="_editNameEn"
                                                   Variant="Variant.Outlined"
                                                   MaxLength="128"
                                                   Required="true"
                                                   Immediate="true" />
                                </div>
                                <SoftLookupSelect TItem="IdentityUserDto" TValue="Guid?"
                                                  Items="_users"
                                                  ToValue="@(u => (Guid?)u.Id)"
                                                  ToLabel="@(u => FormatUser(u))"
                                                  Value="_editManagerUserId"
                                                  ValueChanged="@(v => _editManagerUserId = v)"
                                                  Label="@InvL["Manager"]"
                                                  Placeholder="@InvL["SelectManager"]"
                                                  Clearable="true" />
                                <SoftSelect T="string"
                                            Label="@InvL["BranchType"]"
                                            @bind-Value="_editBranchType"
                                            Variant="Variant.Outlined"
                                            Required="true">
                                    <MudSelectItem T="string" Value="@BranchTypes.SalesBranch">@InvL["BranchType:SalesBranch"]</MudSelectItem>
                                    <MudSelectItem T="string" Value="@BranchTypes.MainKitchen">@InvL["BranchType:MainKitchen"]</MudSelectItem>
                                </SoftSelect>
                            </SoftStack>
                        </div>

                        <div>
                            <SoftText Typo="Typo.overline" Color="Color.Primary">@InvL["Location"]</SoftText>
                            <SoftDivider Class="mb-3" />
                            <SoftStack Spacing="3">
                                <div dir="rtl">
                                    <SoftTextField T="string"
                                                   Label="@InvL["AddressArabic"]"
                                                   @bind-Value="_editAddressAr"
                                                   Variant="Variant.Outlined"
                                                   Lines="2"
                                                   MaxLength="512" />
                                </div>
                                <div dir="ltr">
                                    <SoftTextField T="string"
                                                   Label="@InvL["AddressEnglish"]"
                                                   @bind-Value="_editAddressEn"
                                                   Variant="Variant.Outlined"
                                                   Lines="2"
                                                   MaxLength="512" />
                                </div>
                            </SoftStack>
                        </div>

                        <div>
                            <SoftText Typo="Typo.overline" Color="Color.Primary">@InvL["ContactInfo"]</SoftText>
                            <SoftDivider Class="mb-3" />
                            <SoftStack Row="true" Spacing="2">
                                <SoftTextField T="string"
                                               Label="@InvL["Phone"]"
                                               @bind-Value="_editPhone"
                                               Variant="Variant.Outlined"
                                               MaxLength="32" />
                                <SoftTextField T="string"
                                               Label="@InvL["Email"]"
                                               @bind-Value="_editEmail"
                                               Variant="Variant.Outlined"
                                               InputType="InputType.Email"
                                               MaxLength="256" />
                            </SoftStack>
                            <SoftCheckBox T="bool" @bind-Value="_editIsActive" Label="@InvL["IsActive"]" Color="Color.Primary" Class="mt-3" />
                        </div>
                    </SoftStack>
                </SoftCardContent>
                <SoftDivider />
                <div class="pa-3 d-flex justify-end" style="gap: 8px;">
                    <SoftButton Variant="Variant.Text" OnClick="CloseDialog">@L["Cancel"]</SoftButton>
                    <SoftButton Variant="Variant.Filled"
                                Color="Color.Primary"
                                StartIcon="@Icons.Material.Filled.Save"
                                OnClick="SaveAsync"
                                Disabled="_saving">
                        @L["Save"]
                    </SoftButton>
                </div>
            </SoftCard>
        </div>
    </div>
}

@if (_confirmVisible)
{
    <div class="glass-modal-backdrop" @onclick="() => _confirmVisible = false">
        <div class="glass-modal-container glass-modal-container--sm" @onclick:stopPropagation="true">
            <SoftCard Elevation="24" Class="glass-modal">
                <SoftCardHeader Class="pa-4">
                    <CardHeaderContent>
                        <SoftStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <SoftIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Error" Size="Size.Medium" />
                            <SoftText Typo="Typo.h6">@InvL["Branches:DeleteTitle"]</SoftText>
                        </SoftStack>
                    </CardHeaderContent>
                </SoftCardHeader>
                <SoftDivider />
                <SoftCardContent Class="pa-4">
                    <SoftText>@InvL["Branches:DeleteConfirm", _pendingDelete?.Name ?? ""]</SoftText>
                </SoftCardContent>
                <SoftDivider />
                <div class="pa-3 d-flex justify-end" style="gap: 8px;">
                    <SoftButton Variant="Variant.Text" OnClick="() => _confirmVisible = false">@L["Cancel"]</SoftButton>
                    <SoftButton Variant="Variant.Filled"
                                Color="Color.Error"
                                StartIcon="@Icons.Material.Filled.Delete"
                                OnClick="ConfirmDeleteAsync">
                        @InvL["DeleteAction"]
                    </SoftButton>
                </div>
            </SoftCard>
        </div>
    </div>
}

@code {
    private SoftDataGrid<BranchDto> _grid = null!;
    private bool _loading;
    private bool _saving;
    private string? _filter;
    private bool _canManage;

    private List<IdentityUserDto> _users = new();
    private Dictionary<Guid, string> _userNames = new();

    private bool _dialogVisible;
    private Guid? _editingId;
    private string _editNameAr = string.Empty;
    private string _editNameEn = string.Empty;
    private string? _editAddressAr;
    private string? _editAddressEn;
    private string? _editPhone;
    private string? _editEmail;
    private Guid? _editManagerUserId;
    private bool _editIsActive = true;
    private string _editBranchType = BranchTypes.SalesBranch;

    private bool _confirmVisible;
    private BranchDto? _pendingDelete;

    protected override async Task OnInitializedAsync()
    {
        _canManage = await AuthorizationService.IsGrantedAsync(InventoryPermissions.Branches.Manage);
        await LoadUsersAsync();
    }

    private async Task LoadUsersAsync()
    {
        try
        {
            var result = await IdentityUserAppService.GetListAsync(new GetIdentityUsersInput
            {
                MaxResultCount = 1000,
                Sorting = nameof(IdentityUserDto.UserName)
            });
            _users = result.Items.ToList();
            _userNames = _users.ToDictionary(u => u.Id, FormatUser);
        }
        catch (Exception ex)
        {
            await HandleErrorAsync(ex);
        }
    }

    private static string FormatUser(IdentityUserDto u)
    {
        var display = !string.IsNullOrWhiteSpace(u.Name) || !string.IsNullOrWhiteSpace(u.Surname)
            ? $"{u.Name} {u.Surname}".Trim()
            : u.UserName;
        return string.IsNullOrWhiteSpace(display) ? u.UserName : $"{display} ({u.UserName})";
    }

    private string GetManagerName(Guid? id)
    {
        if (!id.HasValue) return InvL["Unassigned"];
        return _userNames.TryGetValue(id.Value, out var name) ? name : "-";
    }

    private async Task<GridData<BranchDto>> LoadServerData(GridState<BranchDto> state, CancellationToken cancellationToken)
    {
        _loading = true;
        try
        {
            string? sorting = null;
            var sort = state.SortDefinitions.FirstOrDefault();
            if (sort != null)
            {
                sorting = $"{sort.SortBy} {(sort.Descending ? "desc" : "asc")}";
            }

            var result = await BranchAppService.GetListAsync(new GetBranchesInput
            {
                Filter = _filter,
                SkipCount = state.Page * state.PageSize,
                MaxResultCount = state.PageSize,
                Sorting = sorting
            });

            return new GridData<BranchDto>
            {
                Items = result.Items,
                TotalItems = (int)result.TotalCount
            };
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnFilterKeyUpAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await ReloadAsync();
        }
    }

    private async Task ReloadAsync()
    {
        if (_grid != null)
        {
            await _grid.ReloadServerData();
        }
    }

    private void OpenCreateDialog()
    {
        _editingId = null;
        _editNameAr = string.Empty;
        _editNameEn = string.Empty;
        _editAddressAr = null;
        _editAddressEn = null;
        _editPhone = null;
        _editEmail = null;
        _editManagerUserId = null;
        _editIsActive = true;
        _editBranchType = BranchTypes.SalesBranch;
        _dialogVisible = true;
    }

    private void OpenEditDialog(BranchDto b)
    {
        _editingId = b.Id;
        _editNameAr = b.NameAr;
        _editNameEn = b.NameEn;
        _editAddressAr = b.AddressAr;
        _editAddressEn = b.AddressEn;
        _editPhone = b.Phone;
        _editEmail = b.Email;
        _editManagerUserId = b.ManagerUserId;
        _editIsActive = b.IsActive;
        _editBranchType = b.BranchType;
        _dialogVisible = true;
    }

    private void CloseDialog()
    {
        _dialogVisible = false;
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_editNameAr))
        {
            Snackbar.Add(L["ThisFieldIsRequired", InvL["NameArabic"]], Severity.Warning);
            return;
        }
        if (string.IsNullOrWhiteSpace(_editNameEn))
        {
            Snackbar.Add(L["ThisFieldIsRequired", InvL["NameEnglish"]], Severity.Warning);
            return;
        }

        _saving = true;
        try
        {
            if (_editingId.HasValue)
            {
                await BranchAppService.UpdateAsync(_editingId.Value, new UpdateBranchDto
                {
                    NameAr = _editNameAr,
                    NameEn = _editNameEn,
                    AddressAr = _editAddressAr,
                    AddressEn = _editAddressEn,
                    Phone = _editPhone,
                    Email = _editEmail,
                    ManagerUserId = _editManagerUserId,
                    IsActive = _editIsActive,
                    BranchType = _editBranchType
                });
            }
            else
            {
                await BranchAppService.CreateAsync(new CreateBranchDto
                {
                    NameAr = _editNameAr,
                    NameEn = _editNameEn,
                    AddressAr = _editAddressAr,
                    AddressEn = _editAddressEn,
                    Phone = _editPhone,
                    Email = _editEmail,
                    ManagerUserId = _editManagerUserId,
                    IsActive = _editIsActive,
                    BranchType = _editBranchType
                });
            }
            Snackbar.Add(L["SuccessfullySaved"], Severity.Success);
            _dialogVisible = false;
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            await HandleErrorAsync(ex);
        }
        finally
        {
            _saving = false;
        }
    }

    private void DeleteAsync(BranchDto b)
    {
        _pendingDelete = b;
        _confirmVisible = true;
    }

    private async Task ConfirmDeleteAsync()
    {
        if (_pendingDelete == null) return;
        try
        {
            await BranchAppService.DeleteAsync(_pendingDelete.Id);
            Snackbar.Add(L["SuccessfullyDeleted"], Severity.Success);
            _confirmVisible = false;
            _pendingDelete = null;
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            await HandleErrorAsync(ex);
        }
    }
}
