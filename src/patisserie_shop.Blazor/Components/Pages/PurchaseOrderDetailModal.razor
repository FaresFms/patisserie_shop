    // ─── Receive flow ───

    private void OpenReceiveDialog()
    {
        // Default each line to its remaining quantity — a full delivery (the common case)
        // is one click to confirm; the manager reduces lines only for partial deliveries.
        _receiveRows = _po!.Items.Select(i => new ReceiveRow
        {
            Item = i,
            ReceiveNow = i.OrderedQuantity - i.ReceivedQuantity
        }).ToList();
        _receiveVisible = true;
    }

    private void CloseReceive() => _receiveVisible = false;

    private void ReceiveAllRemaining()
    {
        foreach (var row in _receiveRows)
        {
            row.ReceiveNow = row.Item.OrderedQuantity - row.Item.ReceivedQuantity;
        }
    }

    private async Task ConfirmReceive()
    {
        var lines = _receiveRows
            .Where(r => r.ReceiveNow > 0)
            .Select(r => new ReceiveLineDto
            {
                ItemId = r.Item.Id,
                ReceivedQuantity = r.ReceiveNow,
                ExpiryDate = r.ExpiryDate
            })
            .ToList();

        if (lines.Count == 0)
        {
            Snackbar.Add(OpsL["ReceiveAtLeastOne"], Severity.Warning);
            return;
        }

        var missingExpiry = _receiveRows.FirstOrDefault(
            r => r.ReceiveNow > 0 && r.Item.TracksExpiry && !r.ExpiryDate.HasValue);
        if (missingExpiry != null)
        {
            Snackbar.Add(OpsL["ReceiveExpiryRequired", missingExpiry.Item.ProductName], Severity.Warning);
            return;
        }

        var expired = _receiveRows.FirstOrDefault(
            r => r.ReceiveNow > 0 && r.Item.TracksExpiry && r.ExpiryDate!.Value.Date < DateTime.Today);
        if (expired != null)
        {
            Snackbar.Add(OpsL["ReceiveExpiryInPast", expired.Item.ProductName], Severity.Warning);
            return;
        }

        _saving = true;
        try
        {
            var updated = await PurchaseOrderAppService.ReceiveAsync(PurchaseOrderId, new ReceiveItemsDto { Lines = lines });
            _receiveVisible = false;
            var msg = updated.Status == PurchaseOrderStatuses.Received
                ? string.Format(OpsL["PurchaseOrderFullyReceivedToast"], updated.PONumber)
                : string.Format(OpsL["PurchaseOrderPartiallyReceivedToast"], updated.PONumber);
            Snackbar.Add(msg, Severity.Success);
            await NotifyChanged();
            await CloseAsync();
        }
        catch (Exception ex) { await HandleErrorAsync(ex); }
        finally { _saving = false; }
    }

    private static string StatusIcon(string status) => status switch
    {
        PurchaseOrderStatuses.Draft => Icons.Material.Filled.EditNote,
        PurchaseOrderStatuses.Submitted => Icons.Material.Filled.Send,
        PurchaseOrderStatuses.Approved => Icons.Material.Filled.CheckCircle,
        PurchaseOrderStatuses.PartialReceived => Icons.Material.Filled.HourglassBottom,
        PurchaseOrderStatuses.Received => Icons.Material.Filled.TaskAlt,
        PurchaseOrderStatuses.Cancelled => Icons.Material.Filled.Cancel,
        _ => Icons.Material.Filled.HelpOutline
    };

    private static string FormatDate(DateTime date)
        => date.ToString("dd MMMM yyyy", CultureInfo.CurrentCulture);
}
