@using System.Threading
@using System.Threading.Tasks
@using System.Globalization
@using Microsoft.AspNetCore.Components
@using Operations
@using Operations.PurchaseOrders
@using Operations.Permissions
@using Operations.Localization
@using Inventory.Products
@using Color = MudBlazor.Color
@using Variant = MudBlazor.Variant
@using Size = MudBlazor.Size
@using Margin = MudBlazor.Margin
@inherits patisserie_shopComponentBase
@inject IPurchaseOrderAppService PurchaseOrderAppService
@inject IProductAppService ProductAppService
@inject ISnackbar Snackbar
@inject IStringLocalizer<OperationsResource> OpsL

@if (_po == null)
{
    return;
}

<div class="soft-modal-backdrop" @onclick="CloseAsync">
    <div class="soft-modal-container soft-modal-container--xl" @onclick:stopPropagation="true">
        <SoftCard Elevation="24" Class="soft-modal-card">

            <SoftCardHeader Class="pa-4">
                <CardHeaderContent>
                    <SoftStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <SoftIcon Icon="@Icons.Material.Filled.RequestQuote" Color="Color.Primary" Size="Size.Medium" />
                        <div>
                            <SoftStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <SoftText Typo="Typo.h6">@_po.PONumber</SoftText>
                                <div class="@($"po-status po-status-{_po.Status.ToLower()}")">
                                    <MudIcon Icon="@StatusIcon(_po.Status)" Size="Size.Small" />
                                    <span>@OpsL[$"Status:{_po.Status}"]</span>
                                </div>
                            </SoftStack>
                            <SoftText Typo="Typo.caption" Color="Color.Default">
                                @($"{_po.SupplierName} → {_po.DestBranchName}")
                            </SoftText>
                        </div>
                    </SoftStack>
                </CardHeaderContent>
                <CardHeaderActions>
                    <SoftIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="CloseAsync" />
                </CardHeaderActions>
            </SoftCardHeader>
            <SoftDivider />

            <SoftCardContent Class="pa-4 po-modal-body">
                <SoftStack Spacing="4">

                    <!-- Order info -->
                    @{
                        var orderDateText    = FormatDate(_po.OrderDate);
                        var expectedDateText = _po.ExpectedDeliveryDate.HasValue ? FormatDate(_po.ExpectedDeliveryDate.Value) : "-";
                        var createdByText    = _po.CreatorUserName ?? "-";
                        var totalText        = FormatShopMoney(_po.TotalAmount);
                    }
                    <div>
                        <SoftText Typo="Typo.overline" Color="Color.Primary">@OpsL["OrderInfo"]</SoftText>
                        <SoftDivider Class="mb-3" />
                        <div class="po-info-grid">
                            <InfoRow Label="@OpsL["OrderDate"]" Value="@orderDateText" />
                            <InfoRow Label="@OpsL["ExpectedDeliveryDate"]" Value="@expectedDateText" />
                            <InfoRow Label="@OpsL["CreatedAt"]"><BrowserLocalTime Value="@_po.CreationTime" Display="BrowserTimeDisplay.LongDateTime" /></InfoRow>
                            <InfoRow Label="@OpsL["ActualDeliveryDate"]"><BrowserLocalTime Value="@_po.ActualDeliveryDate" Display="BrowserTimeDisplay.LongDateTime" Fallback="-" /></InfoRow>
                            <InfoRow Label="@OpsL["CreatedBy"]" Value="@createdByText" />
                            <InfoRow Label="@OpsL["Currency"]" Value="@ShopCurrency" />
                            <InfoRow Label="@OpsL["TotalAmount"]" Value="@totalText" Strong="true" />
                        </div>
                        @if (!string.IsNullOrWhiteSpace(_po.Notes))
                        {
                            <div class="po-notes">
                                <div class="po-notes-label">@OpsL["Notes"]</div>
                                <div class="po-notes-text">@_po.Notes</div>
                            </div>
                        }
                    </div>

                    <div>
                        <SoftText Typo="Typo.overline" Color="Color.Primary">@OpsL["WorkflowTimeline"]</SoftText>
                        <SoftDivider Class="mb-3" />
                        <div class="po-stepper">
                            @for (var i = 0; i < PoStepKeys.Length; i++)
                            {
                                var stepIndex = i;
                                var state = PoStepState(stepIndex);
                                <div class="@($"po-step po-step-{state}")">
                                    <div class="po-step-dot">
                                        @if (state == "done")
                                        {
                                            <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" />
                                        }
                                        else
                                        {
                                            <MudIcon Icon="@PoStepIcon(stepIndex)" Size="Size.Small" />
                                        }
                                    </div>
                                    <span class="po-step-label">@OpsL[$"POStep:{PoStepKeys[stepIndex]}"]</span>
                                </div>
                                @if (stepIndex < PoStepKeys.Length - 1)
                                {
                                    <div class="@($"po-step-line {(stepIndex < CurrentPoStepIndex ? "po-step-line-done" : "")}")"></div>
                                }
                            }
                        </div>
                    </div>

                    <!-- Progress (when receiving) -->
                    @if (_po.Status == PurchaseOrderStatuses.PartialReceived || _po.Status == PurchaseOrderStatuses.Received)
                    {
                        <div>
                            <SoftText Typo="Typo.overline" Color="Color.Primary">@OpsL["Progress"]</SoftText>
                            <SoftDivider Class="mb-3" />
                            @{
                                var totalOrdered = _po.Items.Sum(i => i.OrderedQuantity);
                                var totalReceived = _po.Items.Sum(i => i.ReceivedQuantity);
                                var pct = totalOrdered == 0 ? 0 : (int)(100.0 * totalReceived / totalOrdered);
                            }
                            <SoftStack Spacing="1">
                                <SoftStack Row="true" Justify="Justify.SpaceBetween">
                                    <SoftText Typo="Typo.body2">@string.Format(OpsL["UnitsReceivedProgress"], totalReceived, totalOrdered)</SoftText>
                                    <SoftText Typo="Typo.body2" Style="font-weight:600;">@pct%</SoftText>
                                </SoftStack>
                                <MudProgressLinear Color="Color.Success" Value="@pct" Class="po-progress" />
                            </SoftStack>
                        </div>
                    }

                    @if (StatusHint() is { Length: > 0 } statusHint)
                    {
                        <SoftAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
                            @statusHint
                        </SoftAlert>
                    }

                    <!-- Items -->
                    <div>
                        <SoftStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                            <SoftText Typo="Typo.overline" Color="Color.Primary">@OpsL["Items"] (@_po.Items.Count)</SoftText>
                            @if (_po.Status == PurchaseOrderStatuses.Draft && _canEdit)
                            {
                                <SoftButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                                            StartIcon="@Icons.Material.Filled.Add"
                                            OnClick="OpenAddItem">@OpsL["AddProduct"]</SoftButton>
                            }
                        </SoftStack>
                        <SoftDivider Class="mb-3" />

                        @if (_po.Items.Count == 0)
                        {
                            <SoftStack AlignItems="AlignItems.Center" Spacing="1" Class="pa-4">
                                <SoftIcon Icon="@Icons.Material.Outlined.Inbox" Style="font-size:42px; opacity:0.4;" />
                                <SoftText Typo="Typo.body2" Color="Color.Default">@OpsL["NoItemsYet"]</SoftText>
                            </SoftStack>
                        }
                        else
                        {
                            <MudTable T="PurchaseOrderItemDto" Items="@_po.Items" Dense="true" Hover="true" Bordered="false" Striped="true">
                                <HeaderContent>
                                    <MudTh>@OpsL["Product"]</MudTh>
                                    <MudTh Style="text-align:right;">@OpsL["OrderedQuantity"]</MudTh>
                                    <MudTh Style="text-align:right;">@OpsL["ReceivedQuantity"]</MudTh>
                                    <MudTh Style="text-align:right;">@OpsL["UnitPrice"]</MudTh>
                                    <MudTh Style="text-align:right;">@OpsL["Subtotal"]</MudTh>
                                    <MudTh></MudTh>
                                </HeaderContent>
                                <RowTemplate Context="item">
                                    <MudTd>
                                        <SoftStack Spacing="0">
                                            <SoftText Typo="Typo.body2" Style="font-weight:500;">@item.ProductName</SoftText>
                                            <SoftText Typo="Typo.caption" Color="Color.Default">@item.ProductSKU</SoftText>
                                        </SoftStack>
                                    </MudTd>
                                    <MudTd Style="text-align:right;">@item.OrderedQuantity @item.ProductUnit</MudTd>
                                    <MudTd Style="text-align:right;">
                                        @if (item.ReceivedQuantity > 0 || _po.Status == PurchaseOrderStatuses.Received || _po.Status == PurchaseOrderStatuses.PartialReceived)
                                        {
                                            <SoftChip T="string"
                                                      Color="@(item.IsFullyReceived ? Color.Success : Color.Warning)"
                                                      Size="Size.Small"
                                                      Variant="Variant.Filled">
                                                @item.ReceivedQuantity / @item.OrderedQuantity
                                            </SoftChip>
                                        }
                                        else
                                        {
                                            <SoftText Color="Color.Default">-</SoftText>
                                        }
                                    </MudTd>
                                    <MudTd Style="text-align:right;">@FormatShopMoney(item.UnitPrice)</MudTd>
                                    <MudTd Style="text-align:right;"><strong>@FormatShopMoney(item.Subtotal)</strong></MudTd>
                                    <MudTd>
                                        @if (_po.Status == PurchaseOrderStatuses.Draft && _canEdit)
                                        {
                                            <SoftIconButton Icon="@Icons.Material.Filled.Delete"
                                                            Color="Color.Error"
                                                            Size="Size.Small"
                                                            OnClick="@(() => RemoveItemAsync(item))" />
                                        }
                                    </MudTd>
                                </RowTemplate>
                            </MudTable>
                        }
                    </div>

                </SoftStack>
            </SoftCardContent>

            <SoftDivider />
            <div class="pa-3 d-flex justify-end flex-wrap" style="gap: 8px;">
                <SoftButton Variant="Variant.Text" OnClick="CloseAsync">@L["Close"]</SoftButton>

                @if (_po.Status == PurchaseOrderStatuses.Draft && _po.Items.Count > 0 && _canSubmit)
                {
                    <SoftButton Variant="Variant.Filled" Color="Color.Primary"
                                StartIcon="@Icons.Material.Filled.Send"
                                OnClick="SubmitAsync" Disabled="_saving">@OpsL["SubmitOrder"]</SoftButton>
                }
                @if (_po.Status == PurchaseOrderStatuses.Submitted && _canApprove)
                {
                    <SoftButton Variant="Variant.Filled" Color="Color.Success"
                                StartIcon="@Icons.Material.Filled.CheckCircle"
                                OnClick="ApproveAsync" Disabled="_saving">@OpsL["Approve"]</SoftButton>
                }
                @if ((_po.Status == PurchaseOrderStatuses.Approved || _po.Status == PurchaseOrderStatuses.PartialReceived) && _canReceive)
                {
                    <SoftButton Variant="Variant.Filled" Color="Color.Tertiary"
                                StartIcon="@Icons.Material.Filled.Inventory"
                                OnClick="OpenReceiveDialog" Disabled="_saving">@OpsL["ReceiveItems"]</SoftButton>
                }
                @if (_po.Status != PurchaseOrderStatuses.Received && _po.Status != PurchaseOrderStatuses.Cancelled && _canCancel)
                {
                    <SoftButton Variant="Variant.Outlined" Color="Color.Error"
                                StartIcon="@Icons.Material.Filled.Cancel"
                                OnClick="CancelAsync" Disabled="_saving">@OpsL["Cancel"]</SoftButton>
                }
            </div>

        </SoftCard>
    </div>
</div>

<!-- ── Add Item dialog ── -->
@if (_addItemVisible)
{
    <div class="soft-modal-backdrop" @onclick="CloseAddItem">
        <div class="soft-modal-container" @onclick:stopPropagation="true">
            <SoftCard Elevation="24" Class="soft-modal-card">
                <SoftCardHeader Class="pa-4">
                    <CardHeaderContent>
                        <SoftStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <SoftIcon Icon="@Icons.Material.Filled.AddBox" Color="Color.Primary" Size="Size.Medium" />
                            <SoftText Typo="Typo.h6">@OpsL["AddProduct"]</SoftText>
                        </SoftStack>
                    </CardHeaderContent>
                    <CardHeaderActions>
                        <SoftIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="CloseAddItem" />
                    </CardHeaderActions>
                </SoftCardHeader>
                <SoftDivider />
                <SoftCardContent Class="pa-4">
                    <SoftStack Spacing="3">
                        <SoftLookupSelect TItem="ProductLookupDto" TValue="Guid?"
                                          Items="_availableProducts"
                                          ToValue="@(p => (Guid?)p.Id)"
                                          ToLabel="@(p => $"{p.SKU} — {p.Name}")"
                                          Value="_newItemProductId"
                                          ValueChanged="OnAddItemProductChanged"
                                          Label="@OpsL["Product"]"
                                          Required="true" />
                        <SoftStack Row="true" Spacing="2">
                            <SoftNumericField T="int" Label="@OpsL["OrderedQuantity"]"
                                              @bind-Value="_newItemQty"
                                              Variant="Variant.Outlined" Min="1" />
                            <SoftNumericField T="decimal" Label="@OpsL["UnitPrice"]"
                                              @bind-Value="_newItemPrice"
                                              Variant="Variant.Outlined" Min="0" Step="0.01m"
                                              InputMode="@(MudBlazor.InputMode.@decimal)" Format="0.00"
                                              Immediate="true"
                                              Adornment="Adornment.Start"
                                              AdornmentText="@ShopCurrency" />
                        </SoftStack>
                        @{
                            var preview = _newItemQty * _newItemPrice;
                        }
                        <SoftStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                            <SoftText Typo="Typo.caption" Color="Color.Default">@OpsL["Subtotal"]:</SoftText>
                            <SoftText Typo="Typo.body1" Style="font-weight:600;">@FormatShopMoney(preview)</SoftText>
                        </SoftStack>
                    </SoftStack>
                </SoftCardContent>
                <SoftDivider />
                <div class="pa-3 d-flex justify-end" style="gap: 8px;">
                    <SoftButton Variant="Variant.Text" OnClick="CloseAddItem">@L["Cancel"]</SoftButton>
                    <SoftButton Variant="Variant.Filled" Color="Color.Primary"
                                StartIcon="@Icons.Material.Filled.Save"
                                OnClick="ConfirmAddItem" Disabled="_saving">@L["Save"]</SoftButton>
                </div>
            </SoftCard>
        </div>
    </div>
}

<!-- ── Receive Items dialog ── -->
@if (_receiveVisible)
{
    <div class="soft-modal-backdrop" @onclick="CloseReceive">
        <div class="soft-modal-container soft-modal-container--lg" @onclick:stopPropagation="true">
            <SoftCard Elevation="24" Class="soft-modal-card">
                <SoftCardHeader Class="pa-4">
                    <CardHeaderContent>
                        <SoftStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <SoftIcon Icon="@Icons.Material.Filled.Inventory" Color="Color.Tertiary" Size="Size.Medium" />
                            <div>
                                <SoftText Typo="Typo.h6">@OpsL["ReceiveItems"]</SoftText>
                                <SoftText Typo="Typo.caption" Color="Color.Default">
                                    @OpsL["ReceiveDialogHint"]
                                </SoftText>
                            </div>
                        </SoftStack>
                    </CardHeaderContent>
                    <CardHeaderActions>
                        <SoftIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="CloseReceive" />
                    </CardHeaderActions>
                </SoftCardHeader>
                <SoftDivider />
                <SoftCardContent Class="pa-4 po-modal-body">
                    <MudTable T="ReceiveRow" Items="@_receiveRows" Dense="true" Hover="true" Bordered="false">
                        <HeaderContent>
                            <MudTh>@OpsL["Product"]</MudTh>
                            <MudTh Style="text-align:right;">@OpsL["OrderedQuantity"]</MudTh>
                            <MudTh Style="text-align:right;">@OpsL["ReceivedQuantity"]</MudTh>
                            <MudTh Style="text-align:right;">@OpsL["Remaining"]</MudTh>
                            <MudTh Style="text-align:center; min-width: 140px;">@OpsL["ReceiveNow"]</MudTh>
                            <MudTh Style="min-width: 190px;">@OpsL["BatchExpiryDate"]</MudTh>
                        </HeaderContent>
                        <RowTemplate Context="row">
                            <MudTd>
                                <SoftStack Spacing="0">
                                    <SoftText Typo="Typo.body2" Style="font-weight:500;">@row.Item.ProductName</SoftText>
                                    <SoftText Typo="Typo.caption" Color="Color.Default">@row.Item.ProductSKU</SoftText>
                                </SoftStack>
                            </MudTd>
                            <MudTd Style="text-align:right;">@row.Item.OrderedQuantity</MudTd>
                            <MudTd Style="text-align:right;">@row.Item.ReceivedQuantity</MudTd>
                            <MudTd Style="text-align:right;">
                                <strong>@(row.Item.OrderedQuantity - row.Item.ReceivedQuantity)</strong>
                            </MudTd>
                            <MudTd Style="text-align:center;">
                                @if (row.Item.IsFullyReceived)
                                {
                                    <SoftChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Filled">
                                        @OpsL["FullyReceived"]
                                    </SoftChip>
                                }
                                else
                                {
                                    <SoftNumericField T="int" @bind-Value="row.ReceiveNow"
                                                      Variant="Variant.Outlined" Min="0"
                                                      Max="@(row.Item.OrderedQuantity - row.Item.ReceivedQuantity)"
                                                      Margin="Margin.Dense" Class="soft-qty" />
                                }
                            </MudTd>
                            <MudTd>
                                @if (!row.Item.IsFullyReceived && row.Item.TracksExpiry && row.ReceiveNow > 0)
                                {
                                    <SoftDatePicker Date="row.ExpiryDate"
                                                    DateChanged="@(d => row.ExpiryDate = d)"
                                                    Label="@OpsL["BatchExpiryDate"]"
                                                    MinDate="DateTime.Today"
                                                    Variant="Variant.Outlined"
                                                    Margin="Margin.Dense" />
                                }
                                else
                                {
                                    <SoftText Color="Color.Default">—</SoftText>
                                }
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                </SoftCardContent>
                <SoftDivider />
                <div class="pa-3 d-flex justify-end" style="gap: 8px;">
                    <SoftButton Variant="Variant.Text" OnClick="CloseReceive">@L["Cancel"]</SoftButton>
                    <SoftButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="ReceiveAllRemaining">
                        @OpsL["ReceiveAllRemaining"]
                    </SoftButton>
                    <SoftButton Variant="Variant.Filled" Color="Color.Tertiary"
                                StartIcon="@Icons.Material.Filled.CheckCircle"
                                OnClick="ConfirmReceive" Disabled="_saving">@OpsL["ConfirmReceive"]</SoftButton>
                </div>
            </SoftCard>
        </div>
    </div>
}

<style>
    .soft-modal-container--xl { max-width: 980px; }
    .soft-modal-container--lg { max-width: 760px; }

    .po-modal-body {
        max-height: 72vh;
        overflow-y: auto;
    }

    .po-info-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
        gap: 12px 24px;
    }

    .po-notes {
        margin-top: 16px;
        padding: 14px 16px;
        background: var(--surface-2);
        border: 1px solid var(--bd-1);
        border-radius: var(--r-sm);
    }

    .po-notes-label {
        margin-bottom: 8px;
        color: var(--fg-3);
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        text-transform: uppercase;
    }

    .po-notes-text {
        color: var(--fg-1);
        font-size: 0.9rem;
        line-height: 1.75;
        white-space: pre-line;
        overflow-wrap: anywhere;
        unicode-bidi: plaintext;
    }

    .po-progress {
        height: 10px;
        border-radius: 5px;
    }

    .po-stepper {
        display: grid;
        grid-template-columns: auto 1fr auto 1fr auto 1fr auto;
        align-items: center;
        gap: 8px;
    }

    .po-step {
        display: inline-flex;
        flex-direction: column;
        align-items: center;
        gap: 6px;
        min-width: 68px;
        text-align: center;
    }

    .po-step-dot {
        width: 32px;
        height: 32px;
        border-radius: 999px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 1px solid var(--bd-2);
        background: var(--surface-2);
        color: var(--fg-3);
    }

    .po-step-label {
        font-size: 0.78rem;
        color: var(--fg-2);
        white-space: nowrap;
    }

    .po-step-line {
        height: 2px;
        min-width: 28px;
        border-radius: 999px;
        background: var(--bd-2);
    }

    .po-step-current .po-step-dot,
    .po-step-done .po-step-dot {
        border-color: var(--accent-line);
        background: var(--accent-soft);
        color: var(--accent);
    }

    .po-step-done .po-step-dot {
        background: var(--accent);
        color: var(--accent-fg);
    }

    .po-step-current .po-step-label,
    .po-step-done .po-step-label {
        color: var(--fg-1);
        font-weight: 600;
    }

    .po-step-line-done {
        background: var(--accent);
    }

    .po-status {
        display: inline-flex; align-items: center; gap: 6px;
        padding: 3px 10px; border-radius: 999px;
        font-size: 0.78rem; font-weight: 500;
    }
    .po-status-draft           { background: rgba(120,120,120,0.18); color: #444; }
    .po-status-submitted       { background: rgba(33,150,243,0.15);  color: #1565c0; }
    .po-status-approved        { background: rgba(76,175,80,0.15);   color: #2e7d32; }
    .po-status-partialreceived { background: rgba(255,167,38,0.18);  color: #b26a00; }
    .po-status-received        { background: rgba(0,150,136,0.15);   color: #00695c; }
    .po-status-cancelled       { background: rgba(244,67,54,0.15);   color: #c62828; }
</style>

@code {
    [Parameter, EditorRequired] public Guid PurchaseOrderId { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback Changed { get; set; }

    private PurchaseOrderDto? _po;
    private bool _saving;

    private bool _canEdit;
    private bool _canSubmit;
    private bool _canApprove;
    private bool _canCancel;
    private bool _canReceive;
    private static readonly string[] PoStepKeys = { "Draft", "Submit", "Approve", "Receive" };

    /// <summary>Plain-language "what happens next" line, per status and role.</summary>
    private string? StatusHint()
    {
        if (_po == null) return null;

        return _po.Status switch
        {
            PurchaseOrderStatuses.Draft when _canEdit => OpsL["POHint:DraftMine"].Value,
            PurchaseOrderStatuses.Draft => OpsL["POHint:Draft"].Value,
            PurchaseOrderStatuses.Submitted when _canApprove => OpsL["POHint:SubmittedApprover"].Value,
            PurchaseOrderStatuses.Submitted => OpsL["POHint:Submitted"].Value,
            PurchaseOrderStatuses.Approved when _canReceive => OpsL["POHint:ApprovedReceiver"].Value,
            PurchaseOrderStatuses.Approved => OpsL["POHint:Approved"].Value,
            PurchaseOrderStatuses.PartialReceived when _canReceive => OpsL["POHint:Partial"].Value,
            _ => null
        };
    }

    private int CurrentPoStepIndex => _po?.Status switch
    {
        PurchaseOrderStatuses.Draft => 0,
        PurchaseOrderStatuses.Submitted => 1,
        PurchaseOrderStatuses.Approved => 2,
        PurchaseOrderStatuses.PartialReceived => 3,
        PurchaseOrderStatuses.Received => PoStepKeys.Length,
        _ => -1
    };

    private string PoStepState(int index)
    {
        if (index < CurrentPoStepIndex) return "done";
        if (index == CurrentPoStepIndex) return "current";
        return "upcoming";
    }

    private static string PoStepIcon(int index) => index switch
    {
        0 => Icons.Material.Filled.EditNote,
        1 => Icons.Material.Filled.Send,
        2 => Icons.Material.Filled.FactCheck,
        3 => Icons.Material.Filled.Inventory,
        _ => Icons.Material.Filled.RadioButtonUnchecked
    };

    private bool _addItemVisible;
    private List<ProductLookupDto> _availableProducts = new();
    private Guid? _newItemProductId;
    private int _newItemQty = 1;
    private decimal _newItemPrice;

    private bool _receiveVisible;
    private List<ReceiveRow> _receiveRows = new();

    public class ReceiveRow
    {
        public PurchaseOrderItemDto Item { get; set; } = null!;
        public int ReceiveNow { get; set; }
        public DateTime? ExpiryDate { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadShopCurrencyAsync();
        _canEdit    = await AuthorizationService.IsGrantedAsync(OperationsPermissions.PurchaseOrders.Edit);
        _canSubmit  = await AuthorizationService.IsGrantedAsync(OperationsPermissions.PurchaseOrders.Submit);
        _canApprove = await AuthorizationService.IsGrantedAsync(OperationsPermissions.PurchaseOrders.Approve);
        _canCancel  = await AuthorizationService.IsGrantedAsync(OperationsPermissions.PurchaseOrders.Cancel);
        _canReceive = await AuthorizationService.IsGrantedAsync(OperationsPermissions.PurchaseOrders.Receive);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            _po = await PurchaseOrderAppService.GetAsync(PurchaseOrderId);
        }
        catch (Exception ex)
        {
            await HandleErrorAsync(ex);
        }
    }

    private async Task CloseAsync()
    {
        if (OnClose.HasDelegate) await OnClose.InvokeAsync();
    }

    private async Task NotifyChanged()
    {
        if (Changed.HasDelegate) await Changed.InvokeAsync();
    }

    // ─── Item editing ───

    private async Task OpenAddItem()
    {
        _newItemProductId = null;
        _newItemQty = 1;
        _newItemPrice = 0;
        try
        {
            _availableProducts = await ProductAppService.GetLookupAsync();
            // Filter out products already on the order
            var existing = _po!.Items.Select(i => i.ProductId).ToHashSet();
            _availableProducts = _availableProducts.Where(p => !existing.Contains(p.Id)).ToList();
        }
        catch (Exception ex)
        {
            await HandleErrorAsync(ex);
        }
        _addItemVisible = true;
    }

    private void OnAddItemProductChanged(Guid? id)
    {
        _newItemProductId = id;
        if (id.HasValue)
        {
            var p = _availableProducts.FirstOrDefault(x => x.Id == id.Value);
            if (p != null)
            {
                _newItemPrice = p.SalePrice;
            }
        }
        else
        {
            _newItemPrice = 0;
        }
    }

    private void CloseAddItem() => _addItemVisible = false;

    private async Task ConfirmAddItem()
    {
        if (!_newItemProductId.HasValue || _newItemQty <= 0)
        {
            Snackbar.Add(L["ThisFieldIsRequired", OpsL["Product"]], Severity.Warning);
            return;
        }
        _saving = true;
        try
        {
            await PurchaseOrderAppService.AddItemAsync(PurchaseOrderId, new AddPurchaseOrderItemDto
            {
                ProductId = _newItemProductId.Value,
                OrderedQuantity = _newItemQty,
                UnitPrice = _newItemPrice
            });
            _addItemVisible = false;
            await LoadAsync();
            await NotifyChanged();
        }
        catch (Exception ex)
        {
            await HandleErrorAsync(ex);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task RemoveItemAsync(PurchaseOrderItemDto item)
    {
        try
        {
            await PurchaseOrderAppService.RemoveItemAsync(PurchaseOrderId, item.Id);
            await LoadAsync();
            await NotifyChanged();
        }
        catch (Exception ex)
        {
            await HandleErrorAsync(ex);
        }
    }

    // ─── Status actions ───

    private async Task SubmitAsync()
    {
        _saving = true;
        try
        {
            var updated = await PurchaseOrderAppService.SubmitAsync(PurchaseOrderId);
            Snackbar.Add(string.Format(OpsL["PurchaseOrderSubmittedToast"], updated.PONumber), Severity.Success);
            await NotifyChanged();
            await CloseAsync();
        }
        catch (Exception ex) { await HandleErrorAsync(ex); }
        finally { _saving = false; }
    }

