@code {
    private DecisionLogSummaryDto _summary = new();
    private List<DecisionLogDto> _items = new();
    private bool _loading;
    private bool _canAcknowledge;
    private Guid? _busyId;

    private bool _consolidateDialogVisible;
    private bool _consolidating;
    private bool _executeDialogVisible;
    private bool _preparingExecute;
    private bool _executingPreview;
    private DecisionLogDto? _executeItem;
    private DecisionActionPreviewDto? _executePreview;

    /// <summary>Pending reorder-type decisions (LowStock / Reorder / Stockout) in the current view.</summary>
    private int _pendingReorderInView;

    private static readonly string[] _reorderTypes =
    {
        DecisionTypes.LowStockAlert,
        DecisionTypes.ReorderSuggestion,
        DecisionTypes.StockoutRisk
    };

    private const string TabPending = "pending";
    private const string TabHandled = "handled";
    private const string TabAll = "all";

    private string _tab = TabPending;
    private string? _filter;
    private Guid? _branchFilter;
    private string? _groupFilter;
    private string? _period;

    private const int _pageSize = 10;
    private int _skipCount;
    private int _totalCount;

    private List<BranchLookupDto> _branches = new();
    private List<LabeledOption> _groupOptions = new();
    private List<LabeledOption> _periodOptions = new();

    /// <summary>Plain-language category groups — nobody should have to pick from 16 technical types.</summary>
    private static readonly Dictionary<string, string[]> _typeGroups = new()
    {
        ["stock"] = new[] { DecisionTypes.LowStockAlert, DecisionTypes.ExcessStockAlert, DecisionTypes.DeadStockFlag, DecisionTypes.StockoutRisk },
        ["restock"] = new[] { DecisionTypes.ReorderSuggestion, DecisionTypes.TransferSuggestion, DecisionTypes.UnfulfilledBranchRequest },
        ["expiry"] = new[] { DecisionTypes.ExpiryAlert, DecisionTypes.WasteWriteOff, DecisionTypes.HighKitchenWaste },
        ["production"] = new[] { DecisionTypes.IngredientShortage, DecisionTypes.ProductionShortageRisk, DecisionTypes.ProductionCostVariance, DecisionTypes.LateProductionRisk },
        ["cashier"] = new[] { DecisionTypes.StockReport, DecisionTypes.CashierVariance }
    };

    private static readonly string[] _handledStatuses =
    {
        DecisionLogStatuses.Acknowledged,
        DecisionLogStatuses.Dismissed,
        DecisionLogStatuses.Executed
    };

    // Cache for AcknowledgedByUserId → UserName, filled once per circuit.
    private readonly Dictionary<Guid, string> _userNames = new();
    private bool _usersLoaded;

    public record LabeledOption(string Value, string Label);

    /// <summary>Deep-link from the notification bell: pre-filter to one branch.</summary>
    [Parameter, SupplyParameterFromQuery(Name = "branchId")]
    public Guid? BranchIdFilter { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _canAcknowledge = await AuthorizationService.IsGrantedAsync(IntelligencePermissions.DecisionLogs.Acknowledge);

        if (BranchIdFilter.HasValue)
        {
            _branchFilter = BranchIdFilter.Value;
        }

        _groupOptions = new List<LabeledOption>
        {
            new("stock",      IntL["DecisionGroup:Stock"]),
            new("restock",    IntL["DecisionGroup:Restock"]),
            new("expiry",     IntL["DecisionGroup:Expiry"]),
            new("production", IntL["DecisionGroup:Production"]),
            new("cashier",    IntL["DecisionGroup:Cashier"])
        };

        _periodOptions = new List<LabeledOption>
        {
            new("today", IntL["Period:Today"]),
            new("7d",    IntL["Period:7d"]),
            new("30d",   IntL["Period:30d"]),
            new("all",   IntL["Period:All"])
        };

        try
        {
            _branches = await BranchAppService.GetLookupAsync();
        }
        catch (Exception ex)
        {
            await HandleErrorAsync(ex);
        }

        await RefreshAllAsync();
    }

    private string TabClass(string tab) => _tab == tab ? "dl-tab dl-tab-active" : "dl-tab";

    private async Task SetTabAsync(string tab)
    {
        if (_tab == tab) return;
        _tab = tab;
        _skipCount = 0;
        await LoadListAsync();
    }

    private async Task RefreshAllAsync()
    {
        await LoadSummaryAsync();
        await LoadListAsync();
    }

    private async Task LoadSummaryAsync()
    {
        try
        {
            _summary = await DecisionLogAppService.GetSummaryAsync();
        }
        catch (Exception ex)
        {
            await HandleErrorAsync(ex);
        }
    }

    private async Task LoadListAsync()
    {
        _loading = true;
        try
        {
            var result = await DecisionLogAppService.GetListAsync(new GetDecisionLogsInput
            {
                Filter = _filter,
                Statuses = _tab switch
                {
                    TabPending => new List<string> { DecisionLogStatuses.Pending },
                    TabHandled => _handledStatuses.ToList(),
                    _ => null
                },
                DecisionTypes = _groupFilter != null && _typeGroups.TryGetValue(_groupFilter, out var types)
                    ? types.ToList()
                    : null,
                BranchId = _branchFilter,
                FromDate = _period switch
                {
                    "today" => DateTime.Today,
                    "7d" => DateTime.Today.AddDays(-7),
                    "30d" => DateTime.Today.AddDays(-30),
                    _ => null
                },
                SkipCount = _skipCount,
                MaxResultCount = _pageSize,
                Sorting = "CreationTime desc"
            });

            _items = result.Items.ToList();
            _totalCount = (int)result.TotalCount;

            _pendingReorderInView = _items.Count(i =>
                i.Status == DecisionLogStatuses.Pending && _reorderTypes.Contains(i.DecisionType));

            if (_items.Any(i => i.AcknowledgedByUserId.HasValue))
            {
                await EnsureUserNamesAsync();
            }
        }
        catch (Exception ex)
        {
            await HandleErrorAsync(ex);
        }
        finally
        {
            _loading = false;
        }
    }

    /// <summary>
    /// Loads all user names ONCE per circuit instead of one round-trip per
    /// acknowledging user per page (the old N+1). A shop has a handful of users;
    /// if the caller lacks the Identity read permission we quietly show "—".
    /// </summary>
    private async Task EnsureUserNamesAsync()
    {
        if (_usersLoaded) return;
        _usersLoaded = true;
        try
        {
            var users = await IdentityUserAppService.GetListAsync(new GetIdentityUsersInput
            {
                MaxResultCount = 1000
            });
            foreach (var user in users.Items)
            {
                _userNames[user.Id] = string.IsNullOrWhiteSpace(user.UserName)
                    ? user.Name ?? "—"
                    : user.UserName;
            }
        }
        catch
        {
            // Missing AbpIdentity.Users permission — names render as "—".
        }
    }

    private string ResolveUserName(Guid? userId)
        => userId.HasValue && _userNames.TryGetValue(userId.Value, out var name) ? name : "—";

    private string AcknowledgedTemplate(Guid? userId)
        => IntL["DecisionLog:AcknowledgedBy"].Value
            .Replace("{0}", ResolveUserName(userId), StringComparison.Ordinal)
            .Replace("{1}", "{0}", StringComparison.Ordinal);

    private async Task OnFilterKeyUpAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            _skipCount = 0;
            await RefreshAllAsync();
        }
    }

    private async Task OnGroupChangedAsync(string? v)
    {
        _groupFilter = v;
        _skipCount = 0;
        await RefreshAllAsync();
    }

    private async Task OnBranchChangedAsync(Guid? v)
    {
        _branchFilter = v;
        _skipCount = 0;
        await RefreshAllAsync();
    }

    private async Task OnPeriodChangedAsync(string? v)
    {
        _period = v;
        _skipCount = 0;
        await RefreshAllAsync();
    }

    private async Task PrevPageAsync()
    {
        if (_skipCount <= 0) return;
        _skipCount = Math.Max(0, _skipCount - _pageSize);
        await LoadListAsync();
    }

    private async Task NextPageAsync()
    {
        if (_skipCount + _pageSize >= _totalCount) return;
        _skipCount += _pageSize;
        await LoadListAsync();
    }

    private async Task AcknowledgeAsync(DecisionLogDto item)
        => await RunActionAsync(item, async id => await DecisionLogAppService.AcknowledgeAsync(id));

    private async Task DismissAsync(DecisionLogDto item)
        => await RunActionAsync(item, async id => await DecisionLogAppService.DismissAsync(id));

    /// <summary>
    /// "Take action": alerts that produce a document open the REAL creation form
    /// pre-filled (New PO / New transfer / production request) so the user reviews
    /// and sends it themselves. Only write-offs and no-document types keep the
    /// in-place confirm dialog — and it opens only AFTER the preview succeeded,
    /// so a failing preview shows an error message instead of a flash-and-vanish
    /// popup.
    /// </summary>
    private async Task OpenExecuteDialogAsync(DecisionLogDto item)
    {
        if (item.DecisionType == DecisionTypes.StockReport)
        {
            OpenProductionRequest(item);
            return;
        }

        _busyId = item.Id;
        _preparingExecute = true;
        try
        {
            var preview = await DecisionActionAppService.PrepareDecisionActionAsync(item.Id);

            if (preview.ActionCreated && preview.ActionType == DecisionActionTypes.PurchaseOrder)
            {
                NavigateToNewPurchaseOrder(item, preview);
                return;
            }

            if (preview.ActionCreated && preview.ActionType == DecisionActionTypes.StockTransfer)
            {
                NavigateToNewTransfer(item, preview);
                return;
            }

            _executeItem = item;
            _executePreview = preview;
            _executeDialogVisible = true;
        }
        catch (Exception ex)
        {
            await HandleErrorAsync(ex);
        }
        finally
        {
            _busyId = null;
            _preparingExecute = false;
        }
    }

    private void NavigateToNewPurchaseOrder(DecisionLogDto item, DecisionActionPreviewDto preview)
    {
        var parameters = new Dictionary<string, string?>
        {
            ["new"] = "true",
            ["supplierId"] = preview.SupplierId?.ToString(),
            ["branchId"] = (preview.BranchId ?? item.BranchId)?.ToString(),
            ["productId"] = (preview.ProductId ?? item.ProductId).ToString(),
            ["qty"] = preview.Quantity?.ToString(),
            ["price"] = preview.UnitPrice?.ToString(System.Globalization.CultureInfo.InvariantCulture),
            ["decisionId"] = item.Id.ToString(),
            ["notes"] = Truncate(preview.Notes, 400)
        };

        NavigationManager.NavigateTo(QueryHelpers.AddQueryString("/operations/purchase-orders", parameters));
    }

    private void NavigateToNewTransfer(DecisionLogDto item, DecisionActionPreviewDto preview)
    {
        var parameters = new Dictionary<string, string?>
        {
            ["new"] = "true",
            ["toBranchId"] = (preview.TargetBranchId ?? item.TargetBranchId)?.ToString(),
            ["fromBranchId"] = (preview.SourceBranchId ?? item.SourceBranchId)?.ToString(),
            ["productId"] = (preview.ProductId ?? item.ProductId).ToString(),
            ["qty"] = preview.Quantity?.ToString(),
            ["decisionId"] = item.Id.ToString(),
            ["notes"] = Truncate(preview.Notes, 400)
        };

        NavigationManager.NavigateTo(QueryHelpers.AddQueryString("/operations/stock-transfers", parameters));
    }

    private static string? Truncate(string? value, int maxLength)
        => value != null && value.Length > maxLength ? value[..maxLength] : value;

    private void CloseExecuteDialog()
    {
        if (_executingPreview) return;
        _executeDialogVisible = false;
        _executeItem = null;
        _executePreview = null;
    }

    private async Task ConfirmExecuteAsync()
    {
        if (_executeItem == null) return;

        var item = _executeItem;
        _busyId = item.Id;
        _executingPreview = true;
        try
        {
            var result = await DecisionActionAppService.ExecuteDecisionAsync(item.Id);

            var updated = await DecisionLogAppService.GetAsync(item.Id);
            await EnsureUserNamesAsync();

            var index = _items.FindIndex(x => x.Id == item.Id);
            if (index >= 0) _items[index] = updated;

            await LoadSummaryAsync();

            if (result.ActionCreated && result.ActionType == DecisionActionTypes.PurchaseOrder)
            {
                Snackbar.Add(string.Format(IntL["DecisionLog:DraftPOCreated"], result.ActionNumber), Severity.Success);
            }
            else if (result.ActionCreated && result.ActionType == DecisionActionTypes.StockTransfer)
            {
                Snackbar.Add(string.Format(IntL["DecisionLog:DraftTransferCreated"], result.ActionNumber), Severity.Success);
            }
            else if (result.ActionCreated && result.ActionType == DecisionActionTypes.StockAdjustment)
            {
                Snackbar.Add(string.Format(IntL["DecisionLog:WriteOffRecorded"], result.ActionNumber), Severity.Success);
            }
            else if (result.ActionCreated && result.ActionType == DecisionActionTypes.BranchProductionRequest)
            {
                Snackbar.Add(string.Format(IntL["DecisionLog:ProductionRequestCreated"], result.ActionNumber), Severity.Success);
            }
            else
            {
                Snackbar.Add(L["SuccessfullySaved"], Severity.Success);
            }

            _executeDialogVisible = false;
            _executeItem = null;
            _executePreview = null;
        }
        catch (Exception ex)
        {
            await HandleErrorAsync(ex);
        }
        finally
        {
            _busyId = null;
            _executingPreview = false;
        }
    }

    private void OpenProductionRequest(DecisionLogDto item)
    {
        var parameters = new Dictionary<string, string?>
        {
            ["new"] = "true",
            ["decisionId"] = item.Id.ToString()
        };

        if (item.BranchId.HasValue)
        {
            parameters["branchId"] = item.BranchId.Value.ToString();
        }

        if (item.ProductId != Guid.Empty)
        {
            parameters["productId"] = item.ProductId.ToString();
        }

        parameters["notes"] = $"{IntL["StockReportNote"]}\n{item.Reasoning}";

        NavigationManager.NavigateTo(QueryHelpers.AddQueryString("/production/my-requests", parameters));
    }

    private void OpenConsolidateDialog() => _consolidateDialogVisible = true;

    private void CloseConsolidateDialog()
    {
        if (_consolidating) return;
        _consolidateDialogVisible = false;
    }

    private async Task ConsolidateAsync()
    {
        _consolidating = true;
        try
        {
            // Pass the current branch filter through so the run matches what's on screen;
            // the app service is branch-scoped server-side regardless.
            var result = await DecisionActionAppService.ConsolidateReordersAsync(new ConsolidateReordersInput
            {
                BranchId = _branchFilter
            });

            _consolidateDialogVisible = false;

            await RefreshAllAsync();

            if (result.PurchaseOrdersCreated == 0)
            {
                Snackbar.Add(IntL["DecisionLog:Consolidate:Nothing"], Severity.Info);
            }
            else
            {
                var message = string.Format(
                    IntL["DecisionLog:Consolidate:Result"],
                    result.PurchaseOrdersCreated,
                    result.DecisionsConsolidated);

                if (result.SkippedNoSupplier > 0)
                {
                    message += string.Format(IntL["DecisionLog:Consolidate:Skipped"], result.SkippedNoSupplier);
                }

                Snackbar.Add(message, Severity.Success);
            }
        }
        catch (Exception ex)
        {
            await HandleErrorAsync(ex);
        }
        finally
        {
            _consolidating = false;
        }
    }

    private async Task RunActionAsync(DecisionLogDto item, Func<Guid, Task<DecisionLogDto>> action)
    {
        _busyId = item.Id;
        try
        {
            var updated = await action(item.Id);
            await EnsureUserNamesAsync();

            var index = _items.FindIndex(x => x.Id == item.Id);
            if (index >= 0) _items[index] = updated;

            await LoadSummaryAsync();
            Snackbar.Add(L["SuccessfullySaved"], Severity.Success);
        }
        catch (Exception ex)
        {
            await HandleErrorAsync(ex);
        }
        finally
        {
            _busyId = null;
        }
    }

    private static string ActionLinkHref(string? actionType) => actionType switch
    {
        DecisionActionTypes.PurchaseOrder => "/operations/purchase-orders",
        DecisionActionTypes.StockTransfer => "/operations/stock-transfers",
        DecisionActionTypes.BranchProductionRequest => "/production/branch-requests",
        _ => "#"
    };

    private static string ActionLinkIcon(string? actionType) => actionType switch
    {
        DecisionActionTypes.PurchaseOrder => Icons.Material.Outlined.ShoppingCart,
        DecisionActionTypes.StockTransfer => Icons.Material.Outlined.SwapHoriz,
        DecisionActionTypes.BranchProductionRequest => Icons.Material.Outlined.Assignment,
        _ => Icons.Material.Outlined.Link
    };

    private string ActionLinkLabel(string? actionType) => actionType switch
    {
        DecisionActionTypes.PurchaseOrder => IntL["DecisionLog:ViewPurchaseOrder"],
        DecisionActionTypes.StockTransfer => IntL["DecisionLog:ViewStockTransfer"],
        DecisionActionTypes.BranchProductionRequest => IntL["DecisionLog:ViewProductionRequest"],
        _ => string.Empty
    };

    private string ExecutePreviewTitle()
    {
        if (_executePreview == null) return IntL["DecisionLog:ExecutePreview:Title"];
        if (_executeItem?.DecisionType == DecisionTypes.StockReport) return IntL["DecisionLog:ExecutePreview:ProductionRequestTitle"];
        if (!_executePreview.ActionCreated) return IntL["DecisionLog:ExecutePreview:NoDocumentTitle"];

        return _executePreview.ActionType switch
        {
            DecisionActionTypes.PurchaseOrder => IntL["DecisionLog:ExecutePreview:POTitle"],
            DecisionActionTypes.StockTransfer => IntL["DecisionLog:ExecutePreview:TransferTitle"],
            DecisionActionTypes.StockAdjustment => IntL["DecisionLog:ExecutePreview:WriteOffTitle"],
            DecisionActionTypes.BranchProductionRequest => IntL["DecisionLog:ExecutePreview:ProductionRequestTitle"],
            _ => IntL["DecisionLog:ExecutePreview:Title"]
        };
    }

    private string ExecutePreviewIntro()
    {
        if (_executePreview == null) return string.Empty;
        if (_executeItem?.DecisionType == DecisionTypes.StockReport) return IntL["DecisionLog:ExecutePreview:ProductionRequestIntro"];
        if (!_executePreview.ActionCreated) return IntL["DecisionLog:ExecutePreview:NoDocumentIntro"];

        return _executePreview.ActionType switch
        {
            DecisionActionTypes.PurchaseOrder => IntL["DecisionLog:ExecutePreview:POIntro"],
            DecisionActionTypes.StockTransfer => IntL["DecisionLog:ExecutePreview:TransferIntro"],
            DecisionActionTypes.StockAdjustment => IntL["DecisionLog:ExecutePreview:WriteOffIntro"],
            DecisionActionTypes.BranchProductionRequest => IntL["DecisionLog:ExecutePreview:ProductionRequestIntro"],
            _ => IntL["DecisionLog:ExecutePreview:GenericIntro"]
        };
    }

    private string ExecutePreviewButtonLabel()
        => _executeItem?.DecisionType == DecisionTypes.StockReport
            ? IntL["DecisionLog:ExecutePreview:OpenForm"]
            : IntL["DecisionLog:ExecutePreview:Continue"];

    private string ExecutePreviewIcon()
    {
        if (_executePreview?.ActionType == DecisionActionTypes.StockAdjustment)
        {
            return Icons.Material.Filled.DeleteSweep;
        }

        if (_executeItem?.DecisionType == DecisionTypes.StockReport)
        {
            return Icons.Material.Filled.Assignment;
        }

        return ActionLinkIcon(_executePreview?.ActionType);
    }

    private static string TypeIcon(string decisionType) => decisionType switch
    {
        DecisionTypes.LowStockAlert => Icons.Material.Filled.WarningAmber,
        DecisionTypes.ExcessStockAlert => Icons.Material.Filled.TrendingUp,
        DecisionTypes.DeadStockFlag => Icons.Material.Filled.Archive,
        DecisionTypes.TransferSuggestion => Icons.Material.Filled.SwapHoriz,
        DecisionTypes.ReorderSuggestion => Icons.Material.Filled.AddShoppingCart,
        DecisionTypes.StockoutRisk => Icons.Material.Filled.HourglassBottom,
        DecisionTypes.ExpiryAlert => Icons.Material.Filled.EventBusy,
        DecisionTypes.WasteWriteOff => Icons.Material.Filled.DeleteSweep,
        DecisionTypes.StockReport => Icons.Material.Filled.ReportProblem, // manual cashier report
        DecisionTypes.CashierVariance => Icons.Material.Filled.PointOfSale,
        DecisionTypes.IngredientShortage => Icons.Material.Filled.Inventory2,
        DecisionTypes.ProductionShortageRisk => Icons.Material.Filled.HourglassBottom,
        DecisionTypes.HighKitchenWaste => Icons.Material.Filled.DeleteSweep,
        DecisionTypes.ProductionCostVariance => Icons.Material.Filled.PriceChange,
        DecisionTypes.LateProductionRisk => Icons.Material.Filled.Schedule,
        DecisionTypes.UnfulfilledBranchRequest => Icons.Material.Filled.AssignmentLate,
        _ => Icons.Material.Filled.Info
    };

    private static Color TypeChipColor(string decisionType) => decisionType switch
    {
        DecisionTypes.LowStockAlert => Color.Warning,
        DecisionTypes.ExcessStockAlert => Color.Info,
        DecisionTypes.DeadStockFlag => Color.Error,
        DecisionTypes.TransferSuggestion => Color.Tertiary,
        DecisionTypes.ReorderSuggestion => Color.Primary,
        DecisionTypes.StockoutRisk => Color.Secondary, // crimson family via CSS accents below
        DecisionTypes.ExpiryAlert => Color.Secondary,  // plum family via CSS accents below
        DecisionTypes.WasteWriteOff => Color.Default,  // brown-grey family via CSS accents below
        DecisionTypes.StockReport => Color.Info,       // blue-grey info family via CSS accents below
        DecisionTypes.CashierVariance => Color.Error,
        DecisionTypes.IngredientShortage => Color.Warning,
        DecisionTypes.ProductionShortageRisk => Color.Secondary,
        DecisionTypes.HighKitchenWaste => Color.Error,
        DecisionTypes.ProductionCostVariance => Color.Info,
        DecisionTypes.LateProductionRisk => Color.Secondary,
        DecisionTypes.UnfulfilledBranchRequest => Color.Tertiary,
        _ => Color.Default
    };

    private static Color OutcomeChipColor(string? outcome) => outcome switch
    {
        DecisionOutcomes.Resolved => Color.Success,   // green outlined
        DecisionOutcomes.StockedOut => Color.Error,   // red filled — the loud one
        _ => Color.Default                            // Unresolved — grey outlined
    };

    private static Color StatusChipColor(string status) => status switch
    {
        DecisionLogStatuses.Pending => Color.Warning,
        DecisionLogStatuses.Acknowledged => Color.Success,
        DecisionLogStatuses.Dismissed => Color.Default,
        DecisionLogStatuses.Executed => Color.Info,
        _ => Color.Default
    };

    private string TimeAgo(DateTime utc)
    {
        var diff = DateTime.UtcNow - utc;
        if (diff.TotalSeconds < 60) return IntL["TimeAgo:JustNow"];
        if (diff.TotalMinutes < 60) return string.Format(IntL["TimeAgo:MinAgo"], (int)diff.TotalMinutes);
        if (diff.TotalHours < 24)   return string.Format(IntL["TimeAgo:HrAgo"],  (int)diff.TotalHours);
        if (diff.TotalDays < 2)     return IntL["TimeAgo:Yesterday"];
        return string.Format(IntL["TimeAgo:DayAgo"], (int)diff.TotalDays);
    }
}
