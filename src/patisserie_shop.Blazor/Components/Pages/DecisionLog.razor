        DecisionLogStatuses.Executed => Color.Info,
        _ => Color.Default
    };

    private string TimeAgo(DateTime utc)
    {
        var diff = DateTime.UtcNow - utc;
        if (diff.TotalSeconds < 60) return IntL["TimeAgo:JustNow"];
        if (diff.TotalMinutes < 60) return string.Format(IntL["TimeAgo:MinAgo"], (int)diff.TotalMinutes);
        if (diff.TotalHours < 24)   return string.Format(IntL["TimeAgo:HrAgo"],  (int)diff.TotalHours);
        if (diff.TotalDays < 2)     return IntL["TimeAgo:Yesterday"];
        return string.Format(IntL["TimeAgo:DayAgo"], (int)diff.TotalDays);
    }
}
