@page "/intelligence/decision-log"
@attribute [Authorize(IntelligencePermissions.DecisionLogs.Default)]
@using System.Threading.Tasks
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.WebUtilities
@using Volo.Abp.Application.Dtos
@using Volo.Abp.AspNetCore.Components.Web.Theming.Layout
@using Volo.Abp.Identity
@using Intelligence.Decisions
@using Intelligence.Permissions
@using Intelligence.Localization
@using Inventory.Branches
@using patisserie_shop.Decisions
@using Color = MudBlazor.Color
@using Variant = MudBlazor.Variant
@using Size = MudBlazor.Size
@using Margin = MudBlazor.Margin
@inherits patisserie_shopComponentBase
@inject IDecisionLogAppService DecisionLogAppService
@inject IDecisionActionAppService DecisionActionAppService
@inject IBranchAppService BranchAppService
@inject IIdentityUserAppService IdentityUserAppService
@inject PageLayout PageLayout
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject IStringLocalizer<IntelligenceResource> IntL

@{
    PageLayout.Title = IntL["DecisionLog"];
}

<SoftCard Elevation="2" Class="pa-2 page-flat">
    <div class="page-head">
        <div>
            <h1 class="page-title">@IntL["DecisionLog"]</h1>
            <div class="page-sub">@IntL["DecisionLogSubtitle"]</div>
        </div>
        <div class="page-head-actions">
            @if (_canAcknowledge && _pendingReorderInView > 0)
            {
                <SoftButton Variant="Variant.Filled" Color="Color.Primary"
                            StartIcon="@Icons.Material.Filled.PlaylistAddCheck"
                            OnClick="OpenConsolidateDialog"
                            Disabled="_consolidating">
                    @IntL["DecisionLog:Consolidate"]
                </SoftButton>
            }
            <SoftButton Variant="Variant.Text" Color="Color.Primary"
                        StartIcon="@Icons.Material.Filled.Refresh"
                        OnClick="RefreshAllAsync">
                @L["Refresh"]
            </SoftButton>
        </div>
    </div>

    <SoftCardContent>
        <div class="dl-summary">
            <div class="dl-summary-card dl-summary-pending">
                <SoftIcon Icon="@Icons.Material.Filled.WarningAmber" />
                <div class="dl-summary-text">
                    <div class="dl-summary-label">@IntL["DecisionLog:Summary:TotalPending"]</div>
                    <div class="dl-summary-value">@_summary.TotalPending</div>
                </div>
            </div>
            <div class="dl-summary-card dl-summary-low">
                <SoftIcon Icon="@Icons.Material.Filled.TrendingDown" />
                <div class="dl-summary-text">
                    <div class="dl-summary-label">@IntL["DecisionLog:Summary:LowStockPending"]</div>
                    <div class="dl-summary-value">@_summary.LowStockPending</div>
                </div>
            </div>
            <div class="dl-summary-card dl-summary-excess">
                <SoftIcon Icon="@Icons.Material.Filled.TrendingUp" />
                <div class="dl-summary-text">
                    <div class="dl-summary-label">@IntL["DecisionLog:Summary:ExcessStockPending"]</div>
                    <div class="dl-summary-value">@_summary.ExcessStockPending</div>
                </div>
            </div>
            <div class="dl-summary-card dl-summary-resolved">
                <SoftIcon Icon="@Icons.Material.Filled.TaskAlt" />
                <div class="dl-summary-text">
                    <div class="dl-summary-label">@IntL["DecisionLog:Summary:ResolvedToday"]</div>
                    <div class="dl-summary-value">@_summary.ResolvedToday</div>
                </div>
            </div>
        </div>

        <div class="dl-tabs" role="tablist">
            <button type="button" class="@TabClass(TabPending)" @onclick="@(() => SetTabAsync(TabPending))">
                @IntL["DecisionLog:Tab:NeedsAttention"]
                @if (_summary.TotalPending > 0)
                {
                    <span class="dl-tab-badge">@_summary.TotalPending</span>
                }
            </button>
            <button type="button" class="@TabClass(TabHandled)" @onclick="@(() => SetTabAsync(TabHandled))">
                @IntL["DecisionLog:Tab:Handled"]
            </button>
            <button type="button" class="@TabClass(TabAll)" @onclick="@(() => SetTabAsync(TabAll))">
                @IntL["DecisionLog:Tab:All"]
            </button>
        </div>

        <div class="toolbar">
            <SoftTextField T="string"
                           Placeholder="@IntL["DecisionLog:Filter"]"
                           @bind-Value="_filter"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Adornment="Adornment.Start"
                           AdornmentIcon="@Icons.Material.Filled.Search"
                           OnKeyUp="OnFilterKeyUpAsync"
                           Immediate="true"
                           Class="toolbar-search"
                           Style="min-width: 220px; max-width: 320px;" />

            <div class="filter-chip">
                <SoftLookupSelect TItem="LabeledOption" TValue="string"
                                  Items="_groupOptions"
                                  ToValue="@(o => o.Value)"
                                  ToLabel="@(o => o.Label)"
                                  Value="_groupFilter"
                                  ValueChanged="OnGroupChangedAsync"
                                  Label="@IntL["DecisionLog:AllCategories"]"
                                  Margin="Margin.Dense"
                                  Clearable="true"
                                  Dense="true" />
            </div>

            <div class="filter-chip">
                <SoftLookupSelect TItem="BranchLookupDto" TValue="Guid?"
                                  Items="_branches"
                                  ToValue="@(b => (Guid?)b.Id)"
                                  ToLabel="@(b => b.Name)"
                                  Value="_branchFilter"
                                  ValueChanged="OnBranchChangedAsync"
                                  Label="@IntL["DecisionLog:AllBranches"]"
                                  Margin="Margin.Dense"
                                  Clearable="true"
                                  Dense="true" />
            </div>

            <div class="filter-chip">
                <SoftLookupSelect TItem="LabeledOption" TValue="string"
                                  Items="_periodOptions"
                                  ToValue="@(o => o.Value)"
                                  ToLabel="@(o => o.Label)"
                                  Value="_period"
                                  ValueChanged="OnPeriodChangedAsync"
                                  Label="@IntL["DecisionLog:Period"]"
                                  Margin="Margin.Dense"
                                  Clearable="true"
                                  Dense="true" />
            </div>
        </div>

        <div class="dl-list">
            @if (_loading && _items.Count == 0)
            {
                <SoftDonutLoader Compact="true" />
            }
            else if (_items.Count == 0)
            {
                <SoftStack AlignItems="AlignItems.Center" Spacing="2" Class="pa-6">
                    @if (_tab == TabPending)
                    {
                        <SoftIcon Icon="@Icons.Material.Outlined.TaskAlt" Style="font-size: 56px; opacity: 0.4;" />
                        <SoftText Typo="Typo.body1" Color="Color.Default">@IntL["DecisionLog:EmptyPending"]</SoftText>
                    }
                    else
                    {
                        <SoftIcon Icon="@Icons.Material.Outlined.Inbox" Style="font-size: 56px; opacity: 0.4;" />
                        <SoftText Typo="Typo.body1" Color="Color.Default">@IntL["DecisionLog:Empty"]</SoftText>
                    }
                </SoftStack>
            }
            else
            {
                @foreach (var item in _items)
                {
                    var typeKey = item.DecisionType.ToLowerInvariant();
                    <div class="@($"dl-card dl-type-{typeKey} dl-status-{item.Status.ToLowerInvariant()}")">
                        <div class="dl-card-icon" aria-hidden="true">
                            <SoftIcon Icon="@TypeIcon(item.DecisionType)" Size="Size.Medium" Class="dl-type-icon" />
                        </div>

                        <div class="dl-card-copy">
                            <div class="dl-card-tags">
                                <SoftChip T="string" Size="Size.Small" Variant="Variant.Filled"
                                          Color="@TypeChipColor(item.DecisionType)"
                                          Class="dl-type-chip">
                                    @IntL[$"DecisionType:{item.DecisionType}"]
                                </SoftChip>
                                <SoftChip T="string" Size="Size.Small"
                                          Color="@StatusChipColor(item.Status)"
                                          Variant="@(item.Status == DecisionLogStatuses.Pending ? Variant.Filled : Variant.Outlined)">
                                    @IntL[$"DecisionStatus:{item.Status}"]
                                </SoftChip>
                            </div>
                            <div class="dl-card-title">@DecisionTitle(item)</div>
                            <div class="dl-card-context">
                                <span>
                                    <SoftIcon Icon="@Icons.Material.Outlined.Storefront" Size="Size.Small" />
                                    @DecisionLocation(item)
                                </span>
                                <span>
                                    <SoftIcon Icon="@Icons.Material.Outlined.Schedule" Size="Size.Small" />
                                    @TimeAgo(item.CreationTime)
                                </span>
                            </div>
                        </div>

                        <div class="dl-card-side">
                            @if (!string.IsNullOrWhiteSpace(item.Outcome))
                            {
                                <SoftChip T="string" Size="Size.Small"
                                          Color="@OutcomeChipColor(item.Outcome)"
                                          Variant="@(item.Outcome == DecisionOutcomes.StockedOut ? Variant.Filled : Variant.Outlined)">
                                    @IntL[$"Outcome:{item.Outcome}"]
                                </SoftChip>
                            }
                            <SoftButton Size="Size.Small"
                                        Variant="Variant.Outlined"
                                        Color="Color.Primary"
                                        StartIcon="@Icons.Material.Outlined.Visibility"
                                        OnClick="@(() => OpenDetails(item))">
                                @L["Details"]
                            </SoftButton>
                        </div>
                    </div>
                }

                <div class="dl-pager">
                    <span class="dl-pager-text">
                        @($"{_skipCount + 1}–{Math.Min(_skipCount + _items.Count, _totalCount)} of {_totalCount}")
                    </span>
                    <SoftIconButton Icon="@Icons.Material.Filled.ChevronLeft" Size="Size.Small"
                                    Disabled="@(_skipCount <= 0 || _loading)"
                                    OnClick="PrevPageAsync" />
                    <SoftIconButton Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small"
                                    Disabled="@(_skipCount + _pageSize >= _totalCount || _loading)"
                                    OnClick="NextPageAsync" />
                </div>
            }
        </div>
    </SoftCardContent>
</SoftCard>

@if (_detailItem is { } detailItem)
{
    var detailTypeKey = detailItem.DecisionType.ToLowerInvariant();
    <div class="glass-modal-backdrop" @onclick="CloseDetails">
        <div class="glass-modal-container glass-modal-container--lg" @onclick:stopPropagation="true">
            <SoftCard Elevation="24" Class="@($"glass-modal dl-detail-modal dl-type-{detailTypeKey}")">
                <SoftCardHeader Class="pa-4 dl-detail-header">
                    <CardHeaderContent>
                        <div class="dl-detail-heading">
                            <span class="dl-detail-icon" aria-hidden="true">
                                <SoftIcon Icon="@TypeIcon(detailItem.DecisionType)" Size="Size.Medium" Class="dl-type-icon" />
                            </span>
                            <div class="dl-detail-heading-copy">
                                <SoftText Typo="Typo.h6">@IntL["DecisionLog:Details:Title"]</SoftText>
                                <div class="dl-detail-subtitle">
                                    @IntL[$"DecisionType:{detailItem.DecisionType}"] · @DecisionTitle(detailItem)
                                </div>
                            </div>
                        </div>
                    </CardHeaderContent>
                    <CardHeaderActions>
                        <div class="dl-detail-header-actions">
                            <SoftChip T="string" Size="Size.Small"
                                      Color="@StatusChipColor(detailItem.Status)"
                                      Variant="@(detailItem.Status == DecisionLogStatuses.Pending ? Variant.Filled : Variant.Outlined)">
                                @IntL[$"DecisionStatus:{detailItem.Status}"]
                            </SoftChip>
                            <SoftIconButton Icon="@Icons.Material.Filled.Close"
                                            Size="Size.Small"
                                            OnClick="CloseDetails"
                                            Disabled="@(_busyId == detailItem.Id)" />
                        </div>
                    </CardHeaderActions>
                </SoftCardHeader>
                <SoftDivider />

                <SoftCardContent Class="pa-4 glass-modal-body dl-detail-body">
                    <section class="dl-detail-section dl-detail-overview-section">
                        <div class="dl-detail-section-title">
                            <SoftIcon Icon="@Icons.Material.Outlined.Dashboard" Size="Size.Small" />
                            <span>@IntL["DecisionLog:Details:Overview"]</span>
                        </div>
                        <div class="dl-detail-overview">
                            <div class="dl-detail-field">
                                <span>@IntL["DecisionLog:Details:Product"]</span>
                                <strong>@(!string.IsNullOrWhiteSpace(detailItem.ProductName) ? detailItem.ProductName : "—")</strong>
                            </div>
                            <div class="dl-detail-field">
                                <span>@IntL["DecisionLog:Details:Branch"]</span>
                                <strong>@DecisionLocation(detailItem)</strong>
                            </div>
                            <div class="dl-detail-field">
                                <span>@IntL["DecisionLog:Details:Type"]</span>
                                <strong>@IntL[$"DecisionType:{detailItem.DecisionType}"]</strong>
                            </div>
                            <div class="dl-detail-field">
                                <span>@IntL["DecisionLog:Details:Status"]</span>
                                <strong>@IntL[$"DecisionStatus:{detailItem.Status}"]</strong>
                            </div>
                        </div>
                    </section>

                    <section class="dl-detail-section">
                        <div class="dl-detail-section-title">
                            <SoftIcon Icon="@Icons.Material.Outlined.PsychologyAlt" Size="Size.Small" />
                            <span>@IntL["DecisionLog:Details:Why"]</span>
                        </div>
                        <p class="dl-detail-reasoning">@detailItem.Reasoning</p>
                    </section>

                    @if (!string.IsNullOrWhiteSpace(detailItem.SuggestedAction))
                    {
                        <section class="dl-detail-section dl-detail-recommendation">
                            <div class="dl-detail-section-title">
                                <SoftIcon Icon="@Icons.Material.Outlined.Lightbulb" Size="Size.Small" />
                                <span>@IntL["DecisionLog:Details:Recommendation"]</span>
                            </div>
                            <p>@detailItem.SuggestedAction</p>
                        </section>
                    }

                    <section class="dl-detail-section">
                        <div class="dl-detail-section-title">
                            <SoftIcon Icon="@Icons.Material.Outlined.Analytics" Size="Size.Small" />
                            <span>@IntL["DecisionLog:Details:Evaluation"]</span>
                        </div>
                        <div class="dl-detail-info-grid">
                            <div class="dl-detail-field">
                                <span>@IntL["DecisionLog:Details:CreatedAt"]</span>
                                <strong><BrowserLocalTime Value="@detailItem.CreationTime" Display="BrowserTimeDisplay.DateTime" /></strong>
                            </div>
                            <div class="dl-detail-field">
                                <span>@IntL["DecisionLog:Rule"]</span>
                                <strong>@(!string.IsNullOrWhiteSpace(detailItem.RuleName) ? detailItem.RuleName : IntL["DecisionLog:NoRule"].Value)</strong>
                            </div>
                            @if (detailItem.StockAtEvaluation.HasValue)
                            {
                                <div class="dl-detail-field">
                                    <span>@IntL["DecisionLog:StockAtEvaluation"]</span>
                                    <strong>@detailItem.StockAtEvaluation</strong>
                                </div>
                            }
                            @if (detailItem.DaysWithoutSale.HasValue)
                            {
                                <div class="dl-detail-field">
                                    <span>@IntL["DecisionLog:DaysWithoutSale"]</span>
                                    <strong>@detailItem.DaysWithoutSale</strong>
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(detailItem.SourceBranchName))
                            {
                                <div class="dl-detail-field">
                                    <span>@IntL["DecisionLog:Details:SourceBranch"]</span>
                                    <strong>@detailItem.SourceBranchName</strong>
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(detailItem.TargetBranchName))
                            {
                                <div class="dl-detail-field">
                                    <span>@IntL["DecisionLog:Details:TargetBranch"]</span>
                                    <strong>@detailItem.TargetBranchName</strong>
                                </div>
                            }
                        </div>
                    </section>

                    @if (detailItem.Status != DecisionLogStatuses.Pending
                         || !string.IsNullOrWhiteSpace(detailItem.Outcome))
                    {
                        <section class="dl-detail-section">
                            <div class="dl-detail-section-title">
                                <SoftIcon Icon="@Icons.Material.Outlined.FactCheck" Size="Size.Small" />
                                <span>@IntL["DecisionLog:Details:Resolution"]</span>
                            </div>
                            <div class="dl-detail-info-grid">
                                @if (detailItem.AcknowledgedByUserId.HasValue)
                                {
                                    <div class="dl-detail-field">
                                        <span>@IntL["DecisionLog:Details:HandledBy"]</span>
                                        <strong>@ResolveUserName(detailItem.AcknowledgedByUserId)</strong>
                                    </div>
                                }
                                @if (detailItem.AcknowledgedAt.HasValue)
                                {
                                    <div class="dl-detail-field">
                                        <span>@IntL["DecisionLog:Details:HandledAt"]</span>
                                        <strong><BrowserLocalTime Value="@detailItem.AcknowledgedAt.Value" Display="BrowserTimeDisplay.DateTime" /></strong>
                                    </div>
                                }
                                @if (!string.IsNullOrWhiteSpace(detailItem.Outcome))
                                {
                                    <div class="dl-detail-field">
                                        <span>@IntL["DecisionLog:Details:Outcome"]</span>
                                        <strong>@IntL[$"Outcome:{detailItem.Outcome}"]</strong>
                                    </div>
                                }
                                @if (detailItem.OutcomeEvaluatedAt.HasValue)
                                {
                                    <div class="dl-detail-field">
                                        <span>@IntL["DecisionLog:Details:OutcomeAt"]</span>
                                        <strong><BrowserLocalTime Value="@detailItem.OutcomeEvaluatedAt.Value" Display="BrowserTimeDisplay.DateTime" /></strong>
                                    </div>
                                }
                            </div>

                            @if (detailItem.Status == DecisionLogStatuses.Executed
                                 && detailItem.ExecutedActionType == DecisionActionTypes.StockAdjustment)
                            {
                                <div class="dl-detail-linked-action">
                                    <SoftIcon Icon="@Icons.Material.Outlined.DeleteSweep" Size="Size.Small" />
                                    <span>@IntL["DecisionLog:Details:LinkedAction"]</span>
                                    <strong>@IntL["DecisionLog:WrittenOff"]</strong>
                                </div>
                            }
                            else if (detailItem.Status == DecisionLogStatuses.Executed
                                     && detailItem.ExecutedActionId.HasValue
                                     && !string.IsNullOrWhiteSpace(detailItem.ExecutedActionType))
                            {
                                <a class="dl-detail-linked-action dl-detail-linked-action--link"
                                   href="@ActionLinkHref(detailItem.ExecutedActionType)">
                                    <SoftIcon Icon="@ActionLinkIcon(detailItem.ExecutedActionType)" Size="Size.Small" />
                                    <span>@IntL["DecisionLog:Details:LinkedAction"]</span>
                                    <strong>@ActionLinkLabel(detailItem.ExecutedActionType)</strong>
                                </a>
                            }
                        </section>
                    }
                </SoftCardContent>

                <SoftDivider />
                <div class="dl-detail-footer">
                    <SoftButton Variant="Variant.Text"
                                OnClick="CloseDetails"
                                Disabled="@(_busyId == detailItem.Id)">
                        @L["Close"]
                    </SoftButton>

                    @if (_canAcknowledge && detailItem.Status == DecisionLogStatuses.Pending)
                    {
                        <div class="dl-detail-actions">
                            <SoftButton Variant="Variant.Text"
                                        Color="Color.Default"
                                        StartIcon="@Icons.Material.Filled.Close"
                                        OnClick="@(() => DismissAsync(detailItem))"
                                        Disabled="@(_busyId == detailItem.Id)">
                                @IntL["DecisionLog:Action:Dismiss"]
                            </SoftButton>
                            <SoftButton Variant="Variant.Outlined"
                                        Color="Color.Success"
                                        StartIcon="@Icons.Material.Filled.Check"
                                        OnClick="@(() => AcknowledgeAsync(detailItem))"
                                        Disabled="@(_busyId == detailItem.Id)">
                                @IntL["DecisionLog:Action:Acknowledge"]
                            </SoftButton>
                            <SoftButton Variant="Variant.Filled"
                                        Color="Color.Primary"
                                        StartIcon="@Icons.Material.Filled.PlayArrow"
                                        OnClick="@(() => OpenExecuteDialogAsync(detailItem))"
                                        Disabled="@(_busyId == detailItem.Id)">
                                @IntL["DecisionLog:Action:Executed"]
                            </SoftButton>
                        </div>
                    }
                </div>
            </SoftCard>
        </div>
    </div>
}

@if (_consolidateDialogVisible)
{
    <div class="glass-modal-backdrop" @onclick="CloseConsolidateDialog">
        <div class="glass-modal-container glass-modal-container--sm" @onclick:stopPropagation="true">
            <SoftCard Elevation="24" Class="glass-modal">
                <SoftCardHeader Class="pa-4">
                    <CardHeaderContent>
                        <SoftStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <SoftIcon Icon="@Icons.Material.Filled.PlaylistAddCheck"
                                      Color="Color.Primary" Size="Size.Medium" />
                            <SoftText Typo="Typo.h6">@IntL["DecisionLog:Consolidate:Title"]</SoftText>
                        </SoftStack>
                    </CardHeaderContent>
                    <CardHeaderActions>
                        <SoftIconButton Icon="@Icons.Material.Filled.Close"
                                        Size="Size.Small" OnClick="CloseConsolidateDialog" />
                    </CardHeaderActions>
                </SoftCardHeader>
                <SoftDivider />
                <SoftCardContent Class="pa-4 glass-modal-body">
                    <SoftText Typo="Typo.body1">@IntL["DecisionLog:Consolidate:Confirm"]</SoftText>
                </SoftCardContent>
                <SoftDivider />
                <div class="pa-3 d-flex justify-end" style="gap: 8px;">
                    <SoftButton Variant="Variant.Text" OnClick="CloseConsolidateDialog"
                                Disabled="_consolidating">
                        @L["Cancel"]
                    </SoftButton>
                    <SoftButton Variant="Variant.Filled" Color="Color.Primary"
                                StartIcon="@Icons.Material.Filled.PlaylistAddCheck"
                                OnClick="ConsolidateAsync"
                                Disabled="_consolidating">
                        @IntL["DecisionLog:Consolidate:Action"]
                    </SoftButton>
                </div>
            </SoftCard>
        </div>
    </div>
}

@if (_executeDialogVisible && _executeItem != null)
{
    <div class="glass-modal-backdrop" @onclick="CloseExecuteDialog">
        <div class="glass-modal-container glass-modal-container--md" @onclick:stopPropagation="true">
            <SoftCard Elevation="24" Class="glass-modal">
                <SoftCardHeader Class="pa-4">
                    <CardHeaderContent>
                        <SoftStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <SoftIcon Icon="@ExecutePreviewIcon()"
                                      Color="Color.Primary" Size="Size.Medium" />
                            <SoftText Typo="Typo.h6">@ExecutePreviewTitle()</SoftText>
                        </SoftStack>
                    </CardHeaderContent>
                    <CardHeaderActions>
                        <SoftIconButton Icon="@Icons.Material.Filled.Close"
                                        Size="Size.Small" OnClick="CloseExecuteDialog"
                                        Disabled="_executingPreview" />
                    </CardHeaderActions>
                </SoftCardHeader>
                <SoftDivider />
                <SoftCardContent Class="pa-4 glass-modal-body">
                    @if (_preparingExecute || _executePreview == null)
                    {
                        <SoftStack AlignItems="AlignItems.Center" Spacing="2" Class="pa-4">
                            <SoftProgressCircular Indeterminate="true" Color="Color.Primary" />
                            <SoftText Typo="Typo.body2" Color="Color.Default">@IntL["DecisionLog:ExecutePreview:Loading"]</SoftText>
                        </SoftStack>
                    }
                    else
                    {
                        <SoftStack Spacing="3">
                            <SoftAlert Severity="@(_executePreview.ActionCreated ? Severity.Info : Severity.Warning)">
                                @ExecutePreviewIntro()
                            </SoftAlert>

                            <div class="dl-preview-grid">
                                @if (!string.IsNullOrWhiteSpace(_executePreview.ProductName))
                                {
                                    <div>
                                        <span>@IntL["DecisionLog:ExecutePreview:Product"]</span>
                                        <strong>@_executePreview.ProductName</strong>
                                    </div>
                                }
                                @if (!string.IsNullOrWhiteSpace(_executePreview.BranchName))
                                {
                                    <div>
                                        <span>@IntL["DecisionLog:ExecutePreview:Branch"]</span>
                                        <strong>@_executePreview.BranchName</strong>
                                    </div>
                                }
                                @if (!string.IsNullOrWhiteSpace(_executePreview.SupplierName))
                                {
                                    <div>
                                        <span>@IntL["DecisionLog:ExecutePreview:Supplier"]</span>
                                        <strong>@_executePreview.SupplierName</strong>
                                    </div>
                                }
                                @if (!string.IsNullOrWhiteSpace(_executePreview.SourceBranchName))
                                {
                                    <div>
                                        <span>@IntL["DecisionLog:ExecutePreview:FromBranch"]</span>
                                        <strong>@_executePreview.SourceBranchName</strong>
                                    </div>
                                }
                                @if (!string.IsNullOrWhiteSpace(_executePreview.TargetBranchName))
                                {
                                    <div>
                                        <span>@IntL["DecisionLog:ExecutePreview:ToBranch"]</span>
                                        <strong>@_executePreview.TargetBranchName</strong>
                                    </div>
                                }
                                @if (_executePreview.Quantity.HasValue)
                                {
                                    <div>
                                        <span>@IntL["DecisionLog:ExecutePreview:Quantity"]</span>
                                        <strong>@_executePreview.Quantity</strong>
                                    </div>
                                }
                            </div>

                            @if (_executePreview.Lines.Count > 0)
                            {
                                <div class="dl-preview-lines">
                                    <SoftText Typo="Typo.overline" Color="Color.Primary">@IntL["DecisionLog:ExecutePreview:Items"]</SoftText>
                                    @foreach (var line in _executePreview.Lines)
                                    {
                                        <div class="dl-preview-line">
                                            <span>@line.ProductName</span>
                                            <strong>@line.Quantity</strong>
                                        </div>
                                    }
                                </div>
                            }

                            @if (!string.IsNullOrWhiteSpace(_executePreview.Notes))
                            {
                                <div class="dl-preview-notes">
                                    <span>@IntL["DecisionLog:ExecutePreview:Notes"]</span>
                                    <p>@_executePreview.Notes</p>
                                </div>
                            }
                        </SoftStack>
                    }
                </SoftCardContent>
                <SoftDivider />
                <div class="pa-3 d-flex justify-end" style="gap: 8px;">
                    <SoftButton Variant="Variant.Text" OnClick="CloseExecuteDialog"
                                Disabled="_executingPreview">
                        @L["Cancel"]
                    </SoftButton>
                    <SoftButton Variant="Variant.Filled" Color="Color.Primary"
                                StartIcon="@Icons.Material.Filled.PlayArrow"
                                OnClick="ConfirmExecuteAsync"
                                Disabled="_preparingExecute || _executingPreview || _executePreview == null">
                        @ExecutePreviewButtonLabel()
                    </SoftButton>
                </div>
            </SoftCard>
        </div>
    </div>
}

