    private static string? Truncate(string? value, int maxLength)
        => value != null && value.Length > maxLength ? value[..maxLength] : value;

    private void CloseExecuteDialog()
    {
        if (_executingPreview) return;
        _executeDialogVisible = false;
        _executeItem = null;
        _executePreview = null;
    }

    private async Task ConfirmExecuteAsync()
    {
        if (_executeItem == null) return;

        var item = _executeItem;
        _busyId = item.Id;
        _executingPreview = true;
        try
        {
            var result = await DecisionActionAppService.ExecuteDecisionAsync(item.Id);

            var updated = await DecisionLogAppService.GetAsync(item.Id);
            await EnsureUserNamesAsync();

            var index = _items.FindIndex(x => x.Id == item.Id);
            if (index >= 0) _items[index] = updated;
            if (_detailItem?.Id == item.Id) _detailItem = updated;

            await LoadSummaryAsync();

            if (result.ActionCreated && result.ActionType == DecisionActionTypes.PurchaseOrder)
            {
                Snackbar.Add(string.Format(IntL["DecisionLog:DraftPOCreated"], result.ActionNumber), Severity.Success);
            }
            else if (result.ActionCreated && result.ActionType == DecisionActionTypes.StockTransfer)
            {
                Snackbar.Add(string.Format(IntL["DecisionLog:DraftTransferCreated"], result.ActionNumber), Severity.Success);
            }
            else if (result.ActionCreated && result.ActionType == DecisionActionTypes.StockAdjustment)
            {
                Snackbar.Add(string.Format(IntL["DecisionLog:WriteOffRecorded"], result.ActionNumber), Severity.Success);
            }
            else if (result.ActionCreated && result.ActionType == DecisionActionTypes.BranchProductionRequest)
            {
                Snackbar.Add(string.Format(IntL["DecisionLog:ProductionRequestCreated"], result.ActionNumber), Severity.Success);
            }
            else
            {
                Snackbar.Add(L["SuccessfullySaved"], Severity.Success);
            }

            _executeDialogVisible = false;
            _executeItem = null;
            _executePreview = null;
        }
        catch (Exception ex)
        {
            await HandleErrorAsync(ex);
        }
        finally
        {
            _busyId = null;
            _executingPreview = false;
        }
    }

    private void OpenProductionRequest(DecisionLogDto item)
    {
        var parameters = new Dictionary<string, string?>
        {
            ["new"] = "true",
            ["decisionId"] = item.Id.ToString()
        };

        if (item.BranchId.HasValue)
        {
            parameters["branchId"] = item.BranchId.Value.ToString();
        }

        if (item.ProductId != Guid.Empty)
        {
            parameters["productId"] = item.ProductId.ToString();
        }

        parameters["notes"] = $"{IntL["StockReportNote"]}\n{item.Reasoning}";

        NavigationManager.NavigateTo(QueryHelpers.AddQueryString("/production/my-requests", parameters));
    }

    private void OpenConsolidateDialog() => _consolidateDialogVisible = true;

    private void CloseConsolidateDialog()
    {
        if (_consolidating) return;
        _consolidateDialogVisible = false;
    }

    private async Task ConsolidateAsync()
    {
        _consolidating = true;
        try
        {
            // Pass the current branch filter through so the run matches what's on screen;
            // the app service is branch-scoped server-side regardless.
            var result = await DecisionActionAppService.ConsolidateReordersAsync(new ConsolidateReordersInput
            {
                BranchId = _branchFilter
            });

            _consolidateDialogVisible = false;

            await RefreshAllAsync();

            if (result.PurchaseOrdersCreated == 0)
            {
                Snackbar.Add(IntL["DecisionLog:Consolidate:Nothing"], Severity.Info);
            }
            else
            {
                var message = string.Format(
                    IntL["DecisionLog:Consolidate:Result"],
                    result.PurchaseOrdersCreated,
                    result.DecisionsConsolidated);

                if (result.SkippedNoSupplier > 0)
                {
                    message += string.Format(IntL["DecisionLog:Consolidate:Skipped"], result.SkippedNoSupplier);
                }

                Snackbar.Add(message, Severity.Success);
            }
        }
        catch (Exception ex)
        {
            await HandleErrorAsync(ex);
        }
        finally
        {
            _consolidating = false;
        }
    }

    private async Task RunActionAsync(DecisionLogDto item, Func<Guid, Task<DecisionLogDto>> action)
    {
        _busyId = item.Id;
        try
        {
            var updated = await action(item.Id);
            await EnsureUserNamesAsync();

            var index = _items.FindIndex(x => x.Id == item.Id);
            if (index >= 0) _items[index] = updated;
            if (_detailItem?.Id == item.Id) _detailItem = updated;

            await LoadSummaryAsync();
            Snackbar.Add(L["SuccessfullySaved"], Severity.Success);
        }
        catch (Exception ex)
        {
            await HandleErrorAsync(ex);
        }
        finally
        {
            _busyId = null;
        }
    }

