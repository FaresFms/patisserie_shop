@page "/operations/stock-transfers"
@attribute [Authorize(OperationsPermissions.Transfers.Default)]
@using System.Threading
@using System.Threading.Tasks
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Routing
@using Volo.Abp.Application.Dtos
@using Volo.Abp.AspNetCore.Components.Web.Theming.Layout
@using Operations
@using Operations.StockTransfers
@using Operations.Permissions
@using Operations.Localization
@using Inventory.Branches
@using Inventory.BranchInventory
@using Inventory.Permissions
@using Intelligence.Decisions
@using patisserie_shop.Blazor.Services
@using Color = MudBlazor.Color
@using Variant = MudBlazor.Variant
@using Size = MudBlazor.Size
@using Margin = MudBlazor.Margin
@inherits patisserie_shopComponentBase
@implements IDisposable
@inject IStockTransferAppService StockTransferAppService
@inject IBranchAppService BranchAppService
@inject IBranchInventoryAppService BranchInventoryAppService
@inject IDecisionLogAppService DecisionLogAppService
@inject TransferNotificationBridge TransferBridge
@inject PageLayout PageLayout
@inject ISnackbar Snackbar
@inject IStringLocalizer<OperationsResource> OpsL

@{
    PageLayout.Title = OpsL["StockTransfers"];
}

<SoftCard Elevation="2" Class="pa-2 page-flat">
    <div class="page-head">
        <div>
            <h1 class="page-title">@OpsL["StockTransfers"]</h1>
            <div class="page-sub">Request stock, approve, ship and receive between branches.</div>
        </div>
        <div class="page-head-actions">
            <SoftButton Variant="Variant.Filled"
                        Color="Color.Primary"
                        StartIcon="@Icons.Material.Filled.Add"
                        OnClick="OpenCreateDialog"
                        Disabled="@(!_canCreate || !CanOpenCreate)">
                @OpsL["NewTransfer"]
            </SoftButton>
        </div>
    </div>
    <SoftCardContent>

        <div class="sts-tabs" role="tablist">
            <button type="button" class="@TabClass(ViewAction)" @onclick="@(() => SetViewAsync(ViewAction))">
                @OpsL["Tab:NeedsMyAction"]
                @if (_summary is { Total: > 0 })
                {
                    <span class="sts-tab-badge">@_summary.Total</span>
                }
            </button>
            @if (!_canManageAllBranches)
            {
                <button type="button" class="@TabClass(ViewIncoming)" @onclick="@(() => SetViewAsync(ViewIncoming))">
                    @OpsL["Tab:Incoming"]
                </button>
                <button type="button" class="@TabClass(ViewOutgoing)" @onclick="@(() => SetViewAsync(ViewOutgoing))">
                    @OpsL["Tab:Outgoing"]
                </button>
            }
            <button type="button" class="@TabClass(null)" @onclick="@(() => SetViewAsync(null))">
                @OpsL["Tab:All"]
            </button>
        </div>

        <div class="toolbar">
            <SoftTextField T="string"
                           Placeholder="@OpsL["Filter"]"
                           @bind-Value="_filter"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Adornment="Adornment.Start"
                           AdornmentIcon="@Icons.Material.Filled.Search"
                           OnKeyUp="OnFilterKeyUpAsync"
                           Immediate="true"
                           Class="toolbar-search"
                           Style="min-width: 220px; max-width: 320px;" />

            <div class="filter-chip">
                <SoftLookupSelect TItem="BranchLookupDto" TValue="Guid?"
                                  Items="_branches"
                                  ToValue="@(b => (Guid?)b.Id)"
                                  ToLabel="@(b => b.Name)"
                                  Value="_fromFilter"
                                  ValueChanged="OnFromChangedAsync"
                                  Label="@OpsL["FromBranch"]"
                                  Margin="Margin.Dense"
                                  Clearable="true"
                                  Dense="true" />
            </div>

            <div class="filter-chip">
                <SoftLookupSelect TItem="BranchLookupDto" TValue="Guid?"
                                  Items="_branches"
                                  ToValue="@(b => (Guid?)b.Id)"
                                  ToLabel="@(b => b.Name)"
                                  Value="_toFilter"
                                  ValueChanged="OnToChangedAsync"
                                  Label="@OpsL["ToBranch"]"
                                  Margin="Margin.Dense"
                                  Clearable="true"
                                  Dense="true" />
            </div>

            <div class="filter-chip">
                <SoftLookupSelect TItem="StatusOption" TValue="string"
                                  Items="_statusOptions"
                                  ToValue="@(o => o.Value)"
                                  ToLabel="@(o => o.Label)"
                                  Value="_statusFilter"
                                  ValueChanged="OnStatusChangedAsync"
                                  Label="@OpsL["AllStatuses"]"
                                  Margin="Margin.Dense"
                                  Clearable="true"
                                  Dense="true" />
            </div>

            <div class="toolbar-right">
                <SoftButton Variant="Variant.Text" Color="Color.Primary"
                            OnClick="ReloadAsync" StartIcon="@Icons.Material.Filled.Refresh">
                    @L["Refresh"]
                </SoftButton>
            </div>
        </div>

        <SoftDataGrid T="StockTransferDto"
                      @ref="_grid"
                      ServerData="LoadServerData"
                      Dense="true"
                      Hover="true"
                      Bordered="false"
                      Loading="_loading"
                      SortMode="SortMode.Single"
                      RowClick="OnRowClick">
            <Columns>
                <PropertyColumn T="StockTransferDto" TProperty="string" Property="x => x.Reference" Title="@OpsL["TransferRef"]" Sortable="false" />
                <PropertyColumn T="StockTransferDto" TProperty="string" Property="x => x.FromBranchName" Title="@OpsL["FromBranch"]" />
                <PropertyColumn T="StockTransferDto" TProperty="string" Property="x => x.ToBranchName" Title="@OpsL["ToBranch"]" />
                <PropertyColumn T="StockTransferDto" TProperty="DateTime" Property="x => x.RequestedDate" Title="@OpsL["RequestedDate"]">
                    <CellTemplate>
                        <SoftText Typo="Typo.body2">@context.Item.RequestedDate.ToString("MMM d, yyyy")</SoftText>
                    </CellTemplate>
                </PropertyColumn>
                <TemplateColumn T="StockTransferDto" Title="@OpsL["Items"]" Sortable="false">
                    <CellTemplate>
                        <SoftChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default">
                            @context.Item.ItemCount
                        </SoftChip>
                    </CellTemplate>
                </TemplateColumn>
                <PropertyColumn T="StockTransferDto" TProperty="string" Property="x => x.Status" Title="@OpsL["Status"]">
                    <CellTemplate>
                        <div class="@($"sts-status sts-status-{context.Item.Status.ToLower()}")">
                            <MudIcon Icon="@StatusIcon(context.Item.Status)" Size="Size.Small" />
                            <span>@OpsL[$"Status:{context.Item.Status}"]</span>
                        </div>
                    </CellTemplate>
                </PropertyColumn>
                <TemplateColumn T="StockTransferDto" Title="@OpsL["NextStep"]" Sortable="false">
                    <CellTemplate>
                        @{ var step = NextStep(context.Item); }
                        @if (step.Mine)
                        {
                            <span class="sts-next sts-next-mine">
                                <MudIcon Icon="@Icons.Material.Filled.TouchApp" Size="Size.Small" />
                                @step.Label
                            </span>
                        }
                        else
                        {
                            <span class="sts-next">@step.Label</span>
                        }
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="StockTransferDto" Title="" Sortable="false">
                    <CellTemplate>
                        <span class="row-actions">
                            <SoftIconButton Icon="@Icons.Material.Filled.OpenInNew"
                                            Color="Color.Primary"
                                            Size="Size.Small"
                                            OnClick="@(() => OpenDetail(context.Item.Id))" />
                        </span>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <NoRecordsContent>
                <SoftStack AlignItems="AlignItems.Center" Spacing="2" Class="pa-6">
                    @if (_view == ViewAction)
                    {
                        <SoftIcon Icon="@Icons.Material.Outlined.TaskAlt" Style="font-size: 56px; opacity: 0.4;" />
                        <SoftText Typo="Typo.body1" Color="Color.Default">@OpsL["NoActionTransfers"]</SoftText>
                    }
                    else
                    {
                        <SoftIcon Icon="@Icons.Material.Outlined.Inbox" Style="font-size: 56px; opacity: 0.4;" />
                        <SoftText Typo="Typo.body1" Color="Color.Default">@OpsL["NoTransfers"]</SoftText>
                    }
                </SoftStack>
            </NoRecordsContent>
            <PagerContent>
                <MudDataGridPager T="StockTransferDto" />
            </PagerContent>
        </SoftDataGrid>
    </SoftCardContent>
</SoftCard>

@if (_createVisible)
{
    <div class="glass-modal-backdrop" @onclick="CloseCreate">
        <div class="glass-modal-container glass-modal-container--md" @onclick:stopPropagation="true">
            <SoftCard Elevation="24" Class="glass-modal">
                <SoftCardHeader Class="pa-4">
                    <CardHeaderContent>
                        <SoftStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <SoftIcon Icon="@Icons.Material.Filled.AddCircle" Color="Color.Primary" Size="Size.Medium" />
                            <SoftText Typo="Typo.h6">@OpsL["NewTransfer"]</SoftText>
                        </SoftStack>
                    </CardHeaderContent>
                    <CardHeaderActions>
                        <SoftIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="CloseCreate" />
                    </CardHeaderActions>
                </SoftCardHeader>
                <SoftDivider />
                <SoftCardContent Class="pa-4">
                    <SoftStack Spacing="3">
                        <SoftAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
                            @if (_canChooseBranches)
                            {
                                <text>Step 1 of 2 — choose the branches, then add the products on the next screen.</text>
                            }
                            else
                            {
                                <text>Step 1 of 2 — choose the receiving branch and requested products. The admin or kitchen assigns the source branch after you submit.</text>
                            }
                        </SoftAlert>
                        @if (UseFixedReceivingBranch)
                        {
                            <div class="sts-fixed-branch">
                                <div class="sts-fixed-label">@OpsL["ReceivingBranch"]</div>
                                <div class="sts-fixed-value">@(_destinationBranches.FirstOrDefault()?.Name ?? "-")</div>
                            </div>
                        }
                        else
                        {
                            <SoftLookupSelect TItem="BranchLookupDto" TValue="Guid?"
                                              Items="DestinationBranchOptions"
                                              ToValue="@(b => (Guid?)b.Id)"
                                              ToLabel="@(b => b.Name)"
                                              Value="_newToId"
                                              ValueChanged="@(v => _newToId = v)"
                                              Label="@OpsL["ReceivingBranch"]"
                                              Required="true" />
                        }
                        @if (_canChooseBranches)
                        {
                            <div>
                                <SoftLookupSelect TItem="BranchLookupDto" TValue="Guid?"
                                                  Items="SourceBranchOptions"
                                                  ToValue="@(b => (Guid?)b.Id)"
                                                  ToLabel="@(b => b.Name)"
                                                  Value="_newFromId"
                                                  ValueChanged="@(v => _newFromId = v)"
                                                  Label="@OpsL["SourceBranchOptional"]"
                                                  Clearable="true" />
                                <SoftText Typo="Typo.caption" Color="Color.Default">@OpsL["SourceBranchOptionalHint"]</SoftText>
                            </div>
                        }
                        <MudDatePicker Label="@OpsL["RequestedDate"]" Variant="Variant.Outlined"
                                       @bind-Date="_newRequestedDate" />
                        <SoftTextField T="string"
                                       Label="@OpsL["Notes"]"
                                       @bind-Value="_newNotes"
                                       Variant="Variant.Outlined"
                                       Lines="2"
                                       MaxLength="512" />
                    </SoftStack>
                </SoftCardContent>
                <SoftDivider />
                <div class="pa-3 d-flex justify-end" style="gap: 8px;">
                    <SoftButton Variant="Variant.Text" OnClick="CloseCreate">@L["Cancel"]</SoftButton>
                    <SoftButton Variant="Variant.Filled" Color="Color.Primary"
                                EndIcon="@Icons.Material.Filled.ArrowForward"
                                OnClick="ConfirmCreateAsync"
                                Disabled="@(_saving || !CanOpenCreate)">
                        @OpsL["SaveAndAddItems"]
                    </SoftButton>
                </div>
            </SoftCard>
        </div>
    </div>
}

@if (_detailId.HasValue)
{
    <StockTransferDetailModal TransferId="_detailId.Value"
                              OnClose="CloseDetailAsync"
                              Changed="OnDetailChangedAsync"
                              @key="_detailId" />
}

<style>
    .sts-tabs {
        display: inline-flex;
        gap: 4px;
        margin: 4px 0 10px;
        padding: 4px;
        border: 1px solid var(--bd-2);
        border-radius: 999px;
        background: var(--surface-2);
    }

    .sts-tab {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 6px 16px;
        border: none;
        border-radius: 999px;
        background: transparent;
        color: var(--fg-2);
        font: 600 0.82rem var(--font-sans);
        cursor: pointer;
        transition: background .15s ease, color .15s ease;
    }

    .sts-tab:hover { background: var(--hover); color: var(--fg-1); }

    .sts-tab-active,
    .sts-tab-active:hover {
        background: var(--accent);
        color: var(--accent-fg);
    }

    .sts-tab-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 20px;
        height: 20px;
        padding: 0 6px;
        border-radius: 999px;
        background: var(--danger);
        color: #fff;
        font-size: 0.7rem;
        font-weight: 700;
    }

    .sts-status {
        display: inline-flex; align-items: center; gap: 6px;
        padding: 3px 10px; border-radius: 999px;
        font-size: 0.78rem; font-weight: 600;
        border: 1px solid transparent;
    }
    .sts-status-draft     { background: rgba(255,255,255, 0.10); border-color: rgba(255,255,255, 0.20); color: var(--fg-2); }
    .sts-status-pending   { background: rgba(251,191, 36, 0.20); border-color: rgba(251,191, 36, 0.40); color: #b26a00; }
    .sts-status-approved  { background: rgba( 59,130,246, 0.20); border-color: rgba( 59,130,246, 0.40); color: #1565c0; }
    .sts-status-intransit { background: rgba( 20,184,166, 0.20); border-color: rgba( 20,184,166, 0.40); color: #00695c; }
    .sts-status-completed { background: rgba( 34,197, 94, 0.20); border-color: rgba( 34,197, 94, 0.40); color: #2e7d32; }
    .sts-status-cancelled { background: rgba(239, 68, 68, 0.20); border-color: rgba(239, 68, 68, 0.40); color: #c62828; }
    .sts-status-rejected  { background: rgba(239, 68, 68, 0.12); border-color: rgba(239, 68, 68, 0.45); color: #c62828; }

    html[data-theme="dark"] .sts-status-pending   { color: #fde68a; }
    html[data-theme="dark"] .sts-status-approved  { color: #93c5fd; }
    html[data-theme="dark"] .sts-status-intransit { color: #5eead4; }
    html[data-theme="dark"] .sts-status-completed { color: #86efac; }
    html[data-theme="dark"] .sts-status-cancelled,
    html[data-theme="dark"] .sts-status-rejected  { color: #fca5a5; }

    .sts-next {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        font-size: 0.78rem;
        color: var(--fg-3);
    }

    .sts-next-mine {
        padding: 3px 10px;
        border-radius: 999px;
        background: var(--accent-soft);
        color: var(--accent);
        font-weight: 700;
    }

    .sts-fixed-branch {
        border: 1px solid var(--bd-2);
        border-radius: var(--r-md);
        background: var(--surface-2);
        padding: 10px 12px;
    }
    .sts-fixed-label {
        color: var(--fg-3);
        font-size: .72rem;
        font-weight: 700;
        text-transform: uppercase;
    }
    .sts-fixed-value {
        color: var(--fg-1);
        font-size: 1rem;
        font-weight: 700;
    }
</style>

@code {
    private const string ViewAction = StockTransferViews.NeedsMyAction;
    private const string ViewIncoming = StockTransferViews.Incoming;
    private const string ViewOutgoing = StockTransferViews.Outgoing;

    private SoftDataGrid<StockTransferDto> _grid = null!;
    private bool _loading;
    private bool _saving;
    private bool _canCreate;
    private bool _canApprove;
    private bool _canShip;
    private bool _canComplete;
    private bool _canChooseBranches;
    private bool _canManageAllBranches;
    private bool _subscribed;
    private bool _disposed;
    private string? _lastInitialView;

    private string? _filter;
    private string? _statusFilter;
    private Guid? _fromFilter;
    private Guid? _toFilter;
    private string? _view;
    private StockTransferActionSummaryDto? _summary;

    [Parameter, SupplyParameterFromQuery(Name = "new")]
    public bool OpenNewTransfer { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "toBranchId")]
    public Guid? NewTransferToBranchId { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "notes")]
    public string? NewTransferNotes { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "fromBranchId")]
    public Guid? NewTransferFromBranchId { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "productId")]
    public Guid? NewTransferProductId { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "qty")]
    public int? NewTransferQuantity { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "decisionId")]
    public Guid? NewTransferDecisionId { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "view")]
    public string? InitialView { get; set; }

    // Pre-fill handoff from the Decision Log's "Take action" button.
    private Guid? _pendingItemProductId;
    private int? _pendingItemQty;
    private Guid? _sourceDecisionId;

    private List<BranchLookupDto> _branches = new();
    private List<BranchLookupDto> _destinationBranches = new();
    private List<Guid> _accessibleBranchIds = new();
    private List<StatusOption> _statusOptions = new();

    private Guid? _detailId;

    private bool _createVisible;
    private Guid? _newToId;
    private Guid? _newFromId;
    private DateTime? _newRequestedDate = DateTime.Today;
    private string? _newNotes;

    public record StatusOption(string Value, string Label);

    private bool CanOpenCreate => _canManageAllBranches || _destinationBranches.Count > 0;
    private bool UseFixedReceivingBranch =>
        !_canManageAllBranches && !_canChooseBranches && _destinationBranches.Count == 1;
    // Without a source, non-admins may only request INTO a branch they manage; once a
    // ChooseBranches holder picks a source they manage, any branch can receive (push).
    private List<BranchLookupDto> DestinationBranchOptions =>
        (_canManageAllBranches || (_canChooseBranches && _newFromId.HasValue)
            ? _branches
            : _destinationBranches)
        .Where(b => b.Id != _newFromId)
        .ToList();
    private List<BranchLookupDto> SourceBranchOptions =>
        (_canManageAllBranches ? _branches : _destinationBranches)
            .Where(b => b.Id != _newToId)
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        _canCreate = await AuthorizationService.IsGrantedAsync(OperationsPermissions.Transfers.Create);
        _canApprove = await AuthorizationService.IsGrantedAsync(OperationsPermissions.Transfers.Approve);
        _canShip = await AuthorizationService.IsGrantedAsync(OperationsPermissions.Transfers.Ship);
        _canComplete = await AuthorizationService.IsGrantedAsync(OperationsPermissions.Transfers.Complete);
        _canChooseBranches = await AuthorizationService.IsGrantedAsync(OperationsPermissions.Transfers.ChooseBranches);
        _canManageAllBranches = await AuthorizationService.IsGrantedAsync(InventoryPermissions.BranchInventory.ManageAll);

        _statusOptions = StockTransferStatuses.All
            .Select(s => new StatusOption(s, OpsL[$"Status:{s}"]))
            .ToList();

        try
        {
            _branches = await BranchAppService.GetLookupAsync();
            _accessibleBranchIds = await BranchInventoryAppService.GetAccessibleBranchIdsAsync();
            if (_canManageAllBranches)
            {
                _destinationBranches = _branches;
            }
            else
            {
                _destinationBranches = _branches
                    .Where(b => _accessibleBranchIds.Contains(b.Id))
                    .ToList();
            }

            _summary = await StockTransferAppService.GetActionSummaryAsync();
        }
        catch (Exception ex)
        {
            await HandleErrorAsync(ex);
        }

        // Land on "Needs my action" when something is actually waiting (or when the
        // notification bell linked here); otherwise show everything.
        _view = InitialView switch
        {
            ViewAction or ViewIncoming or ViewOutgoing => InitialView,
            _ => _summary is { Total: > 0 } ? ViewAction : null
        };

        _lastInitialView = InitialView;

        if (!_disposed)
        {
            TransferBridge.TransferChanged += OnTransferChanged;
            _subscribed = true;
        }

        if (OpenNewTransfer)
        {
            OpenCreateDialog(NewTransferToBranchId, NewTransferNotes);
            if (_createVisible)
            {
                if (_canChooseBranches && NewTransferFromBranchId.HasValue
                    && NewTransferFromBranchId != _newToId)
                {
                    _newFromId = NewTransferFromBranchId;
                }
                _pendingItemProductId = NewTransferProductId;
                _pendingItemQty = NewTransferQuantity;
                _sourceDecisionId = NewTransferDecisionId;
            }
        }
    }

    /// <summary>
    /// The notification bell links here with ?view=action while this page may already
    /// be rendered — Blazor then only re-runs parameter binding, so apply the view here.
    /// </summary>
    protected override async Task OnParametersSetAsync()
    {
        if (_lastInitialView == InitialView)
        {
            return;
        }

        _lastInitialView = InitialView;
        if (InitialView is ViewAction or ViewIncoming or ViewOutgoing)
        {
            await SetViewAsync(InitialView);
        }
    }

    private string TabClass(string? view) =>
        _view == view ? "sts-tab sts-tab-active" : "sts-tab";

    private async Task SetViewAsync(string? view)
    {
        if (_view == view) return;
        _view = view;
        if (_grid != null)
        {
            _grid.CurrentPage = 0;
        }
        await ReloadAsync();
    }

    private (string Label, bool Mine) NextStep(StockTransferDto t)
    {
        var managesFrom = t.FromBranchId.HasValue && _accessibleBranchIds.Contains(t.FromBranchId.Value);
        var managesTo = _accessibleBranchIds.Contains(t.ToBranchId);

        return t.Status switch
        {
            StockTransferStatuses.Draft => _canCreate && (managesTo || managesFrom)
                ? (OpsL["NextStep:Submit"].Value, true)
                : (OpsL["NextStep:WaitingDraft"].Value, false),
            StockTransferStatuses.Pending => _canApprove
                ? (OpsL["NextStep:Approve"].Value, true)
                : (OpsL["NextStep:WaitingApproval"].Value, false),
            StockTransferStatuses.Approved => _canShip && managesFrom
                ? (OpsL["NextStep:Ship"].Value, true)
                : (string.Format(OpsL["NextStep:WaitingShipment"], t.FromBranchName), false),
            StockTransferStatuses.InTransit => _canComplete && managesTo
                ? (OpsL["NextStep:Receive"].Value, true)
                : (string.Format(OpsL["NextStep:WaitingReceipt"], t.ToBranchName), false),
            StockTransferStatuses.Completed => (OpsL["NextStep:Done"].Value, false),
            _ => ("—", false)
        };
    }

    private async Task<GridData<StockTransferDto>> LoadServerData(GridState<StockTransferDto> state, CancellationToken cancellationToken)
    {
        _loading = true;
        try
        {
            string? sorting = null;
            var sort = state.SortDefinitions.FirstOrDefault();
            if (sort != null)
            {
                sorting = $"{sort.SortBy} {(sort.Descending ? "desc" : "asc")}";
            }

            var result = await StockTransferAppService.GetListAsync(new GetStockTransfersInput
            {
                Filter = _filter,
                Status = _statusFilter,
                FromBranchId = _fromFilter,
                ToBranchId = _toFilter,
                View = _view,
                SkipCount = state.Page * state.PageSize,
                MaxResultCount = state.PageSize,
                Sorting = sorting
            });

            return new GridData<StockTransferDto>
            {
                Items = result.Items,
                TotalItems = (int)result.TotalCount
            };
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnFilterKeyUpAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await ReloadAsync();
    }

    private async Task OnStatusChangedAsync(string? v) { _statusFilter = v; await ReloadAsync(); }
    private async Task OnFromChangedAsync(Guid? v) { _fromFilter = v; await ReloadAsync(); }
    private async Task OnToChangedAsync(Guid? v) { _toFilter = v; await ReloadAsync(); }

    private async Task ReloadAsync()
    {
        try
        {
            _summary = await StockTransferAppService.GetActionSummaryAsync();
        }
        catch
        {
            // Keep the stale counts if the summary refresh fails.
        }
        if (_grid != null) await _grid.ReloadServerData();
    }

    /// <summary>Another circuit moved a transfer along — refresh counts and rows live.</summary>
    private void OnTransferChanged(TransferNotification notification)
    {
        _ = InvokeAsync(async () =>
        {
            try
            {
                await ReloadAsync();
                StateHasChanged();
            }
            catch
            {
                // The circuit may be tearing down — ignore.
            }
        });
    }

    private void OnRowClick(DataGridRowClickEventArgs<StockTransferDto> args) => OpenDetail(args.Item.Id);

    private void OpenDetail(Guid id) => _detailId = id;

    private async Task CloseDetailAsync()
    {
        _detailId = null;
        await Task.CompletedTask;
    }

    private async Task OnDetailChangedAsync() => await ReloadAsync();

    private void OpenCreateDialog() => OpenCreateDialog(null, null);

    private void OpenCreateDialog(Guid? toBranchId, string? notes)
    {
        if (!CanOpenCreate)
        {
            Snackbar.Add("No receiving branch is available for this transfer.", Severity.Warning);
            return;
        }

        _newToId = UseFixedReceivingBranch ? _destinationBranches[0].Id : toBranchId;
        _newFromId = null;
        _newRequestedDate = DateTime.Today;
        _newNotes = notes;
        _pendingItemProductId = null;
        _pendingItemQty = null;
        _sourceDecisionId = null;
        _createVisible = true;
    }

    private void CloseCreate() => _createVisible = false;

    private async Task ConfirmCreateAsync()
    {
        if (!_newToId.HasValue)
        {
            Snackbar.Add(L["ThisFieldIsRequired", OpsL["ReceivingBranch"]], Severity.Warning);
            return;
        }
        if (!_newRequestedDate.HasValue)
        {
            Snackbar.Add(L["ThisFieldIsRequired", OpsL["RequestedDate"]], Severity.Warning);
            return;
        }
        if (_newFromId.HasValue && _newFromId == _newToId)
        {
            Snackbar.Add(OpsL["SameBranchWarning"], Severity.Warning);
            return;
        }
        if (!_canManageAllBranches && !_newFromId.HasValue
            && !_destinationBranches.Any(b => b.Id == _newToId.Value))
        {
            Snackbar.Add(OpsL["SourceRequiredForOtherBranch"], Severity.Warning);
            return;
        }

        _saving = true;
        try
        {
            var created = await StockTransferAppService.CreateAsync(new CreateStockTransferDto
            {
                FromBranchId = _canChooseBranches ? _newFromId : null,
                ToBranchId = _newToId.Value,
                RequestedDate = _newRequestedDate.Value,
                Notes = _newNotes
            });

            // Handoff from the Decision Log: pre-add the suggested line and mark
            // the alert as executed, linked to this transfer.
            if (_pendingItemProductId is Guid pendingProductId && _pendingItemQty is > 0)
            {
                await StockTransferAppService.AddItemAsync(created.Id, new AddStockTransferItemDto
                {
                    ProductId = pendingProductId,
                    RequestedQuantity = _pendingItemQty.Value
                });
            }

            if (_sourceDecisionId is Guid decisionId)
            {
                try
                {
                    await DecisionLogAppService.ExecuteAsync(decisionId, new ExecuteDecisionLogInput
                    {
                        ActionType = DecisionActionTypes.StockTransfer,
                        ActionId = created.Id
                    });
                }
                catch
                {
                    // The transfer exists either way — worst case the alert stays pending.
                }
            }

            _pendingItemProductId = null;
            _pendingItemQty = null;
            _sourceDecisionId = null;

            Snackbar.Add($"Transfer {created.Reference} created — review the items and submit.", Severity.Success);
            _createVisible = false;
            _detailId = created.Id;
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            await HandleErrorAsync(ex);
        }
        finally
        {
            _saving = false;
        }
    }

    public void Dispose()
    {
        _disposed = true;
        if (_subscribed)
        {
            TransferBridge.TransferChanged -= OnTransferChanged;
            _subscribed = false;
        }
    }

    private static string StatusIcon(string status) => status switch
    {
        StockTransferStatuses.Draft => Icons.Material.Filled.EditNote,
        StockTransferStatuses.Pending => Icons.Material.Filled.Send,
        StockTransferStatuses.Approved => Icons.Material.Filled.CheckCircle,
        StockTransferStatuses.InTransit => Icons.Material.Filled.LocalShipping,
        StockTransferStatuses.Completed => Icons.Material.Filled.TaskAlt,
        StockTransferStatuses.Cancelled => Icons.Material.Filled.Cancel,
        StockTransferStatuses.Rejected => Icons.Material.Filled.Block,
        _ => Icons.Material.Filled.HelpOutline
    };
}
