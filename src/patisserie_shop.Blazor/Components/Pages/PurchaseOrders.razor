@page "/operations/purchase-orders"
@attribute [Authorize(OperationsPermissions.PurchaseOrders.Default)]
@using System.Threading
@using System.Threading.Tasks
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components
@using Volo.Abp.Application.Dtos
@using Volo.Abp.AspNetCore.Components.Web.Theming.Layout
@using Volo.Abp.Settings
@using Operations
@using Operations.PurchaseOrders
@using Operations.Permissions
@using Operations.Localization
@using Inventory.Branches
@using Inventory.Suppliers
@using Intelligence.Decisions
@using Color = MudBlazor.Color
@using Variant = MudBlazor.Variant
@using Size = MudBlazor.Size
@using Margin = MudBlazor.Margin
@inherits patisserie_shopComponentBase
@inject IPurchaseOrderAppService PurchaseOrderAppService
@inject IBranchAppService BranchAppService
@inject ISupplierAppService SupplierAppService
@inject IDecisionLogAppService DecisionLogAppService
@inject PageLayout PageLayout
@inject ISnackbar Snackbar
@inject IStringLocalizer<OperationsResource> OpsL
@inject Volo.Abp.Settings.ISettingProvider SettingProvider

@{
    PageLayout.Title = OpsL["PurchaseOrders"];
}

<SoftCard Elevation="2" Class="pa-2 page-flat">
    <div class="page-head">
        <div>
            <h1 class="page-title">@OpsL["PurchaseOrders"]</h1>
            <div class="page-sub">Incoming stock orders from suppliers.</div>
        </div>
        <div class="page-head-actions">
            @if (_canCreate)
            {
                <SoftButton Variant="Variant.Filled"
                            Color="Color.Primary"
                            StartIcon="@Icons.Material.Filled.Add"
                            OnClick="OpenCreateDialog">
                    @OpsL["NewPurchaseOrder"]
                </SoftButton>
            }
        </div>
    </div>
    <SoftCardContent>
        <div class="toolbar">
            <SoftTextField T="string"
                           Placeholder="@OpsL["Filter"]"
                           @bind-Value="_filter"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Adornment="Adornment.Start"
                           AdornmentIcon="@Icons.Material.Filled.Search"
                           OnKeyUp="OnFilterKeyUpAsync"
                           Immediate="true"
                           Class="toolbar-search"
                           Style="min-width: 220px; max-width: 320px;" />

            <div class="filter-chip">
                <SoftLookupSelect TItem="StatusOption" TValue="string"
                                  Items="_statusOptions"
                                  ToValue="@(o => o.Value)"
                                  ToLabel="@(o => o.Label)"
                                  Value="_statusFilter"
                                  ValueChanged="OnStatusChangedAsync"
                                  Label="@OpsL["AllStatuses"]"
                                  Margin="Margin.Dense"
                                  Clearable="true"
                                  Dense="true" />
            </div>

            <div class="filter-chip">
                <SoftLookupSelect TItem="SupplierDto" TValue="Guid?"
                                  Items="_suppliers"
                                  ToValue="@(s => (Guid?)s.Id)"
                                  ToLabel="@(s => s.Name)"
                                  Value="_supplierFilter"
                                  ValueChanged="OnSupplierChangedAsync"
                                  Label="@OpsL["Supplier"]"
                                  Margin="Margin.Dense"
                                  Clearable="true"
                                  Dense="true" />
            </div>

            <div class="filter-chip">
                <SoftLookupSelect TItem="BranchLookupDto" TValue="Guid?"
                                  Items="_branches"
                                  ToValue="@(b => (Guid?)b.Id)"
                                  ToLabel="@(b => b.Name)"
                                  Value="_branchFilter"
                                  ValueChanged="OnBranchChangedAsync"
                                  Label="@OpsL["DestinationBranch"]"
                                  Margin="Margin.Dense"
                                  Clearable="true"
                                  Dense="true" />
            </div>

            <div class="toolbar-right">
                <SoftButton Variant="Variant.Text" Color="Color.Primary"
                            OnClick="ReloadAsync" StartIcon="@Icons.Material.Filled.Refresh">
                    @L["Refresh"]
                </SoftButton>
            </div>
        </div>

        <SoftDataGrid T="PurchaseOrderDto"
                      @ref="_grid"
                      ServerData="LoadServerData"
                      Dense="true"
                      Hover="true"
                      Bordered="false"
                      Loading="_loading"
                      SortMode="SortMode.Single"
                      RowClick="OnRowClick">
            <Columns>
                <PropertyColumn T="PurchaseOrderDto" TProperty="string" Property="x => x.PONumber" Title="@OpsL["PONumber"]" />
                <PropertyColumn T="PurchaseOrderDto" TProperty="string" Property="x => x.SupplierName" Title="@OpsL["Supplier"]" />
                <PropertyColumn T="PurchaseOrderDto" TProperty="string" Property="x => x.DestBranchName" Title="@OpsL["DestinationBranch"]" />
                <TemplateColumn T="PurchaseOrderDto" Title="@OpsL["Status"]" SortBy="x => x.Status">
                    <CellTemplate>
                        <div class="@($"po-status po-status-{context.Item.Status.ToLower()}")">
                            <MudIcon Icon="@StatusIcon(context.Item.Status)" Size="Size.Small" />
                            <span>@OpsL[$"Status:{context.Item.Status}"]</span>
                        </div>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="PurchaseOrderDto" Title="@OpsL["OrderDate"]" SortBy="x => x.OrderDate">
                    <CellTemplate>
                        <SoftText Typo="Typo.body2">@context.Item.OrderDate.ToString("MMM d, yyyy")</SoftText>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="PurchaseOrderDto" Title="@OpsL["ExpectedDeliveryDate"]" SortBy="x => x.ExpectedDeliveryDate ?? DateTime.MaxValue">
                    <CellTemplate>
                        <SoftText Typo="Typo.body2">@(context.Item.ExpectedDeliveryDate?.ToString("MMM d, yyyy") ?? "-")</SoftText>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="PurchaseOrderDto" Title="@OpsL["TotalAmount"]" SortBy="x => x.TotalAmount">
                    <CellTemplate>
                        <SoftText Style="font-weight:600;">@($"{context.Item.TotalAmount:N2} {context.Item.Currency}")</SoftText>
                    </CellTemplate>
                </TemplateColumn>
                <PropertyColumn T="PurchaseOrderDto" TProperty="string" Property="x => x.CreatorUserName!" Title="@OpsL["CreatedBy"]" Sortable="false" />
                <TemplateColumn T="PurchaseOrderDto" Title="" Sortable="false">
                    <CellTemplate>
                        <span class="row-actions">
                            <SoftIconButton Icon="@Icons.Material.Filled.OpenInNew"
                                            Color="Color.Primary"
                                            Size="Size.Small"
                                            OnClick="@(() => OpenDetail(context.Item.Id))" />
                        </span>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <NoRecordsContent>
                <SoftStack AlignItems="AlignItems.Center" Spacing="2" Class="pa-6">
                    <SoftIcon Icon="@Icons.Material.Outlined.Inbox" Style="font-size: 56px; opacity: 0.4;" />
                    <SoftText Typo="Typo.body1" Color="Color.Default">@OpsL["NoPurchaseOrders"]</SoftText>
                </SoftStack>
            </NoRecordsContent>
            <PagerContent>
                <MudDataGridPager T="PurchaseOrderDto" />
            </PagerContent>
        </SoftDataGrid>
    </SoftCardContent>
</SoftCard>

@if (_createVisible)
{
    <div class="glass-modal-backdrop" @onclick="CloseCreate">
        <div class="glass-modal-container glass-modal-container--md" @onclick:stopPropagation="true">
            <SoftCard Elevation="24" Class="glass-modal">
                <SoftCardHeader Class="pa-4">
                    <CardHeaderContent>
                        <SoftStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <SoftIcon Icon="@Icons.Material.Filled.AddCircle" Color="Color.Primary" Size="Size.Medium" />
                            <SoftText Typo="Typo.h6">@OpsL["NewPurchaseOrder"]</SoftText>
                        </SoftStack>
                    </CardHeaderContent>
                    <CardHeaderActions>
                        <SoftIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="CloseCreate" />
                    </CardHeaderActions>
                </SoftCardHeader>
                <SoftDivider />
                <SoftCardContent Class="pa-4">
                    <SoftStack Spacing="3">
                        <SoftAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
                            Step 1 of 2 — set up the order header. You'll add products in the next step.
                        </SoftAlert>
                        <SoftLookupSelect TItem="SupplierDto" TValue="Guid?"
                                          Items="_suppliers"
                                          ToValue="@(s => (Guid?)s.Id)"
                                          ToLabel="@(s => s.Name)"
                                          Value="_newSupplierId"
                                          ValueChanged="@(v => _newSupplierId = v)"
                                          Label="@OpsL["Supplier"]"
                                          Required="true" />
                        <SoftLookupSelect TItem="BranchLookupDto" TValue="Guid?"
                                          Items="_branches"
                                          ToValue="@(b => (Guid?)b.Id)"
                                          ToLabel="@(b => b.Name)"
                                          Value="_newBranchId"
                                          ValueChanged="@(v => _newBranchId = v)"
                                          Label="@OpsL["DestinationBranch"]"
                                          Required="true" />
                        <SoftStack Row="true" Spacing="2">
                            <MudDatePicker Label="@OpsL["OrderDate"]" Variant="Variant.Outlined"
                                           @bind-Date="_newOrderDate" />
                            <MudDatePicker Label="@OpsL["ExpectedDeliveryDate"]" Variant="Variant.Outlined"
                                           @bind-Date="_newExpectedDate" Clearable="true" />
                            <SoftSelect T="string" Label="@OpsL["Currency"]"
                                        @bind-Value="_newCurrency"
                                        Variant="Variant.Outlined"
                                        Required="true"
                                        Style="max-width: 160px;">
                                @foreach (var ccode in _currencyOptions)
                                {
                                    <MudSelectItem T="string" Value="@ccode">@CurrencyLabel(ccode)</MudSelectItem>
                                }
                            </SoftSelect>
                        </SoftStack>
                        <SoftTextField T="string"
                                       Label="@OpsL["Notes"]"
                                       @bind-Value="_newNotes"
                                       Variant="Variant.Outlined"
                                       Lines="2"
                                       MaxLength="512" />
                    </SoftStack>
                </SoftCardContent>
                <SoftDivider />
                <div class="pa-3 d-flex justify-end" style="gap: 8px;">
                    <SoftButton Variant="Variant.Text" OnClick="CloseCreate">@L["Cancel"]</SoftButton>
                    <SoftButton Variant="Variant.Filled" Color="Color.Primary"
                                EndIcon="@Icons.Material.Filled.ArrowForward"
                                OnClick="ConfirmCreateAsync"
                                Disabled="_saving">
                        Save & add items
                    </SoftButton>
                </div>
            </SoftCard>
        </div>
    </div>
}

@if (_detailId.HasValue)
{
    <PurchaseOrderDetailModal PurchaseOrderId="_detailId.Value"
                              OnClose="CloseDetailAsync"
                              Changed="OnDetailChangedAsync"
                              @key="_detailId" />
}

<style>
    .po-status {
        display: inline-flex; align-items: center; gap: 6px;
        padding: 3px 10px; border-radius: 999px;
        font-size: 0.78rem; font-weight: 600;
        border: 1px solid transparent;
    }
    .po-status-draft           { background: var(--hover); border-color: var(--bd-2); color: var(--fg-2); }
    .po-status-submitted       { background: rgba( 59,130,246, 0.20); border-color: rgba( 59,130,246, 0.40); color: #1565c0; }
    .po-status-approved        { background: rgba( 34,197, 94, 0.20); border-color: rgba( 34,197, 94, 0.40); color: #2e7d32; }
    .po-status-partialreceived { background: rgba(251,191, 36, 0.20); border-color: rgba(251,191, 36, 0.40); color: #b26a00; }
    .po-status-received        { background: rgba( 20,184,166, 0.20); border-color: rgba( 20,184,166, 0.40); color: #00695c; }
    .po-status-cancelled       { background: rgba(239, 68, 68, 0.20); border-color: rgba(239, 68, 68, 0.40); color: #c62828; }

    html[data-theme="dark"] .po-status-submitted       { color: #93c5fd; }
    html[data-theme="dark"] .po-status-approved        { color: #86efac; }
    html[data-theme="dark"] .po-status-partialreceived { color: #fde68a; }
    html[data-theme="dark"] .po-status-received        { color: #5eead4; }
    html[data-theme="dark"] .po-status-cancelled       { color: #fca5a5; }
</style>

@code {
    private SoftDataGrid<PurchaseOrderDto> _grid = null!;
    private bool _loading;
    private bool _saving;
    private bool _canCreate;

    private string? _filter;
    private string? _statusFilter;
    private Guid? _supplierFilter;
    private Guid? _branchFilter;

    private List<SupplierDto> _suppliers = new();
    private List<BranchLookupDto> _branches = new();
    private List<StatusOption> _statusOptions = new();

    private Guid? _detailId;

    private bool _createVisible;
    private Guid? _newSupplierId;
    private Guid? _newBranchId;
    private DateTime? _newOrderDate = DateTime.Today;
    private DateTime? _newExpectedDate;
    private string _newCurrency = "USD";
    private string? _newNotes;

    // Shop-wide default currency for new purchase orders, from settings.
    private string _defaultCurrency = "USD";

    // Currency codes offered by the New PO dialog's select. The shop's configured
    // default is inserted at load time if it isn't already one of these.
    private readonly List<string> _currencyOptions = new() { "USD", "EUR", "GBP" };

    // Friendly label with a symbol for the codes we know; bare code otherwise.
    private static string CurrencyLabel(string code) => code switch
    {
        "USD" => "USD — $",
        "EUR" => "EUR — €",
        "GBP" => "GBP — £",
        "SAR" => "SAR — ﷼",
        "AED" => "AED — د.إ",
        _ => code
    };

    // Pre-fill handoff from the Decision Log's "Take action" button: the first
    // line to add after the header is created, and the decision to mark executed.
    private Guid? _pendingItemProductId;
    private int? _pendingItemQty;
    private decimal? _pendingItemPrice;
    private Guid? _sourceDecisionId;

    [Parameter, SupplyParameterFromQuery(Name = "new")]
    public bool OpenNew { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "supplierId")]
    public Guid? NewPoSupplierId { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "branchId")]
    public Guid? NewPoBranchId { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "productId")]
    public Guid? NewPoProductId { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "qty")]
    public int? NewPoQuantity { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "price")]
    public decimal? NewPoUnitPrice { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "notes")]
    public string? NewPoNotes { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "decisionId")]
    public Guid? NewPoDecisionId { get; set; }

    public record StatusOption(string Value, string Label);

    protected override async Task OnInitializedAsync()
    {
        _canCreate = await AuthorizationService.IsGrantedAsync(OperationsPermissions.PurchaseOrders.Create);

        _statusOptions = PurchaseOrderStatuses.All
            .Select(s => new StatusOption(s, OpsL[$"Status:{s}"]))
            .ToList();

        try
        {
            var sups = await SupplierAppService.GetListAsync(new Inventory.Suppliers.GetSuppliersInput
            {
                IsActive = true,
                MaxResultCount = 1000,
                Sorting = nameof(SupplierDto.Name)
            });
            _suppliers = sups.Items.ToList();
            _branches = await BranchAppService.GetLookupAsync();
        }
        catch (Exception ex)
        {
            await HandleErrorAsync(ex);
        }

        // Shop-wide default currency for new orders (falls back to USD).
        try
        {
            _defaultCurrency = (await SettingProvider.GetOrNullAsync("patisserie_shop.Operations.DefaultCurrency") ?? "USD").ToUpperInvariant();
        }
        catch
        {
            _defaultCurrency = "USD";
        }
        // The select offers the common codes; make sure the shop's configured
        // default is always present so it never renders as an empty box.
        if (!_currencyOptions.Contains(_defaultCurrency))
        {
            _currencyOptions.Insert(0, _defaultCurrency);
        }
        _newCurrency = _defaultCurrency;

        if (OpenNew && _canCreate)
        {
            OpenCreateDialogPrefilled();
        }
    }

    /// <summary>Opens the New PO dialog pre-filled from Decision Log query parameters.</summary>
    private void OpenCreateDialogPrefilled()
    {
        _newSupplierId = NewPoSupplierId;
        _newBranchId = NewPoBranchId;
        _newOrderDate = DateTime.Today;
        _newExpectedDate = null;
        _newCurrency = _defaultCurrency;
        _newNotes = NewPoNotes;
        _pendingItemProductId = NewPoProductId;
        _pendingItemQty = NewPoQuantity;
        _pendingItemPrice = NewPoUnitPrice;
        _sourceDecisionId = NewPoDecisionId;
        _createVisible = true;
    }

    private async Task<GridData<PurchaseOrderDto>> LoadServerData(GridState<PurchaseOrderDto> state, CancellationToken cancellationToken)
    {
        _loading = true;
        try
        {
            string? sorting = null;
            var sort = state.SortDefinitions.FirstOrDefault();
            if (sort != null)
            {
                sorting = $"{sort.SortBy} {(sort.Descending ? "desc" : "asc")}";
            }

            var result = await PurchaseOrderAppService.GetListAsync(new GetPurchaseOrdersInput
            {
                Filter = _filter,
                Status = _statusFilter,
                SupplierId = _supplierFilter,
                DestBranchId = _branchFilter,
                SkipCount = state.Page * state.PageSize,
                MaxResultCount = state.PageSize,
                Sorting = sorting
            });

            return new GridData<PurchaseOrderDto>
            {
                Items = result.Items,
                TotalItems = (int)result.TotalCount
            };
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnFilterKeyUpAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await ReloadAsync();
    }

    private async Task OnStatusChangedAsync(string? v) { _statusFilter = v; await ReloadAsync(); }
    private async Task OnSupplierChangedAsync(Guid? v) { _supplierFilter = v; await ReloadAsync(); }
    private async Task OnBranchChangedAsync(Guid? v) { _branchFilter = v; await ReloadAsync(); }

    private async Task ReloadAsync()
    {
        if (_grid != null) await _grid.ReloadServerData();
    }

    private void OnRowClick(DataGridRowClickEventArgs<PurchaseOrderDto> args)
    {
        OpenDetail(args.Item.Id);
    }

    private void OpenDetail(Guid id)
    {
        _detailId = id;
    }

    private async Task CloseDetailAsync()
    {
        _detailId = null;
        await Task.CompletedTask;
    }

    private async Task OnDetailChangedAsync()
    {
        await ReloadAsync();
    }

    private void OpenCreateDialog()
    {
        _newSupplierId = null;
        _newBranchId = null;
        _newOrderDate = DateTime.Today;
        _newExpectedDate = null;
        _newCurrency = _defaultCurrency;
        _newNotes = null;
        _pendingItemProductId = null;
        _pendingItemQty = null;
        _pendingItemPrice = null;
        _sourceDecisionId = null;
        _createVisible = true;
    }

    private void CloseCreate() => _createVisible = false;

    private async Task ConfirmCreateAsync()
    {
        if (!_newSupplierId.HasValue)
        {
            Snackbar.Add(L["ThisFieldIsRequired", OpsL["Supplier"]], Severity.Warning);
            return;
        }
        if (!_newBranchId.HasValue)
        {
            Snackbar.Add(L["ThisFieldIsRequired", OpsL["DestinationBranch"]], Severity.Warning);
            return;
        }
        if (!_newOrderDate.HasValue)
        {
            Snackbar.Add(L["ThisFieldIsRequired", OpsL["OrderDate"]], Severity.Warning);
            return;
        }

        _saving = true;
        try
        {
            var created = await PurchaseOrderAppService.CreateAsync(new CreatePurchaseOrderDto
            {
                SupplierId = _newSupplierId.Value,
                DestBranchId = _newBranchId.Value,
                OrderDate = _newOrderDate.Value,
                ExpectedDeliveryDate = _newExpectedDate,
                Currency = (_newCurrency ?? "USD").ToUpper(),
                Notes = _newNotes
            });

            // Handoff from the Decision Log: pre-add the suggested line and mark
            // the alert as executed, linked to this PO.
            if (_pendingItemProductId is Guid pendingProductId && _pendingItemQty is > 0)
            {
                await PurchaseOrderAppService.AddItemAsync(created.Id, new AddPurchaseOrderItemDto
                {
                    ProductId = pendingProductId,
                    OrderedQuantity = _pendingItemQty.Value,
                    UnitPrice = _pendingItemPrice ?? 0
                });
            }

            if (_sourceDecisionId is Guid decisionId)
            {
                try
                {
                    await DecisionLogAppService.ExecuteAsync(decisionId, new ExecuteDecisionLogInput
                    {
                        ActionType = DecisionActionTypes.PurchaseOrder,
                        ActionId = created.Id
                    });
                }
                catch
                {
                    // The PO exists either way — worst case the alert stays pending.
                }
            }

            _pendingItemProductId = null;
            _pendingItemQty = null;
            _pendingItemPrice = null;
            _sourceDecisionId = null;

            Snackbar.Add($"PO {created.PONumber} created — review the items and submit.", Severity.Success);
            _createVisible = false;
            _detailId = created.Id;
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            await HandleErrorAsync(ex);
        }
        finally
        {
            _saving = false;
        }
    }

    private static string StatusIcon(string status) => status switch
    {
        PurchaseOrderStatuses.Draft => Icons.Material.Filled.EditNote,
        PurchaseOrderStatuses.Submitted => Icons.Material.Filled.Send,
        PurchaseOrderStatuses.Approved => Icons.Material.Filled.CheckCircle,
        PurchaseOrderStatuses.PartialReceived => Icons.Material.Filled.HourglassBottom,
        PurchaseOrderStatuses.Received => Icons.Material.Filled.TaskAlt,
        PurchaseOrderStatuses.Cancelled => Icons.Material.Filled.Cancel,
        _ => Icons.Material.Filled.HelpOutline
    };
}
