@page "/operations/sales"
@attribute [Authorize(OperationsPermissions.Sales.Default)]
@using System.Threading
@using System.Threading.Tasks
@using Microsoft.AspNetCore.Authorization
@using Volo.Abp.Application.Dtos
@using Volo.Abp.AspNetCore.Components.Web.Theming.Layout
@using Operations
@using Operations.Sales
@using Operations.Permissions
@using Operations.Localization
@using Inventory.Branches
@using Color = MudBlazor.Color
@using Variant = MudBlazor.Variant
@using Size = MudBlazor.Size
@using Margin = MudBlazor.Margin
@inherits patisserie_shopComponentBase
@inject ISaleAppService SaleAppService
@inject IBranchAppService BranchAppService
@inject PageLayout PageLayout
@inject ISnackbar Snackbar
@inject IStringLocalizer<OperationsResource> OpsL

@{
    PageLayout.Title = OpsL["Sales"];
}

<SoftCard Elevation="2" Class="pa-2 page-flat">
    <div class="page-head">
        <div>
            <h1 class="page-title">@OpsL["Sales"]</h1>
            <div class="page-sub">@OpsL["Sales:Subtitle"]</div>
        </div>
        <div class="page-head-actions">
            <SoftButton Variant="Variant.Filled" Color="Color.Primary"
                        StartIcon="@Icons.Material.Filled.Add"
                        OnClick="OpenCreate"
                        Disabled="!_canManage">
                @OpsL["NewSale"]
            </SoftButton>
        </div>
    </div>
    <SoftCardContent>
        <div class="toolbar">
            <SoftTextField T="string"
                           Placeholder="@OpsL["InvoiceNumber"]"
                           @bind-Value="_filter"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Adornment="Adornment.Start"
                           AdornmentIcon="@Icons.Material.Filled.Search"
                           OnKeyUp="OnFilterKeyUpAsync"
                           Immediate="true"
                           Class="toolbar-search"
                           Style="min-width: 220px; max-width: 320px;" />

            <div class="filter-chip">
                <SoftLookupSelect TItem="BranchLookupDto" TValue="Guid?"
                                  Items="_accessibleBranches"
                                  ToValue="@(b => (Guid?)b.Id)"
                                  ToLabel="@(b => b.Name)"
                                  Value="_branchFilter"
                                  ValueChanged="OnBranchChangedAsync"
                                  Label="@OpsL["Branch"]"
                                  Margin="Margin.Dense"
                                  Clearable="true"
                                  Dense="true" />
            </div>

            <MudDatePicker Label="@OpsL["FromDate"]" @bind-Date="_fromDate" @bind-Date:after="ReloadAsync"
                           Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" />
            <MudDatePicker Label="@OpsL["ToDate"]" @bind-Date="_toDate" @bind-Date:after="ReloadAsync"
                           Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" />

            <div class="toolbar-right">
                <SoftButton Variant="Variant.Text" Color="Color.Primary"
                            OnClick="ReloadAsync" StartIcon="@Icons.Material.Filled.Refresh">
                    @L["Refresh"]
                </SoftButton>
            </div>
        </div>

        <SoftDataGrid T="SaleDto"
                      @ref="_grid"
                      ServerData="LoadServerData"
                      Dense="true"
                      Hover="true"
                      Bordered="false"
                      Loading="_loading"
                      SortMode="SortMode.Single"
                      RowClick="@OnRowClick">
            <Columns>
                <TemplateColumn T="SaleDto" Title="@OpsL["InvoiceNumber"]" SortBy="x => x.InvoiceNumber">
                    <CellTemplate>
                        <SoftText Typo="Typo.body2" Style="font-weight:600; color: var(--mud-palette-primary);">@context.Item.InvoiceNumber</SoftText>
                    </CellTemplate>
                </TemplateColumn>
                <PropertyColumn T="SaleDto" TProperty="string" Property="x => x.BranchName" Title="@OpsL["Branch"]" />
                <TemplateColumn T="SaleDto" Title="@OpsL["SaleDate"]" SortBy="x => x.SaleDate">
                    <CellTemplate>
                        <SoftText Typo="Typo.body2"><BrowserLocalTime Value="@context.Item.SaleDate" Display="BrowserTimeDisplay.LongDateTime" /></SoftText>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="SaleDto" Title="@OpsL["RecordedAt"]" SortBy="x => x.CreationTime">
                    <CellTemplate>
                        <SoftText Typo="Typo.body2"><BrowserLocalTime Value="@context.Item.CreationTime" Display="BrowserTimeDisplay.DateTime" /></SoftText>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="SaleDto" Title="@OpsL["Items"]" Sortable="false">
                    <CellTemplate>
                        <SoftChip T="string" Color="Color.Default" Size="Size.Small" Variant="Variant.Outlined">
                            @context.Item.ItemCount
                        </SoftChip>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="SaleDto" Title="@OpsL["TotalAmount"]" SortBy="x => x.TotalAmount">
                    <CellTemplate>
                        <SoftText Style="font-weight:600;">@($"{context.Item.TotalAmount:N2} {context.Item.Currency}")</SoftText>
                    </CellTemplate>
                </TemplateColumn>
                <PropertyColumn T="SaleDto" TProperty="string" Property="x => x.CreatorUserName!" Title="@OpsL["RecordedBy"]" Sortable="false" />
                <TemplateColumn T="SaleDto" Title="" Sortable="false">
                    <CellTemplate>
                        <span class="row-actions">
                            <SoftStack Row="true" Spacing="1">
                                <SoftIconButton Icon="@Icons.Material.Filled.OpenInNew"
                                                Color="Color.Primary"
                                                Size="Size.Small"
                                                OnClick="@(() => OpenDetail(context.Item.Id))" />
                                @if (_canDelete)
                                {
                                    <SoftIconButton Icon="@Icons.Material.Filled.Delete"
                                                    Color="Color.Error"
                                                    Size="Size.Small"
                                                    OnClick="@(() => RequestDelete(context.Item))" />
                                }
                            </SoftStack>
                        </span>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <NoRecordsContent>
                <SoftStack AlignItems="AlignItems.Center" Spacing="2" Class="pa-6">
                    <SoftIcon Icon="@Icons.Material.Outlined.Inbox" Style="font-size: 56px; opacity: 0.4;" />
                    <SoftText Typo="Typo.body1" Color="Color.Default">@OpsL["NoSales"]</SoftText>
                </SoftStack>
            </NoRecordsContent>
            <PagerContent>
                <MudDataGridPager T="SaleDto" />
            </PagerContent>
        </SoftDataGrid>
    </SoftCardContent>
</SoftCard>

@if (_createVisible)
{
    <SaleCreateModal AccessibleBranches="_accessibleBranches"
                     OnClose="CloseCreate"
                     Saved="OnSavedAsync" />
}

@if (_detailId.HasValue)
{
    <SaleDetailModal SaleId="_detailId.Value"
                     OnClose="CloseDetailAsync"
                     @key="_detailId" />
}

@if (_pendingDelete != null)
{
    <div class="soft-modal-backdrop" @onclick="CancelDelete">
        <div class="soft-modal-container soft-modal-container--sm" @onclick:stopPropagation="true">
            <SoftCard Elevation="24" Class="soft-modal-card">
                <SoftCardHeader Class="pa-4">
                    <CardHeaderContent>
                        <SoftStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <SoftIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Error" Size="Size.Medium" />
                            <SoftText Typo="Typo.h6">@L["AreYouSure"]</SoftText>
                        </SoftStack>
                    </CardHeaderContent>
                </SoftCardHeader>
                <SoftDivider />
                <SoftCardContent Class="pa-4">
                    <SoftText>@string.Format(OpsL["SaleDeleteConfirm"], _pendingDelete.InvoiceNumber)</SoftText>
                </SoftCardContent>
                <SoftDivider />
                <div class="pa-3 d-flex justify-end" style="gap: 8px;">
                    <SoftButton Variant="Variant.Text" OnClick="CancelDelete">@L["Cancel"]</SoftButton>
                    <SoftButton Variant="Variant.Filled" Color="Color.Error"
                                StartIcon="@Icons.Material.Filled.Delete"
                                OnClick="ConfirmDeleteAsync">@OpsL["Delete"]</SoftButton>
                </div>
            </SoftCard>
        </div>
    </div>
}

<style>
    .soft-modal-backdrop {
        position: fixed; inset: 0;
        background: rgba(0, 0, 0, 0.5);
        z-index: 1400;
        display: flex; align-items: center; justify-content: center;
        padding: 16px;
        animation: soft-modal-fade-in 0.15s ease-out;
    }
    .soft-modal-container { width: 100%; max-width: 560px; animation: soft-modal-scale-in 0.18s ease-out; }
    .soft-modal-container--sm { max-width: 420px; }
    .soft-modal-card { border-radius: 12px; overflow: hidden; }
    @@keyframes soft-modal-fade-in { from { opacity: 0; } to { opacity: 1; } }
    @@keyframes soft-modal-scale-in { from { opacity: 0; transform: scale(0.96); } to { opacity: 1; transform: scale(1); } }
</style>

@code {
    private SoftDataGrid<SaleDto> _grid = null!;
    private bool _loading;
    private bool _canManage;
    private bool _canDelete;

    private List<BranchLookupDto> _accessibleBranches = new();

    private string? _filter;
    private Guid? _branchFilter;
    private DateTime? _fromDate;
    private DateTime? _toDate;

    private bool _createVisible;
    private Guid? _detailId;
    private SaleDto? _pendingDelete;

    protected override async Task OnInitializedAsync()
    {
        _canManage = await AuthorizationService.IsGrantedAsync(OperationsPermissions.Sales.Manage);
        _canDelete = await AuthorizationService.IsGrantedAsync(OperationsPermissions.Sales.Delete);

        try
        {
            var allBranches = await BranchAppService.GetLookupAsync();
            var accessibleIds = await SaleAppService.GetAccessibleBranchIdsAsync();
            var set = accessibleIds.ToHashSet();
            _accessibleBranches = allBranches.Where(b => set.Contains(b.Id)).ToList();
        }
        catch (Exception ex) { await HandleErrorAsync(ex); }
    }

    private async Task<GridData<SaleDto>> LoadServerData(GridState<SaleDto> state, CancellationToken cancellationToken)
    {
        _loading = true;
        try
        {
            string? sorting = null;
            var sort = state.SortDefinitions.FirstOrDefault();
            if (sort != null) sorting = $"{sort.SortBy} {(sort.Descending ? "desc" : "asc")}";

            var result = await SaleAppService.GetListAsync(new GetSalesInput
            {
                Filter = _filter,
                BranchId = _branchFilter,
                FromDate = _fromDate,
                ToDate = _toDate,
                SkipCount = state.Page * state.PageSize,
                MaxResultCount = state.PageSize,
                Sorting = sorting
            });
            return new GridData<SaleDto> { Items = result.Items, TotalItems = (int)result.TotalCount };
        }
        finally { _loading = false; }
    }

    private async Task OnFilterKeyUpAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await ReloadAsync();
    }

    private async Task OnBranchChangedAsync(Guid? v) { _branchFilter = v; await ReloadAsync(); }

    private async Task ReloadAsync()
    {
        if (_grid != null) await _grid.ReloadServerData();
    }

    private void OnRowClick(DataGridRowClickEventArgs<SaleDto> args) => OpenDetail(args.Item.Id);
    private void OpenDetail(Guid id) => _detailId = id;
    private Task CloseDetailAsync() { _detailId = null; return Task.CompletedTask; }

    private void OpenCreate() => _createVisible = true;
    private void CloseCreate() => _createVisible = false;

    private async Task OnSavedAsync(SaleDto created)
    {
        _createVisible = false;
        Snackbar.Add(string.Format(OpsL["SaleRecordedToast"], created.InvoiceNumber), Severity.Success);
        await ReloadAsync();
    }

    private void RequestDelete(SaleDto sale) => _pendingDelete = sale;
    private void CancelDelete() => _pendingDelete = null;

    private async Task ConfirmDeleteAsync()
    {
        if (_pendingDelete == null) return;
        try
        {
            await SaleAppService.DeleteAsync(_pendingDelete.Id);
            Snackbar.Add(L["SuccessfullyDeleted"], Severity.Success);
            _pendingDelete = null;
            await ReloadAsync();
        }
        catch (Exception ex) { await HandleErrorAsync(ex); }
    }
}
