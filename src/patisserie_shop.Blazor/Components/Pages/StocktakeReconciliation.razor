    .sr-number { display: inline-block; min-width: 42px; text-align: end; font-variant-numeric: tabular-nums; white-space: nowrap; }
    .sr-print-table { display: none; width: 100%; border-collapse: collapse; font-size: 11px; }
    .sr-print-table th, .sr-print-table td { padding: 5px 6px; border-bottom: 1px solid var(--bd-2); text-align: start; font-variant-numeric: tabular-nums; }
