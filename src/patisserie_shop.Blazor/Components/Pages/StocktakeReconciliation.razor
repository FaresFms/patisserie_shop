    .sr-attention-problem span, .sr-attention-metric span { color: var(--fg-3); font-size: 10.5px; }
    .sr-attention-problem strong, .sr-attention-metric strong { color: var(--fg-1); font-variant-numeric: tabular-nums; }
    .sr-attention-problem small { margin-top: 2px; color: var(--fg-3); font-size: 10.5px; }
    .sr-attention-action { display: flex; justify-content: flex-end; }

    .sr-grid-wrap { overflow-x: auto; }
    .sr-grid { min-width: 900px; }
    .sr-product { display: flex; flex-direction: column; min-width: 170px; }
