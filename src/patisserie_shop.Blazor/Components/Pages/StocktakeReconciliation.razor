    .sr-empty { min-height: 220px; display: flex; align-items: center; justify-content: center; gap: 10px; color: var(--fg-3); }
    .sr-empty--small { min-height: 100px; }

    .sr-detail-section { margin-bottom: 18px; }
    .sr-detail-section h3, .sr-next-steps h3 { margin: 0 0 9px; color: var(--fg-1); font-family: var(--font-serif); font-size: 16px; }
    .sr-detail-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border: 1px solid var(--bd-1); border-radius: var(--r-sm); overflow: hidden; }
    .sr-detail-grid > div { display: flex; flex-direction: column; gap: 3px; min-height: 70px; padding: 12px 14px; border-inline-end: 1px solid var(--bd-1); border-bottom: 1px solid var(--bd-1); background: var(--surface-2); }
    .sr-detail-grid > div:nth-child(3n) { border-inline-end: none; }
    .sr-detail-grid > div:nth-last-child(-n+3) { border-bottom: none; }
    .sr-detail-grid span { color: var(--fg-3); font-size: 11px; }
    .sr-detail-grid strong { color: var(--fg-1); font-size: 17px; font-variant-numeric: tabular-nums; }
    .sr-detail-hint { margin: 7px 2px 0; color: var(--fg-3); font-size: 11px; }
    .sr-next-steps { padding: 14px 16px; border-radius: var(--r-sm); background: var(--accent-soft); }
    .sr-next-steps ul { margin: 0; padding-inline-start: 20px; color: var(--fg-2); font-size: 12.5px; line-height: 1.9; }
    .sr-modal-actions { gap: 8px; }

    @@media (max-width: 1050px) {
        .sr-overview { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .sr-guide { grid-template-columns: 1fr; }
        .sr-attention-row { grid-template-columns: 34px minmax(180px, 1.3fr) minmax(180px, 1fr) 90px 130px; }
        .sr-attention-action { grid-column: 2 / -1; justify-content: flex-start; }
    }

    @@media (max-width: 760px) {
        .sr-skeletons { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .sr-section, .sr-explanation, .sr-action-alert, .sr-overview, .sr-guide { margin-left: 12px; margin-right: 12px; }
        .sr-guide-steps { grid-template-columns: 1fr; }
        .sr-attention-row { grid-template-columns: 32px 1fr 1fr; }
        .sr-attention-problem { grid-column: 2 / -1; }
        .sr-attention-action { grid-column: 2 / -1; }
        .sr-products-head { align-items: stretch; flex-direction: column; }
        .sr-search { width: 100%; }
        .sr-detail-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .sr-detail-grid > div:nth-child(3n) { border-inline-end: 1px solid var(--bd-1); }
        .sr-detail-grid > div:nth-child(2n) { border-inline-end: none; }
        .sr-detail-grid > div:nth-last-child(-n+3) { border-bottom: 1px solid var(--bd-1); }
        .sr-detail-grid > div:nth-last-child(-n+2) { border-bottom: none; }
    }

    @@media (max-width: 600px) {
        .sr-overview, .sr-skeletons { grid-template-columns: 1fr; }
        .sr-range { width: 100%; }
        .sr-range .mud-button-root { flex: 1; }
        .sr-period { display: none; }
        .sr-detail-grid { grid-template-columns: 1fr; }
        .sr-detail-grid > div, .sr-detail-grid > div:nth-child(2n), .sr-detail-grid > div:nth-child(3n) { border-inline-end: none; border-bottom: 1px solid var(--bd-1); }
