    @@media print {
        body.stocktake-report-printing * { visibility: hidden !important; }
        body.stocktake-report-printing .stocktake-reconciliation,
        body.stocktake-report-printing .stocktake-reconciliation * { visibility: visible !important; }
        body.stocktake-report-printing .stocktake-reconciliation { position: absolute; inset: 0; width: 100%; padding: 0 !important; background: #fff !important; color: #222 !important; }
        body.stocktake-report-printing .sr-no-print,
