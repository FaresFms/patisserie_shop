</style>

@code {
    private static readonly int[] RangeOptions = { 7, 30, 90 };

    private StocktakeReconciliationDto? _data;
    private StocktakeReconciliationProductDto? _selectedProduct;
    private List<BranchLookupDto> _accessibleBranches = new();
    private int _days = 30;
    private Guid? _branchId;
    private string _search = string.Empty;
    private bool _loading;
    private bool _error;
    private bool _showComparison;

    private string SelectedBranchName
        => _branchId.HasValue
            ? _accessibleBranches.FirstOrDefault(branch => branch.Id == _branchId.Value)?.Name
                ?? InvL["StocktakeReconciliation:Branch"]
            : InvL["StocktakeReconciliation:AllBranches"];

    private IEnumerable<StocktakeReconciliationProductDto> FilteredProducts
        => _data?.Products.Where(product =>
            string.IsNullOrWhiteSpace(_search)
            || product.ProductName.Contains(_search, StringComparison.OrdinalIgnoreCase)
            || product.Sku.Contains(_search, StringComparison.OrdinalIgnoreCase))
            ?? Enumerable.Empty<StocktakeReconciliationProductDto>();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadShopCurrencyAsync();
            var branches = await BranchAppService.GetLookupAsync();
            var inventoryIds = (await InventoryAppService.GetAccessibleBranchIdsAsync()).ToHashSet();
            var salesIds = (await SaleAppService.GetAccessibleBranchIdsAsync()).ToHashSet();
            _accessibleBranches = branches
                .Where(branch => inventoryIds.Contains(branch.Id) && salesIds.Contains(branch.Id))
                .ToList();
        }
        catch (Exception ex)
        {
            _error = true;
            await HandleErrorAsync(ex);
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = false;
        _selectedProduct = null;
        try
        {
            _data = await ReconciliationAppService.GetAsync(new GetStocktakeReconciliationInput
            {
                Days = _days,
                BranchId = _branchId
            });
        }
        catch (Exception ex)
        {
            _error = true;
            await HandleErrorAsync(ex);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SetDaysAsync(int days)
    {
        if (_days == days) return;
        _days = days;
        await LoadAsync();
    }

    private async Task OnBranchChangedAsync(Guid? branchId)
    {
        _branchId = branchId;
        await LoadAsync();
    }

    private string FormatMoney(decimal value) => FormatShopMoney(value, 2);

    private static string FormatPercent(decimal value)
        => $"{value.ToString("N1", CultureInfo.CurrentCulture)}%";

    private async Task PrintAsync()
    {
        if (_data is null) return;
        await JS.InvokeVoidAsync("reportTools.printStocktakeReconciliation");
    }

    private async Task ExportCsvAsync()
    {
        if (_data is null) return;

        try
        {
            var csv = BuildCsv();
            var fileName = $"stocktake-reconciliation-{_data.FromDate:yyyyMMdd}-{_data.ToDate:yyyyMMdd}.csv";
            await JS.InvokeVoidAsync("reportTools.downloadCsv", fileName, csv);
            Snackbar.Add(InvL["StocktakeReconciliation:Exported"], Severity.Success);
        }
        catch (Exception ex)
        {
            await HandleErrorAsync(ex);
        }
    }

    private string BuildCsv()
    {
        var builder = new StringBuilder();
        AppendCsvRow(builder, InvL["StocktakeReconciliation:Title"]);
        AppendCsvRow(builder, InvL["StocktakeReconciliation:Branch"], SelectedBranchName);
        AppendCsvRow(builder, _data!.FromDate.ToString("d"), _data.ToDate.ToString("d"));
        AppendCsvRow(builder, InvL["StocktakeReconciliation:EstimatedShortageValue"], FormatMoney(_data.EstimatedShortageValue));
        AppendCsvRow(builder, InvL["StocktakeReconciliation:EstimatedWriteOffValue"], FormatMoney(_data.EstimatedWriteOffValue));
        builder.AppendLine();

        AppendCsvRow(
            builder,
            InvL["StocktakeReconciliation:Product"],
            InvL["StocktakeReconciliation:SKU"],
            InvL["StocktakeReconciliation:CurrentStock"],
            InvL["StocktakeReconciliation:Sold"],
            InvL["StocktakeReconciliation:Revenue"],
            InvL["StocktakeReconciliation:Shortage"],
            InvL["StocktakeReconciliation:Overage"],
            InvL["StocktakeReconciliation:NetVariance"],
            InvL["StocktakeReconciliation:EstimatedValue"],
            InvL["StocktakeReconciliation:WriteOff"],
            InvL["StocktakeReconciliation:EstimatedWriteOffValue"],
            InvL["StocktakeReconciliation:UnrecordedSale"],
            InvL["StocktakeReconciliation:ShortageRate"],
            InvL["StocktakeReconciliation:Stocktakes"]);

        foreach (var product in FilteredProducts)
        {
            AppendCsvRow(
                builder,
                product.ProductName,
                product.Sku,
                product.CurrentStock.ToString(CultureInfo.InvariantCulture),
                product.QuantitySold.ToString(CultureInfo.InvariantCulture),
                FormatMoney(product.Revenue),
                product.ShortageQuantity.ToString(CultureInfo.InvariantCulture),
                product.OverageQuantity.ToString(CultureInfo.InvariantCulture),
                product.NetVariance.ToString(CultureInfo.InvariantCulture),
                FormatMoney(product.EstimatedShortageValue),
                product.WriteOffQuantity.ToString(CultureInfo.InvariantCulture),
                FormatMoney(product.EstimatedWriteOffValue),
                product.UnrecordedSaleQuantity.ToString(CultureInfo.InvariantCulture),
                FormatPercent(product.ShortageRate),
                product.StocktakeCount.ToString(CultureInfo.InvariantCulture));
        }

        return builder.ToString();
    }

    private static void AppendCsvRow(StringBuilder builder, params string[] values)
    {
        builder.AppendLine(string.Join(",", values.Select(EscapeCsv)));
    }

    private static string EscapeCsv(string value)
        => $"\"{(value ?? string.Empty).Replace("\"", "\"\"")}\"";

    private string ReasonLabel(string reason) => InvL[$"Stocktake:Reason:{reason}"];

    private string ReasonIcon(string reason) => reason switch
    {
        StocktakeVarianceReasons.Damaged => Icons.Material.Outlined.BrokenImage,
        StocktakeVarianceReasons.Expired => Icons.Material.Outlined.EventBusy,
        StocktakeVarianceReasons.Waste => Icons.Material.Outlined.DeleteSweep,
        StocktakeVarianceReasons.Complimentary => Icons.Material.Outlined.CardGiftcard,
        StocktakeVarianceReasons.UnrecordedSale => Icons.Material.Outlined.ReceiptLong,
        StocktakeVarianceReasons.UnrecordedReceipt => Icons.Material.Outlined.Inventory,
        StocktakeVarianceReasons.CountingError => Icons.Material.Outlined.Calculate,
        _ => Icons.Material.Outlined.HelpOutline
    };

    private string ProblemLabel(StocktakeReconciliationProductDto product)
    {
        if (product.UnrecordedSaleQuantity > 0) return InvL["StocktakeReconciliation:IssueUnrecordedSale"];
        if (product.WriteOffQuantity > 0) return InvL["StocktakeReconciliation:IssueWriteOff"];
        if (product.HasRepeatedVariance) return InvL["StocktakeReconciliation:IssueRepeated"];
        return InvL["StocktakeReconciliation:IssueShortage"];
    }

    private string ProblemDescription(StocktakeReconciliationProductDto product)
    {
        if (product.UnrecordedSaleQuantity > 0)
            return string.Format(InvL["StocktakeReconciliation:IssueUnrecordedSaleDescription"], product.UnrecordedSaleQuantity);
        if (product.WriteOffQuantity > 0)
            return string.Format(InvL["StocktakeReconciliation:IssueWriteOffDescription"], product.WriteOffQuantity);
        if (product.HasRepeatedVariance)
            return string.Format(InvL["StocktakeReconciliation:IssueRepeatedDescription"], product.StocktakeCount);
        return string.Format(InvL["StocktakeReconciliation:IssueShortageDescription"], product.ShortageQuantity);
    }

    private static Severity ProductIssueSeverity(StocktakeReconciliationProductDto product)
        => product.UnrecordedSaleQuantity > 0 ? Severity.Error
            : product.WriteOffQuantity > 0 || product.HasRepeatedVariance ? Severity.Warning
            : Severity.Info;

    private IEnumerable<string> ProductNextSteps(StocktakeReconciliationProductDto product)
    {
        if (product.UnrecordedSaleQuantity > 0)
            yield return InvL["StocktakeReconciliation:NextUnrecordedSale"];
        if (product.WriteOffQuantity > 0)
            yield return InvL["StocktakeReconciliation:NextWriteOff"];
        if (product.HasRepeatedVariance)
            yield return InvL["StocktakeReconciliation:NextRepeated"];
        yield return InvL["StocktakeReconciliation:NextRecount"];
        if (!_branchId.HasValue)
            yield return InvL["StocktakeReconciliation:SelectBranchForStory"];
    }

    private void OpenProductDetails(StocktakeReconciliationProductDto product)
        => _selectedProduct = product;

    private void CloseProductDetails()
        => _selectedProduct = null;

    private void OpenProductStory()
    {
        if (_selectedProduct is null || !_branchId.HasValue) return;
        Nav.NavigateTo($"/inventory/product-story?productId={_selectedProduct.ProductId}&branchId={_branchId.Value}");
    }

}
