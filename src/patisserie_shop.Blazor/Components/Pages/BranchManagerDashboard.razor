@code {
    private BranchDashboardDto? _data;
    private bool _loading;
    private DateTime? _lastRefresh;
    private string _greeting = "Welcome";
    private string? _userName;
    private string? _error;
    private Guid? _busyId;
    private readonly HashSet<Guid> _fadingIds = new();

    private double TodayDelta
    {
        get
        {
            if (_data == null) return 0;
            if (_data.YesterdaySalesTotal <= 0) return _data.TodaySalesTotal > 0 ? 100 : 0;
            return (double)((_data.TodaySalesTotal - _data.YesterdaySalesTotal) / _data.YesterdaySalesTotal) * 100.0;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _greeting = ComputeGreeting(DateTime.Now);
        var state = await AuthState.GetAuthenticationStateAsync();
        _userName = state.User.Identity?.Name;

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _data = await BranchDashboardService.GetBranchDashboardAsync();
            _lastRefresh = DateTime.UtcNow;
            _fadingIds.Clear();
        }
        catch (Exception ex)
        {
            _error = $"{ex.GetType().Name}: {ex.Message}";
            Console.Error.WriteLine($"[BranchManagerDashboard] {ex}");
            await HandleErrorAsync(ex);
        }
        finally
        {
            _loading = false;
        }
    }

    private void OnPendingAlertsClick()
    {
        if (_data?.HasBranchAssigned == true)
        {
            Nav.NavigateTo($"/intelligence/decision-log?branchId={_data.BranchId}");
        }
        else
        {
            Nav.NavigateTo("/intelligence/decision-log");
        }
    }

    private Task AcknowledgeAsync(Guid id) => RunActionAsync(id, DecisionLogAppService.AcknowledgeAsync);
    private Task DismissAsync(Guid id) => RunActionAsync(id, DecisionLogAppService.DismissAsync);

    private async Task RunActionAsync(Guid id, Func<Guid, Task<DecisionLogDto>> action)
    {
        _busyId = id;
        try
        {
            await action(id);
            _fadingIds.Add(id);
            Snackbar.Add(L["SuccessfullySaved"], Severity.Success);
            StateHasChanged();

            // After the fade transition completes, drop the item and refresh counters.
            await Task.Delay(380);
            if (_data != null)
            {
                _data.PendingDecisions = _data.PendingDecisions.Where(d => d.Id != id).ToList();
                _data.PendingDecisionsCount = Math.Max(0, _data.PendingDecisionsCount - 1);
            }
        }
        catch (Exception ex)
        {
            await HandleErrorAsync(ex);
        }
        finally
        {
            _busyId = null;
        }
    }

    private static string ComputeGreeting(DateTime now)
    {
        var h = now.Hour;
        if (h < 12) return "Good morning";
        if (h < 18) return "Good afternoon";
        return "Good evening";
    }

    private static string FormatMoney(decimal v) => v.ToString("C0", System.Globalization.CultureInfo.GetCultureInfo("en-US"));

    private static string FormatCompact(decimal v)
    {
        if (v >= 1_000_000) return $"${v / 1_000_000m:0.#}M";
        if (v >= 1_000) return $"${v / 1_000m:0.#}k";
        return $"${v:0}";
    }

    private static bool IsToday(DateTime d) => d.Date == DateTime.UtcNow.Date;

    private static string Truncate(string s, int max)
        => string.IsNullOrEmpty(s) || s.Length <= max ? s : s[..max].TrimEnd() + "…";

    private static Color DecisionTypeColor(string type) => type switch
    {
        DecisionTypes.LowStockAlert => Color.Warning,
        DecisionTypes.ExcessStockAlert => Color.Info,
        DecisionTypes.DeadStockFlag => Color.Error,
        DecisionTypes.TransferSuggestion => Color.Tertiary,
        DecisionTypes.ReorderSuggestion => Color.Primary,
        _ => Color.Default
    };

    private static string FormatDecisionType(string type) => type switch
    {
        DecisionTypes.LowStockAlert => "Low Stock",
        DecisionTypes.ExcessStockAlert => "Excess Stock",
        DecisionTypes.DeadStockFlag => "Dead Stock",
        DecisionTypes.TransferSuggestion => "Transfer",
        DecisionTypes.ReorderSuggestion => "Reorder",
        _ => type
    };

    private static Color TransferStatusColor(string status) => status switch
    {
        "InTransit" => Color.Info,
        "Approved" => Color.Success,
        "Pending" => Color.Warning,
        _ => Color.Default
    };

    private static string FormatTransferStatus(string status) => status switch
    {
        "InTransit" => "In Transit",
        _ => status
    };

    private static string TimeAgo(DateTime utc)
    {
        var diff = DateTime.UtcNow - utc;
        if (diff.TotalSeconds < 60) return "just now";
        if (diff.TotalMinutes < 60) return $"{(int)diff.TotalMinutes}m ago";
        if (diff.TotalHours < 24) return $"{(int)diff.TotalHours}h ago";
        if (diff.TotalDays < 2) return "yesterday";
        return $"{(int)diff.TotalDays}d ago";
    }
}
