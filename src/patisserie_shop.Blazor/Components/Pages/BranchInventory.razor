@page "/inventory/branch-inventory"
@attribute [Authorize(InventoryPermissions.BranchInventory.Default)]
@using System.Threading
@using System.Threading.Tasks
@using Microsoft.AspNetCore.Authorization
@using Microsoft.JSInterop
@using Volo.Abp.Application.Dtos
@using Volo.Abp.AspNetCore.Components.Web.Theming.Layout
@using Volo.Abp.Settings
@using Inventory
@using Inventory.Branches
@using Inventory.BranchInventory
@using Inventory.Products
@using Inventory.Permissions
@using Inventory.Localization
@using Intelligence.Decisions
@using Intelligence.Permissions
@using Color = MudBlazor.Color
@using Variant = MudBlazor.Variant
@using Size = MudBlazor.Size
@using Margin = MudBlazor.Margin
@inherits patisserie_shopComponentBase
@inject IBranchInventoryAppService InventoryAppService
@inject IBranchAppService BranchAppService
@inject IProductAppService ProductAppService
@inject IDecisionLogAppService DecisionLogAppService
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject PageLayout PageLayout
@inject ISnackbar Snackbar
@inject IStringLocalizer<InventoryResource> InvL
@inject Volo.Abp.Settings.ISettingProvider SettingProvider

@{
    PageLayout.Title = InvL["Menu:Stock"];
}

<SoftStack Spacing="3">

    <StockSubNav Active="levels" />

    @* ── 1. Compact header (unchanged) ─────────────────────────────────── *@
    <div class="bi-head">
        <div class="bi-head-left">
            <SoftIcon Icon="@Icons.Material.Filled.Place" Color="Color.Primary" Size="Size.Small" />
            @if (_accessibleBranches.Count > 1)
            {
                <div class="bi-branch-select">
                    <SoftLookupSelect TItem="BranchLookupDto" TValue="Guid?"
                                      Items="_accessibleBranches"
                                      ToValue="@(b => (Guid?)b.Id)"
                                      ToLabel="@(b => b.Name)"
                                      Value="_branchId"
                                      ValueChanged="OnBranchChangedAsync"
                                      Dense="true"
                                      Margin="Margin.Dense" />
                </div>
            }
            else
            {
                <span class="bi-branch-name">@_currentBranchName</span>
            }
        </div>

        @if (_branchId.HasValue)
        {
            <div class="bi-stats-strip">
                <span><strong>@_stats.TotalItems</strong> @InvL["Stats:Total:Short"]</span>
                <span class="bi-dot">·</span>
                <span class="bi-strip-ok"><strong>@_stats.HealthyStockCount</strong> @InvL["Stats:Healthy"]</span>
                <span class="bi-dot">·</span>
                <span class="@(_stats.LowStockCount > 0 ? "bi-strip-warn" : "")"><strong>@_stats.LowStockCount</strong> @InvL["Stats:LowStock"]</span>
                <span class="bi-dot">·</span>
                <span class="@(_stats.OutOfStockCount > 0 ? "bi-strip-danger" : "")"><strong>@_stats.OutOfStockCount</strong> @InvL["Stats:OutOfStock"]</span>
                @if (_stats.ExpiredItemCount > 0)
                {
                    <span class="bi-dot">·</span>
                    <span class="bi-strip-danger"><strong>@_stats.ExpiredItemCount</strong> @InvL["ExpiredStat"]</span>
                }
            </div>
        }

        <div class="bi-head-actions">
            @if (_branchId.HasValue && _canInitialize)
            {
                <SoftButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                            StartIcon="@Icons.Material.Filled.AddBox"
                            OnClick="OpenInitializeDialog">
                    @InvL["InitializeProduct"]
                </SoftButton>
            }
            <SoftIconButton Icon="@Icons.Material.Filled.Refresh" Size="Size.Small"
                            Color="Color.Default" OnClick="ReloadAsync" />
        </div>
    </div>

    @if (!_branchId.HasValue)
    {
        <SoftCard Elevation="0" Class="pa-6 d-flex align-items-center justify-content-center" Style="border: 2px dashed var(--bd-2); background: transparent;">
            <SoftStack AlignItems="AlignItems.Center" Spacing="2">
                <SoftIcon Icon="@Icons.Material.Outlined.Warehouse" Color="Color.Default" Style="font-size: 64px; opacity: 0.5;" />
                <SoftText Typo="Typo.h6" Color="Color.Default">@InvL["SelectBranchPrompt"]</SoftText>
                @if (_accessibleBranches.Count == 0)
                {
                    <SoftText Typo="Typo.body2" Color="Color.Warning">@InvL["NoBranchAccess"]</SoftText>
                }
            </SoftStack>
        </SoftCard>
    }
    else
    {
        @* ── 2. Pending-decisions banner (replaces the card grid) ───────── *@
        @if (_pendingDecisionCount > 0)
        {
            <div class="bi-decisions-banner">
                <MudIcon Icon="@Icons.Material.Filled.NotificationsActive" Size="Size.Small" Class="bi-banner-icon" />
                <span class="bi-banner-text">
                    <strong>@_pendingDecisionCount</strong> @InvL["DecisionsNeedAttention"]
                </span>
                <SoftButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                            EndIcon="@Icons.Material.Filled.ArrowForward"
                            OnClick="GoToDecisionLog">
                    @InvL["Review"]
                </SoftButton>
            </div>
        }

        @* ── 3. All Products (table / card toggle) ──────────────────────── *@
        <section class="bi-section">
            <div class="bi-section-head bi-section-head--spread">
                <h2 class="bi-section-title">@InvL["AllProducts"] (@_stats.TotalItems)</h2>
                <div class="bi-view-toggle">
                    <SoftTooltip Text="@InvL["TableView"]">
                        <SoftIconButton Icon="@Icons.Material.Filled.ViewList"
                                        Size="Size.Small"
                                        Color="@(_viewMode == ViewTable ? Color.Primary : Color.Default)"
                                        Class="@(_viewMode == ViewTable ? "bi-view-active" : "")"
                                        OnClick="@(() => SetViewAsync(ViewTable))" />
                    </SoftTooltip>
                    <SoftTooltip Text="@InvL["CardView"]">
                        <SoftIconButton Icon="@Icons.Material.Filled.GridView"
                                        Size="Size.Small"
                                        Color="@(_viewMode == ViewCard ? Color.Primary : Color.Default)"
                                        Class="@(_viewMode == ViewCard ? "bi-view-active" : "")"
                                        OnClick="@(() => SetViewAsync(ViewCard))" />
                    </SoftTooltip>
                </div>
            </div>

            <SoftCard Elevation="2" Class="pa-2 page-flat">
                <SoftCardContent>
                    <div class="toolbar">
                        <SoftTextField T="string"
                                       Placeholder="@InvL["Filter"]"
                                       @bind-Value="_filter"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense"
                                       Adornment="Adornment.Start"
                                       AdornmentIcon="@Icons.Material.Filled.Search"
                                       OnKeyUp="OnFilterKeyUpAsync"
                                       Immediate="true"
                                       Class="toolbar-search"
                                       Style="min-width: 240px; max-width: 320px;" />

                        <SoftCheckBox T="bool" Value="_onlyLowStock"
                                      Label="@InvL["OnlyLowStock"]"
                                      Color="Color.Warning"
                                      ValueChanged="OnOnlyLowStockChangedAsync" />

                        <SoftCheckBox T="bool" Value="_includeInactive"
                                      Label="@InvL["IncludeInactiveProducts"]"
                                      Color="Color.Default"
                                      ValueChanged="OnIncludeInactiveChangedAsync" />

                        @if (_viewMode == ViewTable)
                        {
                            <div class="toolbar-right">
                                <SoftButton Variant="Variant.Text" Color="Color.Default"
                                            StartIcon="@(_showLimits ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Tune)"
                                            OnClick="@(() => _showLimits = !_showLimits)">
                                    @(_showLimits ? InvL["HideLimits"] : InvL["ShowLimits"])
                                </SoftButton>
                            </div>
                        }
                    </div>

                    @if (_viewMode == ViewTable)
                    {
                        <SoftDataGrid T="BranchInventoryDto"
                                      @ref="_grid"
                                      ServerData="LoadServerData"
                                      Dense="true"
                                      Hover="true"
                                      Bordered="false"
                                      Loading="_loading"
                                      SortMode="SortMode.Single"
                                      RowClassFunc="@RowClassFunc">
                            <Columns>
                                <PropertyColumn T="BranchInventoryDto" TProperty="string" Property="x => x.ProductSKU" Title="@InvL["SKU"]" />
                                <PropertyColumn T="BranchInventoryDto" TProperty="string" Property="x => x.ProductName" Title="@InvL["Product"]" />
                                <TemplateColumn T="BranchInventoryDto" Title="@InvL["QuantityOnHand"]" SortBy="x => x.QuantityOnHand">
                                    <CellTemplate>
                                        <SoftStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                            <SoftText Typo="Typo.body1" Style="font-weight:600;">@context.Item.QuantityOnHand</SoftText>
                                            <SoftText Typo="Typo.caption" Color="Color.Default">@context.Item.ProductUnit</SoftText>
                                            @if (context.Item.IsOutOfStock)
                                            {
                                                <SoftChip T="string" Color="Color.Error" Size="Size.Small" Variant="Variant.Filled">@InvL["OutOfStock"]</SoftChip>
                                            }
                                            else if (context.Item.IsLowStock)
                                            {
                                                <SoftChip T="string" Color="Color.Warning" Size="Size.Small" Variant="Variant.Filled">@InvL["LowStock"]</SoftChip>
                                            }
                                            @if (context.Item.HasExpiredStock)
                                            {
                                                <SoftTooltip Text="@string.Format(InvL["ExpiredUnits"], context.Item.ExpiredQuantity)">
                                                    <SoftChip T="string" Color="Color.Error" Size="Size.Small" Variant="Variant.Outlined"
                                                              Icon="@Icons.Material.Filled.EventBusy">@string.Format(InvL["ExpiredUnits"], context.Item.ExpiredQuantity)</SoftChip>
                                                </SoftTooltip>
                                            }
                                        </SoftStack>
                                    </CellTemplate>
                                </TemplateColumn>
                                @if (_showLimits)
                                {
                                    <PropertyColumn T="BranchInventoryDto" TProperty="int" Property="x => x.MinimumStock" Title="@InvL["MinimumStock"]" />
                                    <TemplateColumn T="BranchInventoryDto" Title="@InvL["MaximumStock"]" SortBy="x => x.MaximumStock ?? 0">
                                        <CellTemplate>
                                            <SoftText>@(context.Item.MaximumStock?.ToString() ?? "-")</SoftText>
                                        </CellTemplate>
                                    </TemplateColumn>
                                }
                                <TemplateColumn T="BranchInventoryDto" Title="@InvL["LastRestocked"]" SortBy="x => x.LastRestockedDate ?? DateTime.MinValue">
                                    <CellTemplate>
                                        <SoftText Typo="Typo.body2">@(context.Item.LastRestockedDate?.ToString("g") ?? "-")</SoftText>
                                    </CellTemplate>
                                </TemplateColumn>
                                <TemplateColumn T="BranchInventoryDto" Title="@InvL["Actions"]" Sortable="false">
                                    <CellTemplate>
                                        <span class="row-actions">
                                            <SoftTooltip Text="@L["ProductStory:OpenTimeline"]">
                                                <SoftIconButton Icon="@Icons.Material.Filled.Timeline" Size="Size.Small"
                                                                OnClick="() => GoToProductStory(context.Item)" />
                                            </SoftTooltip>
                                            @RowActions(context.Item)
                                        </span>
                                    </CellTemplate>
                                </TemplateColumn>
                            </Columns>
                            <PagerContent>
                                <MudDataGridPager T="BranchInventoryDto" />
                            </PagerContent>
                        </SoftDataGrid>
                    }
                    else
                    {
                        @* ── Card view ─────────────────────────────────── *@
                        @if (_loading && _cardItems.Count == 0)
                        {
                            <SoftStack AlignItems="AlignItems.Center" Class="pa-6">
                                <SoftProgressCircular Indeterminate="true" Color="Color.Primary" />
                            </SoftStack>
                        }
                        else if (_cardItems.Count == 0)
                        {
                            <SoftStack AlignItems="AlignItems.Center" Spacing="2" Class="pa-6">
                                <SoftIcon Icon="@Icons.Material.Outlined.Inventory2" Style="font-size: 52px; opacity: 0.4;" />
                                <SoftText Typo="Typo.body1" Color="Color.Default">@InvL["NoMovements"]</SoftText>
                            </SoftStack>
                        }
                        else
                        {
                            <div class="bi-prod-grid">
                                @foreach (var item in _cardItems)
                                {
                                    var barClass = CardBarClass(item);
                                    <div class="bi-prod-card @(item.ProductIsActive ? "" : "bi-prod-inactive")">
                                        <div class="bi-prod-top">
                                            <span class="bi-prod-sku">@item.ProductSKU</span>
                                            <span class="bi-prod-unit">@item.ProductUnit</span>
                                        </div>
                                        <div class="bi-prod-name" title="@item.ProductName">@item.ProductName</div>

                                        <SoftDivider Class="bi-prod-div" />

                                        <div class="bi-prod-onhand-label">@InvL["QuantityOnHand"]</div>
                                        <div class="bi-bar-wrap">
                                            <div class="bi-bar">
                                                <div class="bi-bar-fill @barClass" style="width:@(CardBarPercent(item))%"></div>
                                            </div>
                                            <div class="bi-prod-onhand-val">@item.QuantityOnHand</div>
                                        </div>

                                        <div class="bi-prod-limits">
                                            @InvL["MinimumStock"] @item.MinimumStock
                                            <span class="bi-dot">·</span>
                                            @InvL["MaximumStock"] @(item.MaximumStock?.ToString() ?? "—")
                                        </div>
                                        <div class="bi-prod-restock">
                                            @InvL["LastRestocked"]: @(item.LastRestockedDate?.ToLocalTime().ToString("MMM d") ?? "—")
                                        </div>

                                        <SoftDivider Class="bi-prod-div" />

                                        <div class="bi-prod-actions">@RowActions(item)</div>
                                    </div>
                                }
                            </div>

                            @if (_cardTotal > _cardItems.Count)
                            {
                                <div class="bi-prod-more">
                                    @string.Format(InvL["ShowingOfTotal"], _cardItems.Count, _cardTotal)
                                </div>
                            }
                        }
                    }
                </SoftCardContent>
            </SoftCard>
        </section>
    }
</SoftStack>

@if (_adjustVisible && _adjustTarget != null)
{
    <div class="glass-modal-backdrop" @onclick="CloseAdjust">
        <div class="glass-modal-container" @onclick:stopPropagation="true">
            <SoftCard Elevation="24" Class="glass-modal">
                <SoftCardHeader Class="pa-4">
                    <CardHeaderContent>
                        <SoftStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <SoftIcon Icon="@Icons.Material.Filled.SwapVert" Color="Color.Primary" Size="Size.Medium" />
                            <div>
                                <SoftText Typo="Typo.h6">@InvL["AdjustStock"]</SoftText>
                                <SoftText Typo="Typo.caption" Color="Color.Default">
                                    @_adjustTarget.ProductSKU • @_adjustTarget.ProductName
                                </SoftText>
                            </div>
                        </SoftStack>
                    </CardHeaderContent>
                    <CardHeaderActions>
                        <SoftIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="CloseAdjust" />
                    </CardHeaderActions>
                </SoftCardHeader>
                <SoftDivider />
                <SoftCardContent Class="pa-4">
                    <SoftStack Spacing="3">
                        <div class="bi-current-qty">
                            <SoftText Typo="Typo.caption" Color="Color.Default">@InvL["QuantityOnHand"]</SoftText>
                            <SoftText Typo="Typo.h4">
                                @_adjustTarget.QuantityOnHand <span style="font-size:0.6em; opacity:0.7;">@_adjustTarget.ProductUnit</span>
                            </SoftText>
                        </div>

                        <SoftNumericField T="int"
                                          Label="@InvL["NewQuantity"]"
                                          @bind-Value="_adjustNewQty"
                                          Variant="Variant.Outlined"
                                          Min="0" />

                        @{
                            var delta = _adjustNewQty - _adjustTarget.QuantityOnHand;
                            var deltaColor = delta > 0 ? Color.Success : (delta < 0 ? Color.Error : Color.Default);
                            var deltaSign = delta > 0 ? "+" : "";
                        }
                        <SoftStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <SoftText Typo="Typo.caption">@InvL["Delta"]:</SoftText>
                            <SoftChip T="string" Color="@deltaColor" Variant="Variant.Filled" Size="Size.Small">
                                @deltaSign@delta
                            </SoftChip>
                        </SoftStack>

                        <SoftLookupSelect TItem="MovementOption" TValue="string"
                                          Items="_movementOptions"
                                          ToValue="@(o => o.Value)"
                                          ToLabel="@(o => o.Label)"
                                          Value="_adjustMovementType"
                                          ValueChanged="@(v => _adjustMovementType = v ?? StockMovementTypes.ManualAdjustment)"
                                          Label="@InvL["MovementType"]" />

                        @if (delta > 0)
                        {
                            <SoftDatePicker Label="@InvL["ProductionDate"]"
                                            Date="_adjustProductionDate"
                                            DateChanged="@(d => _adjustProductionDate = d)"
                                            MaxDate="DateTime.Today"
                                            Variant="Variant.Outlined"
                                            Margin="Margin.Dense"
                                            HelperText="@InvL["ProductionDateHint"]" />
                        }

                        <SoftTextField T="string"
                                       Label="@InvL["Notes"]"
                                       @bind-Value="_adjustNotes"
                                       Variant="Variant.Outlined"
                                       Lines="2"
                                       MaxLength="512" />
                    </SoftStack>
                </SoftCardContent>
                <SoftDivider />
                <div class="pa-3 d-flex justify-end" style="gap: 8px;">
                    <SoftButton Variant="Variant.Text" OnClick="CloseAdjust">@L["Cancel"]</SoftButton>
                    <SoftButton Variant="Variant.Filled"
                                Color="Color.Primary"
                                StartIcon="@Icons.Material.Filled.Save"
                                OnClick="ConfirmAdjustAsync"
                                Disabled="_saving">
                        @L["Save"]
                    </SoftButton>
                </div>
            </SoftCard>
        </div>
    </div>
}

@if (_writeOffTarget != null)
{
    <div class="glass-modal-backdrop" @onclick="CancelWriteOffExpired">
        <div class="glass-modal-container glass-modal-container--sm" @onclick:stopPropagation="true">
            <SoftCard Elevation="24" Class="glass-modal">
                <SoftCardHeader Class="pa-4">
                    <CardHeaderContent>
                        <SoftStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <SoftIcon Icon="@Icons.Material.Filled.EventBusy" Color="Color.Error" Size="Size.Medium" />
                            <SoftText Typo="Typo.h6">@InvL["WriteOffExpired"]</SoftText>
                        </SoftStack>
                    </CardHeaderContent>
                </SoftCardHeader>
                <SoftDivider />
                <SoftCardContent Class="pa-4">
                    <SoftText Typo="Typo.body2">
                        @string.Format(InvL["WriteOffExpiredConfirm"], _writeOffTarget.ExpiredQuantity, _writeOffTarget.ProductName)
                    </SoftText>
                </SoftCardContent>
                <SoftDivider />
                <div class="pa-3 d-flex justify-end" style="gap: 8px;">
                    <SoftButton Variant="Variant.Text" OnClick="CancelWriteOffExpired">@L["Cancel"]</SoftButton>
                    <SoftButton Variant="Variant.Filled" Color="Color.Error"
                                StartIcon="@Icons.Material.Filled.DeleteSweep"
                                OnClick="ConfirmWriteOffExpiredAsync" Disabled="_saving">
                        @InvL["WriteOffExpired"]
                    </SoftButton>
                </div>
            </SoftCard>
        </div>
    </div>
}

@if (_initVisible && _branchId.HasValue)
{
    <div class="glass-modal-backdrop" @onclick="CloseInitialize">
        <div class="glass-modal-container" @onclick:stopPropagation="true">
            <SoftCard Elevation="24" Class="glass-modal">
                <SoftCardHeader Class="pa-4">
                    <CardHeaderContent>
                        <SoftStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <SoftIcon Icon="@Icons.Material.Filled.AddBox" Color="Color.Primary" Size="Size.Medium" />
                            <SoftText Typo="Typo.h6">@InvL["InitializeProduct"]</SoftText>
                        </SoftStack>
                    </CardHeaderContent>
                    <CardHeaderActions>
                        <SoftIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="CloseInitialize" />
                    </CardHeaderActions>
                </SoftCardHeader>
                <SoftDivider />
                <SoftCardContent Class="pa-4">
                    <SoftStack Spacing="3">
                        <SoftLookupSelect TItem="ProductLookupDto" TValue="Guid?"
                                          Items="_availableProducts"
                                          ToValue="@(p => (Guid?)p.Id)"
                                          ToLabel="@(p => $"{p.SKU} — {p.Name}")"
                                          Value="_initProductId"
                                          ValueChanged="@(v => _initProductId = v)"
                                          Label="@InvL["Product"]"
                                          Required="true" />
                        <SoftStack Row="true" Spacing="2">
                            <SoftNumericField T="int" Label="@InvL["InitialQuantity"]"
                                              @bind-Value="_initQty"
                                              Variant="Variant.Outlined" Min="0" />
                            <SoftNumericField T="int" Label="@InvL["MinimumStock"]"
                                              @bind-Value="_initMin"
                                              Variant="Variant.Outlined" Min="0" />
                            <SoftNumericField T="int?" Label="@InvL["MaximumStock"]"
                                              @bind-Value="_initMax"
                                              Variant="Variant.Outlined" Min="0" Clearable="true" />
                        </SoftStack>
                    </SoftStack>
                </SoftCardContent>
                <SoftDivider />
                <div class="pa-3 d-flex justify-end" style="gap: 8px;">
                    <SoftButton Variant="Variant.Text" OnClick="CloseInitialize">@L["Cancel"]</SoftButton>
                    <SoftButton Variant="Variant.Filled" Color="Color.Primary"
                                StartIcon="@Icons.Material.Filled.Save"
                                OnClick="ConfirmInitializeAsync"
                                Disabled="_saving">
                        @L["Save"]
                    </SoftButton>
                </div>
            </SoftCard>
        </div>
    </div>
}

@if (_limitsVisible && _limitsTarget != null)
{
    <div class="glass-modal-backdrop" @onclick="CloseLimits">
        <div class="glass-modal-container glass-modal-container--sm" @onclick:stopPropagation="true">
            <SoftCard Elevation="24" Class="glass-modal">
                <SoftCardHeader Class="pa-4">
                    <CardHeaderContent>
                        <SoftStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <SoftIcon Icon="@Icons.Material.Filled.Tune" Color="Color.Primary" Size="Size.Medium" />
                            <SoftText Typo="Typo.h6">@InvL["EditLimits"]</SoftText>
                        </SoftStack>
                    </CardHeaderContent>
                    <CardHeaderActions>
                        <SoftIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="CloseLimits" />
                    </CardHeaderActions>
                </SoftCardHeader>
                <SoftDivider />
                <SoftCardContent Class="pa-4">
                    <SoftStack Spacing="3">
                        <SoftText Typo="Typo.caption" Color="Color.Default">
                            @_limitsTarget.ProductSKU • @_limitsTarget.ProductName
                        </SoftText>
                        <SoftNumericField T="int" Label="@InvL["MinimumStock"]"
                                          @bind-Value="_limitsMin"
                                          Variant="Variant.Outlined" Min="0" />
                        <SoftNumericField T="int?" Label="@InvL["MaximumStock"]"
                                          @bind-Value="_limitsMax"
                                          Variant="Variant.Outlined" Min="0" Clearable="true" />
                    </SoftStack>
                </SoftCardContent>
                <SoftDivider />
                <div class="pa-3 d-flex justify-end" style="gap: 8px;">
                    <SoftButton Variant="Variant.Text" OnClick="CloseLimits">@L["Cancel"]</SoftButton>
                    <SoftButton Variant="Variant.Filled" Color="Color.Primary"
                                StartIcon="@Icons.Material.Filled.Save"
                                OnClick="ConfirmLimitsAsync"
                                Disabled="_saving">
                        @L["Save"]
                    </SoftButton>
                </div>
            </SoftCard>
        </div>
    </div>
}

<style>
    /* ── 1. Compact header (≤60px) ───────────────────────────────────── */
    .bi-head {
        display: flex;
        align-items: center;
        gap: 16px;
        min-height: 44px;
        max-height: 60px;
        padding: 6px 4px;
    }
    .bi-head-left {
        display: flex;
        align-items: center;
        gap: 6px;
        min-width: 0;
    }
    .bi-branch-name {
        font-family: var(--font-serif);
        font-size: 1.05rem;
        font-weight: 600;
        color: var(--fg-1);
        white-space: nowrap;
    }
    .bi-branch-select { min-width: 220px; }
    .bi-stats-strip {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-left: auto;
        font-size: 0.82rem;
        color: var(--fg-3);
        white-space: nowrap;
        font-variant-numeric: tabular-nums;
    }
    .bi-stats-strip strong { color: var(--fg-1); font-weight: 600; }
    .bi-dot { opacity: 0.4; }
    .bi-strip-ok strong     { color: var(--green-text, var(--success)); }
    .bi-strip-warn          { color: var(--amber-text, var(--warn)); }
    .bi-strip-warn strong   { color: var(--amber-text, var(--warn)); }
    .bi-strip-danger        { color: var(--danger); }
    .bi-strip-danger strong { color: var(--danger); }
    .bi-head-actions {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    /* ── 2. Pending-decisions banner ─────────────────────────────────── */
    .bi-decisions-banner {
        display: flex;
        align-items: center;
        gap: 12px;
        max-height: 48px;
        padding: 8px 14px;
        background: var(--surface);
        border: 1px solid var(--bd-1);
        border-left: 3px solid var(--warn);
        border-radius: var(--r-md);
    }
    .bi-banner-icon { color: var(--amber-text, var(--warn)); }
    .bi-banner-text {
        font-size: 0.9rem;
        color: var(--fg-2);
    }
    .bi-banner-text strong {
        color: var(--fg-1);
        font-variant-numeric: tabular-nums;
    }
    .bi-decisions-banner .mud-button-root { margin-left: auto; }

    /* ── Sections ────────────────────────────────────────────────────── */
    .bi-section { display: flex; flex-direction: column; gap: 12px; }
    .bi-section-head {
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .bi-section-head--spread { justify-content: space-between; }
    .bi-section-title {
        font-family: var(--font-serif);
        font-size: 1.15rem;
        font-weight: 600;
        color: var(--fg-1);
        margin: 0;
    }
    .bi-view-toggle {
        display: flex;
        align-items: center;
        gap: 2px;
        padding: 2px;
        background: var(--bg-2);
        border: 1px solid var(--bd-1);
        border-radius: var(--r-sm);
    }
    .bi-view-toggle .bi-view-active {
        background: var(--accent-soft);
    }

    /* ── 3a. Table row tints ─────────────────────────────────────────── */
    .bi-current-qty {
        background: var(--bg-2);
        border: 1px solid var(--bd-1);
        border-radius: var(--r-sm);
        padding: 12px 16px;
        text-align: center;
        color: var(--fg-1);
    }

    ::deep tr.row-low-stock { background: rgba(200, 156, 79, 0.10); }
    ::deep tr.row-low-stock:hover { background: rgba(200, 156, 79, 0.18) !important; }
    ::deep tr.row-out-of-stock { background: rgba(179, 84, 58, 0.12); }
    ::deep tr.row-out-of-stock:hover { background: rgba(179, 84, 58, 0.20) !important; }
    ::deep tr.row-inactive { opacity: 0.55; }

    /* ── 3b. Card view ───────────────────────────────────────────────── */
    .bi-prod-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 14px;
        padding-top: 4px;
    }
    .bi-prod-card {
        display: flex;
        flex-direction: column;
        gap: 6px;
        padding: 14px 16px;
        background: var(--surface);
        border: 1px solid var(--bd-1);
        border-radius: var(--r-md);
        transition: box-shadow .15s;
    }
    .bi-prod-card:hover { box-shadow: var(--shadow-sm); }
    .bi-prod-inactive { opacity: 0.55; }
    .bi-prod-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
    }
    .bi-prod-sku {
        font-family: var(--font-mono);
        font-size: 0.78rem;
        color: var(--fg-3);
    }
    .bi-prod-unit {
        font-size: 0.68rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.03em;
        color: var(--fg-2);
        background: var(--hover);
        padding: 2px 8px;
        border-radius: 999px;
    }
    .bi-prod-name {
        font-weight: 600;
        font-size: 0.95rem;
        color: var(--fg-1);
        line-height: 1.3;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        min-height: 2.5em;
    }
    .bi-prod-div { margin: 4px 0; }
    .bi-prod-onhand-label {
        font-size: 0.72rem;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: var(--fg-3);
    }
    .bi-prod-onhand-val {
        font-size: 0.95rem;
        font-weight: 700;
        color: var(--fg-1);
        font-variant-numeric: tabular-nums;
        min-width: 2.5em;
        text-align: right;
    }
    .bi-prod-limits {
        font-size: 0.8rem;
        color: var(--fg-2);
        font-variant-numeric: tabular-nums;
    }
    .bi-prod-restock { font-size: 0.78rem; color: var(--fg-3); }
    .bi-prod-actions { display: flex; justify-content: flex-end; }
    .bi-prod-more {
        text-align: center;
        font-size: 0.8rem;
        color: var(--fg-3);
        padding: 12px 0 4px;
    }

    /* shared stock bar */
    .bi-bar-wrap { display: flex; align-items: center; gap: 8px; }
    .bi-bar {
        flex: 1;
        height: 8px;
        border-radius: 999px;
        background: var(--hover);
        overflow: hidden;
    }
    .bi-bar-fill { height: 100%; border-radius: 999px; transition: width .25s; }
    .bi-bar-critical { background: var(--danger); }
    .bi-bar-warning  { background: var(--warn); }
    .bi-bar-ok       { background: var(--success); }

    @@media (max-width: 1100px) {
        .bi-prod-grid { grid-template-columns: repeat(2, 1fr); }
    }
    @@media (max-width: 720px) {
        .bi-head { flex-wrap: wrap; max-height: none; }
        .bi-stats-strip { margin-left: 0; flex-wrap: wrap; }
        .bi-prod-grid { grid-template-columns: 1fr; }
    }
</style>

@code {
    private const string ViewTable = "table";
    private const string ViewCard = "card";
    private const string ViewStorageKey = "bi-viewmode";
    private const int CardFetchLimit = 200;

    private SoftDataGrid<BranchInventoryDto> _grid = null!;
    private bool _loading;
    private bool _saving;

    private List<BranchLookupDto> _accessibleBranches = new();
    private Guid? _branchId;
    private string _currentBranchName = string.Empty;

    private string? _filter;
    private bool _includeInactive;
    private bool _onlyLowStock;
    private bool _showLimits;

    private string _viewMode = ViewTable;
    private List<BranchInventoryDto> _cardItems = new();
    private int _cardTotal;

    private BranchInventoryStatsDto _stats = new();
    private int _pendingDecisionCount;

    private bool _canAdjust;
    private bool _canInitialize;
    private bool _canSetLimits;
    private bool _canViewDecisions;

    private bool _adjustVisible;
    private BranchInventoryDto? _adjustTarget;
    private int _adjustNewQty;
    private string _adjustMovementType = StockMovementTypes.ManualAdjustment;
    private string? _adjustNotes;
    private DateTime? _adjustProductionDate;

    /// <summary>Non-null shows the "write off expired" confirm dialog for this row.</summary>
    private BranchInventoryDto? _writeOffTarget;

    private bool _initVisible;
    private List<ProductLookupDto> _availableProducts = new();
    private Guid? _initProductId;
    private int _initQty;
    private int _initMin = 5;
    private int? _initMax;

    // Shop-wide default minimum-stock level pre-filled on Initialize, from settings.
    private int _defaultMinStock = 5;

    private bool _limitsVisible;
    private BranchInventoryDto? _limitsTarget;
    private int _limitsMin;
    private int? _limitsMax;

    private List<MovementOption> _movementOptions = new();

    public record MovementOption(string Value, string Label);

    /// <summary>Kebab action menu, shared by the table rows and the product cards.</summary>
    private RenderFragment<BranchInventoryDto> RowActions => item =>
        @<SoftMenu Icon="@Icons.Material.Filled.MoreVert"
                   Size="Size.Small"
                   Dense="true"
                   AnchorOrigin="Origin.BottomRight"
                   TransformOrigin="Origin.TopRight">
            @if (_canAdjust)
            {
                <SoftMenuItem Icon="@Icons.Material.Filled.SwapVert" OnClick="() => OpenAdjustDialog(item)">
                    @InvL["AdjustStock"]
                </SoftMenuItem>
                @if (item.HasExpiredStock)
                {
                    <SoftMenuItem Icon="@Icons.Material.Filled.EventBusy"
                                  OnClick="() => AskWriteOffExpired(item)">
                        @InvL["WriteOffExpired"]
                    </SoftMenuItem>
                }
            }
            @if (_canSetLimits)
            {
                <SoftMenuItem Icon="@Icons.Material.Filled.Tune" OnClick="() => OpenLimitsDialog(item)">
                    @InvL["EditLimits"]
                </SoftMenuItem>
            }
            <SoftMenuItem Icon="@Icons.Material.Filled.History" OnClick="GoToMovements">
                @InvL["ViewMovementHistory"]
            </SoftMenuItem>
            <SoftMenuItem Icon="@Icons.Material.Filled.SwapHoriz" OnClick="GoToTransfers">
                @InvL["RequestTransfer"]
            </SoftMenuItem>
            <SoftMenuItem Icon="@Icons.Material.Filled.Inventory2" OnClick="GoToProducts">
                @InvL["ViewProductDetails"]
            </SoftMenuItem>
        </SoftMenu>;

    /// <summary>Deep-link (e.g. from the manager dashboard): pre-select this branch.</summary>
    [Parameter, SupplyParameterFromQuery(Name = "branchId")]
    public Guid? BranchIdParam { get; set; }

    /// <summary>Deep-link: open the page pre-filtered to low-stock rows.</summary>
    [Parameter, SupplyParameterFromQuery(Name = "low")]
    public bool LowStockParam { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _onlyLowStock = LowStockParam;
        _canAdjust = await AuthorizationService.IsGrantedAsync(InventoryPermissions.BranchInventory.Adjust);
        _canInitialize = await AuthorizationService.IsGrantedAsync(InventoryPermissions.BranchInventory.Initialize);
        _canSetLimits = await AuthorizationService.IsGrantedAsync(InventoryPermissions.BranchInventory.SetLimits);
        _canViewDecisions = await AuthorizationService.IsGrantedAsync(IntelligencePermissions.DecisionLogs.Default);

        _movementOptions = new List<MovementOption>
        {
            new(StockMovementTypes.Purchase, InvL["MovementType:Purchase"]),
            new(StockMovementTypes.Sale, InvL["MovementType:Sale"]),
            new(StockMovementTypes.TransferIn, InvL["MovementType:TransferIn"]),
            new(StockMovementTypes.TransferOut, InvL["MovementType:TransferOut"]),
            new(StockMovementTypes.ManualAdjustment, InvL["MovementType:ManualAdjustment"]),
        };

        // Shop-wide default minimum-stock level for the Initialize dialog (falls back to 5).
        try
        {
            _defaultMinStock = await SettingProvider.GetAsync<int>("patisserie_shop.Operations.DefaultMinimumStock", 5);
        }
        catch
        {
            _defaultMinStock = 5;
        }

        try
        {
            var ids = await InventoryAppService.GetAccessibleBranchIdsAsync();
            if (ids.Count > 0)
            {
                var all = await BranchAppService.GetLookupAsync();
                _accessibleBranches = all.Where(b => ids.Contains(b.Id)).ToList();

                // Deep-linked branch wins when accessible; otherwise branch managers
                // normally have exactly one branch — auto-select it.
                if (BranchIdParam is Guid linked && _accessibleBranches.Any(b => b.Id == linked))
                {
                    await SelectBranchAsync(linked);
                }
                else if (_accessibleBranches.Count > 0)
                {
                    await SelectBranchAsync(_accessibleBranches[0].Id);
                }
            }
        }
        catch (Exception ex)
        {
            await HandleErrorAsync(ex);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            var saved = await JS.InvokeAsync<string?>("localStorage.getItem", ViewStorageKey);
            if (saved == ViewCard && _viewMode != ViewCard)
            {
                _viewMode = ViewCard;
                if (_branchId.HasValue) await LoadCardItemsAsync();
                StateHasChanged();
            }
        }
        catch
        {
            // localStorage unavailable (e.g. prerender) — keep the default table view.
        }
    }

    private async Task OnBranchChangedAsync(Guid? branchId)
    {
        if (branchId.HasValue)
        {
            await SelectBranchAsync(branchId.Value);
        }
        else
        {
            _branchId = null;
        }
    }

    private async Task SelectBranchAsync(Guid branchId)
    {
        _branchId = branchId;
        _currentBranchName = _accessibleBranches.FirstOrDefault(b => b.Id == branchId)?.Name ?? string.Empty;
        _filter = null;
        await RefreshStatsAsync();
        await LoadPendingDecisionCountAsync();
        await ReloadCurrentViewAsync();
    }

    private async Task RefreshStatsAsync()
    {
        if (!_branchId.HasValue) return;
        try
        {
            _stats = await InventoryAppService.GetStatsAsync(_branchId.Value);
        }
        catch (Exception ex)
        {
            await HandleErrorAsync(ex);
        }
    }

    /// <summary>
    /// Counts pending decision logs for this branch (only when the user may read them).
    /// Drives the banner. Acknowledged / Dismissed / Executed logs are excluded by the
    /// Status == Pending filter, so the count drops once a decision is resolved.
    /// </summary>
    private async Task LoadPendingDecisionCountAsync()
    {
        _pendingDecisionCount = 0;
        if (!_branchId.HasValue || !_canViewDecisions) return;
        try
        {
            var res = await DecisionLogAppService.GetListAsync(new GetDecisionLogsInput
            {
                BranchId = _branchId.Value,
                Status = DecisionLogStatuses.Pending,
                SkipCount = 0,
                MaxResultCount = 1
            });
            _pendingDecisionCount = (int)res.TotalCount;
        }
        catch (Exception ex)
        {
            await HandleErrorAsync(ex);
        }
    }

    private async Task<GridData<BranchInventoryDto>> LoadServerData(GridState<BranchInventoryDto> state, CancellationToken cancellationToken)
    {
        if (!_branchId.HasValue)
        {
            return new GridData<BranchInventoryDto> { Items = Array.Empty<BranchInventoryDto>(), TotalItems = 0 };
        }

        _loading = true;
        try
        {
            string? sorting = null;
            var sort = state.SortDefinitions.FirstOrDefault();
            if (sort != null)
            {
                sorting = $"{sort.SortBy} {(sort.Descending ? "desc" : "asc")}";
            }

            var result = await InventoryAppService.GetListAsync(new GetBranchInventoryInput
            {
                BranchId = _branchId.Value,
                Filter = _filter,
                OnlyLowStock = _onlyLowStock ? true : (bool?)null,
                IncludeInactiveProducts = _includeInactive ? true : (bool?)null,
                SkipCount = state.Page * state.PageSize,
                MaxResultCount = state.PageSize,
                Sorting = sorting
            });

            return new GridData<BranchInventoryDto>
            {
                Items = result.Items,
                TotalItems = (int)result.TotalCount
            };
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadCardItemsAsync()
    {
        if (!_branchId.HasValue) return;
        _loading = true;
        try
        {
            var result = await InventoryAppService.GetListAsync(new GetBranchInventoryInput
            {
                BranchId = _branchId.Value,
                Filter = _filter,
                OnlyLowStock = _onlyLowStock ? true : (bool?)null,
                IncludeInactiveProducts = _includeInactive ? true : (bool?)null,
                SkipCount = 0,
                MaxResultCount = CardFetchLimit,
                Sorting = "ProductName asc"
            });
            _cardItems = result.Items.ToList();
            _cardTotal = (int)result.TotalCount;
        }
        catch (Exception ex)
        {
            await HandleErrorAsync(ex);
        }
        finally
        {
            _loading = false;
        }
    }

    private string RowClassFunc(BranchInventoryDto row, int index)
    {
        if (!row.ProductIsActive) return "row-inactive";
        if (row.IsOutOfStock) return "row-out-of-stock";
        if (row.IsLowStock) return "row-low-stock";
        return string.Empty;
    }

    private static int CardBarPercent(BranchInventoryDto r)
    {
        var denom = r.MaximumStock.HasValue && r.MaximumStock.Value > 0
            ? r.MaximumStock.Value
            : Math.Max(1, r.MinimumStock * 3);
        var pct = (int)Math.Round((double)r.QuantityOnHand / denom * 100);
        return Math.Clamp(pct, 0, 100);
    }

    private static string CardBarClass(BranchInventoryDto r)
    {
        if (r.QuantityOnHand < r.MinimumStock) return "bi-bar-critical";
        if (r.QuantityOnHand < r.MinimumStock * 1.5) return "bi-bar-warning";
        return "bi-bar-ok";
    }

    private async Task OnFilterKeyUpAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await ReloadCurrentViewAsync();
    }

    private async Task OnOnlyLowStockChangedAsync(bool value)
    {
        _onlyLowStock = value;
        await ReloadCurrentViewAsync();
    }

    private async Task OnIncludeInactiveChangedAsync(bool value)
    {
        _includeInactive = value;
        await ReloadCurrentViewAsync();
    }

    private async Task SetViewAsync(string mode)
    {
        if (_viewMode == mode) return;
        _viewMode = mode;
        try { await JS.InvokeVoidAsync("localStorage.setItem", ViewStorageKey, mode); } catch { }
        await ReloadCurrentViewAsync();
    }

    private async Task GoToDecisionLog() => Nav.NavigateTo("/intelligence/decision-log");
    private void GoToTransfers() => Nav.NavigateTo("/operations/stock-transfers");
    private void GoToMovements() => Nav.NavigateTo("/inventory/stock-movements");
    private void GoToProductStory(BranchInventoryDto item)
        => Nav.NavigateTo($"/inventory/product-story?productId={item.ProductId}&branchId={_branchId}");
    private void GoToProducts() => Nav.NavigateTo("/inventory/products");

    /// <summary>Full refresh: stats, banner, and the active view.</summary>
    private async Task ReloadAsync()
    {
        await RefreshStatsAsync();
        await LoadPendingDecisionCountAsync();
        await ReloadCurrentViewAsync();
    }

    /// <summary>Reload whichever view is active (table grid or card list).</summary>
    private async Task ReloadCurrentViewAsync()
    {
        if (_viewMode == ViewCard)
        {
            await LoadCardItemsAsync();
        }
        else if (_grid != null)
        {
            await _grid.ReloadServerData();
        }
    }

    private void OpenAdjustDialog(BranchInventoryDto row)
    {
        _adjustTarget = row;
        _adjustNewQty = row.QuantityOnHand;
        _adjustMovementType = StockMovementTypes.ManualAdjustment;
        _adjustNotes = null;
        _adjustProductionDate = DateTime.Today;
        _adjustVisible = true;
    }

    private void CloseAdjust() => _adjustVisible = false;

    private async Task ConfirmAdjustAsync()
    {
        if (_adjustTarget == null) return;
        _saving = true;
        try
        {
            await InventoryAppService.AdjustStockAsync(_adjustTarget.Id, new AdjustStockDto
            {
                NewQuantity = _adjustNewQty,
                MovementType = _adjustMovementType,
                Notes = _adjustNotes,
                ProductionDate = _adjustNewQty > _adjustTarget.QuantityOnHand ? _adjustProductionDate : null,
                ConcurrencyStamp = _adjustTarget.ConcurrencyStamp
            });
            Snackbar.Add(L["SuccessfullySaved"], Severity.Success);
            _adjustVisible = false;
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            await HandleErrorAsync(ex);
        }
        finally
        {
            _saving = false;
        }
    }

    private void AskWriteOffExpired(BranchInventoryDto row)
    {
        _writeOffTarget = row;
    }

    private void CancelWriteOffExpired() => _writeOffTarget = null;

    private async Task ConfirmWriteOffExpiredAsync()
    {
        if (_writeOffTarget == null) return;
        _saving = true;
        try
        {
            await InventoryAppService.WriteOffExpiredAsync(_writeOffTarget.Id);
            Snackbar.Add(InvL["WriteOffExpiredDone"], Severity.Success);
            _writeOffTarget = null;
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            await HandleErrorAsync(ex);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task OpenInitializeDialog()
    {
        _initProductId = null;
        _initQty = 0;
        _initMin = _defaultMinStock;
        _initMax = null;
        try
        {
            _availableProducts = await ProductAppService.GetLookupAsync();
        }
        catch (Exception ex)
        {
            await HandleErrorAsync(ex);
        }
        _initVisible = true;
    }

    private void CloseInitialize() => _initVisible = false;

    private async Task ConfirmInitializeAsync()
    {
        if (!_branchId.HasValue || !_initProductId.HasValue)
        {
            Snackbar.Add(L["ThisFieldIsRequired", InvL["Product"]], Severity.Warning);
            return;
        }
        _saving = true;
        try
        {
            await InventoryAppService.InitializeAsync(new InitializeBranchInventoryDto
            {
                BranchId = _branchId.Value,
                ProductId = _initProductId.Value,
                InitialQuantity = _initQty,
                MinimumStock = _initMin,
                MaximumStock = _initMax
            });
            Snackbar.Add(L["SuccessfullySaved"], Severity.Success);
            _initVisible = false;
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            await HandleErrorAsync(ex);
        }
        finally
        {
            _saving = false;
        }
    }

    private void OpenLimitsDialog(BranchInventoryDto row)
    {
        _limitsTarget = row;
        _limitsMin = row.MinimumStock;
        _limitsMax = row.MaximumStock;
        _limitsVisible = true;
    }

    private void CloseLimits() => _limitsVisible = false;

    private async Task ConfirmLimitsAsync()
    {
        if (_limitsTarget == null) return;
        _saving = true;
        try
        {
            await InventoryAppService.UpdateLimitsAsync(_limitsTarget.Id, new UpdateStockLimitsDto
            {
                MinimumStock = _limitsMin,
                MaximumStock = _limitsMax,
                ConcurrencyStamp = _limitsTarget.ConcurrencyStamp
            });
            Snackbar.Add(L["SuccessfullySaved"], Severity.Success);
            _limitsVisible = false;
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            await HandleErrorAsync(ex);
        }
        finally
        {
            _saving = false;
        }
    }
}
