@using System.Threading
@using System.Threading.Tasks
@using Microsoft.AspNetCore.Components
@using Operations
@using Operations.StockTransfers
@using Operations.Permissions
@using Operations.Localization
@using Inventory
@using Inventory.Branches
@using Inventory.BranchInventory
@using Volo.Abp
@using Color = MudBlazor.Color
@using Variant = MudBlazor.Variant
@using Size = MudBlazor.Size
@using Margin = MudBlazor.Margin
@inherits patisserie_shopComponentBase
@inject IStockTransferAppService StockTransferAppService
@inject IBranchAppService BranchAppService
@inject IBranchInventoryAppService BranchInventoryAppService
@inject ISnackbar Snackbar
@inject IStringLocalizer<OperationsResource> OpsL

@if (_transfer == null)
{
    return;
}

<div class="soft-modal-backdrop" @onclick="CloseAsync">
    <div class="soft-modal-container soft-modal-container--xl" @onclick:stopPropagation="true">
        <SoftCard Elevation="24" Class="soft-modal-card">

            <SoftCardHeader Class="pa-4">
                <CardHeaderContent>
                    <SoftStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <SoftIcon Icon="@Icons.Material.Filled.SwapHoriz" Color="Color.Primary" Size="Size.Medium" />
                        <div>
                            <SoftStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <SoftText Typo="Typo.h6">@_transfer.Reference</SoftText>
                                <div class="@($"sts-status sts-status-{_transfer.Status.ToLower()}")">
                                    <MudIcon Icon="@StatusIcon(_transfer.Status)" Size="Size.Small" />
                                    <span>@OpsL[$"Status:{_transfer.Status}"]</span>
                                </div>
                            </SoftStack>
                            <SoftStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                <SoftText Typo="Typo.caption" Color="Color.Default">@_transfer.FromBranchName</SoftText>
                                <MudIcon Icon="@Icons.Material.Filled.ArrowRightAlt" Size="Size.Small" />
                                <SoftText Typo="Typo.caption" Color="Color.Default">@_transfer.ToBranchName</SoftText>
                            </SoftStack>
                        </div>
                    </SoftStack>
                </CardHeaderContent>
                <CardHeaderActions>
                    <SoftIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="CloseAsync" />
                </CardHeaderActions>
            </SoftCardHeader>
            <SoftDivider />

            <SoftCardContent Class="pa-4 sts-modal-body">
                <SoftStack Spacing="4">

                    @if (IsClosed)
                    {
                        <!-- Terminal closure — replaces the stepper -->
                        <div class="sts-closed-banner">
                            <MudIcon Icon="@(_transfer.Status == StockTransferStatuses.Rejected ? Icons.Material.Filled.Block : Icons.Material.Filled.Cancel)"
                                     Size="Size.Medium" />
                            <div>
                                <div class="sts-closed-title">
                                    @(_transfer.Status == StockTransferStatuses.Rejected ? OpsL["Hint:Rejected"] : OpsL["Hint:Cancelled"])
                                    @if (!string.IsNullOrWhiteSpace(_transfer.ClosedByUserName))
                                    {
                                        <span class="sts-closed-by"> — @OpsL["ClosedBy"]: @_transfer.ClosedByUserName</span>
                                    }
                                </div>
                                @if (!string.IsNullOrWhiteSpace(_transfer.ClosureReason))
                                {
                                    <div class="sts-closed-reason">"@_transfer.ClosureReason"</div>
                                }
                            </div>
                        </div>
                    }
                    else
                    {
                        <!-- Workflow stepper: Request → Approval → Ship → Receive -->
                        <div class="sts-stepper">
                            @for (var i = 0; i < StepKeys.Length; i++)
                            {
                                var stepIndex = i;
                                var state = StepState(stepIndex);
                                <div class="@($"sts-step sts-step-{state}")">
                                    <div class="sts-step-dot">
                                        @if (state == "done")
                                        {
                                            <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" />
                                        }
                                        else
                                        {
                                            <MudIcon Icon="@StepIcon(stepIndex)" Size="Size.Small" />
                                        }
                                    </div>
                                    <span class="sts-step-label">@OpsL[$"Step:{StepKeys[stepIndex]}"]</span>
                                </div>
                                @if (stepIndex < StepKeys.Length - 1)
                                {
                                    <div class="@($"sts-step-line {(stepIndex < CurrentStepIndex ? "sts-step-line-done" : "")}")"></div>
                                }
                            }
                        </div>

                        <!-- Who does what next -->
                        var hint = CurrentHint();
                        <div class="@(hint.Mine ? "sts-hint sts-hint-mine" : "sts-hint")">
                            <MudIcon Icon="@(hint.Mine ? Icons.Material.Filled.TouchApp : Icons.Material.Outlined.HourglassEmpty)"
                                     Size="Size.Small" />
                            <span>@hint.Text</span>
                        </div>
                    }

                    <!-- Transfer info -->
                    @{
                        var requestedText = _transfer.RequestedDate.ToString("MMM d, yyyy");
                        var approvedText  = _transfer.ApprovedDate?.ToString("MMM d, yyyy") ?? "-";
                        var shippedText   = _transfer.ShippedDate?.ToString("MMM d, yyyy") ?? "-";
                        var completedText = _transfer.CompletedDate?.ToString("MMM d, yyyy") ?? "-";
                        var requestedBy   = _transfer.RequestedByUserName ?? "-";
                        var approvedBy    = _transfer.ApprovedByUserName ?? "-";
                    }
                    <div>
                        <SoftText Typo="Typo.overline" Color="Color.Primary">@OpsL["TransferInfo"]</SoftText>
                        <SoftDivider Class="mb-3" />
                        <div class="sts-info-grid">
                            <InfoRow Label="@OpsL["RequestedDate"]" Value="@requestedText" />
                            <InfoRow Label="@OpsL["ApprovedDate"]" Value="@approvedText" />
                            <InfoRow Label="@OpsL["ShippedDate"]" Value="@shippedText" />
                            <InfoRow Label="@OpsL["CompletedDate"]" Value="@completedText" />
                            <InfoRow Label="@OpsL["RequestedBy"]" Value="@requestedBy" />
                            <InfoRow Label="@OpsL["ApprovedBy"]" Value="@approvedBy" />
                        </div>
                        @if (!string.IsNullOrWhiteSpace(_transfer.Notes))
                        {
                            <div class="sts-notes">
                                <SoftText Typo="Typo.caption" Color="Color.Default">@OpsL["Notes"]</SoftText>
                                <SoftText Typo="Typo.body2">@_transfer.Notes</SoftText>
                            </div>
                        }
                    </div>

                    @if (_transfer.Status == StockTransferStatuses.Pending && _canApprove && !_transfer.FromBranchId.HasValue)
                    {
                        <div class="sts-source-assign">
                            <SoftText Typo="Typo.overline" Color="Color.Primary">@OpsL["AssignSourceBranch"]</SoftText>
                            <SoftText Typo="Typo.caption" Color="Color.Default">@OpsL["ChooseSourceBranchHint"]</SoftText>
                            <SoftLookupSelect TItem="BranchLookupDto" TValue="Guid?"
                                              Items="AvailableSourceBranches"
                                              ToValue="@(b => (Guid?)b.Id)"
                                              ToLabel="@(b => b.Name)"
                                              Value="_sourceBranchId"
                                              ValueChanged="@(v => _sourceBranchId = v)"
                                              Label="@OpsL["FromBranch"]"
                                              Required="true" />
                        </div>
                    }

                    <!-- Items -->
                    <div>
                        <SoftStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                            <SoftText Typo="Typo.overline" Color="Color.Primary">@OpsL["Items"] (@_transfer.Items.Count)</SoftText>
                            @if (_transfer.Status == StockTransferStatuses.Draft && CanEditCurrentRequest)
                            {
                                <SoftButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                                            StartIcon="@Icons.Material.Filled.Add"
                                            OnClick="OpenAddItem">@OpsL["AddProduct"]</SoftButton>
                            }
                        </SoftStack>
                        <SoftDivider Class="mb-3" />

                        @if (_transfer.Items.Count == 0)
                        {
                            <SoftStack AlignItems="AlignItems.Center" Spacing="1" Class="pa-4">
                                <SoftIcon Icon="@Icons.Material.Outlined.Inbox" Style="font-size:42px; opacity:0.4;" />
                                <SoftText Typo="Typo.body2" Color="Color.Default">@OpsL["NoItemsYet"]</SoftText>
                            </SoftStack>
                        }
                        else
                        {
                            <MudTable T="StockTransferItemDto" Items="@_transfer.Items" Dense="true" Hover="true" Bordered="false" Striped="true">
                                <HeaderContent>
                                    <MudTh>@OpsL["Product"]</MudTh>
                                    <MudTh Style="text-align:right;">@OpsL["RequestedQuantity"]</MudTh>
                                    <MudTh Style="text-align:center;">@OpsL["ApprovedQuantity"]</MudTh>
                                    <MudTh Style="text-align:right;">@OpsL["TransferredQuantity"]</MudTh>
                                    <MudTh></MudTh>
                                </HeaderContent>
                                <RowTemplate Context="item">
                                    <MudTd>
                                        <SoftStack Spacing="0">
                                            <SoftText Typo="Typo.body2" Style="font-weight:500;">@item.ProductName</SoftText>
                                            <SoftText Typo="Typo.caption" Color="Color.Default">@item.ProductSKU</SoftText>
                                        </SoftStack>
                                    </MudTd>
                                    <MudTd Style="text-align:right;">@item.RequestedQuantity @item.ProductUnit</MudTd>
                                    <MudTd Style="text-align:center;">
                                        @if (CanAdjustQuantities)
                                        {
                                            <SoftStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Justify="Justify.Center">
                                                <SoftNumericField T="int" Value="@GetApprovedEdit(item)"
                                                                  ValueChanged="@(v => _approvedEdits[item.Id] = v)"
                                                                  Variant="Variant.Outlined" Min="0"
                                                                  Margin="Margin.Dense"
                                                                  Style="max-width: 90px;" />
                                                <SoftIconButton Icon="@Icons.Material.Filled.Check"
                                                                Color="Color.Success" Size="Size.Small"
                                                                OnClick="@(() => SaveApprovedAsync(item))" />
                                            </SoftStack>
                                        }
                                        else if (item.ApprovedQuantity.HasValue)
                                        {
                                            <SoftChip T="string"
                                                      Color="@(item.ApprovedQuantity == item.RequestedQuantity ? Color.Success : Color.Warning)"
                                                      Size="Size.Small"
                                                      Variant="Variant.Filled">
                                                @item.ApprovedQuantity
                                            </SoftChip>
                                        }
                                        else
                                        {
                                            <SoftText Color="Color.Default">-</SoftText>
                                        }
                                    </MudTd>
                                    <MudTd Style="text-align:right;">
                                        @(item.TransferredQuantity?.ToString() ?? "-")
                                    </MudTd>
                                    <MudTd>
                                        @if (_transfer.Status == StockTransferStatuses.Draft && CanEditCurrentRequest)
                                        {
                                            <SoftIconButton Icon="@Icons.Material.Filled.Delete"
                                                            Color="Color.Error"
                                                            Size="Size.Small"
                                                            OnClick="@(() => RemoveItemAsync(item))" />
                                        }
                                    </MudTd>
                                </RowTemplate>
                            </MudTable>
                        }
                    </div>

                </SoftStack>
            </SoftCardContent>

            <SoftDivider />
            <div class="pa-3 d-flex justify-end flex-wrap" style="gap: 8px;">
                <SoftButton Variant="Variant.Text" OnClick="CloseAsync">@L["Close"]</SoftButton>

                @if ((_transfer.Status == StockTransferStatuses.Draft
                      || _transfer.Status == StockTransferStatuses.Pending
                      || _transfer.Status == StockTransferStatuses.Approved) && CanCancelCurrentTransfer)
                {
                    <SoftButton Variant="Variant.Outlined" Color="Color.Error"
                                StartIcon="@Icons.Material.Filled.Cancel"
                                OnClick="OpenCancelDialog" Disabled="_saving">@OpsL["CancelTransfer"]</SoftButton>
                }
                @if (_transfer.Status == StockTransferStatuses.Pending && _canApprove)
                {
                    <SoftButton Variant="Variant.Outlined" Color="Color.Error"
                                StartIcon="@Icons.Material.Filled.Block"
                                OnClick="OpenRejectDialog" Disabled="_saving">@OpsL["RejectRequest"]</SoftButton>
                }
                @if (_transfer.Status == StockTransferStatuses.Draft && _transfer.Items.Count > 0 && CanEditCurrentRequest)
                {
                    <SoftButton Variant="Variant.Filled" Color="Color.Primary"
                                StartIcon="@Icons.Material.Filled.Send"
                                OnClick="SubmitAsync" Disabled="_saving">@OpsL["SubmitRequest"]</SoftButton>
                }
                @if (_transfer.Status == StockTransferStatuses.Pending && _canApprove && !_transfer.FromBranchId.HasValue)
                {
                    <SoftButton Variant="Variant.Filled" Color="Color.Success"
                                StartIcon="@Icons.Material.Filled.Route"
                                OnClick="AssignSourceAsync" Disabled="_saving">@OpsL["AssignSourceBranch"]</SoftButton>
                }
                @if (_transfer.Status == StockTransferStatuses.Pending && _canApprove && _transfer.FromBranchId.HasValue)
                {
                    <SoftButton Variant="Variant.Filled" Color="Color.Success"
                                StartIcon="@Icons.Material.Filled.CheckCircle"
                                OnClick="ApproveAsync" Disabled="_saving">@OpsL["Approve"]</SoftButton>
                }
                @if (_transfer.Status == StockTransferStatuses.Approved && CanShipCurrentTransfer)
                {
                    <SoftButton Variant="Variant.Filled" Color="Color.Info"
                                StartIcon="@Icons.Material.Filled.LocalShipping"
                                OnClick="OpenShipDialog" Disabled="_saving">@OpsL["Ship"]</SoftButton>
                }
                @if (_transfer.Status == StockTransferStatuses.InTransit && CanCompleteCurrentTransfer)
                {
                    <SoftButton Variant="Variant.Filled" Color="Color.Tertiary"
                                StartIcon="@Icons.Material.Filled.TaskAlt"
                                OnClick="OpenCompleteDialog" Disabled="_saving">@OpsL["MarkCompleted"]</SoftButton>
                }
            </div>

        </SoftCard>
    </div>
</div>

<!-- ── Add Item dialog ── -->
@if (_addItemVisible)
{
    <div class="soft-modal-backdrop" @onclick="CloseAddItem">
        <div class="soft-modal-container" @onclick:stopPropagation="true">
            <SoftCard Elevation="24" Class="soft-modal-card">
                <SoftCardHeader Class="pa-4">
                    <CardHeaderContent>
                        <SoftStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <SoftIcon Icon="@Icons.Material.Filled.AddBox" Color="Color.Primary" Size="Size.Medium" />
                            <SoftText Typo="Typo.h6">@OpsL["AddProduct"]</SoftText>
                        </SoftStack>
                    </CardHeaderContent>
                    <CardHeaderActions>
                        <SoftIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="CloseAddItem" />
                    </CardHeaderActions>
                </SoftCardHeader>
                <SoftDivider />
                <SoftCardContent Class="pa-4">
                    <SoftStack Spacing="3">
                        <SoftLookupSelect TItem="StockTransferProductLookupDto" TValue="Guid?"
                                          Items="_availableProducts"
                                          ToValue="@(p => (Guid?)p.ProductId)"
                                          ToLabel="@(p => _transfer?.FromBranchId != null
                                              ? $"{p.Name} — {p.SKU} — {p.QuantityOnHand} in stock"
                                              : $"{p.Name} — {p.SKU}")"
                                          Value="_newItemProductId"
                                          ValueChanged="OnAddItemProductChanged"
                                          Label="@OpsL["Product"]"
                                          Required="true" />
                        <SoftNumericField T="int" Label="@OpsL["RequestedQuantity"]"
                                          @bind-Value="_newItemQty"
                                          Variant="Variant.Outlined" Min="1" />
                        @if (_selectedAvailableStock.HasValue && _newItemQty > _selectedAvailableStock.Value)
                        {
                            <SoftAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true">
                                @string.Format(OpsL["OnlyXInStock"], _selectedAvailableStock.Value)
                            </SoftAlert>
                        }
                    </SoftStack>
                </SoftCardContent>
                <SoftDivider />
                <div class="pa-3 d-flex justify-end" style="gap: 8px;">
                    <SoftButton Variant="Variant.Text" OnClick="CloseAddItem">@L["Cancel"]</SoftButton>
                    <SoftButton Variant="Variant.Filled" Color="Color.Primary"
                                StartIcon="@Icons.Material.Filled.Save"
                                OnClick="ConfirmAddItem" Disabled="_saving">@L["Save"]</SoftButton>
                </div>
            </SoftCard>
        </div>
    </div>
}

<!-- ── Ship confirmation dialog ── -->
@if (_shipVisible)
{
    <div class="soft-modal-backdrop" @onclick="CloseShip">
        <div class="soft-modal-container soft-modal-container--lg" @onclick:stopPropagation="true">
            <SoftCard Elevation="24" Class="soft-modal-card">
                <SoftCardHeader Class="pa-4">
                    <CardHeaderContent>
                        <SoftStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <SoftIcon Icon="@Icons.Material.Filled.LocalShipping" Color="Color.Primary" Size="Size.Medium" />
                            <div>
                                <SoftText Typo="Typo.h6">@OpsL["Ship"]</SoftText>
                                <SoftText Typo="Typo.caption" Color="Color.Default">
                                    @string.Format(OpsL["ShipLeavesSourceHint"], _transfer.FromBranchName)
                                </SoftText>
                            </div>
                        </SoftStack>
                    </CardHeaderContent>
                    <CardHeaderActions>
                        <SoftIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="CloseShip" />
                    </CardHeaderActions>
                </SoftCardHeader>
                <SoftDivider />
                <SoftCardContent Class="pa-4 sts-modal-body">
                    @if (HasShipStockShortage)
                    {
                        <SoftAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" Class="mb-3">
                            @OpsL["TransferSourceStockMissingNow"]
                        </SoftAlert>
                    }
                    else if (HasShipShortShipment)
                    {
                        <SoftAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mb-3">
                            @OpsL["TransferShipShortInfo"]
                        </SoftAlert>
                    }
                    <MudTable T="ShipRow" Items="@_shipRows" Dense="true" Hover="true" Bordered="false">
                        <HeaderContent>
                            <MudTh>@OpsL["Product"]</MudTh>
                            <MudTh Style="text-align:center;">@OpsL["ApprovedQuantity"]</MudTh>
                            <MudTh Style="text-align:center; min-width: 130px;">@OpsL["ShippedQuantity"]</MudTh>
                            <MudTh Style="text-align:right;">@OpsL["SourceStock"]</MudTh>
                        </HeaderContent>
                        <RowTemplate Context="row">
                            <MudTd>
                                <SoftStack Spacing="0">
                                    <SoftText Typo="Typo.body2" Style="font-weight:500;">@row.Item.ProductName</SoftText>
                                    <SoftText Typo="Typo.caption" Color="Color.Default">@row.Item.ProductSKU</SoftText>
                                </SoftStack>
                            </MudTd>
                            <MudTd Style="text-align:center;">@row.Approved</MudTd>
                            <MudTd Style="text-align:center;">
                                <SoftNumericField T="int" @bind-Value="row.ToShip"
                                                  Variant="Variant.Outlined" Min="0" Max="@row.Approved"
                                                  Margin="Margin.Dense" />
                            </MudTd>
                            <MudTd Style="text-align:right;">
                                <SoftText Color="@(row.SourceStock < row.ToShip ? Color.Error : Color.Default)">
                                    @row.SourceStock
                                </SoftText>
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                </SoftCardContent>
                <SoftDivider />
                <div class="pa-3 d-flex justify-end" style="gap: 8px;">
                    <SoftButton Variant="Variant.Text" OnClick="CloseShip">@L["Cancel"]</SoftButton>
                    <SoftButton Variant="Variant.Filled" Color="Color.Info"
                                StartIcon="@Icons.Material.Filled.LocalShipping"
                                OnClick="ConfirmShipAsync"
                                Disabled="@(_saving || HasShipStockShortage || !HasAnythingToShip)">@OpsL["Ship"]</SoftButton>
                </div>
            </SoftCard>
        </div>
    </div>
}

<!-- ── Receive dialog ── -->
@if (_completeVisible)
{
    <div class="soft-modal-backdrop" @onclick="CloseComplete">
        <div class="soft-modal-container soft-modal-container--lg" @onclick:stopPropagation="true">
            <SoftCard Elevation="24" Class="soft-modal-card">
                <SoftCardHeader Class="pa-4">
                    <CardHeaderContent>
                        <SoftStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <SoftIcon Icon="@Icons.Material.Filled.TaskAlt" Color="Color.Tertiary" Size="Size.Medium" />
                            <div>
                                <SoftText Typo="Typo.h6">@OpsL["ReceiveTransfer"]</SoftText>
                                <SoftText Typo="Typo.caption" Color="Color.Default">
                                    @OpsL["CompleteTransferHint"]
                                </SoftText>
                            </div>
                        </SoftStack>
                    </CardHeaderContent>
                    <CardHeaderActions>
                        <SoftIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="CloseComplete" />
                    </CardHeaderActions>
                </SoftCardHeader>
                <SoftDivider />
                <SoftCardContent Class="pa-4 sts-modal-body">
                    @if (HasReceiveOverShipped)
                    {
                        <SoftAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" Class="mb-3">
                            @BuildReceiveOverShippedWarning()
                        </SoftAlert>
                    }
                    else if (HasReceiveShortfall)
                    {
                        <SoftAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Class="mb-3">
                            @OpsL["TransferReceiveShortWarn"]
                        </SoftAlert>
                    }
                    <MudTable T="CompleteRow" Items="@_completeRows" Dense="true" Hover="true" Bordered="false">
                        <HeaderContent>
                            <MudTh>@OpsL["Product"]</MudTh>
                            <MudTh Style="text-align:right;">@OpsL["ShippedQuantity"]</MudTh>
                            <MudTh Style="text-align:center; min-width: 140px;">@OpsL["ReceiveNow"]</MudTh>
                        </HeaderContent>
                        <RowTemplate Context="row">
                            <MudTd>
                                <SoftStack Spacing="0">
                                    <SoftText Typo="Typo.body2" Style="font-weight:500;">@row.Item.ProductName</SoftText>
                                    <SoftText Typo="Typo.caption" Color="Color.Default">@row.Item.ProductSKU</SoftText>
                                </SoftStack>
                            </MudTd>
                            <MudTd Style="text-align:right;">@row.Shipped</MudTd>
                            <MudTd Style="text-align:center;">
                                <SoftNumericField T="int" @bind-Value="row.ReceiveNow"
                                                  Variant="Variant.Outlined" Min="0" Max="@row.Shipped"
                                                  Margin="Margin.Dense" />
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                </SoftCardContent>
                <SoftDivider />
                <div class="pa-3 d-flex align-center flex-wrap" style="gap: 8px;">
                    <SoftButton Variant="Variant.Text" Color="Color.Error"
                                StartIcon="@Icons.Material.Filled.ReportProblem"
                                OnClick="OpenReportLost" Disabled="_saving">@OpsL["TransferReportLost"]</SoftButton>
                    <div class="flex-grow-1"></div>
                    <SoftButton Variant="Variant.Text" OnClick="CloseComplete">@L["Cancel"]</SoftButton>
                    <SoftButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="ReceiveAll">
                        @OpsL["TransferAll"]
                    </SoftButton>
                    <SoftButton Variant="Variant.Filled" Color="Color.Tertiary"
                                StartIcon="@Icons.Material.Filled.CheckCircle"
                                OnClick="ConfirmComplete" Disabled="@(_saving || HasReceiveOverShipped)">@OpsL["ConfirmReceive"]</SoftButton>
                </div>
            </SoftCard>
        </div>
    </div>
}

<!-- ── Report lost confirm ── -->
@if (_reportLostVisible)
{
    <div class="soft-modal-backdrop" @onclick="CloseReportLost">
        <div class="soft-modal-container" @onclick:stopPropagation="true">
            <SoftCard Elevation="24" Class="soft-modal-card">
                <SoftCardHeader Class="pa-4">
                    <CardHeaderContent>
                        <SoftStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <SoftIcon Icon="@Icons.Material.Filled.ReportProblem" Color="Color.Error" Size="Size.Medium" />
                            <SoftText Typo="Typo.h6">@OpsL["TransferReportLost"]</SoftText>
                        </SoftStack>
                    </CardHeaderContent>
                    <CardHeaderActions>
                        <SoftIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="CloseReportLost" />
                    </CardHeaderActions>
                </SoftCardHeader>
                <SoftDivider />
                <SoftCardContent Class="pa-4">
                    <SoftText Typo="Typo.body2">@OpsL["TransferReportLostConfirm"]</SoftText>
                </SoftCardContent>
                <SoftDivider />
                <div class="pa-3 d-flex justify-end" style="gap: 8px;">
                    <SoftButton Variant="Variant.Text" OnClick="CloseReportLost">@L["Cancel"]</SoftButton>
                    <SoftButton Variant="Variant.Filled" Color="Color.Error"
                                StartIcon="@Icons.Material.Filled.ReportProblem"
                                OnClick="ConfirmReportLostAsync" Disabled="_saving">@OpsL["TransferReportLost"]</SoftButton>
                </div>
            </SoftCard>
        </div>
    </div>
}

<!-- ── Reject dialog ── -->
@if (_rejectVisible)
{
    <div class="soft-modal-backdrop" @onclick="CloseReject">
        <div class="soft-modal-container" @onclick:stopPropagation="true">
            <SoftCard Elevation="24" Class="soft-modal-card">
                <SoftCardHeader Class="pa-4">
                    <CardHeaderContent>
                        <SoftStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <SoftIcon Icon="@Icons.Material.Filled.Block" Color="Color.Error" Size="Size.Medium" />
                            <SoftText Typo="Typo.h6">@OpsL["RejectRequest"]</SoftText>
                        </SoftStack>
                    </CardHeaderContent>
                    <CardHeaderActions>
                        <SoftIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="CloseReject" />
                    </CardHeaderActions>
                </SoftCardHeader>
                <SoftDivider />
                <SoftCardContent Class="pa-4">
                    <SoftStack Spacing="2">
                        <SoftTextField T="string"
                                       Label="@OpsL["RejectReason"]"
                                       @bind-Value="_rejectReason"
                                       Variant="Variant.Outlined"
                                       Lines="3"
                                       MaxLength="512"
                                       Required="true" />
                        <SoftText Typo="Typo.caption" Color="Color.Default">@OpsL["RejectReasonHint"]</SoftText>
                    </SoftStack>
                </SoftCardContent>
                <SoftDivider />
                <div class="pa-3 d-flex justify-end" style="gap: 8px;">
                    <SoftButton Variant="Variant.Text" OnClick="CloseReject">@L["Cancel"]</SoftButton>
                    <SoftButton Variant="Variant.Filled" Color="Color.Error"
                                StartIcon="@Icons.Material.Filled.Block"
                                OnClick="ConfirmRejectAsync"
                                Disabled="@(_saving || string.IsNullOrWhiteSpace(_rejectReason))">
                        @OpsL["RejectRequest"]
                    </SoftButton>
                </div>
            </SoftCard>
        </div>
    </div>
}

<!-- ── Cancel dialog ── -->
@if (_cancelVisible)
{
    <div class="soft-modal-backdrop" @onclick="CloseCancel">
        <div class="soft-modal-container" @onclick:stopPropagation="true">
            <SoftCard Elevation="24" Class="soft-modal-card">
                <SoftCardHeader Class="pa-4">
                    <CardHeaderContent>
                        <SoftStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <SoftIcon Icon="@Icons.Material.Filled.Cancel" Color="Color.Error" Size="Size.Medium" />
                            <SoftText Typo="Typo.h6">@OpsL["CancelTransfer"]</SoftText>
                        </SoftStack>
                    </CardHeaderContent>
                    <CardHeaderActions>
                        <SoftIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="CloseCancel" />
                    </CardHeaderActions>
                </SoftCardHeader>
                <SoftDivider />
                <SoftCardContent Class="pa-4">
                    <SoftStack Spacing="3">
                        <SoftText Typo="Typo.body2">@OpsL["CancelConfirmText"]</SoftText>
                        <SoftTextField T="string"
                                       Label="@OpsL["CancelReason"]"
                                       @bind-Value="_cancelReason"
                                       Variant="Variant.Outlined"
                                       Lines="2"
                                       MaxLength="512" />
                    </SoftStack>
                </SoftCardContent>
                <SoftDivider />
                <div class="pa-3 d-flex justify-end" style="gap: 8px;">
                    <SoftButton Variant="Variant.Text" OnClick="CloseCancel">@L["Close"]</SoftButton>
                    <SoftButton Variant="Variant.Filled" Color="Color.Error"
                                StartIcon="@Icons.Material.Filled.Cancel"
                                OnClick="ConfirmCancelAsync" Disabled="_saving">
                        @OpsL["CancelTransfer"]
                    </SoftButton>
                </div>
            </SoftCard>
        </div>
    </div>
}

