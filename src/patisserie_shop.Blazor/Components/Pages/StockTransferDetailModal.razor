@code {
    [Parameter, EditorRequired] public Guid TransferId { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback Changed { get; set; }

    private static readonly string[] StepKeys = { "Request", "Approval", "Ship", "Receive" };

    private StockTransferDto? _transfer;
    private bool _saving;

    private bool _canCreate;
    private bool _canApprove;
    private bool _canShip;
    private bool _canComplete;
    private bool _canCancel;
    private List<Guid> _accessibleBranchIds = new();

    private readonly Dictionary<Guid, int> _approvedEdits = new();
    private List<BranchLookupDto> _branches = new();
    private Guid? _sourceBranchId;
    private List<BranchLookupDto> AvailableSourceBranches =>
        _transfer is null
            ? _branches
            : _branches.Where(b => b.Id != _transfer.ToBranchId).ToList();

    private bool _addItemVisible;
    private List<StockTransferProductLookupDto> _availableProducts = new();
    private Guid? _newItemProductId;
    private int _newItemQty = 1;
    private int? _selectedAvailableStock;

    private bool _shipVisible;
    private List<ShipRow> _shipRows = new();

    private bool _completeVisible;
    private List<CompleteRow> _completeRows = new();
    private bool _reportLostVisible;

    private bool _rejectVisible;
    private string? _rejectReason;

    private bool _cancelVisible;
    private string? _cancelReason;

    private bool IsClosed =>
        _transfer?.Status == StockTransferStatuses.Cancelled
        || _transfer?.Status == StockTransferStatuses.Rejected;

    private bool CanEditCurrentRequest =>
        _canCreate && _transfer is not null
        && (_accessibleBranchIds.Contains(_transfer.ToBranchId)
            || (_transfer.FromBranchId is Guid f && _accessibleBranchIds.Contains(f)));
    private bool CanShipCurrentTransfer =>
        _canShip && _transfer?.FromBranchId is Guid sourceBranchId && _accessibleBranchIds.Contains(sourceBranchId);
    private bool CanCompleteCurrentTransfer =>
        _canComplete && _transfer is not null && _accessibleBranchIds.Contains(_transfer.ToBranchId);
    private bool CanCancelCurrentTransfer =>
        _canCancel && _transfer is not null
        && (_canApprove
            || _accessibleBranchIds.Contains(_transfer.ToBranchId)
            || (_transfer.FromBranchId is Guid src && _accessibleBranchIds.Contains(src)));
    private bool CanAdjustQuantities =>
        _canApprove
        && (_transfer?.Status == StockTransferStatuses.Pending
            || _transfer?.Status == StockTransferStatuses.Approved);

    private bool HasShipStockShortage => _shipRows.Any(r => r.ToShip > r.SourceStock);
    private bool HasShipShortShipment => _shipRows.Any(r => r.ToShip < r.Approved);
    private bool HasAnythingToShip => _shipRows.Any(r => r.ToShip > 0);
    private bool HasReceiveOverShipped => _completeRows.Any(r => r.ReceiveNow > r.Shipped);
    private bool HasReceiveShortfall => _completeRows.Any(r => r.ReceiveNow < r.Shipped);

    public class ShipRow
    {
        public StockTransferItemDto Item { get; set; } = null!;
        public int Approved { get; set; }
        public int ToShip { get; set; }
        public int SourceStock { get; set; }
    }

    public class CompleteRow
    {
        public StockTransferItemDto Item { get; set; } = null!;
        public int Shipped { get; set; }
        public int ReceiveNow { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        _canCreate   = await AuthorizationService.IsGrantedAsync(OperationsPermissions.Transfers.Create);
        _canApprove  = await AuthorizationService.IsGrantedAsync(OperationsPermissions.Transfers.Approve);
        _canShip     = await AuthorizationService.IsGrantedAsync(OperationsPermissions.Transfers.Ship);
        _canComplete = await AuthorizationService.IsGrantedAsync(OperationsPermissions.Transfers.Complete);
        _canCancel   = await AuthorizationService.IsGrantedAsync(OperationsPermissions.Transfers.Cancel);
        _accessibleBranchIds = await BranchInventoryAppService.GetAccessibleBranchIdsAsync();
        if (_canApprove)
        {
            _branches = await BranchAppService.GetLookupAsync();
        }
        await LoadAsync();
    }

    // ── Stepper / hint helpers ──

    private int CurrentStepIndex => _transfer?.Status switch
    {
        StockTransferStatuses.Draft => 0,
        StockTransferStatuses.Pending => 1,
        StockTransferStatuses.Approved => 2,
        StockTransferStatuses.InTransit => 3,
        StockTransferStatuses.Completed => StepKeys.Length,
        _ => -1
    };

    private string StepState(int index)
    {
        if (index < CurrentStepIndex) return "done";
        if (index == CurrentStepIndex) return "current";
        return "upcoming";
    }

    private static string StepIcon(int index) => index switch
    {
        0 => Icons.Material.Filled.EditNote,
        1 => Icons.Material.Filled.FactCheck,
        2 => Icons.Material.Filled.LocalShipping,
        _ => Icons.Material.Filled.Inventory
    };

    private (string Text, bool Mine) CurrentHint()
    {
        if (_transfer == null) return (string.Empty, false);

        return _transfer.Status switch
        {
            StockTransferStatuses.Draft => CanEditCurrentRequest
                ? (OpsL["Hint:DraftMine"].Value, true)
                : (string.Format(OpsL["Hint:DraftOther"], _transfer.RequestedByUserName ?? _transfer.ToBranchName), false),
            StockTransferStatuses.Pending => _canApprove
                ? (_transfer.FromBranchId.HasValue
                    ? (OpsL["Hint:PendingApproverWithSource"].Value, true)
                    : (OpsL["Hint:PendingApprover"].Value, true))
                : (OpsL["Hint:PendingOther"].Value, false),
            StockTransferStatuses.Approved => CanShipCurrentTransfer
                ? (OpsL["Hint:ApprovedShipper"].Value, true)
                : (string.Format(OpsL["Hint:ApprovedOther"], _transfer.FromBranchName), false),
            StockTransferStatuses.InTransit => CanCompleteCurrentTransfer
                ? (OpsL["Hint:InTransitReceiver"].Value, true)
                : (string.Format(OpsL["Hint:InTransitOther"], _transfer.ToBranchName), false),
            StockTransferStatuses.Completed =>
                (string.Format(OpsL["Hint:Completed"], _transfer.CompletedDate?.ToString("MMM d, yyyy") ?? "-"), false),
            _ => (string.Empty, false)
        };
    }

    private async Task LoadAsync(bool keepUnsavedEdits = false)
    {
        try
        {
            var unsaved = keepUnsavedEdits ? new Dictionary<Guid, int>(_approvedEdits) : null;

            _transfer = await StockTransferAppService.GetAsync(TransferId);
            _sourceBranchId = _transfer.FromBranchId;
            _approvedEdits.Clear();
            foreach (var i in _transfer.Items)
            {
                _approvedEdits[i.Id] = unsaved != null && unsaved.TryGetValue(i.Id, out var pending)
                    ? pending
                    : (i.ApprovedQuantity ?? i.RequestedQuantity);
            }

            // Suggest the Main Kitchen as the source — it fulfils almost every request.
            if (_sourceBranchId == null && _canApprove && _transfer.Status == StockTransferStatuses.Pending)
            {
                _sourceBranchId = _branches
                    .FirstOrDefault(b => b.BranchType == BranchTypes.MainKitchen && b.Id != _transfer.ToBranchId)?.Id;
            }
        }
        catch (Exception ex)
        {
            await HandleTransferErrorAsync(ex);
            if (_transfer == null)
            {
                // Nothing to render (deleted / no access) — release the parent so the
                // row can be clicked again instead of soft-locking.
                await CloseAsync();
            }
        }
    }

    private int GetApprovedEdit(StockTransferItemDto item)
        => _approvedEdits.TryGetValue(item.Id, out var v) ? v : (item.ApprovedQuantity ?? item.RequestedQuantity);

    private async Task CloseAsync()
    {
        if (OnClose.HasDelegate) await OnClose.InvokeAsync();
    }

    private async Task NotifyChanged()
    {
        if (Changed.HasDelegate) await Changed.InvokeAsync();
    }

    // ─── Item editing ───

    private async Task OpenAddItem()
    {
        _newItemProductId = null;
        _newItemQty = 1;
        _selectedAvailableStock = null;
        try
        {
            var products = await StockTransferAppService.GetSourceProductsAsync(TransferId);
            var existing = _transfer!.Items.Select(i => i.ProductId).ToHashSet();
            _availableProducts = products.Where(p => !existing.Contains(p.ProductId)).ToList();
            _addItemVisible = true;
        }
        catch (Exception ex)
        {
            await HandleTransferErrorAsync(ex);
        }
    }

    private void OnAddItemProductChanged(Guid? id)
    {
        _newItemProductId = id;
        // The stock warning only makes sense once a source branch exists — for pull
        // requests the lookup returns the requester's OWN (low) stock, which is
        // exactly why they are requesting.
        _selectedAvailableStock = id.HasValue && _transfer?.FromBranchId != null
            ? _availableProducts.FirstOrDefault(p => p.ProductId == id.Value)?.QuantityOnHand
            : null;
    }

    private void CloseAddItem() => _addItemVisible = false;

    private async Task ConfirmAddItem()
    {
        if (!_newItemProductId.HasValue || _newItemQty <= 0)
        {
            Snackbar.Add(L["ThisFieldIsRequired", OpsL["Product"]], Severity.Warning);
            return;
        }
        _saving = true;
        try
        {
            await StockTransferAppService.AddItemAsync(TransferId, new AddStockTransferItemDto
            {
                ProductId = _newItemProductId.Value,
                RequestedQuantity = _newItemQty
            });
            _addItemVisible = false;
            await LoadAsync();
            await NotifyChanged();
        }
        catch (Exception ex)
        {
            await HandleTransferErrorAsync(ex);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task RemoveItemAsync(StockTransferItemDto item)
    {
        if (_saving) return;
        _saving = true;
        try
        {
            await StockTransferAppService.RemoveItemAsync(TransferId, item.Id);
            await LoadAsync();
            await NotifyChanged();
        }
        catch (Exception ex)
        {
            await HandleTransferErrorAsync(ex);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task SaveApprovedAsync(StockTransferItemDto item)
    {
        if (_saving) return;
        _saving = true;
        try
        {
            var qty = GetApprovedEdit(item);
            await StockTransferAppService.UpdateApprovedQuantityAsync(TransferId, item.Id, new UpdateApprovedQuantityDto
            {
                ApprovedQuantity = qty
            });
            Snackbar.Add(OpsL["ApprovedQtyUpdated"], Severity.Success);
            // Keep the approver's typed-but-unsaved edits on the other rows.
            await LoadAsync(keepUnsavedEdits: true);
            _approvedEdits[item.Id] = qty;
        }
        catch (Exception ex)
        {
            await HandleTransferErrorAsync(ex);
        }
        finally
        {
            _saving = false;
        }
    }

    // ─── Status actions ───

    private async Task SubmitAsync() => await RunAsync(
        () => StockTransferAppService.SubmitAsync(TransferId), OpsL["TransferSubmitted"], Severity.Success);

    private async Task ApproveAsync() => await RunAsync(
        () => StockTransferAppService.ApproveAsync(TransferId), OpsL["TransferApproved"], Severity.Success);

    private async Task AssignSourceAsync()
    {
        if (!_sourceBranchId.HasValue)
        {
            Snackbar.Add(L["ThisFieldIsRequired", OpsL["FromBranch"]], Severity.Warning);
            return;
        }

        await RunAsync(
            () => StockTransferAppService.AssignSourceAsync(TransferId, new AssignStockTransferSourceDto
            {
                FromBranchId = _sourceBranchId.Value
            }),
            OpsL["TransferSourceAssigned"],
            Severity.Success);
    }

    // ─── Ship flow ───

    private async Task OpenShipDialog()
    {
        try
        {
            var source = await StockTransferAppService.GetSourceProductsAsync(TransferId);
            var stockByProduct = source.ToDictionary(p => p.ProductId, p => p.QuantityOnHand);

            _shipRows = _transfer!.Items.Select(i =>
            {
                var approved = i.ApprovedQuantity ?? i.RequestedQuantity;
                var sourceStock = stockByProduct.GetValueOrDefault(i.ProductId, 0);
                return new ShipRow
                {
                    Item = i,
                    Approved = approved,
                    // Default to approved, but cap at what the source can actually spare so
                    // the packer starts from a shippable number instead of a blocked one.
                    ToShip = Math.Min(approved, sourceStock),
                    SourceStock = sourceStock
                };
            }).ToList();
            _shipVisible = true;
        }
        catch (Exception ex)
        {
            await HandleTransferErrorAsync(ex);
        }
    }

    private void CloseShip() => _shipVisible = false;

    private async Task ConfirmShipAsync()
    {
        var input = new ShipStockTransferDto
        {
            Lines = _shipRows
                .Select(r => new ShipTransferLineDto { ItemId = r.Item.Id, ShippedQuantity = r.ToShip })
                .ToList()
        };

        if (await RunAsync(
                () => StockTransferAppService.ShipAsync(TransferId, input), OpsL["TransferShipped"], Severity.Success))
        {
            _shipVisible = false;
        }
    }

    // ─── Reject / cancel flows ───

    private void OpenRejectDialog()
    {
        _rejectReason = null;
        _rejectVisible = true;
    }

    private void CloseReject() => _rejectVisible = false;

    private async Task ConfirmRejectAsync()
    {
        if (string.IsNullOrWhiteSpace(_rejectReason))
        {
            Snackbar.Add(L["ThisFieldIsRequired", OpsL["RejectReason"]], Severity.Warning);
            return;
        }

        if (await RunAsync(
                () => StockTransferAppService.RejectAsync(TransferId, new RejectStockTransferDto { Reason = _rejectReason }),
                OpsL["TransferRejected"],
                Severity.Warning))
        {
            _rejectVisible = false;
        }
    }

    private void OpenCancelDialog()
    {
        _cancelReason = null;
        _cancelVisible = true;
    }

    private void CloseCancel() => _cancelVisible = false;

    private async Task ConfirmCancelAsync()
    {
        if (await RunAsync(
                () => StockTransferAppService.CancelAsync(TransferId, new CancelStockTransferDto { Reason = _cancelReason }),
                OpsL["TransferCancelled"],
                Severity.Warning))
        {
            _cancelVisible = false;
        }
    }

    private async Task<bool> RunAsync(Func<Task<StockTransferDto>> action, string message, Severity severity)
    {
        _saving = true;
        try
        {
            await action();
            Snackbar.Add(message, severity);
            await NotifyChanged();
            await CloseAsync();
            return true;
        }
        catch (Exception ex)
        {
            await HandleTransferErrorAsync(ex);
            // Another user may have moved the transfer along — refresh so the
            // action buttons match the real status instead of a stale one.
            await LoadAsync(keepUnsavedEdits: true);
            return false;
        }
        finally { _saving = false; }
    }

    // ─── Receive flow ───

    private void OpenCompleteDialog()
    {
        _completeRows = _transfer!.Items.Select(i =>
        {
            // Cap at what actually shipped (falls back to approved for legacy transfers).
            var shipped = i.ShippedQuantity ?? i.ApprovedQuantity ?? i.RequestedQuantity;
            return new CompleteRow { Item = i, Shipped = shipped, ReceiveNow = shipped };
        }).ToList();
        _completeVisible = true;
    }

    private void OpenReportLost() => _reportLostVisible = true;

    private void CloseReportLost() => _reportLostVisible = false;

    private async Task ConfirmReportLostAsync()
    {
        // Nothing arrived — receive 0 on every line. The source was already decremented
        // at ship time, so the whole shipment is recorded as transit loss and the
        // transfer leaves the "needs my action" list.
        foreach (var row in _completeRows)
        {
            row.ReceiveNow = 0;
        }
        _reportLostVisible = false;
        await ConfirmComplete();
    }

    private void CloseComplete() => _completeVisible = false;

    private void ReceiveAll()
    {
        foreach (var row in _completeRows)
        {
            row.ReceiveNow = row.Shipped;
        }
    }

    private async Task ConfirmComplete()
    {
        if (HasReceiveOverShipped)
        {
            Snackbar.Add(BuildReceiveOverShippedWarning(), Severity.Error);
            return;
        }

        var lines = _completeRows
            .Select(r => new CompleteTransferLineDto { ItemId = r.Item.Id, TransferredQuantity = r.ReceiveNow })
            .ToList();

        _saving = true;
        try
        {
            var updated = await StockTransferAppService.CompleteAsync(TransferId, new CompleteStockTransferDto { Lines = lines });
            _completeVisible = false;
            Snackbar.Add(string.Format(OpsL["TransferCompleted"], updated.Reference), Severity.Success);
            await NotifyChanged();
            await CloseAsync();
        }
        catch (Exception ex)
        {
            await HandleTransferErrorAsync(ex);
            await LoadAsync(keepUnsavedEdits: true);
            if (_transfer?.Status != StockTransferStatuses.InTransit)
            {
                _completeVisible = false;
            }
        }
        finally { _saving = false; }
    }

    private string BuildReceiveOverShippedWarning()
    {
        var row = _completeRows.FirstOrDefault(r => r.ReceiveNow > r.Shipped);
        return row == null
            ? string.Empty
            : string.Format(OpsL["TransferReceiveOverShipped"], row.Item.ProductName, row.Shipped);
    }

    private async Task HandleTransferErrorAsync(Exception ex)
    {
        if (TryFindBusinessException(ex, out var business))
        {
            if (business.Code == OperationsErrorCodes.InsufficientStockAtSource)
            {
                Snackbar.Add(OpsL["TransferSourceStockMissingNow"], Severity.Error);
                return;
            }

            if (business.Code == OperationsErrorCodes.CannotShipNothing)
            {
                Snackbar.Add(OpsL["Operations:Transfers:CannotShipNothing"], Severity.Warning);
                return;
            }

            if (business.Code == InventoryErrorCodes.BranchAccessDenied)
            {
                Snackbar.Add(OpsL["TransferBranchActionDenied"], Severity.Error);
                return;
            }

            if (business.Code == OperationsErrorCodes.TransferSourceBranchRequired)
            {
                Snackbar.Add(OpsL["Operations:Transfers:SourceBranchRequired"], Severity.Warning);
                return;
            }

            if (business.Code == OperationsErrorCodes.TransferRejectionReasonRequired)
            {
                Snackbar.Add(OpsL["Operations:Transfers:RejectionReasonRequired"], Severity.Warning);
                return;
            }

            if (business.Code == OperationsErrorCodes.TransferReceivedExceedsShipped)
            {
                Snackbar.Add(BuildReceiveOverShippedWarning(), Severity.Error);
                return;
            }
        }

        await HandleErrorAsync(ex);
    }

    private static bool TryFindBusinessException(Exception? ex, out BusinessException business)
    {
        while (ex != null)
        {
            if (ex is BusinessException found)
            {
                business = found;
                return true;
            }

            ex = ex.InnerException;
        }

        business = null!;
        return false;
    }

    private static string StatusIcon(string status) => status switch
    {
        StockTransferStatuses.Draft => Icons.Material.Filled.EditNote,
        StockTransferStatuses.Pending => Icons.Material.Filled.Send,
        StockTransferStatuses.Approved => Icons.Material.Filled.CheckCircle,
        StockTransferStatuses.InTransit => Icons.Material.Filled.LocalShipping,
        StockTransferStatuses.Completed => Icons.Material.Filled.TaskAlt,
        StockTransferStatuses.Cancelled => Icons.Material.Filled.Cancel,
        StockTransferStatuses.Rejected => Icons.Material.Filled.Block,
        _ => Icons.Material.Filled.HelpOutline
    };
}
