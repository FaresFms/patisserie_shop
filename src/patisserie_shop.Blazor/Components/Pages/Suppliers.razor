@page "/inventory/suppliers"
@attribute [Authorize(InventoryPermissions.Suppliers.Default)]
@using System.Threading
@using System.Threading.Tasks
@using Microsoft.AspNetCore.Authorization
@using Volo.Abp.Application.Dtos
@using Volo.Abp.AspNetCore.Components.Web.Theming.Layout
@using Inventory.Suppliers
@using Inventory.Permissions
@using Inventory.Localization
@using patisserie_shop.Suppliers
@using Color = MudBlazor.Color
@using Variant = MudBlazor.Variant
@using Size = MudBlazor.Size
@using Margin = MudBlazor.Margin
@inherits patisserie_shopComponentBase
@inject ISupplierAppService SupplierAppService
@inject ISupplierScorecardAppService SupplierScorecardAppService
@inject PageLayout PageLayout
@inject ISnackbar Snackbar
@inject IStringLocalizer<InventoryResource> InvL

@{
    PageLayout.Title = InvL["Suppliers"];
}

<SoftCard Elevation="2" Class="pa-2 page-flat">
    <div class="page-head">
        <div>
            <h1 class="page-title">@InvL["Suppliers"]</h1>
            <div class="page-sub">@InvL["Suppliers:Subtitle"]</div>
        </div>
        <div class="page-head-actions">
            @if (_canManage)
            {
                <SoftButton Variant="Variant.Filled"
                            Color="Color.Primary"
                            StartIcon="@Icons.Material.Filled.Add"
                            OnClick="OpenCreateDialog">
                    @InvL["NewSupplier"]
                </SoftButton>
            }
        </div>
    </div>
    <SoftCardContent>
        <div class="toolbar">
            <SoftTextField T="string"
                           Placeholder="@InvL["Filter"]"
                           @bind-Value="_filter"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Adornment="Adornment.Start"
                           AdornmentIcon="@Icons.Material.Filled.Search"
                           OnKeyUp="OnFilterKeyUpAsync"
                           Immediate="true"
                           Class="toolbar-search"
                           Style="max-width: 320px;" />
            <div class="toolbar-right">
                <SoftText Typo="Typo.caption" Color="Color.Default" Style="opacity:.7;">
                    @InvL["Scorecard:RangeNote"]
                </SoftText>
                <SoftButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Refresh" OnClick="ReloadAsync">
                    @L["Refresh"]
                </SoftButton>
            </div>
        </div>

        <SoftDataGrid T="SupplierDto"
                      @ref="_grid"
                      ServerData="LoadServerData"
                      Dense="true"
                      Hover="true"
                      Bordered="false"
                      Striped="true"
                      Loading="_loading"
                      SortMode="SortMode.Single">
            <Columns>
                <PropertyColumn T="SupplierDto" TProperty="string" Property="x => x.Name" Title="@InvL["Name"]" />
                <PropertyColumn T="SupplierDto" TProperty="string" Property="x => x.ContactPerson!" Title="@InvL["ContactPerson"]" />
                <PropertyColumn T="SupplierDto" TProperty="string" Property="x => x.Phone!" Title="@InvL["Phone"]" Sortable="false" />
                <PropertyColumn T="SupplierDto" TProperty="string" Property="x => x.Email!" Title="@InvL["Email"]" Sortable="false" />
                <PropertyColumn T="SupplierDto" TProperty="int" Property="x => x.LeadTimeDays" Title="@InvL["LeadTimeDays"]" />
                <TemplateColumn T="SupplierDto" Title="@InvL["Scorecard:Delivery"]" Sortable="false">
                    <CellTemplate>
                        @{
                            var sc = _scorecards.GetValueOrDefault(context.Item.Id);
                        }
                        @if (sc == null || sc.TotalOrders == 0)
                        {
                            <SoftText Typo="Typo.caption" Style="opacity:.6;">@InvL["Scorecard:NoHistory"]</SoftText>
                        }
                        else
                        {
                            <div class="stats" style="gap:14px;">
                                <span>
                                    <span class="stat-label">@InvL["Scorecard:OnTime"]</span>
                                    <span class="stat-value">@(sc.OnTimeRate.HasValue ? $"{sc.OnTimeRate.Value:0.#}%" : InvL["Scorecard:Dash"])</span>
                                </span>
                                <span>
                                    <span class="stat-label">@InvL["Scorecard:Fill"]</span>
                                    <span class="stat-value">@(sc.FillRate.HasValue ? $"{sc.FillRate.Value:0.#}%" : InvL["Scorecard:Dash"])</span>
                                </span>
                                <span>
                                    <span class="stat-label">@InvL["Scorecard:MeasuredLead"]</span>
                                    <span class="stat-value">@(sc.MeasuredLeadTimeDays.HasValue ? $"{sc.MeasuredLeadTimeDays.Value}d" : InvL["Scorecard:Dash"])</span>
                                </span>
                            </div>
                        }
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="SupplierDto" Title="@InvL["Scorecard:Grade"]" Sortable="false">
                    <CellTemplate>
                        @{
                            var sc = _scorecards.GetValueOrDefault(context.Item.Id);
                            var grade = sc?.Grade ?? SupplierGrading.NotAvailable;
                        }
                        <SoftTooltip Text="@GradeTooltip(sc)">
                            <SoftChip T="string"
                                      Color="@GradeColor(grade)"
                                      Variant="@(grade == SupplierGrading.NotAvailable ? Variant.Outlined : Variant.Filled)"
                                      Size="Size.Small">
                                @GradeLabel(grade)
                            </SoftChip>
                        </SoftTooltip>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="SupplierDto" Title="@InvL["IsActive"]" Sortable="true" SortBy="x => x.IsActive">
                    <CellTemplate>
                        @if (context.Item.IsActive)
                        {
                            <SoftChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Filled">@InvL["IsActive"]</SoftChip>
                        }
                        else
                        {
                            <SoftChip T="string" Color="Color.Default" Size="Size.Small" Variant="Variant.Outlined">-</SoftChip>
                        }
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="SupplierDto" Title="@InvL["CreationTime"]" SortBy="x => x.CreationTime">
                    <CellTemplate><BrowserLocalTime Value="@context.Item.CreationTime" Display="BrowserTimeDisplay.DateTime" /></CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="SupplierDto" Title="@InvL["Actions"]" Sortable="false">
                    <CellTemplate>
                        <span class="row-actions">
                            @if (_canManage)
                            {
                                <SoftStack Row="true" Spacing="1">
                                    <SoftIconButton Icon="@Icons.Material.Filled.Edit"
                                                    Color="Color.Primary"
                                                    Size="Size.Small"
                                                    OnClick="() => OpenEditDialog(context.Item)" />
                                    <SoftIconButton Icon="@Icons.Material.Filled.Delete"
                                                    Color="Color.Error"
                                                    Size="Size.Small"
                                                    OnClick="() => DeleteAsync(context.Item)" />
                                </SoftStack>
                            }
                        </span>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <PagerContent>
                <MudDataGridPager T="SupplierDto" />
            </PagerContent>
        </SoftDataGrid>
    </SoftCardContent>
</SoftCard>

@if (_dialogVisible)
{
    <div class="glass-modal-backdrop" @onclick="CloseDialog">
        <div class="glass-modal-container glass-modal-container--md" @onclick:stopPropagation="true">
            <SoftCard Elevation="24" Class="glass-modal">
                <SoftCardHeader Class="pa-4">
                    <CardHeaderContent>
                        <SoftStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <SoftIcon Icon="@(_editingId.HasValue ? Icons.Material.Filled.Edit : Icons.Material.Filled.AddCircle)"
                                      Color="Color.Primary" Size="Size.Medium" />
                            <SoftText Typo="Typo.h6">
                                @(_editingId.HasValue ? InvL["EditSupplier"] : InvL["NewSupplier"])
                            </SoftText>
                        </SoftStack>
                    </CardHeaderContent>
                    <CardHeaderActions>
                        <SoftIconButton Icon="@Icons.Material.Filled.Close"
                                        Size="Size.Small"
                                        OnClick="CloseDialog" />
                    </CardHeaderActions>
                </SoftCardHeader>
                <SoftDivider />
                <SoftCardContent Class="pa-4">
                    <SoftStack Spacing="3">
                        <SoftTextField T="string"
                                       Label="@InvL["Name"]"
                                       @bind-Value="_editName"
                                       Variant="Variant.Outlined"
                                       MaxLength="128"
                                       Required="true"
                                       Immediate="true" />
                        <SoftTextField T="string"
                                       Label="@InvL["ContactPerson"]"
                                       @bind-Value="_editContactPerson"
                                       Variant="Variant.Outlined"
                                       MaxLength="128" />
                        <SoftStack Row="true" Spacing="2">
                            <SoftTextField T="string"
                                           Label="@InvL["Phone"]"
                                           @bind-Value="_editPhone"
                                           Variant="Variant.Outlined"
                                           MaxLength="32" />
                            <SoftTextField T="string"
                                           Label="@InvL["Email"]"
                                           @bind-Value="_editEmail"
                                           Variant="Variant.Outlined"
                                           InputType="InputType.Email"
                                           MaxLength="256" />
                        </SoftStack>
                        <SoftTextField T="string"
                                       Label="@InvL["Address"]"
                                       @bind-Value="_editAddress"
                                       Variant="Variant.Outlined"
                                       Lines="2"
                                       MaxLength="512" />
                        <SoftNumericField T="int"
                                          Label="@InvL["LeadTimeDays"]"
                                          @bind-Value="_editLeadTimeDays"
                                          Variant="Variant.Outlined"
                                          Min="0"
                                          Max="365"
                                          HideSpinButtons="true"
                                          Style="max-width: 200px;" />
                        <SoftCheckBox T="bool" @bind-Value="_editIsActive" Label="@InvL["IsActive"]" Color="Color.Primary" />
                    </SoftStack>
                </SoftCardContent>
                <SoftDivider />
                <div class="pa-3 d-flex justify-end" style="gap: 8px;">
                    <SoftButton Variant="Variant.Text" OnClick="CloseDialog">@L["Cancel"]</SoftButton>
                    <SoftButton Variant="Variant.Filled"
                                Color="Color.Primary"
                                StartIcon="@Icons.Material.Filled.Save"
                                OnClick="SaveAsync">
                        @L["Save"]
                    </SoftButton>
                </div>
            </SoftCard>
        </div>
    </div>
}

@if (_confirmVisible)
{
    <div class="glass-modal-backdrop" @onclick="() => _confirmVisible = false">
        <div class="glass-modal-container glass-modal-container--sm" @onclick:stopPropagation="true">
            <SoftCard Elevation="24" Class="glass-modal">
                <SoftCardHeader Class="pa-4">
                    <CardHeaderContent>
                        <SoftStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <SoftIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Error" Size="Size.Medium" />
                            <SoftText Typo="Typo.h6">@InvL["Suppliers:DeleteTitle"]</SoftText>
                        </SoftStack>
                    </CardHeaderContent>
                </SoftCardHeader>
                <SoftDivider />
                <SoftCardContent Class="pa-4">
                    <SoftText>@InvL["Suppliers:DeleteConfirm", _pendingDelete?.Name ?? ""]</SoftText>
                </SoftCardContent>
                <SoftDivider />
                <div class="pa-3 d-flex justify-end" style="gap: 8px;">
                    <SoftButton Variant="Variant.Text" OnClick="() => _confirmVisible = false">@L["Cancel"]</SoftButton>
                    <SoftButton Variant="Variant.Filled"
                                Color="Color.Error"
                                StartIcon="@Icons.Material.Filled.Delete"
                                OnClick="ConfirmDeleteAsync">
                        @InvL["DeleteAction"]
                    </SoftButton>
                </div>
            </SoftCard>
        </div>
    </div>
}

@code {
    private SoftDataGrid<SupplierDto> _grid = null!;
    private bool _loading;
    private string? _filter;
    private bool _canManage;

    private bool _dialogVisible;
    private Guid? _editingId;
    private string _editName = string.Empty;
    private string? _editContactPerson;
    private string? _editPhone;
    private string? _editEmail;
    private string? _editAddress;
    private bool _editIsActive = true;
    private int _editLeadTimeDays = 3;

    private bool _confirmVisible;
    private SupplierDto? _pendingDelete;

    private const int ScorecardWindowDays = 90;
    private Dictionary<Guid, SupplierScorecardDto> _scorecards = new();

    protected override async Task OnInitializedAsync()
    {
        _canManage = await AuthorizationService.IsGrantedAsync(InventoryPermissions.Suppliers.Manage);
        await LoadScorecardsAsync();
    }

    private async Task LoadScorecardsAsync()
    {
        try
        {
            var rows = await SupplierScorecardAppService.GetListAsync(
                new GetSupplierScorecardsInput { Days = ScorecardWindowDays });
            _scorecards = rows.ToDictionary(r => r.SupplierId);
        }
        catch
        {
            // Scorecards are a non-critical overlay — if they fail to load the grid
            // still renders the supplier list (cells fall back to "no history").
            _scorecards = new();
        }
    }

    private async Task<GridData<SupplierDto>> LoadServerData(GridState<SupplierDto> state, CancellationToken cancellationToken)
    {
        _loading = true;
        try
        {
            string? sorting = null;
            var sort = state.SortDefinitions.FirstOrDefault();
            if (sort != null)
            {
                sorting = $"{sort.SortBy} {(sort.Descending ? "desc" : "asc")}";
            }

            var result = await SupplierAppService.GetListAsync(new GetSuppliersInput
            {
                Filter = _filter,
                SkipCount = state.Page * state.PageSize,
                MaxResultCount = state.PageSize,
                Sorting = sorting
            });

            return new GridData<SupplierDto>
            {
                Items = result.Items,
                TotalItems = (int)result.TotalCount
            };
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnFilterKeyUpAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await ReloadAsync();
        }
    }

    private async Task ReloadAsync()
    {
        await LoadScorecardsAsync();
        if (_grid != null)
        {
            await _grid.ReloadServerData();
        }
    }

    private Color GradeColor(string grade) => grade switch
    {
        "A" => Color.Success,
        "B" => Color.Info,
        "C" => Color.Warning,
        "D" => Color.Error,
        _ => Color.Default
    };

    private string GradeLabel(string grade)
        => grade == SupplierGrading.NotAvailable ? InvL["Scorecard:Grade:NA"] : grade;

    private string GradeTooltip(SupplierScorecardDto? sc)
    {
        if (sc == null || sc.TotalOrders == 0)
        {
            return InvL["Scorecard:NoHistory"];
        }

        var onTime = sc.OnTimeRate.HasValue ? $"{sc.OnTimeRate.Value:0.#}%" : InvL["Scorecard:Dash"];
        var fill = sc.FillRate.HasValue ? $"{sc.FillRate.Value:0.#}%" : InvL["Scorecard:Dash"];
        var delay = sc.AvgDelayDays.HasValue ? $"{sc.AvgDelayDays.Value:0.#}d" : InvL["Scorecard:Dash"];
        var lead = sc.MeasuredLeadTimeDays.HasValue
            ? $"{sc.MeasuredLeadTimeDays.Value}d ({sc.LeadTimeSampleSize})"
            : InvL["Scorecard:Dash"];

        return string.Format(
            InvL["Scorecard:Tooltip"],
            sc.TotalOrders, sc.ReceivedOrders, onTime, fill, delay, lead);
    }

    private void OpenCreateDialog()
    {
        _editingId = null;
        _editName = string.Empty;
        _editContactPerson = null;
        _editPhone = null;
        _editEmail = null;
        _editAddress = null;
        _editIsActive = true;
        _editLeadTimeDays = 3;
        _dialogVisible = true;
    }

    private void OpenEditDialog(SupplierDto supplier)
    {
        _editingId = supplier.Id;
        _editName = supplier.Name;
        _editContactPerson = supplier.ContactPerson;
        _editPhone = supplier.Phone;
        _editEmail = supplier.Email;
        _editAddress = supplier.Address;
        _editIsActive = supplier.IsActive;
        _editLeadTimeDays = supplier.LeadTimeDays;
        _dialogVisible = true;
    }

    private void CloseDialog()
    {
        _dialogVisible = false;
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_editName))
        {
            Snackbar.Add(L["ThisFieldIsRequired", InvL["Name"]], Severity.Warning);
            return;
        }

        try
        {
            if (_editingId.HasValue)
            {
                await SupplierAppService.UpdateAsync(_editingId.Value, new UpdateSupplierDto
                {
                    Name = _editName,
                    ContactPerson = _editContactPerson,
                    Phone = _editPhone,
                    Email = _editEmail,
                    Address = _editAddress,
                    IsActive = _editIsActive,
                    LeadTimeDays = _editLeadTimeDays
                });
            }
            else
            {
                await SupplierAppService.CreateAsync(new CreateSupplierDto
                {
                    Name = _editName,
                    ContactPerson = _editContactPerson,
                    Phone = _editPhone,
                    Email = _editEmail,
                    Address = _editAddress,
                    IsActive = _editIsActive,
                    LeadTimeDays = _editLeadTimeDays
                });
            }
            Snackbar.Add(L["SuccessfullySaved"], Severity.Success);
            _dialogVisible = false;
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            await HandleErrorAsync(ex);
        }
    }

    private void DeleteAsync(SupplierDto supplier)
    {
        _pendingDelete = supplier;
        _confirmVisible = true;
    }

    private async Task ConfirmDeleteAsync()
    {
        if (_pendingDelete == null) return;
        try
        {
            await SupplierAppService.DeleteAsync(_pendingDelete.Id);
            Snackbar.Add(L["SuccessfullyDeleted"], Severity.Success);
            _confirmVisible = false;
            _pendingDelete = null;
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            await HandleErrorAsync(ex);
        }
    }
}
