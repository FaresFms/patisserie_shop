</style>

@code {
    private InventoryDashboardDto? _data;
    private bool _loading;
    private DateTime? _lastRefreshed;
    private List<HealthSlice> _healthSlices = new();

    private sealed class HealthSlice
    {
        public string Label { get; set; } = string.Empty;
        public int Count { get; set; }
    }

    // Warm-theme chart styling — hex values mirror glass-theme.css tokens:
    // --success #6b8e4e, --warn #c89c4f, --danger #b3543a, --fg-3 #8a7e6e.
    private readonly ApexChartOptions<HealthSlice> _healthChartOptions = new()
    {
        Chart = new ApexCharts.Chart
        {
            Toolbar = new ApexCharts.Toolbar { Show = false },
            Background = "transparent",
            FontFamily = "Inter, sans-serif",
            ForeColor = "#8a7e6e"
        },
        Colors = new List<string> { "#6b8e4e", "#c89c4f", "#b3543a" },
        DataLabels = new ApexCharts.DataLabels { Enabled = false },
        Legend = new ApexCharts.Legend { Show = false },
        Stroke = new ApexCharts.Stroke { Show = false },
        PlotOptions = new ApexCharts.PlotOptions
        {
            Pie = new ApexCharts.PlotOptionsPie
            {
                Donut = new ApexCharts.PlotOptionsDonut { Size = "74%" }
            }
        }
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _loading = true;
        try
        {
            _data = await DashboardAppService.GetAsync();
            _healthSlices = new List<HealthSlice>
            {
                new() { Label = L["InvDash:Healthy"].Value, Count = _data.HealthyStockCount },
                new() { Label = L["InvDash:LowStock"].Value, Count = _data.LowStockCount },
                new() { Label = L["InvDash:OutOfStock"].Value, Count = _data.OutOfStockCount }
            };
            _lastRefreshed = DateTime.UtcNow;
        }
        catch (Exception ex)
        {
            await HandleErrorAsync(ex);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task RefreshAsync() => await LoadDataAsync();

    private Color GetBranchHealthColor(BranchDashboardStatsDto branch) => branch.HealthPercentage switch
    {
        >= 90 => Color.Success,
        >= 70 => Color.Warning,
        _     => Color.Error
    };

    private string FormatMovementType(string type)
    {
        var localized = InvL[$"MovementType:{type}"];
        return localized.ResourceNotFound ? type : localized.Value;
    }
}
