@code {
    private InventoryDashboardDto? _data;
    private bool _loading;
    private DateTime? _lastRefreshed;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _loading = true;
        try
        {
            _data = await DashboardAppService.GetAsync();
            _lastRefreshed = DateTime.Now;
        }
        catch (Exception ex)
        {
            await HandleErrorAsync(ex);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task RefreshAsync() => await LoadDataAsync();

    private Color GetBranchHealthColor(BranchDashboardStatsDto branch) => branch.HealthPercentage switch
    {
        >= 90 => Color.Success,
        >= 70 => Color.Warning,
        _     => Color.Error
    };

    private string BuildRingStyle()
    {
        if (_data == null) return "";
        var total = _data.TotalInventoryItems;
        if (total == 0) return "background: conic-gradient(#4caf50 0%, #e0e0e0 0%);";

        double healthy = (double)_data.HealthyStockCount / total * 100;
        double low = (double)_data.LowStockCount / total * 100;

        return $"background: conic-gradient(" +
               $"#4caf50 0% {healthy:F1}%, " +
               $"#ff9800 {healthy:F1}% {healthy + low:F1}%, " +
               $"#f44336 {healthy + low:F1}% 100%);";
    }

    private static string FormatMovementType(string type) => type switch
    {
        "Purchase"         => "Purchase",
        "Sale"             => "Sale",
        "TransferIn"       => "Transfer In",
        "TransferOut"      => "Transfer Out",
        "ManualAdjustment" => "Adjustment",
        _                  => type
    };
}
