@page "/inventory/dashboard"
@attribute [Authorize(InventoryPermissions.BranchInventory.Default)]
@using System.Threading.Tasks
@using Microsoft.AspNetCore.Authorization
@using Inventory.Dashboard
@using Inventory.BranchInventory
@using Inventory.StockMovements
@using Inventory.Permissions
@using Inventory.Localization
@using Volo.Abp.AspNetCore.Components.Web.Theming.Layout
@using ApexCharts
@using Color = MudBlazor.Color
@using Size = MudBlazor.Size
@inherits patisserie_shopComponentBase
@inject IInventoryDashboardAppService DashboardAppService
@inject PageLayout PageLayout
@inject IStringLocalizer<InventoryResource> InvL

@{
    PageLayout.Title = L["InvDash:Title"].Value;
}

<div class="dashboard-root">

    @* ── Header Bar ── *@
    <div class="dash-header mb-5">
        <div class="dash-header-left">
            <MudIcon Icon="@Icons.Material.Filled.Dashboard" Class="dash-header-icon" />
            <div>
                <MudText Typo="Typo.h5" Class="dash-title">@L["InvDash:Title"]</MudText>
                <MudText Typo="Typo.body2" Class="dash-subtitle">
                    @if (_lastRefreshed.HasValue)
                    {
                        <BrowserLocalTime Value="@_lastRefreshed.Value"
                                          Display="BrowserTimeDisplay.Time"
                                          Template="@L["InvDash:LastUpdated"]" />
                    }
                    else
                    {
                        <span>@L["InvDash:LoadingData"]</span>
                    }
                </MudText>
            </div>
        </div>
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Refresh"
                   OnClick="RefreshAsync"
                   Disabled="_loading"
                   Class="dash-refresh-btn">
            @(_loading ? L["InvDash:Refreshing"] : L["InvDash:Refresh"])
        </MudButton>
    </div>

    @if (_loading && _data == null)
    {
        <div class="dash-loading-wrap">
            <SoftDonutLoader Fill="true" Label="@L["InvDash:LoadingDashboard"]" />
        </div>
    }
    else if (_data != null)
    {
        @* ── KPI Cards Row ── *@
        <div class="kpi-grid mb-5">
            <SoftCard Class="kpi-card accent-blue">
                <div class="kpi-icon-wrap"><MudIcon Icon="@Icons.Material.Filled.Inventory2" /></div>
                <div class="kpi-body">
                    <div class="kpi-value">@_data.TotalProducts</div>
                    <div class="kpi-label">@L["InvDash:TotalProducts"]</div>
                    <div class="kpi-sub">@L["InvDash:CountActive", _data.ActiveProducts]</div>
                </div>
            </SoftCard>

            <SoftCard Class="kpi-card accent-purple">
                <div class="kpi-icon-wrap"><MudIcon Icon="@Icons.Material.Filled.Store" /></div>
                <div class="kpi-body">
                    <div class="kpi-value">@_data.TotalBranches</div>
                    <div class="kpi-label">@L["InvDash:Branches"]</div>
                    <div class="kpi-sub">@L["InvDash:CountActive", _data.ActiveBranches]</div>
                </div>
            </SoftCard>

            <SoftCard Class="kpi-card accent-teal">
                <div class="kpi-icon-wrap"><MudIcon Icon="@Icons.Material.Filled.Warehouse" /></div>
                <div class="kpi-body">
                    <div class="kpi-value">@_data.TotalInventoryItems</div>
                    <div class="kpi-label">@L["InvDash:InventoryItems"]</div>
                    <div class="kpi-sub">@L["InvDash:CountHealthy", _data.HealthyStockCount]</div>
                </div>
            </SoftCard>

            <SoftCard Class="@($"kpi-card { (_data.LowStockCount > 0 ? "accent-orange" : "accent-green") }")">
                <div class="kpi-icon-wrap"><MudIcon Icon="@Icons.Material.Filled.TrendingDown" /></div>
                <div class="kpi-body">
                    <div class="kpi-value">@_data.LowStockCount</div>
                    <div class="kpi-label">@L["InvDash:LowStock"]</div>
                    <div class="kpi-sub">@L["InvDash:NeedsAttention"]</div>
                </div>
            </SoftCard>

            <SoftCard Class="@($"kpi-card { (_data.OutOfStockCount > 0 ? "accent-red" : "accent-green") }")">
                <div class="kpi-icon-wrap"><MudIcon Icon="@Icons.Material.Filled.RemoveShoppingCart" /></div>
                <div class="kpi-body">
                    <div class="kpi-value">@_data.OutOfStockCount</div>
                    <div class="kpi-label">@L["InvDash:OutOfStock"]</div>
                    <div class="kpi-sub">@(_data.OutOfStockCount == 0 ? L["InvDash:AllClear"] : L["InvDash:Critical"])</div>
                </div>
            </SoftCard>

            <SoftCard Class="kpi-card accent-indigo">
                <div class="kpi-icon-wrap"><MudIcon Icon="@Icons.Material.Filled.Category" /></div>
                <div class="kpi-body">
                    <div class="kpi-value">@_data.TotalCategories</div>
                    <div class="kpi-label">@L["InvDash:Categories"]</div>
                    <div class="kpi-sub">@L["InvDash:CountSuppliers", _data.TotalSuppliers]</div>
                </div>
            </SoftCard>
        </div>

        @* ── Middle Row: Health Overview + Movement Summary ── *@
        <div class="dash-row mb-5">

            @* Stock Health Overview *@
            <SoftCard Class="dash-panel dash-panel--health">
                <div class="panel-header">
                    <MudIcon Icon="@Icons.Material.Filled.MonitorHeart" Class="panel-header-icon" />
                    <MudText Typo="Typo.h6">@L["InvDash:StockHealthOverview"]</MudText>
                </div>
                <div class="panel-body">

                    @{ var total = _data.TotalInventoryItems; }

                    @* Healthy *@
                    <div class="health-row mb-3">
                        <div class="health-row-top">
                            <div class="health-dot health-dot--green"></div>
                            <span class="health-label">@L["InvDash:HealthyStock"]</span>
                            <span class="health-count health-count--green">@_data.HealthyStockCount</span>
                        </div>
                        <MudProgressLinear Color="Color.Success"
                                           Value="@(total > 0 ? (double)_data.HealthyStockCount / total * 100 : 0)"
                                           Rounded="true" Size="Size.Medium" Class="health-bar" />
                        <span class="health-pct">@(total > 0 ? $"{(double)_data.HealthyStockCount / total * 100:F1}" : "0")%</span>
                    </div>

                    @* Low Stock *@
                    <div class="health-row mb-3">
                        <div class="health-row-top">
                            <div class="health-dot health-dot--orange"></div>
                            <span class="health-label">@L["InvDash:LowStock"]</span>
                            <span class="health-count health-count--orange">@_data.LowStockCount</span>
                        </div>
                        <MudProgressLinear Color="Color.Warning"
                                           Value="@(total > 0 ? (double)_data.LowStockCount / total * 100 : 0)"
                                           Rounded="true" Size="Size.Medium" Class="health-bar" />
                        <span class="health-pct">@(total > 0 ? $"{(double)_data.LowStockCount / total * 100:F1}" : "0")%</span>
                    </div>

                    @* Out of Stock *@
                    <div class="health-row">
                        <div class="health-row-top">
                            <div class="health-dot health-dot--red"></div>
                            <span class="health-label">@L["InvDash:OutOfStock"]</span>
                            <span class="health-count health-count--red">@_data.OutOfStockCount</span>
                        </div>
                        <MudProgressLinear Color="Color.Error"
                                           Value="@(total > 0 ? (double)_data.OutOfStockCount / total * 100 : 0)"
                                           Rounded="true" Size="Size.Medium" Class="health-bar" />
                        <span class="health-pct">@(total > 0 ? $"{(double)_data.OutOfStockCount / total * 100:F1}" : "0")%</span>
                    </div>

                    @* Visual donut (ApexCharts) *@
                    <div class="health-donut-wrap">
                        @if (total > 0)
                        {
                            <ApexChart TItem="HealthSlice" @key="_data" Options="_healthChartOptions" Height="230">
                                <ApexPointSeries TItem="HealthSlice"
                                                 Items="_healthSlices"
                                                 Name="@L["InvDash:ItemsSeries"].Value"
                                                 SeriesType="SeriesType.Donut"
                                                 XValue="@(s => s.Label)"
                                                 YValue="@(s => s.Count)" />
                            </ApexChart>
                            <div class="health-donut-center">
                                <div class="health-donut-pct">@($"{(double)_data.HealthyStockCount / total * 100:F0}")%</div>
                                <div class="health-donut-text">@L["InvDash:HealthyLower"]</div>
                            </div>
                        }
                        else
                        {
                            <div class="health-donut-empty">@L["InvDash:NoInventoryItemsYet"]</div>
                        }
                    </div>
                </div>
            </SoftCard>

            @* Movement Summary (last 30 days) *@
            <SoftCard Class="dash-panel dash-panel--movements">
                <div class="panel-header">
                    <MudIcon Icon="@Icons.Material.Filled.SwapHoriz" Class="panel-header-icon" />
                    <MudText Typo="Typo.h6">@L["InvDash:StockMovements"]</MudText>
                    <span class="panel-badge">@L["InvDash:Last30Days"]</span>
                </div>
                <div class="panel-body">
                    <div class="movement-total mb-3">
                        <span class="movement-total-num">@_data.MovementSummary.TotalCount</span>
                        <span class="movement-total-label">@L["InvDash:TotalMovements"]</span>
                    </div>
                    <div class="movement-cards">
                        <div class="mv-card mv-purchase">
                            <MudIcon Icon="@Icons.Material.Filled.ShoppingCart" Class="mv-icon" />
                            <div class="mv-num">@_data.MovementSummary.PurchaseCount</div>
                            <div class="mv-name">@L["InvDash:Purchases"]</div>
                        </div>
                        <div class="mv-card mv-sale">
                            <MudIcon Icon="@Icons.Material.Filled.PointOfSale" Class="mv-icon" />
                            <div class="mv-num">@_data.MovementSummary.SaleCount</div>
                            <div class="mv-name">@L["InvDash:Sales"]</div>
                        </div>
                        <div class="mv-card mv-transfer-in">
                            <MudIcon Icon="@Icons.Material.Filled.CallReceived" Class="mv-icon" />
                            <div class="mv-num">@_data.MovementSummary.TransferInCount</div>
                            <div class="mv-name">@L["InvDash:TransferIn"]</div>
                        </div>
                        <div class="mv-card mv-transfer-out">
                            <MudIcon Icon="@Icons.Material.Filled.CallMade" Class="mv-icon" />
                            <div class="mv-num">@_data.MovementSummary.TransferOutCount</div>
                            <div class="mv-name">@L["InvDash:TransferOut"]</div>
                        </div>
                        <div class="mv-card mv-adjust">
                            <MudIcon Icon="@Icons.Material.Filled.Tune" Class="mv-icon" />
                            <div class="mv-num">@_data.MovementSummary.ManualAdjustmentCount</div>
                            <div class="mv-name">@L["InvDash:Adjustments"]</div>
                        </div>
                    </div>
                </div>
            </SoftCard>

        </div>

        @* ── Branch Performance ── *@
        @if (_data.BranchStats.Any())
        {
            <SoftCard Class="dash-panel dash-panel--full mb-5">
                <div class="panel-header">
                    <MudIcon Icon="@Icons.Material.Filled.BusinessCenter" Class="panel-header-icon" />
                    <MudText Typo="Typo.h6">@L["InvDash:BranchPerformance"]</MudText>
                </div>
                <div class="panel-body pa-0">
                    <table class="branch-table">
                        <thead>
                            <tr>
                                <th>@L["InvDash:Branch"]</th>
                                <th class="text-center">@L["InvDash:TotalItems"]</th>
                                <th class="text-center">@L["InvDash:Healthy"]</th>
                                <th class="text-center">@L["InvDash:LowStock"]</th>
                                <th class="text-center">@L["InvDash:OutOfStock"]</th>
                                <th style="min-width:180px">@L["InvDash:HealthScore"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var branch in _data.BranchStats)
                            {
                                <tr class="@(!branch.IsActive ? "branch-row--inactive" : "")">
                                    <td>
                                        <div class="branch-name-cell">
                                            <MudIcon Icon="@Icons.Material.Filled.Store"
                                                     Style="font-size:16px; margin-right:6px; opacity:.6;" />
                                            <span class="branch-name">@branch.BranchName</span>
                                            @if (!branch.IsActive)
                                            {
                                                <span class="branch-inactive-badge">@L["InvDash:Inactive"]</span>
                                            }
                                        </div>
                                    </td>
                                    <td class="text-center">
                                        <span class="branch-stat-chip">@branch.TotalItems</span>
                                    </td>
                                    <td class="text-center">
                                        <span class="branch-stat-chip chip-green">@branch.HealthyStockCount</span>
                                    </td>
                                    <td class="text-center">
                                        <span class="branch-stat-chip @(branch.LowStockCount > 0 ? "chip-orange" : "")">@branch.LowStockCount</span>
                                    </td>
                                    <td class="text-center">
                                        <span class="branch-stat-chip @(branch.OutOfStockCount > 0 ? "chip-red" : "")">@branch.OutOfStockCount</span>
                                    </td>
                                    <td>
                                        <div class="branch-health-bar-wrap">
                                            <MudProgressLinear Color="@GetBranchHealthColor(branch)"
                                                               Value="@branch.HealthPercentage"
                                                               Rounded="true" Size="Size.Small"
                                                               Class="branch-health-bar" />
                                            <span class="branch-health-pct">@branch.HealthPercentage%</span>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </SoftCard>
        }

        @* ── Bottom Row: Critical Items + Recent Movements ── *@
        <div class="dash-row mb-4">

            @* Critical Stock Items *@
            <SoftCard Class="dash-panel dash-panel--critical">
                <div class="panel-header">
                    <MudIcon Icon="@Icons.Material.Filled.Warning" Class="panel-header-icon panel-header-icon--warning" />
                    <MudText Typo="Typo.h6">@L["InvDash:CriticalStockItems"]</MudText>
                    @if (_data.CriticalStockItems.Any())
                    {
                        <span class="panel-badge panel-badge--red">@_data.CriticalStockItems.Count</span>
                    }
                </div>
                <div class="panel-body pa-0">
                    @if (!_data.CriticalStockItems.Any())
                    {
                        <div class="empty-state">
                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Class="empty-icon empty-icon--green" />
                            <MudText Typo="Typo.body1">@L["InvDash:AllItemsWellStocked"]</MudText>
                        </div>
                    }
                    else
                    {
                        <table class="critical-table">
                            <thead>
                                <tr>
                                    <th>@L["InvDash:Product"]</th>
                                    <th class="text-center">@L["InvDash:OnHand"]</th>
                                    <th class="text-center">@L["InvDash:MinStock"]</th>
                                    <th class="text-center">@L["InvDash:Status"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in _data.CriticalStockItems)
                                {
                                    <tr>
                                        <td>
                                            <div class="product-name-cell">
                                                <span class="product-name">@item.ProductName</span>
                                                <span class="product-sku">@item.ProductSKU</span>
                                            </div>
                                        </td>
                                        <td class="text-center">
                                            <span class="@(item.IsOutOfStock ? "qty-out" : "qty-low")">@item.QuantityOnHand</span>
                                        </td>
                                        <td class="text-center">
                                            <span class="qty-min">@item.MinimumStock</span>
                                        </td>
                                        <td class="text-center">
                                            @if (item.IsOutOfStock)
                                            {
                                                <span class="status-badge status-out">@L["InvDash:OutOfStock"]</span>
                                            }
                                            else
                                            {
                                                <span class="status-badge status-low">@L["InvDash:LowStock"]</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </SoftCard>

            @* Recent Movements *@
            <SoftCard Class="dash-panel dash-panel--recent">
                <div class="panel-header">
                    <MudIcon Icon="@Icons.Material.Filled.History" Class="panel-header-icon" />
                    <MudText Typo="Typo.h6">@L["InvDash:RecentMovements"]</MudText>
                    <span class="panel-badge">@L["InvDash:Last30Days"]</span>
                </div>
                <div class="panel-body pa-0">
                    @if (!_data.RecentMovements.Any())
                    {
                        <div class="empty-state">
                            <MudIcon Icon="@Icons.Material.Outlined.Inbox" Class="empty-icon" />
                            <MudText Typo="Typo.body1">@L["InvDash:NoRecentMovements"]</MudText>
                        </div>
                    }
                    else
                    {
                        <div class="movement-list">
                            @foreach (var mv in _data.RecentMovements)
                            {
                                <div class="movement-item">
                                    <div class="@($"mv-type-dot mv-dot-{mv.MovementType.ToLower()}")"></div>
                                    <div class="mv-item-body">
                                        <div class="mv-item-top">
                                            <span class="mv-product">@mv.ProductName</span>
                                            <span class="@($"mv-type-badge mv-badge-{mv.MovementType.ToLower()}")">@FormatMovementType(mv.MovementType)</span>
                                        </div>
                                        <div class="mv-item-bottom">
                                            <span class="mv-branch">@mv.BranchName</span>
                                            <span class="mv-qty">
                                                @(mv.Quantity > 0 ? $"+{mv.Quantity}" : mv.Quantity.ToString()) @mv.ProductUnit
                                            </span>
                                            <BrowserLocalTime Value="@mv.CreationTime"
                                                              Display="BrowserTimeDisplay.MonthDayTime"
                                                              Class="mv-time" />
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </SoftCard>

        </div>
    }
</div>

<style>
    /* ─── Root ─────────────────────────────────────────── */
    .dashboard-root {
        padding: 4px 0;
        max-width: 1400px;
    }

    /* ─── Header ────────────────────────────────────────── */
    .dash-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 12px;
    }
    .dash-header-left {
        display: flex;
        align-items: center;
        gap: 14px;
    }
    .dash-header-icon {
        font-size: 40px;
        color: var(--accent);
        opacity: .85;
    }
    .dash-title {
        font-weight: 700;
        line-height: 1.2;
    }
    .dash-subtitle {
        opacity: .55;
        font-size: .82rem;
    }
    .dash-refresh-btn {
        border-radius: 8px !important;
    }
    .dash-loading-wrap {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 300px;
    }

    /* ─── KPI Grid ──────────────────────────────────────── */
    .kpi-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        gap: 16px;
    }
    /* Direct children of SoftCard (.mud-card) — the glass theme handles the surface */
    .kpi-card {
        padding: 20px 18px !important;
        display: flex !important;
        align-items: flex-start;
        gap: 14px;
        position: relative;
        overflow: hidden;
    }
    .kpi-card::after {
        content: '';
        position: absolute;
        top: -20px; right: -20px;
        width: 80px; height: 80px;
        border-radius: 50%;
        background: var(--accent-soft);
        pointer-events: none;
    }
    .kpi-card:hover { transform: translateY(-2px); }

    /* Coloured glow strip — accent stays visible through the glass */
    .kpi-card::before {
        content: '';
        position: absolute;
        left: 0; top: 0; bottom: 0;
        width: 4px;
        background: var(--kpi-accent, var(--accent));
        box-shadow: 0 0 24px var(--kpi-accent, var(--accent-line));
    }

    .kpi-icon-wrap {
        background: var(--kpi-accent-soft, var(--accent-soft));
        border-radius: 10px;
        padding: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        box-shadow: var(--shadow-sm);
    }
    .kpi-icon-wrap .mud-icon-root { font-size: 24px; color: var(--kpi-accent, var(--accent)); }
    .kpi-body { flex: 1; z-index: 1; }
    .kpi-value { font-size: 2rem; font-weight: 700; line-height: 1; color: var(--fg-1); }
    .kpi-label { font-size: .78rem; font-weight: 600; margin-top: 4px; text-transform: uppercase; letter-spacing: .04em; color: var(--fg-2); }
    .kpi-sub   { font-size: .75rem; margin-top: 2px; color: var(--fg-3); }

    .accent-blue   { --kpi-accent: #3f7fbf; --kpi-accent-soft: rgba(63, 127, 191, .13); }
    .accent-purple { --kpi-accent: #8b65a8; --kpi-accent-soft: rgba(139, 101, 168, .13); }
    .accent-teal   { --kpi-accent: #3f8f87; --kpi-accent-soft: rgba(63, 143, 135, .13); }
    .accent-orange { --kpi-accent: var(--warn); --kpi-accent-soft: rgba(200, 156, 79, .15); }
    .accent-red    { --kpi-accent: var(--danger); --kpi-accent-soft: rgba(179, 84, 58, .13); }
    .accent-green  { --kpi-accent: var(--success); --kpi-accent-soft: rgba(107, 142, 78, .13); }
    .accent-indigo { --kpi-accent: #6f78b8; --kpi-accent-soft: rgba(111, 120, 184, .13); }

    /* ─── Panels ────────────────────────────────────────── */
    .dash-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
    }
    @@media (max-width: 900px) { .dash-row { grid-template-columns: 1fr; } }

    /* dash-panel is a SoftCard — let the glass theme drive bg/border/shadow */
    .dash-panel {
        overflow: hidden;
        display: block;
    }
    .dash-panel--full { width: 100%; }

    .panel-header {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 16px 20px 12px;
        border-bottom: 1px solid var(--bd-1);
        flex-wrap: wrap;
    }
    .panel-header-icon {
        font-size: 22px;
        color: var(--accent);
        opacity: .8;
    }
    .panel-header-icon--warning { color: #ff9800 !important; }
    .panel-header .mud-typography-h6 { font-weight: 600; flex: 1; }
    .panel-badge {
        font-size: .7rem;
        font-weight: 600;
        background: var(--hover);
        color: var(--fg-2);
        padding: 2px 8px;
        border-radius: 20px;
        letter-spacing: .03em;
    }
    .panel-badge--red {
        background: rgba(211,47,47,.12);
        color: #d32f2f;
    }
    .panel-body { padding: 20px; }
    .panel-body.pa-0 { padding: 0; }

    /* ─── Health Panel ──────────────────────────────────── */
    .health-row { }
    .health-row-top {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 6px;
    }
    .health-dot {
        width: 10px; height: 10px;
        border-radius: 50%;
        flex-shrink: 0;
    }
    .health-dot--green  { background: #4caf50; }
    .health-dot--orange { background: #ff9800; }
    .health-dot--red    { background: #f44336; }
    .health-label { flex: 1; font-size: .88rem; font-weight: 500; }
    .health-count {
        font-size: .88rem;
        font-weight: 700;
        padding: 1px 8px;
        border-radius: 12px;
    }
    .health-count--green  { background: rgba(76,175,80,.12);  color: #2e7d32; }
    .health-count--orange { background: rgba(255,152,0,.12);  color: #e65100; }
