@page "/cashier"
@attribute [Authorize(OperationsPermissions.Cashier.Default)]
@using System.Globalization
@using System.Text.Json
@using System.Threading.Tasks
@using Microsoft.AspNetCore.Authorization
@using Microsoft.JSInterop
@using Volo.Abp.AspNetCore.Components.Web.Theming.Layout
@using Volo.Abp.Settings
@using Operations.Cashier
@using Operations.Permissions
@using patisserie_shop.Cashier
@using Color = MudBlazor.Color
@using Variant = MudBlazor.Variant
@using Size = MudBlazor.Size
@inherits patisserie_shopComponentBase
@inject ICashierAppService CashierAppService
@inject ICashierReportAppService CashierReportAppService
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject PageLayout PageLayout
@inject Volo.Abp.Settings.ISettingProvider SettingProvider

@{
    PageLayout.Title = L["Cashier:Title"];
}

<div class="pos-root">
    @if (_loading)
    {
        <div class="pos-center">
            <SoftProgressCircular Indeterminate="true" Color="Color.Primary" />
        </div>
    }
    else if (_myBranch is null)
    {
        @* ─────────── NO BRANCH ASSIGNED ─────────── *@
        <div class="pos-center">
            <SoftIcon Icon="@Icons.Material.Outlined.Storefront" Style="font-size:56px;opacity:.4;" />
            <h1 class="pos-gate-title">@L["Cashier:NoBranchTitle"]</h1>
            <div class="pos-gate-sub">@L["Cashier:NoBranchSub"]</div>
        </div>
    }
    else if (_shift is null)
    {
        @* ─────────── SHIFT GATE ─────────── *@
        <div class="pos-gate">
            <div class="pos-gate-card">
                <div class="pos-gate-head">
                    <SoftIcon Icon="@Icons.Material.Filled.PointOfSale" Color="Color.Primary" Style="font-size:40px;" />
                    <h1 class="pos-gate-title">@L["Cashier:OpenShiftTitle"]</h1>
                    <div class="pos-gate-sub">@L["Cashier:OpenShiftSub"]</div>
                </div>

                <div class="pos-field-label">@L["Cashier:Branch"]</div>
                <div class="pos-branch-fixed">@_myBranch.Name</div>

                <div class="pos-field-label">@L["Cashier:OpeningFloat"]</div>
                <div class="pos-amount-display" tabindex="0"
                     @onkeydown="@(e => HandleAmountKey(e, EditFloatDigit, EditFloatBackspace, EditFloatClear))">@FormatMoney(_floatEntry)</div>

                @KeypadFor(EditFloatDigit, EditFloatBackspace, EditFloatClear)

                <button type="button" class="pos-primary-btn pos-gate-btn"
                        disabled="@_busy" @onclick="OpenShiftAsync">
                    <SoftIcon Icon="@Icons.Material.Filled.LockOpen" Class="mr-2" />
                    @L["Cashier:OpenShift"]
                </button>
            </div>
        </div>
    }
    else
    {
        @* ─────────── HEADER STRIP ─────────── *@
        <div class="pos-header">
            <div class="pos-header-left">
                <div class="pos-header-branch">@(_shift.BranchName ?? "")</div>
                <div class="pos-header-meta">
                    @L["Cashier:Opened"] @_shift.OpenedAt.ToLocalTime().ToString("t", CultureInfo.CurrentCulture)
                </div>
            </div>
            <div class="pos-header-stats">
                <div class="pos-hstat">
                    <span class="pos-hstat-label">@L["Cashier:ExpectedCash"]</span>
                    <span class="pos-hstat-value">@FormatMoney(_shift.ExpectedCash)</span>
                </div>
                <div class="pos-hstat">
                    <span class="pos-hstat-label">@L["Cashier:TodayTotal"]</span>
                    <span class="pos-hstat-value">@FormatMoney(_shift.SalesTotal) · @_shift.SalesCount</span>
                </div>
            </div>
            <div class="pos-header-actions">
                <button type="button" class="pos-chip-btn" @onclick="OpenHeldAsync">
                    <SoftIcon Icon="@Icons.Material.Filled.Inventory2" Size="Size.Small" Class="mr-1" />
                    @L["Cashier:Held", _heldCarts.Count]
                </button>
                <button type="button" class="pos-chip-btn pos-chip-danger" @onclick="OpenCloseShiftDialog">
                    <SoftIcon Icon="@Icons.Material.Filled.Logout" Size="Size.Small" Class="mr-1" />
                    @L["Cashier:CloseShift"]
                </button>
            </div>
        </div>

        @* ─────────── TWO-PANE BODY ─────────── *@
        <div class="pos-body">
            @* LEFT — product tiles *@
            <div class="pos-left">
                <div class="pos-search-row">
                    <input class="pos-scan" placeholder="@L["Cashier:ScanOrSku"]"
                           @bind="_scanEntry" @bind:event="oninput"
                           @onkeydown="OnScanKeyDownAsync" />
                    <input class="pos-search" placeholder="@L["Cashier:SearchProducts"]"
                           @bind="_filter" @bind:event="oninput"
                           @onkeydown="OnFilterKeyDownAsync" />
                </div>

                @if (_tilesLoading)
                {
                    <div class="pos-center"><SoftProgressCircular Indeterminate="true" Color="Color.Primary" /></div>
                }
                else if (_tiles.Count == 0)
                {
                    <div class="pos-empty">@L["Cashier:NoProducts"]</div>
                }
                else
                {
                    <div class="pos-tiles">
                        @foreach (var p in _tiles)
                        {
                            var remaining = RemainingFor(p);
                            var cannotAdd = remaining <= 0;
                            <div class="pos-tile @(cannotAdd ? "is-oos" : "")"
                                 @onclick="() => AddToCart(p)">
                                <button type="button" class="pos-tile-info"
                                        title="Product details"
                                        @onclick:stopPropagation="true"
                                        @onclick="() => OpenProductInfo(p)">
                                    <SoftIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" />
                                </button>
                                @if (remaining == 1)
                                {
                                    <span class="pos-tile-badge">@L["Cashier:LastOne"]</span>
                                }
                                else if (p.IsLowStock && !p.IsOutOfStock)
                                {
                                    <span class="pos-tile-badge">@L["Cashier:RunningLow"]</span>
                                }
                                <div class="pos-tile-img">
                                    @if (!string.IsNullOrWhiteSpace(p.ImageUrl))
                                    {
                                        <img src="@p.ImageUrl" alt="@p.Name" />
                                    }
                                    else
                                    {
                                        <span class="pos-tile-initial">@Initial(p.Name)</span>
                                    }
                                </div>
                                <div class="pos-tile-name">@p.Name</div>
                                <div class="pos-tile-price">@FormatMoney(p.SalePrice)</div>
                                @if (p.IsOutOfStock)
                                {
                                    <div class="pos-tile-oos">@L["Cashier:OutOfStock"]</div>
                                }
                                else if (p.IsLowStock)
                                {
                                    var reportPending = _pendingReportProductIds.Contains(p.ProductId);
                                    <button type="button" class="pos-tile-report"
                                            disabled="@reportPending"
                                            @onclick:stopPropagation="true"
                                            @onclick="() => ReportLowStockAsync(p)">
                                        @(reportPending ? L["Cashier:ReportPending"] : L["Cashier:Report"])
                                    </button>
                                }
                            </div>
                        }
                    </div>
                }
            </div>

            @* RIGHT — cart *@
            <div class="pos-right">
                <div class="pos-cart-head">
                    <span class="pos-cart-title">@L["Cashier:Cart"]</span>
                    @if (_cart.Count > 0)
                    {
                        <button type="button" class="pos-link-btn" @onclick="ClearCart">@L["Cashier:ClearCart"]</button>
                    }
                </div>

                <div class="pos-cart-lines">
                    @if (_cart.Count == 0)
                    {
                        <div class="pos-empty">@L["Cashier:CartEmpty"]</div>
                    }
                    else
                    {
                        @foreach (var line in _cart)
                        {
                            <div class="pos-line">
                                <div class="pos-line-info">
                                    <div class="pos-line-name">@line.Name</div>
                                    <div class="pos-line-price">@FormatMoney(line.UnitPrice)</div>
                                    @if (line.AvailableQuantity > 0 && line.Quantity >= line.AvailableQuantity)
                                    {
                                        <div class="pos-line-stock">@L["Cashier:LastAvailableInCart"]</div>
                                    }
                                </div>
                                <div class="pos-stepper">
                                    <button type="button" class="pos-step" @onclick="() => DecLine(line)">−</button>
                                    <span class="pos-step-qty">@line.Quantity</span>
                                    <button type="button" class="pos-step"
                                            disabled="@(line.AvailableQuantity <= 0 || line.Quantity >= line.AvailableQuantity)"
                                            @onclick="() => IncLine(line)">+</button>
                                </div>
                                <div class="pos-line-sub">@FormatMoney(line.Subtotal)</div>
                                <button type="button" class="pos-line-remove" title="@L["Cashier:Remove"]"
                                        @onclick="() => RemoveLine(line)">×</button>
                            </div>
                        }
                    }
                </div>

                <div class="pos-total-row">
                    <span class="pos-total-label">@L["Cashier:Total"]</span>
                    <span class="pos-total-value">@FormatMoney(CartTotal)</span>
                </div>

                <div class="pos-pay">
                    <div class="pos-pay-row">
                        <span class="pos-pay-label">@L["Cashier:CashTendered"]</span>
                        <span class="pos-pay-value" tabindex="0"
                              @onkeydown="@(e => HandleAmountKey(e, EditTenderedDigit, EditTenderedBackspace, EditTenderedClear))">@FormatMoney(_tendered)</span>
                    </div>
                    <div class="pos-pay-row">
                        <span class="pos-pay-label">@L["Cashier:ChangeDue"]</span>
                        <span class="pos-pay-value @(ChangeDue < 0 ? "is-neg" : "")">@FormatMoney(ChangeDue)</span>
                    </div>
                    @if (_cart.Count > 0 && _tendered < CartTotal)
                    {
                        <div class="pos-pay-short">@L["Cashier:CashShort", FormatMoney(CartTotal - _tendered)]</div>
                    }

                    @KeypadFor(EditTenderedDigit, EditTenderedBackspace, EditTenderedClear, exact: true)

                    <div class="pos-pay-actions">
                        <button type="button" class="pos-secondary-btn"
                                disabled="@(_cart.Count == 0 || _busy)" @onclick="HoldCartAsync">
                            <SoftIcon Icon="@Icons.Material.Filled.PauseCircle" Class="mr-1" />
                            @L["Cashier:Hold"]
                        </button>
                        <button type="button" class="pos-primary-btn pos-charge-btn"
                                disabled="@(_cart.Count == 0 || _tendered < CartTotal || _busy)" @onclick="ChargeAsync">
                            <SoftIcon Icon="@Icons.Material.Filled.PointOfSale" Class="mr-2" />
                            @(_busy ? L["Cashier:Charging"] : $"{L["Cashier:Charge"]} · {FormatMoney(CartTotal)}")
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@* ─────────── PRODUCT INFO MODAL ─────────── *@
@if (_infoProduct is not null)
{
    var infoRemaining = RemainingFor(_infoProduct);
    <div class="glass-modal-backdrop" @onclick="CloseProductInfo">
        <div class="glass-modal-container glass-modal-container--md" @onclick:stopPropagation="true">
            <SoftCard Elevation="24" Class="glass-modal pos-info-modal">
                <SoftCardHeader Class="pa-4">
                    <CardHeaderContent>
                        <SoftStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <SoftIcon Icon="@Icons.Material.Filled.Info" Color="Color.Primary" Size="Size.Medium" />
                            <SoftText Typo="Typo.h6">@_infoProduct.Name</SoftText>
                        </SoftStack>
                    </CardHeaderContent>
                    <CardHeaderActions>
                        <SoftIconButton Icon="@Icons.Material.Filled.Close"
                                        Size="Size.Small"
                                        OnClick="CloseProductInfo" />
                    </CardHeaderActions>
                </SoftCardHeader>
                <SoftDivider />
                <SoftCardContent Class="pa-4">
                    <div class="pos-info-layout">
                        <div class="pos-info-photo">
                            @if (!string.IsNullOrWhiteSpace(_infoProduct.ImageUrl))
                            {
                                <img src="@_infoProduct.ImageUrl" alt="@_infoProduct.Name" />
                            }
                            else
                            {
                                <span class="pos-info-initial">@Initial(_infoProduct.Name)</span>
                            }
                        </div>
                        <div class="pos-info-copy">
                            <div class="pos-info-sku">@_infoProduct.SKU</div>
                            <div class="pos-info-price">@FormatMoney(_infoProduct.SalePrice)</div>
                            <p class="pos-info-desc">@ProductDescription(_infoProduct)</p>
                            <div class="pos-info-stock @StockInfoClass(_infoProduct, infoRemaining)">
                                <SoftIcon Icon="@StockInfoIcon(_infoProduct, infoRemaining)" Size="Size.Small" />
                                <span>@StockInfoText(_infoProduct, infoRemaining)</span>
                            </div>
                        </div>
                    </div>
                </SoftCardContent>
                <SoftDivider />
                <div class="pa-3 d-flex justify-end" style="gap:8px;">
                    <SoftButton Variant="Variant.Text" OnClick="CloseProductInfo">@L["Cancel"]</SoftButton>
                    <SoftButton Variant="Variant.Filled"
                                Color="Color.Primary"
                                StartIcon="@Icons.Material.Filled.AddShoppingCart"
                                Disabled="@(infoRemaining <= 0)"
                                OnClick="AddInfoProductToCart">
                        @L["Cashier:AddToCart"]
                    </SoftButton>
                </div>
            </SoftCard>
        </div>
    </div>
}

@* ─────────── RECEIPT MODAL ─────────── *@
@if (_receipt is not null)
{
    <div class="glass-modal-backdrop">
        <div class="glass-modal-container glass-modal-container--sm" @onclick:stopPropagation="true">
            <SoftCard Elevation="24" Class="glass-modal">
                <div class="pos-print-area">
                    <div class="pos-receipt">
                        <div class="pos-receipt-head">
                            <div class="pos-receipt-shop">@_shopName</div>
                            @if (!string.IsNullOrWhiteSpace(_shift?.BranchName))
                            {
                                <div class="pos-receipt-branch">@_shift!.BranchName</div>
                            }
                            @if (!string.IsNullOrWhiteSpace(_shopAddress))
                            {
                                <div class="pos-receipt-addr">@_shopAddress</div>
                            }
                            @if (!string.IsNullOrWhiteSpace(_shopPhone))
                            {
                                <div class="pos-receipt-addr">@_shopPhone</div>
                            }
                            <div class="pos-receipt-inv">@L["Cashier:Invoice"] @_receipt.InvoiceNumber</div>
                            <div class="pos-receipt-date">@_receipt.SaleDate.ToLocalTime().ToString("g", CultureInfo.CurrentCulture)</div>
                        </div>
                        <div class="pos-receipt-lines">
                            @foreach (var l in _receipt.Lines)
                            {
                                <div class="pos-receipt-line">
                                    <span class="pos-receipt-qty">@l.Quantity×</span>
                                    <span class="pos-receipt-name">@l.ProductName</span>
                                    <span class="pos-receipt-amt">@FormatMoney(l.Subtotal)</span>
                                </div>
                            }
                        </div>
                        <div class="pos-receipt-foot">
                            <div class="pos-receipt-trow pos-receipt-total">
                                <span>@L["Cashier:Total"]</span><span>@FormatMoney(_receipt.Total)</span>
                            </div>
                            @if (_receiptTendered.HasValue)
                            {
                                <div class="pos-receipt-trow">
                                    <span>@L["Cashier:CashTendered"]</span><span>@FormatMoney(_receiptTendered.Value)</span>
                                </div>
                            }
                            @if (_receipt.ChangeDue.HasValue)
                            {
                                <div class="pos-receipt-trow">
                                    <span>@L["Cashier:ChangeDue"]</span><span>@FormatMoney(_receipt.ChangeDue.Value)</span>
                                </div>
                            }
                        </div>
                        @if (!string.IsNullOrWhiteSpace(_receiptFooter))
                        {
                            <div class="pos-receipt-thanks">@_receiptFooter</div>
                        }
                    </div>
                </div>
                <SoftDivider />
                <div class="pa-3 d-flex justify-end pos-noprint" style="gap:8px;">
                    <SoftButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Print" OnClick="PrintReceiptAsync">
                        @L["Cashier:Print"]
                    </SoftButton>
                    <SoftButton Variant="Variant.Filled" Color="Color.Primary"
                                StartIcon="@Icons.Material.Filled.AddShoppingCart" OnClick="NewSale">
                        @L["Cashier:NewSale"]
                    </SoftButton>
                </div>
            </SoftCard>
        </div>
    </div>
}

@* ─────────── HELD CARTS MODAL ─────────── *@
@if (_heldVisible)
{
    <div class="glass-modal-backdrop" @onclick="() => _heldVisible = false">
        <div class="glass-modal-container glass-modal-container--sm" @onclick:stopPropagation="true">
            <SoftCard Elevation="24" Class="glass-modal">
                <SoftCardHeader Class="pa-4">
                    <CardHeaderContent>
                        <SoftStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <SoftIcon Icon="@Icons.Material.Filled.Inventory2" Color="Color.Primary" Size="Size.Medium" />
                            <SoftText Typo="Typo.h6">@L["Cashier:HeldCarts"]</SoftText>
                        </SoftStack>
                    </CardHeaderContent>
                    <CardHeaderActions>
                        <SoftIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                                        OnClick="() => _heldVisible = false" />
                    </CardHeaderActions>
                </SoftCardHeader>
                <SoftDivider />
                <SoftCardContent Class="pa-3">
                    @if (_heldCarts.Count == 0)
                    {
                        <div class="pos-empty">@L["Cashier:NoHeldCarts"]</div>
                    }
                    else
                    {
                        @foreach (var h in _heldCarts)
                        {
                            <div class="pos-held-row">
                                <div class="pos-held-info">
                                    <div class="pos-held-label">@h.Label</div>
                                    <div class="pos-held-meta">
                                        @L["Cashier:Items", h.Lines.Sum(x => x.Quantity)] · @FormatMoney(h.Lines.Sum(x => x.Subtotal))
                                    </div>
                                </div>
                                <button type="button" class="pos-chip-btn" @onclick="() => ResumeHeld(h)">@L["Cashier:Resume"]</button>
                                <button type="button" class="pos-chip-btn pos-chip-danger" @onclick="() => DiscardHeld(h)">@L["Cashier:Discard"]</button>
                            </div>
                        }
                    }
                </SoftCardContent>
            </SoftCard>
        </div>
    </div>
}

@* ─────────── CLOSE SHIFT MODAL ─────────── *@
@if (_closeVisible)
{
    <div class="glass-modal-backdrop">
        <div class="glass-modal-container glass-modal-container--sm" @onclick:stopPropagation="true">
            <SoftCard Elevation="24" Class="glass-modal">
                <SoftCardHeader Class="pa-4">
                    <CardHeaderContent>
                        <SoftStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <SoftIcon Icon="@Icons.Material.Filled.Logout" Color="Color.Primary" Size="Size.Medium" />
                            <SoftText Typo="Typo.h6">@L["Cashier:CloseShiftTitle"]</SoftText>
                        </SoftStack>
                    </CardHeaderContent>
                    <CardHeaderActions>
                        <SoftIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                                        OnClick="() => _closeVisible = false" />
                    </CardHeaderActions>
                </SoftCardHeader>
                <SoftDivider />
                <SoftCardContent Class="pa-4">
                    <div class="pos-gate-sub mb-2">@L["Cashier:CloseShiftSub"]</div>
                    <div class="pos-field-label">@L["Cashier:CountedCash"]</div>
                    <div class="pos-amount-display" tabindex="0"
                         @onkeydown="@(e => HandleAmountKey(e, EditCountedDigit, EditCountedBackspace, EditCountedClear))">@FormatMoney(_countedEntry)</div>
                    @KeypadFor(EditCountedDigit, EditCountedBackspace, EditCountedClear)

                    @* Live reconciliation preview — the cashier sees the variance BEFORE
                       committing, so closing is a single confirmed step. *@
                    @if (_shift is not null)
                    {
                        var previewVariance = _countedEntry - _shift.ExpectedCash;
                        <div class="pos-recon mt-3">
                            <div class="pos-recon-row">
                                <span>@L["Cashier:Expected"]</span><span>@FormatMoney(_shift.ExpectedCash)</span>
                            </div>
                            <div class="pos-recon-row pos-recon-variance @VarianceClass(previewVariance)">
                                <span>@L["Cashier:Variance"]</span>
                                <span>@FormatMoney(previewVariance) · @VarianceLabel(previewVariance)</span>
                            </div>
                        </div>
                    }
                    <button type="button" class="pos-primary-btn pos-gate-btn mt-3"
                            disabled="@_busy" @onclick="CloseShiftAsync">
                        <SoftIcon Icon="@Icons.Material.Filled.Check" Class="mr-2" />
                        @L["Cashier:CloseShift"]
                    </button>
                </SoftCardContent>
            </SoftCard>
        </div>
    </div>
}

@code {
    // ─── state ───
    private bool _loading = true;
    private bool _tilesLoading;
    private bool _busy;

    private CashierBranchDto? _myBranch;
    private CashierShiftDto? _shift;

    private List<CashierProductDto> _tiles = new();
    private string? _filter;
    private string? _scanEntry;

    private readonly List<CartLine> _cart = new();
    private readonly HashSet<Guid> _pendingReportProductIds = new();
    private decimal _tendered;

    // numeric keypad buffers (string-built, two decimals)
    private decimal _floatEntry;
    private decimal _countedEntry;

    private readonly List<HeldCart> _heldCarts = new();
    private bool _heldVisible;

    private bool _closeVisible;

    private CashierSaleResultDto? _receipt;
    private decimal? _receiptTendered;

    private CashierProductDto? _infoProduct;

    // Shop branding for the printed receipt — loaded from shop settings.
    private string _shopName = "Patisserie Shop";
    private string? _shopAddress;
    private string? _shopPhone;
    private string? _receiptFooter;
    private string _currency = "USD";

    private Guid BranchId => _shift?.BranchId ?? _myBranch?.Id ?? Guid.Empty;
    private decimal CartTotal => _cart.Sum(l => l.Subtotal);
    private decimal ChangeDue => _tendered - CartTotal;

    protected override async Task OnInitializedAsync()
    {
        // Receipt branding from shop settings. Defensive so a settings read
        // failure never blocks the cashier from opening a shift or selling.
        try
        {
            _shopName = await SettingProvider.GetOrNullAsync("patisserie_shop.Shop.Name") ?? "Patisserie Shop";
            _shopAddress = await SettingProvider.GetOrNullAsync("patisserie_shop.Shop.Address");
            _shopPhone = await SettingProvider.GetOrNullAsync("patisserie_shop.Shop.Phone");
            _receiptFooter = await SettingProvider.GetOrNullAsync("patisserie_shop.Shop.ReceiptFooterMessage");
            _currency = (await SettingProvider.GetOrNullAsync("patisserie_shop.Operations.DefaultCurrency") ?? "USD").Trim().ToUpperInvariant();
        }
        catch
        {
            _shopName = "Patisserie Shop";
        }

        try
        {
            // The cashier operates their single assigned branch — no picker.
            _myBranch = await CashierAppService.GetMyBranchAsync();
            if (_myBranch is not null)
            {
                await TryLoadShiftAsync();
            }
        }
        catch (Exception)
        {
            Snackbar.Add(L["Cashier:LoadFailed"], Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task TryLoadShiftAsync()
    {
        if (_myBranch is null) return;

        var s = await CashierAppService.GetCurrentShiftAsync(_myBranch.Id);
        if (s is not null)
        {
            _shift = s;
            await LoadTilesAsync();
        }
    }

    // ─── shift gate ───
    private async Task OpenShiftAsync()
    {
        if (_busy || _myBranch is null) return;
        _busy = true;
        try
        {
            _shift = await CashierAppService.OpenShiftAsync(new OpenShiftDto
            {
                BranchId = _myBranch.Id,
                OpeningFloat = _floatEntry
            });
            Snackbar.Add(L["Cashier:ShiftOpened"], Severity.Success);
            await LoadTilesAsync();
        }
        catch (Exception)
        {
            Snackbar.Add(L["Cashier:OpenShiftFailed"], Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    // ─── tiles ───
    private async Task LoadTilesAsync()
    {
        if (_shift is null) return;
        _tilesLoading = true;
        try
        {
            _tiles = await CashierAppService.GetProductTilesAsync(_shift.BranchId, _filter);
            await LoadPendingReportsAsync();
        }
        catch (Exception)
        {
            Snackbar.Add(L["Cashier:LoadFailed"], Severity.Error);
        }
        finally
        {
            _tilesLoading = false;
        }
    }

    private async Task OnFilterKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await LoadTilesAsync();
        }
    }

    private async Task OnScanKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key != "Enter" || string.IsNullOrWhiteSpace(_scanEntry)) return;

        var code = _scanEntry.Trim();
        var match = _tiles.FirstOrDefault(t =>
            string.Equals(t.SKU, code, StringComparison.OrdinalIgnoreCase));

        // If it's not in the current (filtered) tile set, query the server by the code.
        if (match is null && _shift is not null)
        {
            var hits = await CashierAppService.GetProductTilesAsync(_shift.BranchId, code);
            match = hits.FirstOrDefault(t => string.Equals(t.SKU, code, StringComparison.OrdinalIgnoreCase))
                    ?? hits.FirstOrDefault();
        }

        if (match is not null && !match.IsOutOfStock)
        {
            AddToCart(match);
            _scanEntry = string.Empty;
        }
        else
        {
            Snackbar.Add(L["Cashier:SkuNotFound", code], Severity.Warning);
        }
    }

    private async Task ReportLowStockAsync(CashierProductDto p)
    {
        if (_shift is null) return;
        if (_pendingReportProductIds.Contains(p.ProductId))
        {
            Snackbar.Add(L["Cashier:ReportAlreadyPending"], Severity.Info);
            return;
        }

        try
        {
            await CashierReportAppService.ReportLowStockAsync(new ReportLowStockInput
            {
                ProductId = p.ProductId,
                BranchId = _shift.BranchId
            });
            _pendingReportProductIds.Add(p.ProductId);
            Snackbar.Add(L["Cashier:Reported"], Severity.Info);
        }
        catch (Exception)
        {
            Snackbar.Add(L["Cashier:ReportFailed"], Severity.Error);
        }
    }

    private async Task LoadPendingReportsAsync()
    {
        if (_shift is null)
        {
            _pendingReportProductIds.Clear();
            return;
        }

        try
        {
            var productIds = await CashierReportAppService.GetPendingLowStockProductIdsAsync(_shift.BranchId);
            _pendingReportProductIds.Clear();
            foreach (var productId in productIds)
            {
                _pendingReportProductIds.Add(productId);
            }
        }
        catch
        {
            _pendingReportProductIds.Clear();
        }
    }


    // ─── cart ───
    private void AddToCart(CashierProductDto p)
    {
        if (p.IsOutOfStock || p.QuantityOnHand <= 0)
        {
            Snackbar.Add(L["Cashier:OutOfStock"], Severity.Warning);
            return;
        }

        var line = _cart.FirstOrDefault(l => l.ProductId == p.ProductId);
        if (line is null)
        {
            _cart.Add(new CartLine
            {
                ProductId = p.ProductId,
                Name = p.Name,
                UnitPrice = p.SalePrice,
                Quantity = 1,
                AvailableQuantity = p.QuantityOnHand
            });

            if (p.QuantityOnHand == 1)
            {
                Snackbar.Add(L["Cashier:LastOneNotice", p.Name], Severity.Info);
            }
        }
        else
        {
            line.AvailableQuantity = p.QuantityOnHand;
            IncLine(line);
        }
    }

    private void OpenProductInfo(CashierProductDto product)
    {
        _infoProduct = product;
    }

    private void CloseProductInfo()
    {
        _infoProduct = null;
    }

    private void AddInfoProductToCart()
    {
        if (_infoProduct is null)
        {
            return;
        }

        AddToCart(_infoProduct);
        if (RemainingFor(_infoProduct) <= 0)
        {
            _infoProduct = null;
        }
    }

    private void IncLine(CartLine line)
    {
        if (line.AvailableQuantity <= 0 || line.Quantity >= line.AvailableQuantity)
        {
            Snackbar.Add(L["Cashier:OnlyXAvailable", line.AvailableQuantity, line.Name], Severity.Warning);
            return;
        }

        line.Quantity++;

        if (line.Quantity == line.AvailableQuantity)
        {
            Snackbar.Add(L["Cashier:LastOneNotice", line.Name], Severity.Info);
        }
    }

    private void DecLine(CartLine line)
    {
        line.Quantity--;
        if (line.Quantity <= 0) _cart.Remove(line);
    }

    private void RemoveLine(CartLine line) => _cart.Remove(line);

    private void ClearCart()
    {
        _cart.Clear();
        _tendered = 0;
    }

    private async Task<bool> RefreshCartAvailabilityAsync()
    {
        if (_shift is null || _cart.Count == 0)
        {
            return true;
        }

        var latest = await CashierAppService.GetProductTilesAsync(_shift.BranchId, null);
        var byProduct = latest.ToDictionary(p => p.ProductId);
        var changed = false;

        foreach (var line in _cart.ToList())
        {
            if (!byProduct.TryGetValue(line.ProductId, out var product) || product.QuantityOnHand <= 0)
            {
                _cart.Remove(line);
                changed = true;
                Snackbar.Add(L["Cashier:OutOfStockRemoved", line.Name], Severity.Warning);
                continue;
            }

            line.AvailableQuantity = product.QuantityOnHand;
            if (line.Quantity > product.QuantityOnHand)
            {
                line.Quantity = product.QuantityOnHand;
                changed = true;
                Snackbar.Add(L["Cashier:OnlyXAvailable", product.QuantityOnHand, line.Name], Severity.Warning);
            }
        }

        await LoadTilesAsync();

        if (changed && _cart.Count == 0)
        {
            _tendered = 0;
        }

        return !changed;
    }

    // ─── charge ───
    private async Task ChargeAsync()
    {
        if (_busy || _cart.Count == 0 || _shift is null) return;
        _busy = true;
        try
        {
            if (!await RefreshCartAvailabilityAsync())
            {
                return;
            }

            var tendered = _tendered;
            var result = await CashierAppService.RecordSaleAsync(new RecordCashierSaleDto
            {
                BranchId = _shift.BranchId,
                CashTendered = tendered,
                Lines = _cart.Select(l => new RecordCashierSaleLineDto
                {
                    ProductId = l.ProductId,
                    Quantity = l.Quantity
                }).ToList()
            });

            _receipt = result;
            _receiptTendered = tendered;
            _cart.Clear();
            _tendered = 0;

            // Refresh the live drawer figures + tiles (stock flags may have changed).
            _shift = await CashierAppService.GetCurrentShiftAsync(_shift.BranchId) ?? _shift;
            await LoadTilesAsync();
        }
        catch (Exception ex)
        {
            await HandleErrorAsync(ex);
            await RefreshCartAvailabilityAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private void NewSale()
    {
        _receipt = null;
        _receiptTendered = null;
    }

    private async Task PrintReceiptAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("posPrintReceipt");
        }
        catch
        {
            // Printing is best-effort; ignore interop failures.
        }
    }

    // ─── hold / park ───
    private async Task HoldCartAsync()
    {
        if (_cart.Count == 0) return;
        _heldCarts.Add(new HeldCart
        {
            Label = DateTime.Now.ToString("t", CultureInfo.CurrentCulture),
            Lines = _cart.Select(l => l.Clone()).ToList()
        });
        ClearCart();
        Snackbar.Add(L["Cashier:CartHeld"], Severity.Info);
        await Task.CompletedTask;
    }

    private async Task OpenHeldAsync()
    {
        _heldVisible = true;
        await Task.CompletedTask;
    }

    private void ResumeHeld(HeldCart h)
    {
        // Park whatever's currently in the cart first so nothing is lost.
        if (_cart.Count > 0)
        {
            _heldCarts.Add(new HeldCart
            {
                Label = DateTime.Now.ToString("t", CultureInfo.CurrentCulture),
                Lines = _cart.Select(l => l.Clone()).ToList()
            });
        }
        _cart.Clear();
        _cart.AddRange(h.Lines.Select(l => l.Clone()));
        _heldCarts.Remove(h);
        _heldVisible = false;
    }

    private void DiscardHeld(HeldCart h) => _heldCarts.Remove(h);

    // ─── close shift ───
    private void OpenCloseShiftDialog()
    {
        _countedEntry = 0;
        _closeVisible = true;
    }

    private async Task CloseShiftAsync()
    {
        if (_busy || _shift is null) return;
        _busy = true;
        try
        {
            var closed = await CashierAppService.CloseShiftAsync(new CloseShiftDto
            {
                ShiftId = _shift.Id,
                CountedCash = _countedEntry
            });

            // One step: the variance was previewed before confirming, so summarize in
            // a toast and return straight to the shift gate — no extra "Done" tap.
            Snackbar.Add(
                string.Format(L["Cashier:ShiftClosedToast"],
                    FormatMoney(closed.Variance ?? 0), VarianceLabel(closed.Variance)),
                (closed.Variance ?? 0) == 0 ? Severity.Success : Severity.Warning);

            await FinishCloseAsync();
        }
        catch (Exception)
        {
            Snackbar.Add(L["Cashier:CloseShiftFailed"], Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task FinishCloseAsync()
    {
        await ClearPersistedCartAsync();
        _closeVisible = false;
        _shift = null;       // back to the shift gate
        _cart.Clear();
        _heldCarts.Clear();
        _tiles.Clear();
        _tendered = 0;
        _floatEntry = 0;
    }

    // ─── keypad helpers ───
    private static decimal AppendDigit(decimal current, int digit)
    {
        // Treat the value as cents and shift left, capping to a sane maximum.
        var cents = (long)Math.Round(current * 100m);
        cents = cents * 10 + digit;
        if (cents > 9_999_999_99) cents = 9_999_999_99;
        return cents / 100m;
    }

    private static decimal Backspace(decimal current)
    {
        var cents = (long)Math.Round(current * 100m);
        cents /= 10;
        return cents / 100m;
    }

    private void EditFloatDigit(int d) => _floatEntry = AppendDigit(_floatEntry, d);
    private void EditFloatBackspace() => _floatEntry = Backspace(_floatEntry);
    private void EditFloatClear() => _floatEntry = 0;

    private void EditCountedDigit(int d) => _countedEntry = AppendDigit(_countedEntry, d);
    private void EditCountedBackspace() => _countedEntry = Backspace(_countedEntry);
    private void EditCountedClear() => _countedEntry = 0;

    private void EditTenderedDigit(int d) => _tendered = AppendDigit(_tendered, d);
    private void EditTenderedBackspace() => _tendered = Backspace(_tendered);
    private void EditTenderedClear() => _tendered = 0;

    /// <summary>
    /// Physical-keyboard path for the money amounts: click/tab onto the amount and type
    /// digits (Backspace deletes, Delete/Escape clears). The on-screen keypad stays for
    /// touch tills — both drive the same digit buffer.
    /// </summary>
    private static void HandleAmountKey(KeyboardEventArgs e, Action<int> onDigit, Action onBack, Action onClear)
    {
        if (e.Key.Length == 1 && e.Key[0] is >= '0' and <= '9')
        {
            onDigit(e.Key[0] - '0');
        }
        else if (e.Key == "Backspace")
        {
            onBack();
        }
        else if (e.Key is "Delete" or "Escape")
        {
            onClear();
        }
    }

    // ─── cart persistence (survives refresh / reconnect) ───

    /// <summary>Serialized cart + held carts + tendered, keyed per shift in localStorage.</summary>
    private sealed class PosCartState
    {
        public List<CartLine> Cart { get; set; } = new();
        public List<HeldCart> Held { get; set; } = new();
        public decimal Tendered { get; set; }
    }

    private bool _cartRestored;
    private string? _lastPersistedState;

    private string CartStorageKey => $"pos-cart-{_shift?.Id}";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_shift is null)
        {
            return;
        }

        // Rehydrate once as soon as a shift is on screen (JS interop is unavailable
        // earlier during the initial server render).
        if (!_cartRestored)
        {
            _cartRestored = true;
            if (await RestoreCartStateAsync())
            {
                StateHasChanged();
                return;
            }
        }

        await PersistCartStateAsync();
    }

    private async Task PersistCartStateAsync()
    {
        try
        {
            var json = JsonSerializer.Serialize(new PosCartState
            {
                Cart = _cart.ToList(),
                Held = _heldCarts.ToList(),
                Tendered = _tendered
            });

            if (json == _lastPersistedState)
            {
                return;
            }

            _lastPersistedState = json;
            await JS.InvokeVoidAsync("localStorage.setItem", CartStorageKey, json);
        }
        catch
        {
            // Persistence is best-effort — never let it disturb a sale.
        }
    }

    private async Task<bool> RestoreCartStateAsync()
    {
        try
        {
            var json = await JS.InvokeAsync<string?>("localStorage.getItem", CartStorageKey);
            if (string.IsNullOrEmpty(json))
            {
                return false;
            }

            var state = JsonSerializer.Deserialize<PosCartState>(json);
            if (state is null || (state.Cart.Count == 0 && state.Held.Count == 0))
            {
                return false;
            }

            _cart.Clear();
            _cart.AddRange(state.Cart);
            _heldCarts.Clear();
            _heldCarts.AddRange(state.Held);
            _tendered = state.Tendered;
            _lastPersistedState = json;
            return true;
        }
        catch
        {
            return false;
        }
    }

    private async Task ClearPersistedCartAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("localStorage.removeItem", CartStorageKey);
            _lastPersistedState = null;
        }
        catch
        {
            // Best-effort.
        }
    }

    // Renders a reusable 0-9 keypad. `exact` adds an "exact cash" shortcut that
    // sets the tendered amount to the cart total.
    private RenderFragment KeypadFor(Action<int> onDigit, Action onBack, Action onClear, bool exact = false) => builder =>
    {
        var seq = 0;
        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", "pos-keypad");

        void Key(string label, Action onClick, string extraClass = "")
        {
            builder.OpenElement(seq++, "button");
            builder.AddAttribute(seq++, "type", "button");
            builder.AddAttribute(seq++, "class", $"pos-key {extraClass}");
            builder.AddAttribute(seq++, "onclick", EventCallback.Factory.Create(this, onClick));
            builder.AddContent(seq++, label);
            builder.CloseElement();
        }

        for (var n = 1; n <= 9; n++)
        {
            var digit = n;
            Key(digit.ToString(), () => onDigit(digit));
        }

        if (exact)
        {
            Key(L["Cashier:ExactCash"], () => _tendered = CartTotal, "pos-key-fn");
        }
        else
        {
            Key(L["Cashier:Keypad:Clear"], onClear, "pos-key-fn");
        }

        Key("0", () => onDigit(0));
        Key(L["Cashier:Keypad:Backspace"], onBack, "pos-key-fn");

        builder.CloseElement();
    };

    // ─── formatting ───
    // Currency comes from the shop's DefaultCurrency setting (loaded in OnInitializedAsync),
    // so the till and printed receipt match the rest of the system instead of a baked-in code.
    private string FormatMoney(decimal v) => $"{v.ToString("N2", CultureInfo.CurrentCulture)} {_currency}";

    private static string Initial(string name)
        => string.IsNullOrWhiteSpace(name) ? "?" : name.Trim()[0].ToString().ToUpperInvariant();

    private int RemainingFor(CashierProductDto product)
    {
        var inCart = _cart.FirstOrDefault(l => l.ProductId == product.ProductId)?.Quantity ?? 0;
        return Math.Max(product.QuantityOnHand - inCart, 0);
    }

    private string ProductDescription(CashierProductDto product)
        => string.IsNullOrWhiteSpace(product.Description)
            ? L["Cashier:NoDescription"]
            : product.Description.Trim();

    private string StockInfoText(CashierProductDto product, int remaining)
    {
        if (product.IsOutOfStock || remaining <= 0)
        {
            return L["Cashier:StockInfo:Out"];
        }

        if (remaining <= 2)
        {
            return L["Cashier:StockInfo:Tight", remaining];
        }

        if (product.IsLowStock)
        {
            return L["Cashier:StockInfo:Low", remaining];
        }

        return L["Cashier:StockInfo:Ok", remaining];
    }

    private static string StockInfoClass(CashierProductDto product, int remaining)
    {
        if (product.IsOutOfStock || remaining <= 0) return "is-out";
        if (remaining <= 2) return "is-tight";
        if (product.IsLowStock) return "is-low";
        return "is-ok";
    }

    private static string StockInfoIcon(CashierProductDto product, int remaining)
    {
        if (product.IsOutOfStock || remaining <= 0) return Icons.Material.Filled.Block;
        if (remaining <= 2 || product.IsLowStock) return Icons.Material.Filled.PriorityHigh;
        return Icons.Material.Filled.CheckCircle;
    }

    private string VarianceLabel(decimal? variance)
    {
        var v = variance ?? 0;
        if (v > 0) return L["Cashier:VarianceOver"];
        if (v < 0) return L["Cashier:VarianceShort"];
        return L["Cashier:VarianceBalanced"];
    }

    private static string VarianceClass(decimal? variance)
        => (variance ?? 0) == 0 ? "is-balanced" : "is-off";

    // ─── client-side models ───
    private sealed class CartLine
    {
        public Guid ProductId { get; set; }
        public string Name { get; set; } = "";
        public decimal UnitPrice { get; set; }
        public int Quantity { get; set; }
        public int AvailableQuantity { get; set; }
        public decimal Subtotal => UnitPrice * Quantity;
        public CartLine Clone() => new()
        {
            ProductId = ProductId,
            Name = Name,
            UnitPrice = UnitPrice,
            Quantity = Quantity,
            AvailableQuantity = AvailableQuantity
        };
    }

    private sealed class HeldCart
    {
        public string Label { get; set; } = "";
        public List<CartLine> Lines { get; set; } = new();
    }
}

