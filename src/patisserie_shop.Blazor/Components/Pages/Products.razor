@page "/inventory/products"
@attribute [Authorize(InventoryPermissions.Products.Default)]
@using System.Threading
@using System.Threading.Tasks
@using System.IO
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Hosting
@using Volo.Abp.Application.Dtos
@using Volo.Abp.AspNetCore.Components.Web.Theming.Layout
@using Inventory
@using Inventory.Branches
@using Inventory.Categories
@using Inventory.Suppliers
@using Inventory.Products
@using Inventory.BranchInventory
@using Inventory.Permissions
@using Inventory.Localization
@using Color = MudBlazor.Color
@using Variant = MudBlazor.Variant
@using Size = MudBlazor.Size
@using Margin = MudBlazor.Margin
@inherits patisserie_shopComponentBase
@inject IProductAppService ProductAppService
@inject ICategoryAppService CategoryAppService
@inject ISupplierAppService SupplierAppService
@inject IBranchInventoryAppService BranchInventoryAppService
@inject IBranchAppService BranchAppService
@inject PageLayout PageLayout
@inject ISnackbar Snackbar
@inject IStringLocalizer<InventoryResource> InvL
@inject IWebHostEnvironment WebHostEnvironment

@{
    PageLayout.Title = InvL["Products"];
}

<SoftCard Elevation="2" Class="pa-2 page-flat">
    <div class="page-head">
        <div>
            <h1 class="page-title">@InvL["Products"]</h1>
            <div class="page-sub">@InvL["Products:Subtitle"]</div>
        </div>
        <div class="page-head-actions">
            @if (_canManage)
            {
                <SoftButton Variant="Variant.Filled"
                            Color="Color.Primary"
                            StartIcon="@Icons.Material.Filled.Add"
                            OnClick="OpenCreateDialog">
                    @InvL["NewProduct"]
                </SoftButton>
            }
        </div>
    </div>
    <SoftCardContent>
        <div class="toolbar">
            <SoftTextField T="string"
                           Placeholder="@InvL["Filter"]"
                           @bind-Value="_filter"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Adornment="Adornment.Start"
                           AdornmentIcon="@Icons.Material.Filled.Search"
                           OnKeyUp="OnFilterKeyUpAsync"
                           Immediate="true"
                           Class="toolbar-search"
                           Style="min-width: 240px; max-width: 320px;" />

            <div class="filter-chip">
                <SoftLookupSelect TItem="CategoryDto" TValue="Guid?"
                                  Items="_categories"
                                  ToValue="@(c => (Guid?)c.Id)"
                                  ToLabel="@(c => c.Name)"
                                  Value="_filterCategoryId"
                                  ValueChanged="OnFilterCategoryChangedAsync"
                                  Label="@InvL["AllCategories"]"
                                  Margin="Margin.Dense"
                                  Clearable="true"
                                  Dense="true" />
            </div>

            <div class="filter-chip">
                <SoftLookupSelect TItem="SupplierDto" TValue="Guid?"
                                  Items="_suppliers"
                                  ToValue="@(s => (Guid?)s.Id)"
                                  ToLabel="@(s => s.Name)"
                                  Value="_filterSupplierId"
                                  ValueChanged="OnFilterSupplierChangedAsync"
                                  Label="@InvL["AllSuppliers"]"
                                  Margin="Margin.Dense"
                                  Clearable="true"
                                  Dense="true" />
            </div>

            <div class="toolbar-right">
                <SoftButton Variant="Variant.Text" Color="Color.Primary" OnClick="ReloadAsync" StartIcon="@Icons.Material.Filled.Refresh">
                    @L["Refresh"]
                </SoftButton>
            </div>
        </div>

        <SoftDataGrid T="ProductDto"
                      @ref="_grid"
                      ServerData="LoadServerData"
                      Dense="true"
                      Hover="true"
                      Bordered="false"
                      Striped="true"
                      Loading="_loading"
                      SortMode="SortMode.Single">
            <Columns>
                <PropertyColumn T="ProductDto" TProperty="string" Property="x => x.SKU" Title="@InvL["SKU"]" />
                <PropertyColumn T="ProductDto" TProperty="string" Property="x => x.Name" Title="@InvL["Name"]" />
                <TemplateColumn T="ProductDto" Title="@InvL["Category"]" Sortable="false">
                    <CellTemplate>
                        <SoftText Typo="Typo.body2">@GetCategoryName(context.Item.CategoryId)</SoftText>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="ProductDto" Title="@InvL["ProductType"]" Sortable="true" SortBy="x => x.ProductType">
                    <CellTemplate>
                        <SoftChip T="string"
                                  Color="@ProductTypeColor(context.Item.ProductType)"
                                  Size="Size.Small"
                                  Variant="@(context.Item.ProductType == ProductTypes.FinishedGood ? Variant.Filled : Variant.Outlined)">
                            @InvL[$"ProductType:{context.Item.ProductType}"]
                        </SoftChip>
                    </CellTemplate>
                </TemplateColumn>
                <PropertyColumn T="ProductDto" TProperty="string" Property="x => x.Unit" Title="@InvL["Unit"]" Sortable="false" />
                <TemplateColumn T="ProductDto" Title="@InvL["SalePrice"]" SortBy="x => x.SalePrice">
                    <CellTemplate>
                        <SoftText>@FormatMoney(context.Item.SalePrice, context.Item.Currency)</SoftText>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="ProductDto" Title="@InvL["ShelfLife"]" SortBy="x => x.ShelfLifeDays">
                    <CellTemplate>
                        @if (context.Item.ShelfLifeDays.HasValue)
                        {
                            <SoftText Typo="Typo.body2">@($"{context.Item.ShelfLifeDays}d")</SoftText>
                        }
                        else
                        {
                            <SoftText Typo="Typo.caption" Color="Color.Default">—</SoftText>
                        }
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="ProductDto" Title="@InvL["IsActive"]" Sortable="true" SortBy="x => x.IsActive">
                    <CellTemplate>
                        @if (context.Item.IsActive)
                        {
                            <SoftChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Filled">@InvL["IsActive"]</SoftChip>
                        }
                        else
                        {
                            <SoftChip T="string" Color="Color.Default" Size="Size.Small" Variant="Variant.Outlined">-</SoftChip>
                        }
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="ProductDto" Title="@InvL["Actions"]" Sortable="false">
                    <CellTemplate>
                        <span class="row-actions">
                            <SoftStack Row="true" Spacing="1">
                                <SoftTooltip Text="@InvL["ProductStock:ViewAcrossBranches"]">
                                    <SoftIconButton Icon="@Icons.Material.Filled.Warehouse"
                                                    Size="Size.Small"
                                                    OnClick="() => OpenStockAcrossBranchesAsync(context.Item)" />
                                </SoftTooltip>
                                @if (_canManage)
                                {
                                    <SoftIconButton Icon="@Icons.Material.Filled.Edit"
                                                    Color="Color.Primary"
                                                    Size="Size.Small"
                                                    OnClick="() => OpenEditDialog(context.Item)" />
                                    <SoftIconButton Icon="@Icons.Material.Filled.Delete"
                                                    Color="Color.Error"
                                                    Size="Size.Small"
                                                    OnClick="() => DeleteAsync(context.Item)" />
                                }
                            </SoftStack>
                        </span>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <PagerContent>
                <MudDataGridPager T="ProductDto" />
            </PagerContent>
        </SoftDataGrid>
    </SoftCardContent>
</SoftCard>

@if (_dialogVisible)
{
    <div class="glass-modal-backdrop" @onclick="CloseDialog">
        <div class="glass-modal-container glass-modal-container--lg" @onclick:stopPropagation="true">
            <SoftCard Elevation="24" Class="glass-modal">
                <SoftCardHeader Class="pa-4">
                    <CardHeaderContent>
                        <SoftStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <SoftIcon Icon="@(_editingId.HasValue ? Icons.Material.Filled.Edit : Icons.Material.Filled.AddCircle)"
                                      Color="Color.Primary" Size="Size.Medium" />
                            <SoftText Typo="Typo.h6">
                                @(_editingId.HasValue ? InvL["EditProduct"] : InvL["NewProduct"])
                            </SoftText>
                        </SoftStack>
                    </CardHeaderContent>
                    <CardHeaderActions>
                        <SoftStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudSwitch T="bool" @bind-Value="_editIsActive" Color="Color.Primary" Label="@InvL["IsActive"]" />
                            <SoftIconButton Icon="@Icons.Material.Filled.Close"
                                            Size="Size.Small"
                                            OnClick="CloseDialog" />
                        </SoftStack>
                    </CardHeaderActions>
                </SoftCardHeader>
                <SoftDivider />
                <SoftCardContent Class="pa-4 glass-modal-body product-modal-body">
                    <div class="product-editor">
                        <aside class="product-photo-panel">
                            <div class="product-photo-frame">
                                @if (!string.IsNullOrWhiteSpace(ProductImagePreview))
                                {
                                    <img src="@ProductImagePreview" alt="@_editName" />
                                }
                                else
                                {
                                    <div class="product-photo-empty">
                                        <SoftIcon Icon="@Icons.Material.Filled.AddPhotoAlternate"
                                                  Color="Color.Primary"
                                                  Size="Size.Large" />
                                        <SoftText Typo="Typo.body2">@InvL["Products:ProductPhoto"]</SoftText>
                                    </div>
                                }
                            </div>
                            <InputFile id="product-image-input"
                                       class="product-image-input"
                                       accept="image/png,image/jpeg,image/webp,image/gif"
                                       OnChange="OnProductImageChangedAsync" />
                            <label class="product-upload-button" for="product-image-input">
                                <SoftIcon Icon="@Icons.Material.Filled.Upload" Size="Size.Small" />
                                <span>@(string.IsNullOrWhiteSpace(ProductImagePreview) ? InvL["Products:ChooseImage"] : InvL["Products:ChangeImage"])</span>
                            </label>
                            @if (!string.IsNullOrWhiteSpace(ProductImagePreview))
                            {
                                <SoftButton Variant="Variant.Text"
                                            Color="Color.Error"
                                            StartIcon="@Icons.Material.Filled.DeleteOutline"
                                            OnClick="ClearProductImage">
                                    @InvL["Products:RemovePhoto"]
                                </SoftButton>
                            }
                        </aside>

                        <div class="product-fields">
                            <section class="product-form-section">
                                <SoftText Typo="Typo.overline" Color="Color.Primary">@InvL["BasicInfo"]</SoftText>
                                <SoftDivider Class="mb-3" />
                                <div class="product-form-grid product-form-grid--two">
                                    <SoftTextField T="string"
                                                   Label="@InvL["Name"]"
                                                   @bind-Value="_editName"
                                                   Variant="Variant.Outlined"
                                                   MaxLength="128"
                                                   Required="true"
                                                   Immediate="true" />
                                    <SoftTextField T="string"
                                                   Label="@InvL["SKU"]"
                                                   @bind-Value="_editSku"
                                                   Variant="Variant.Outlined"
                                                   MaxLength="64"
                                                   Required="true"
                                                   Immediate="true" />
                                    <div>
                                        <SoftLookupSelect TItem="CategoryDto" TValue="Guid?"
                                                          Items="_categories"
                                                          ToValue="@(c => (Guid?)c.Id)"
                                                          ToLabel="@(c => c.Name)"
                                                          Value="_editCategoryId"
                                                          ValueChanged="@(v => _editCategoryId = v)"
                                                          Label="@InvL["Category"]"
                                                          Placeholder="@InvL["SelectCategory"]"
                                                          Required="true" />
                                    </div>
                                    <div>
                                        <SoftLookupSelect TItem="SupplierDto" TValue="Guid?"
                                                          Items="_suppliers"
                                                          ToValue="@(s => (Guid?)s.Id)"
                                                          ToLabel="@(s => s.Name)"
                                                          Value="_editSupplierId"
                                                          ValueChanged="@(v => _editSupplierId = v)"
                                                          Label="@InvL["DefaultSupplier"]"
                                                          Placeholder="@InvL["SelectSupplier"]"
                                                          Clearable="true" />
                                    </div>
                                    <div class="product-form-grid-span">
                                        <SoftTextField T="string"
                                                       Label="@InvL["Description"]"
                                                       @bind-Value="_editDescription"
                                                       Variant="Variant.Outlined"
                                                       Lines="2"
                                                       MaxLength="1024" />
                                    </div>
                                </div>
                            </section>

                            <section class="product-form-section">
                                <SoftText Typo="Typo.overline" Color="Color.Primary">@InvL["Pricing"]</SoftText>
                                <SoftDivider Class="mb-3" />
                                <div class="product-form-grid product-form-grid--pricing">
                                    <SoftTextField T="string"
                                                   Label="@InvL["Unit"]"
                                                   @bind-Value="_editUnit"
                                                   Variant="Variant.Outlined"
                                                   MaxLength="32"
                                                   Required="true" />
                                    <SoftNumericField T="decimal"
                                                      Label="@InvL["CostPrice"]"
                                                      @bind-Value="_editCostPrice"
                                                      Variant="Variant.Outlined"
                                                      Min="0"
                                                      HideSpinButtons="true"
                                                      Adornment="Adornment.Start"
                                                      AdornmentText="@_editCurrency" />
                                    <SoftNumericField T="decimal"
                                                      Label="@InvL["SalePrice"]"
                                                      @bind-Value="_editSalePrice"
                                                      Variant="Variant.Outlined"
                                                      Min="0"
                                                      HideSpinButtons="true"
                                                      Adornment="Adornment.Start"
                                                      AdornmentText="@_editCurrency" />
                                    <SoftSelect T="string"
                                                Label="@InvL["Currency"]"
                                                @bind-Value="_editCurrency"
                                                Variant="Variant.Outlined"
                                                Required="true">
                                        @foreach (var currency in _currencyOptions)
                                        {
                                            <MudSelectItem T="string" Value="@currency">@CurrencyLabel(currency)</MudSelectItem>
                                        }
                                    </SoftSelect>
                                </div>
                            </section>

                            <section class="product-form-section">
                                <SoftText Typo="Typo.overline" Color="Color.Primary">@InvL["Stock"]</SoftText>
                                <SoftDivider Class="mb-3" />
                                <div class="product-form-grid product-form-grid--stock">
                                    <SoftNumericField T="int"
                                                      Label="@InvL["ReorderLevel"]"
                                                      @bind-Value="_editReorderLevel"
                                                      Variant="Variant.Outlined"
                                                      Min="0"
                                                      HideSpinButtons="true" />
                                    <SoftNumericField T="int?"
                                                      Label="@InvL["ShelfLifeDays"]"
                                                      @bind-Value="_editShelfLifeDays"
                                                      Variant="Variant.Outlined"
                                                      Min="1"
                                                      Max="3650"
                                                      Clearable="true"
                                                      HideSpinButtons="true"
                                                      HelperText="@InvL["ShelfLifeHint"]" />
                                </div>
                            </section>

                            <section class="product-form-section">
                                <SoftText Typo="Typo.overline" Color="Color.Primary">@InvL["Classification"]</SoftText>
                                <SoftDivider Class="mb-3" />
                                <div class="product-form-grid product-form-grid--two">
                                    <SoftSelect T="string"
                                                Label="@InvL["ProductType"]"
                                                @bind-Value="_editProductType"
                                                Variant="Variant.Outlined"
                                                Required="true">
                                        <MudSelectItem T="string" Value="@ProductTypes.FinishedGood">@InvL["ProductType:FinishedGood"]</MudSelectItem>
                                        <MudSelectItem T="string" Value="@ProductTypes.RawMaterial">@InvL["ProductType:RawMaterial"]</MudSelectItem>
                                        <MudSelectItem T="string" Value="@ProductTypes.Packaging">@InvL["ProductType:Packaging"]</MudSelectItem>
                                        <MudSelectItem T="string" Value="@ProductTypes.SemiFinished">@InvL["ProductType:SemiFinished"]</MudSelectItem>
                                    </SoftSelect>
                                    <div class="d-flex flex-column">
                                        <SoftCheckBox T="bool" @bind-Value="_editIsSellable" Label="@InvL["IsSellable"]" Color="Color.Primary" />
                                        <SoftCheckBox T="bool" @bind-Value="_editIsPurchasable" Label="@InvL["IsPurchasable"]" Color="Color.Primary" />
                                        <SoftCheckBox T="bool" @bind-Value="_editIsProducible" Label="@InvL["IsProducible"]" Color="Color.Primary" />
                                    </div>
                                </div>
                            </section>

                            @if (!_editingId.HasValue && _canInitializeStock && _stockBranches.Count > 0)
                            {
                                <section class="product-form-section">
                                    <SoftText Typo="Typo.overline" Color="Color.Primary">@InvL["InitialStockAtBranches"]</SoftText>
                                    <SoftDivider Class="mb-1" />
                                    <SoftText Typo="Typo.caption" Color="Color.Default" Class="mb-2 d-block">
                                        @InvL["InitialStockAtBranchesHint"]
                                    </SoftText>
                                    <div class="product-form-grid product-form-grid--two">
                                        @foreach (var branch in _stockBranches)
                                        {
                                            var branchId = branch.Id;
                                            <SoftNumericField T="int"
                                                              Label="@branch.Name"
                                                              Value="@_initialStockByBranch.GetValueOrDefault(branchId, 0)"
                                                              ValueChanged="@(v => _initialStockByBranch[branchId] = v)"
                                                              Variant="Variant.Outlined"
                                                              Min="0"
                                                              Margin="Margin.Dense"
                                                              HideSpinButtons="true" />
                                        }
                                    </div>
                                </section>
                            }
                        </div>
                    </div>
                </SoftCardContent>
                <SoftDivider />
                <div class="pa-3 d-flex justify-end" style="gap: 8px;">
                    <SoftButton Variant="Variant.Text" OnClick="CloseDialog">@L["Cancel"]</SoftButton>
                    <SoftButton Variant="Variant.Filled"
                                Color="Color.Primary"
                                StartIcon="@Icons.Material.Filled.Save"
                                OnClick="SaveAsync"
                                Disabled="_saving">
                        @L["Save"]
                    </SoftButton>
                </div>
            </SoftCard>
        </div>
    </div>
}

@if (_confirmVisible)
{
    <div class="glass-modal-backdrop" @onclick="() => _confirmVisible = false">
        <div class="glass-modal-container glass-modal-container--sm" @onclick:stopPropagation="true">
            <SoftCard Elevation="24" Class="glass-modal">
                <SoftCardHeader Class="pa-4">
                    <CardHeaderContent>
                        <SoftStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <SoftIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Error" Size="Size.Medium" />
                            <SoftText Typo="Typo.h6">@InvL["Products:DeleteTitle"]</SoftText>
                        </SoftStack>
                    </CardHeaderContent>
                </SoftCardHeader>
                <SoftDivider />
                <SoftCardContent Class="pa-4">
                    <SoftText>@InvL["Products:DeleteConfirm", _pendingDelete?.Name ?? ""]</SoftText>
                </SoftCardContent>
                <SoftDivider />
                <div class="pa-3 d-flex justify-end" style="gap: 8px;">
                    <SoftButton Variant="Variant.Text" OnClick="() => _confirmVisible = false">@L["Cancel"]</SoftButton>
                    <SoftButton Variant="Variant.Filled"
                                Color="Color.Error"
                                StartIcon="@Icons.Material.Filled.Delete"
                                OnClick="ConfirmDeleteAsync">
                        @InvL["DeleteAction"]
                    </SoftButton>
                </div>
            </SoftCard>
        </div>
    </div>
}

@if (_stockModalVisible)
{
    <div class="glass-modal-backdrop" @onclick="CloseStockModal">
        <div class="glass-modal-container glass-modal-container--md" @onclick:stopPropagation="true">
            <SoftCard Elevation="24" Class="glass-modal">
                <SoftCardHeader Class="pa-4">
                    <CardHeaderContent>
                        <SoftStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <SoftIcon Icon="@Icons.Material.Filled.Warehouse"
                                      Color="Color.Primary" Size="Size.Medium" />
                            <div>
                                <SoftText Typo="Typo.h6">@InvL["ProductStock:Title"]</SoftText>
                                <SoftText Typo="Typo.body2" Color="Color.Default">@_stockProduct?.Name</SoftText>
                            </div>
                        </SoftStack>
                    </CardHeaderContent>
                    <CardHeaderActions>
                        <SoftIconButton Icon="@Icons.Material.Filled.Close"
                                        Size="Size.Small"
                                        OnClick="CloseStockModal" />
                    </CardHeaderActions>
                </SoftCardHeader>
                <SoftDivider />
                <SoftCardContent Class="pa-4 glass-modal-body">
                    @if (_stockLoading)
                    {
                        <div class="d-flex justify-center pa-6">
                            <SoftProgressCircular Indeterminate="true" Color="Color.Primary" />
                        </div>
                    }
                    else if (_productStock.Count == 0)
                    {
                        <SoftText Typo="Typo.body2" Color="Color.Default">@InvL["ProductStock:NoStock"]</SoftText>
                    }
                    else
                    {
                        <div class="stats mb-3">
                            <span class="stat-label">@InvL["ProductStock:Total"]</span>
                            <span class="stat-value">@_stockTotal @(_productStock[0].ProductUnit)</span>
                        </div>
                        <SoftDataGrid T="ProductBranchStockDto"
                                      Items="_productStock"
                                      Dense="true"
                                      Hover="true"
                                      Bordered="false"
                                      Striped="true">
                            <Columns>
                                <PropertyColumn T="ProductBranchStockDto" TProperty="string"
                                                Property="x => x.BranchName" Title="@InvL["Branch"]" Sortable="false" />
                                <TemplateColumn T="ProductBranchStockDto" Title="@InvL["QuantityOnHand"]" Sortable="false">
                                    <CellTemplate>
                                        <SoftText>@context.Item.QuantityOnHand @context.Item.ProductUnit</SoftText>
                                    </CellTemplate>
                                </TemplateColumn>
                                <PropertyColumn T="ProductBranchStockDto" TProperty="int"
                                                Property="x => x.MinimumStock" Title="@InvL["MinimumStock"]" Sortable="false" />
                                <TemplateColumn T="ProductBranchStockDto" Title="@InvL["MaximumStock"]" Sortable="false">
                                    <CellTemplate>
                                        @if (context.Item.MaximumStock.HasValue)
                                        {
                                            <SoftText>@context.Item.MaximumStock</SoftText>
                                        }
                                        else
                                        {
                                            <SoftText Typo="Typo.caption" Color="Color.Default">—</SoftText>
                                        }
                                    </CellTemplate>
                                </TemplateColumn>
                                <TemplateColumn T="ProductBranchStockDto" Title="@InvL["Status"]" Sortable="false">
                                    <CellTemplate>
                                        @if (context.Item.IsOutOfStock)
                                        {
                                            <SoftChip T="string" Color="Color.Error" Size="Size.Small" Variant="Variant.Filled">@InvL["OutOfStock"]</SoftChip>
                                        }
                                        else if (context.Item.IsLowStock)
                                        {
                                            <SoftChip T="string" Color="Color.Warning" Size="Size.Small" Variant="Variant.Filled">@InvL["LowStock"]</SoftChip>
                                        }
                                        else
                                        {
                                            <SoftChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Outlined">@InvL["StockOk"]</SoftChip>
                                        }
                                    </CellTemplate>
                                </TemplateColumn>
                            </Columns>
                        </SoftDataGrid>
                    }
                </SoftCardContent>
                <SoftDivider />
                <div class="pa-3 d-flex justify-end" style="gap: 8px;">
                    <SoftButton Variant="Variant.Text" OnClick="CloseStockModal">@L["Close"]</SoftButton>
                </div>
            </SoftCard>
        </div>
    </div>
}

@code {
    private SoftDataGrid<ProductDto> _grid = null!;
    private bool _loading;
    private bool _saving;
    private string? _filter;
    private Guid? _filterCategoryId;
    private Guid? _filterSupplierId;
    private bool _canManage;

    private List<CategoryDto> _categories = new();
    private List<SupplierDto> _suppliers = new();
    private Dictionary<Guid, string> _categoryNames = new();
    private readonly List<string> _currencyOptions = new() { "USD", "EUR", "GBP" };

    private bool _dialogVisible;
    private Guid? _editingId;
    private string _editName = string.Empty;
    private string _editSku = string.Empty;
    private string? _editDescription;
    private Guid? _editCategoryId;
    private Guid? _editSupplierId;
    private string _editUnit = "pcs";
    private decimal _editCostPrice;
    private decimal _editSalePrice;
    private string _editCurrency = "USD";
    private int _editReorderLevel = 5;
    private string? _editImageUrl;
    private string? _editImagePreviewUrl;
    private IBrowserFile? _selectedImageFile;
    private bool _editIsActive = true;
    private int? _editShelfLifeDays;
    private string _editProductType = ProductTypes.FinishedGood;
    private bool _editIsSellable = true;
    private bool _editIsPurchasable = true;
    private bool _editIsProducible = false;

    // "Stock at branches" section on the CREATE dialog: one qty row per branch
    // (0 = don't stock there). Saves a per-branch trip to the Branch Inventory page.
    private bool _canInitializeStock;
    private List<BranchLookupDto> _stockBranches = new();
    private readonly Dictionary<Guid, int> _initialStockByBranch = new();

    private bool _confirmVisible;
    private ProductDto? _pendingDelete;

    private bool _stockModalVisible;
    private ProductDto? _stockProduct;
    private List<ProductBranchStockDto> _productStock = new();
    private bool _stockLoading;
    private int _stockTotal => _productStock.Sum(s => s.QuantityOnHand);

    protected override async Task OnInitializedAsync()
    {
        await LoadShopCurrencyAsync();
        if (!_currencyOptions.Contains(ShopCurrency))
        {
            _currencyOptions.Insert(0, ShopCurrency);
        }

        _canManage = await AuthorizationService.IsGrantedAsync(InventoryPermissions.Products.Manage);
        _canInitializeStock = await AuthorizationService.IsGrantedAsync(InventoryPermissions.BranchInventory.Initialize);
        if (_canInitializeStock)
        {
            try
            {
                // Only offer branches the user can actually stock (a branch manager
                // manages a subset; InitializeAsync enforces access server-side).
                var accessible = await BranchInventoryAppService.GetAccessibleBranchIdsAsync();
                var lookup = await BranchAppService.GetLookupAsync();
                _stockBranches = lookup.Where(b => accessible.Contains(b.Id)).ToList();
            }
            catch
            {
                _stockBranches = new();
            }
        }
        await LoadLookupsAsync();
    }

    private async Task LoadLookupsAsync()
    {
        try
        {
            var cats = await CategoryAppService.GetListAsync(new GetCategoriesInput
            {
                IsActive = true,
                MaxResultCount = 1000,
                Sorting = nameof(CategoryDto.Name)
            });
            _categories = cats.Items.ToList();
            _categoryNames = _categories.ToDictionary(c => c.Id, c => c.Name);

            var sups = await SupplierAppService.GetListAsync(new GetSuppliersInput
            {
                IsActive = true,
                MaxResultCount = 1000,
                Sorting = nameof(SupplierDto.Name)
            });
            _suppliers = sups.Items.ToList();
        }
        catch (Exception ex)
        {
            await HandleErrorAsync(ex);
        }
    }

