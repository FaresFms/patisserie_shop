    private string? ProductImagePreview => _editImagePreviewUrl ?? _editImageUrl;

    private async Task OnProductImageChangedAsync(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null)
        {
            return;
        }

        if (!file.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase))
        {
            Snackbar.Add(InvL["Products:ImageNotImage"], Severity.Warning);
            return;
        }

        const long maxImageBytes = 3 * 1024 * 1024;
        if (file.Size > maxImageBytes)
        {
            Snackbar.Add(InvL["Products:ImageTooLarge"], Severity.Warning);
            return;
        }

        _selectedImageFile = file;
        await using var stream = file.OpenReadStream(maxImageBytes);
        using var buffer = new MemoryStream();
        await stream.CopyToAsync(buffer);
        _editImagePreviewUrl = $"data:{file.ContentType};base64,{Convert.ToBase64String(buffer.ToArray())}";
    }

    private void ClearProductImage()
    {
        _selectedImageFile = null;
        _editImageUrl = null;
        _editImagePreviewUrl = null;
    }

    private async Task<string?> SaveProductImageAsync()
    {
        if (_selectedImageFile == null)
        {
            return _editImageUrl;
        }

        var extension = Path.GetExtension(_selectedImageFile.Name).ToLowerInvariant();
        var allowedExtensions = new HashSet<string>(StringComparer.OrdinalIgnoreCase)
        {
            ".jpg", ".jpeg", ".png", ".webp", ".gif"
        };

        if (!allowedExtensions.Contains(extension))
        {
            Snackbar.Add(InvL["Products:ImageBadFormat"], Severity.Warning);
            return _editImageUrl;
        }

        var uploadRoot = Path.Combine(WebHostEnvironment.WebRootPath, "uploads", "products");
        Directory.CreateDirectory(uploadRoot);

        var fileName = $"{Guid.NewGuid():N}{extension}";
        var targetPath = Path.Combine(uploadRoot, fileName);

        const long maxImageBytes = 3 * 1024 * 1024;
        await using var readStream = _selectedImageFile.OpenReadStream(maxImageBytes);
        await using var writeStream = File.Create(targetPath);
        await readStream.CopyToAsync(writeStream);

        return $"/uploads/products/{fileName}";
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_editName))
        {
            Snackbar.Add(L["ThisFieldIsRequired", InvL["Name"]], Severity.Warning);
            return;
        }
        if (string.IsNullOrWhiteSpace(_editSku))
        {
            Snackbar.Add(L["ThisFieldIsRequired", InvL["SKU"]], Severity.Warning);
            return;
        }
        if (!_editCategoryId.HasValue)
        {
            Snackbar.Add(L["ThisFieldIsRequired", InvL["Category"]], Severity.Warning);
            return;
        }
        if (string.IsNullOrWhiteSpace(_editUnit))
        {
            Snackbar.Add(L["ThisFieldIsRequired", InvL["Unit"]], Severity.Warning);
            return;
        }
        if (string.IsNullOrWhiteSpace(_editCurrency) || _editCurrency.Length != 3)
        {
            Snackbar.Add(L["ThisFieldIsRequired", InvL["Currency"]], Severity.Warning);
            return;
        }

        _saving = true;
        try
        {
            var imageUrl = await SaveProductImageAsync();
            if (_editingId.HasValue)
            {
                await ProductAppService.UpdateAsync(_editingId.Value, new UpdateProductDto
                {
                    CategoryId = _editCategoryId.Value,
                    DefaultSupplierId = _editSupplierId,
                    Name = _editName,
                    SKU = _editSku,
                    Description = _editDescription,
                    Unit = _editUnit,
                    CostPrice = _editCostPrice,
                    SalePrice = _editSalePrice,
                    Currency = _editCurrency.ToUpper(),
                    ReorderLevel = _editReorderLevel,
                    ImageUrl = imageUrl,
                    IsActive = _editIsActive,
                    ShelfLifeDays = _editShelfLifeDays,
                    ProductType = _editProductType,
                    IsSellable = _editIsSellable,
                    IsPurchasable = _editIsPurchasable,
                    IsProducible = _editIsProducible
                });
            }
            else
            {
                var created = await ProductAppService.CreateAsync(new CreateProductDto
                {
                    CategoryId = _editCategoryId.Value,
                    DefaultSupplierId = _editSupplierId,
                    Name = _editName,
                    SKU = _editSku,
                    Description = _editDescription,
                    Unit = _editUnit,
                    CostPrice = _editCostPrice,
                    SalePrice = _editSalePrice,
                    Currency = _editCurrency.ToUpper(),
                    ReorderLevel = _editReorderLevel,
                    ImageUrl = imageUrl,
                    IsActive = _editIsActive,
                    ShelfLifeDays = _editShelfLifeDays,
                    ProductType = _editProductType,
                    IsSellable = _editIsSellable,
                    IsPurchasable = _editIsPurchasable,
                    IsProducible = _editIsProducible
                });

                await InitializeStockAtBranchesAsync(created.Id);
            }
            Snackbar.Add(L["SuccessfullySaved"], Severity.Success);
            _dialogVisible = false;
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            await HandleErrorAsync(ex);
        }
        finally
        {
            _saving = false;
        }
    }

    /// <summary>
    /// Stocks the freshly created product at each branch with a quantity > 0 from the
    /// "Stock at branches" section. Per-branch failures don't undo the product —
    /// they surface as a warning so the manager can finish on the Stock page.
    /// </summary>
    private async Task InitializeStockAtBranchesAsync(Guid productId)
    {
        var failedBranches = new List<string>();
        foreach (var branch in _stockBranches)
        {
            var qty = _initialStockByBranch.GetValueOrDefault(branch.Id, 0);
            if (qty <= 0)
            {
                continue;
            }

            try
            {
                await BranchInventoryAppService.InitializeAsync(new InitializeBranchInventoryDto
                {
                    BranchId = branch.Id,
                    ProductId = productId,
                    InitialQuantity = qty,
                    MinimumStock = _editReorderLevel
                });
            }
            catch
            {
                failedBranches.Add(branch.Name);
            }
        }

        if (failedBranches.Count > 0)
        {
            Snackbar.Add(
                string.Format(InvL["InitialStockPartialFail"], string.Join(", ", failedBranches)),
                Severity.Warning);
        }
    }

