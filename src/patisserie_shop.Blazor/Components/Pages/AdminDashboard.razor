@code {
    private AdminDashboardDto? _data;
    private bool _loading;
    private DateTime? _lastRefresh;
    private string? _error;

    private double TodayDelta
    {
        get
        {
            if (_data == null) return 0;
            if (_data.YesterdaySalesTotal <= 0) return _data.TodaySalesTotal > 0 ? 100 : 0;
            return (double)((_data.TodaySalesTotal - _data.YesterdaySalesTotal) / _data.YesterdaySalesTotal) * 100.0;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _data = await AdminDashboardService.GetAdminDashboardAsync();
            _lastRefresh = DateTime.UtcNow;
        }
        catch (Exception ex)
        {
            _error = $"{ex.GetType().Name}: {ex.Message}";
            Console.Error.WriteLine($"[AdminDashboard] {ex}");
            await HandleErrorAsync(ex);
        }
        finally
        {
            _loading = false;
        }
    }

    private static string FormatMoney(decimal v) => v.ToString("C0", System.Globalization.CultureInfo.GetCultureInfo("en-US"));

    private static string FormatCompact(decimal v)
    {
        if (v >= 1_000_000) return $"${v / 1_000_000m:0.#}M";
        if (v >= 1_000) return $"${v / 1_000m:0.#}k";
        return $"${v:0}";
    }

    private static bool IsToday(DateTime d) => d.Date == DateTime.UtcNow.Date;

    private static string Truncate(string s, int max)
        => string.IsNullOrEmpty(s) || s.Length <= max ? s : s[..max].TrimEnd() + "…";

    private static Color DecisionTypeColor(string type) => type switch
    {
        DecisionTypes.LowStockAlert => Color.Warning,
        DecisionTypes.ExcessStockAlert => Color.Info,
        DecisionTypes.DeadStockFlag => Color.Error,
        DecisionTypes.TransferSuggestion => Color.Tertiary,
        DecisionTypes.ReorderSuggestion => Color.Primary,
        _ => Color.Default
    };

    private static string FormatDecisionType(string type) => type switch
    {
        DecisionTypes.LowStockAlert => "Low Stock",
        DecisionTypes.ExcessStockAlert => "Excess Stock",
        DecisionTypes.DeadStockFlag => "Dead Stock",
        DecisionTypes.TransferSuggestion => "Transfer",
        DecisionTypes.ReorderSuggestion => "Reorder",
        _ => type
    };

    private static string FormatMovementType(string type) => type switch
    {
        "Purchase" => "Purchase",
        "Sale" => "Sale",
        "TransferIn" => "Transfer In",
        "TransferOut" => "Transfer Out",
        "ManualAdjustment" => "Adjustment",
        _ => type
    };

    private static string TimeAgo(DateTime utc)
    {
        var diff = DateTime.UtcNow - utc;
        if (diff.TotalSeconds < 60) return "just now";
        if (diff.TotalMinutes < 60) return $"{(int)diff.TotalMinutes}m ago";
        if (diff.TotalHours < 24) return $"{(int)diff.TotalHours}h ago";
        if (diff.TotalDays < 2) return "yesterday";
        return $"{(int)diff.TotalDays}d ago";
    }
}
