@using System
@using System.Collections.Generic
@using System.Globalization
@using System.Linq
@using System.Threading.Tasks
@using Microsoft.AspNetCore.Authorization
@using Operations.Cashier
@using Operations.Sales
@using Operations.Permissions
@using Color = MudBlazor.Color
@using Size = MudBlazor.Size
@using Placement = MudBlazor.Placement
@namespace patisserie_shop.Blazor.Components.Layout
@inherits patisserie_shopComponentBase
@inject ICashierAppService CashierAppService
@inject ISnackbar Snackbar

@* ── Last-hour recent-sales panel. Mirrors NotificationBell: resolved by name
     from the shared MainLayout so the shared theme project needs no host
     reference. Only visible to users with the Cashier permission. ── *@
@if (_canView)
{
    <div class="recent-panel-root">
        <SoftTooltip Text="@L["Recent"]" Placement="Placement.Bottom">
            <SoftIconButton Icon="@Icons.Material.Filled.ReceiptLong"
                            Color="Color.Inherit"
                            Size="Size.Medium"
                            OnClick="OpenAsync" />
        </SoftTooltip>

        @if (_open)
        {
            <div class="recent-backdrop" @onclick="Close"></div>
            <div class="recent-drawer" @onclick:stopPropagation="true">
                <div class="recent-head">
                    <div>
                        <div class="recent-head-title">@L["Recent:Title"]</div>
                        <div class="recent-head-sub">@L["Recent:Subtitle"]</div>
                    </div>
                    <div class="recent-head-actions">
                        <button type="button" class="recent-icon-btn" title="@L["Recent:Refresh"]"
                                @onclick="RefreshAsync" disabled="@_loading">
                            <SoftIcon Icon="@Icons.Material.Filled.Refresh" Size="Size.Small" />
                        </button>
                        <button type="button" class="recent-icon-btn" title="@L["Close"]" @onclick="Close">
                            <SoftIcon Icon="@Icons.Material.Filled.Close" Size="Size.Small" />
                        </button>
                    </div>
                </div>

                <div class="recent-body">
                    @if (_loading)
                    {
                        <div class="recent-state">
                            <SoftProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Small" />
                        </div>
                    }
                    else if (_shift is null)
                    {
                        <div class="recent-state">
                            <SoftIcon Icon="@Icons.Material.Outlined.PointOfSale" Style="font-size:40px;opacity:.4;" />
                            <span>@L["Recent:NoShift"]</span>
                        </div>
                    }
                    else if (_sales.Count == 0)
                    {
                        <div class="recent-state">
                            <SoftIcon Icon="@Icons.Material.Outlined.ReceiptLong" Style="font-size:40px;opacity:.4;" />
                            <span>@L["Recent:Empty"]</span>
                        </div>
                    }
                    else
                    {
                        <div class="recent-list">
                            @foreach (var s in _sales)
                            {
                                <div class="recent-item @(s.IsVoided ? "is-voided" : "")">
                                    <div class="recent-item-main">
                                        <div class="recent-item-inv">
                                            @s.InvoiceNumber
                                            @if (s.IsVoided)
                                            {
                                                <span class="recent-voided-tag">@L["Recent:Voided"]</span>
                                            }
                                        </div>
                                        <div class="recent-item-meta">
                                            @RelativeTime(s.SaleDate) · @L["Recent:Items", s.ItemCount]
                                        </div>
                                    </div>
                                    <div class="recent-item-total">@FormatMoney(s.Total)</div>
                                    <div class="recent-item-actions">
                                        <button type="button" class="recent-act recent-act-view"
                                                disabled="@_busy"
                                                @onclick="() => OpenDetailAsync(s.SaleId)">
                                            @L["Recent:View"]
                                        </button>
                                        <button type="button" class="recent-act"
                                                disabled="@(!s.CanVoid || _busy)"
                                                @onclick="() => AskVoid(s, replace: false)">
                                            @L["Recent:Void"]
                                        </button>
                                        <button type="button" class="recent-act recent-act-alt"
                                                disabled="@(!s.CanVoid || _busy)"
                                                @onclick="() => AskVoid(s, replace: true)">
                                            @L["Recent:Replace"]
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        }
    </div>

    @* ── Void / Replace confirm ── *@
    @if (_confirm is not null)
    {
        <div class="glass-modal-backdrop" @onclick="CancelVoid">
            <div class="glass-modal-container glass-modal-container--sm" @onclick:stopPropagation="true">
                <SoftCard Elevation="24" Class="glass-modal">
                    <SoftCardHeader Class="pa-4">
                        <CardHeaderContent>
                            <SoftStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <SoftIcon Icon="@Icons.Material.Filled.RemoveShoppingCart" Color="Color.Primary" Size="Size.Medium" />
                                <SoftText Typo="Typo.h6">@L["Recent:VoidTitle", _confirm.InvoiceNumber]</SoftText>
                            </SoftStack>
                        </CardHeaderContent>
                        <CardHeaderActions>
                            <SoftIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="CancelVoid" />
                        </CardHeaderActions>
                    </SoftCardHeader>
                    <SoftDivider />
                    <SoftCardContent Class="pa-4">
                        <div class="recent-confirm-sub">@L["Recent:VoidConfirm"]</div>
                        <SoftTextField @bind-Value="_reason"
                                       Label="@L["Recent:Reason"]"
                                       Variant="MudBlazor.Variant.Outlined"
                                       Margin="MudBlazor.Margin.Dense"
                                       Lines="2"
                                       Class="mt-3" />
                    </SoftCardContent>
                    <SoftDivider />
                    <div class="pa-3 d-flex justify-end" style="gap:8px;">
                        <SoftButton Variant="MudBlazor.Variant.Text" OnClick="CancelVoid">@L["Cashier:Cancel"]</SoftButton>
                        <SoftButton Variant="MudBlazor.Variant.Filled" Color="Color.Error"
                                    StartIcon="@Icons.Material.Filled.RemoveShoppingCart"
                                    Disabled="@_busy" OnClick="ConfirmVoidAsync">
                            @L["Recent:Void"]
                        </SoftButton>
                    </div>
                </SoftCard>
            </div>
        </div>
    }

    @if (_detailSale is not null)
    {
        <div class="glass-modal-backdrop" @onclick="CloseDetail">
            <div class="glass-modal-container glass-modal-container--lg" @onclick:stopPropagation="true">
                <SoftCard Elevation="24" Class="glass-modal">
                    <SoftCardHeader Class="pa-4">
                        <CardHeaderContent>
                            <SoftStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <SoftIcon Icon="@Icons.Material.Filled.ReceiptLong" Color="Color.Primary" Size="Size.Medium" />
                                <div>
                                    <SoftText Typo="Typo.h6">@_detailSale.InvoiceNumber</SoftText>
                                    <SoftText Typo="Typo.caption" Color="Color.Default">
                                        @_detailSale.SaleDate.ToLocalTime().ToString("g", CultureInfo.CurrentCulture)
                                    </SoftText>
                                </div>
                            </SoftStack>
                        </CardHeaderContent>
                        <CardHeaderActions>
                            <SoftIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="CloseDetail" />
                        </CardHeaderActions>
                    </SoftCardHeader>
                    <SoftDivider />
                    <SoftCardContent Class="pa-4 recent-detail-body">
                        <div class="recent-detail-summary">
                            <div>
                                <span>@L["Cashier:Branch"]</span>
                                <strong>@_detailSale.BranchName</strong>
                            </div>
                            <div>
                                <span>@L["Recent:ItemsLabel"]</span>
                                <strong>@_detailSale.ItemCount</strong>
                            </div>
                            <div>
                                <span>@L["Cashier:Total"]</span>
                                <strong>@FormatMoney(_detailSale.TotalAmount)</strong>
                            </div>
                        </div>

                        <div class="recent-detail-table">
                            <div class="recent-detail-row recent-detail-row-head">
                                <span>@L["Recent:Product"]</span>
                                <span>@L["Cashier:Qty"]</span>
                                <span>@L["Cashier:UnitPrice"]</span>
                                <span>@L["Cashier:Subtotal"]</span>
                            </div>
                            @foreach (var item in _detailSale.Items)
                            {
                                <div class="recent-detail-row">
                                    <span>
                                        <strong>@item.ProductName</strong>
                                        <small>@item.ProductSKU</small>
                                    </span>
                                    <span>@item.Quantity @item.ProductUnit</span>
                                    <span>@FormatMoney(item.UnitPrice)</span>
                                    <span>@FormatMoney(item.Subtotal)</span>
                                </div>
                            }
                        </div>
                    </SoftCardContent>
                    <SoftDivider />
                    <div class="pa-3 d-flex justify-end">
                        <SoftButton Variant="MudBlazor.Variant.Filled" Color="Color.Default" OnClick="CloseDetail">@L["Close"]</SoftButton>
                    </div>
                </SoftCard>
            </div>
        </div>
    }

    <style>
        .recent-panel-root {
            position: relative;
            display: inline-flex;
            align-items: center;
            margin-right: 2px;
        }

        .recent-backdrop {
            position: fixed;
            inset: 0;
            z-index: 1399;
            background: rgba(0, 0, 0, 0.18);
        }

        .recent-drawer {
            position: fixed;
            top: 0;
            right: 0;
            bottom: 0;
            width: 380px;
            max-width: 92vw;
            z-index: 1400;
            background: var(--surface);
            border-left: 1px solid var(--bd-2);
            box-shadow: var(--shadow-modal);
            display: flex;
            flex-direction: column;
            animation: recent-slide-in 0.18s ease;
        }

        @@keyframes recent-slide-in {
            from { transform: translateX(100%); }
            to { transform: translateX(0); }
        }

        .recent-head {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 8px;
            padding: 14px 16px;
            border-bottom: 1px solid var(--bd-1);
        }

        .recent-head-title {
            font-family: var(--font-serif);
            font-size: 1.05rem;
            font-weight: 600;
            color: var(--fg-1);
        }

        .recent-head-sub {
            font-size: 0.76rem;
            color: var(--fg-3);
            margin-top: 2px;
        }

        .recent-head-actions {
            display: flex;
            gap: 4px;
            flex: 0 0 auto;
        }

        .recent-icon-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 40px;
            height: 40px;
            border: none;
            border-radius: var(--r-sm);
            background: transparent;
            color: var(--fg-2);
            cursor: pointer;
        }

        .recent-icon-btn:hover { background: var(--hover); }
        .recent-icon-btn:disabled { opacity: 0.5; cursor: not-allowed; }

        .recent-body {
            flex: 1 1 auto;
            overflow-y: auto;
        }

        .recent-state {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 10px;
            padding: 40px 18px;
            color: var(--fg-3);
            font-size: 0.85rem;
            text-align: center;
        }

        .recent-item {
            display: grid;
            grid-template-columns: 1fr auto;
            grid-template-areas: "main total" "actions actions";
            gap: 6px 10px;
            padding: 12px 16px;
            border-bottom: 1px solid var(--bd-1);
        }

        .recent-item.is-voided { opacity: 0.55; }

        .recent-item-main { grid-area: main; min-width: 0; }

        .recent-item-inv {
            font-family: var(--font-mono);
            font-size: 0.88rem;
            font-weight: 600;
            color: var(--fg-1);
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .recent-voided-tag {
            font-family: var(--font-sans);
            font-size: 0.62rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            color: var(--danger);
            border: 1px solid var(--danger);
            border-radius: 999px;
            padding: 1px 6px;
        }

        .recent-item-meta {
            font-size: 0.74rem;
            color: var(--fg-3);
            margin-top: 2px;
        }

        .recent-item-total {
            grid-area: total;
            font-size: 1rem;
            font-weight: 700;
            color: var(--fg-1);
            font-variant-numeric: tabular-nums;
            text-align: right;
        }

        .recent-item-actions {
            grid-area: actions;
            display: flex;
            gap: 8px;
            margin-top: 2px;
        }

        .recent-act {
            min-height: 36px;
            padding: 0 14px;
            border-radius: var(--r-sm);
            border: 1px solid var(--bd-2);
            background: var(--surface-2);
            color: var(--danger);
            font-size: 0.82rem;
            font-weight: 600;
            cursor: pointer;
        }

        .recent-act-alt { color: var(--accent); }
        .recent-act-view { color: var(--fg-1); }

        .recent-act:hover:not(:disabled) { background: var(--hover); }

        .recent-act:disabled {
            opacity: 0.4;
            cursor: not-allowed;
            color: var(--fg-4);
        }

        .recent-confirm-sub {
            color: var(--fg-2);
            font-size: 0.9rem;
        }

        .recent-detail-body {
            max-height: 72vh;
            overflow-y: auto;
        }

        .recent-detail-summary {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 10px;
            margin-bottom: 16px;
        }

        .recent-detail-summary > div {
            display: flex;
            flex-direction: column;
            gap: 3px;
            padding: 10px 12px;
            border: 1px solid var(--bd-1);
            border-radius: var(--r-sm);
            background: var(--surface-2);
        }

        .recent-detail-summary span {
            font-size: 0.72rem;
            color: var(--fg-3);
        }

        .recent-detail-summary strong {
            font-size: 0.9rem;
            color: var(--fg-1);
        }

        .recent-detail-table {
            border-top: 1px solid var(--bd-1);
        }

        .recent-detail-row {
            display: grid;
            grid-template-columns: minmax(0, 1.8fr) .7fr .9fr .9fr;
            gap: 12px;
            align-items: center;
            padding: 10px 0;
            border-bottom: 1px solid var(--bd-1);
            font-size: 0.85rem;
        }

        .recent-detail-row-head {
            font-size: 0.72rem;
            font-weight: 700;
            text-transform: uppercase;
            color: var(--fg-3);
        }

        .recent-detail-row > span:not(:first-child) {
            text-align: right;
            font-variant-numeric: tabular-nums;
        }

        .recent-detail-row small {
            display: block;
            margin-top: 2px;
            color: var(--fg-3);
            font-family: var(--font-mono);
            font-size: 0.7rem;
        }

        html[dir="rtl"] .recent-panel-root,
        html[dir="rtl"] .recent-drawer,
        html[dir="rtl"] .recent-head,
        html[dir="rtl"] .recent-item,
        html[dir="rtl"] .recent-item-inv,
        html[dir="rtl"] .recent-item-actions {
            direction: rtl;
            text-align: right;
        }

        html[dir="rtl"] .recent-panel-root {
            margin-right: 0;
            margin-left: 2px;
        }

        html[dir="rtl"] .recent-drawer {
            right: auto;
            left: 0;
            border-left: none;
            border-right: 1px solid var(--bd-2);
        }

        html[dir="rtl"] .recent-item-total {
            text-align: left;
        }

        html[dir="rtl"] .recent-detail-body,
        html[dir="rtl"] .recent-detail-row {
            direction: rtl;
            text-align: right;
        }

        html[dir="rtl"] .recent-detail-row > span:not(:first-child) {
            text-align: left;
        }

        @@media (max-width: 560px) {
            .recent-detail-summary {
                grid-template-columns: 1fr;
            }

            .recent-detail-row {
                grid-template-columns: minmax(0, 1.5fr) .5fr .8fr .8fr;
                gap: 8px;
                font-size: 0.78rem;
            }
        }
    </style>
}

@code {
    private bool _canView;
    private bool _open;
    private bool _loading;
    private bool _busy;

    private CashierBranchDto? _branch;
    private CashierShiftDto? _shift;
    private List<RecentSaleDto> _sales = new();

    private RecentSaleDto? _confirm;
    private bool _confirmReplace;
    private string? _reason;
    private SaleDto? _detailSale;

    protected override async Task OnInitializedAsync()
    {
        _canView = await AuthorizationService.IsGrantedAsync(OperationsPermissions.Cashier.Default);
        await LoadShopCurrencyAsync();
    }

    private async Task OpenAsync()
    {
        _open = true;
        await RefreshAsync();
    }

    private void Close() => _open = false;

    private async Task RefreshAsync()
    {
        if (_loading)
        {
            return;
        }

        _loading = true;
        try
        {
            // Branch context = the cashier's single assigned branch (authoritative).
            _branch ??= await CashierAppService.GetMyBranchAsync();

            if (_branch is null)
            {
                _shift = null;
                _sales = new();
                return;
            }

            // Recent sales are shown whenever a branch is assigned; the open-shift lookup
            // doubles as the "open a shift to see sales" empty-state signal.
            _shift = await CashierAppService.GetCurrentShiftAsync(_branch.Id);
            if (_shift is null)
            {
                _sales = new();
                return;
            }

            _sales = await CashierAppService.GetRecentSalesAsync(_branch.Id, 60);
        }
        catch (Exception)
        {
            Snackbar.Add(L["CashierShifts:LoadFailed"], Severity.Error);
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private void AskVoid(RecentSaleDto sale, bool replace)
    {
        if (!sale.CanVoid)
        {
            return;
        }
        _confirm = sale;
        _confirmReplace = replace;
        _reason = null;
    }

    private async Task OpenDetailAsync(Guid saleId)
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        try
        {
            _detailSale = await CashierAppService.GetSaleDetailsAsync(saleId);
        }
        catch (Exception)
        {
            Snackbar.Add(L["Recent:ViewFailed"], Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private void CloseDetail() => _detailSale = null;

    private void CancelVoid()
    {
        _confirm = null;
        _reason = null;
    }

    private async Task ConfirmVoidAsync()
    {
        if (_busy || _confirm is null)
        {
            return;
        }
        _busy = true;
        try
        {
            await CashierAppService.VoidSaleAsync(new VoidSaleDto
            {
                SaleId = _confirm.SaleId,
                Reason = _reason
            });

            Snackbar.Add(
                _confirmReplace ? L["Recent:Replaced"] : L["Recent:Voided:Success"],
                _confirmReplace ? Severity.Info : Severity.Success);

            _confirm = null;
            _reason = null;
            await RefreshAsync();
        }
        catch (Exception)
        {
            Snackbar.Add(L["Recent:VoidFailed"], Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private string FormatMoney(decimal v) => FormatShopMoney(v);

    private string RelativeTime(DateTime saleDate)
    {
        var delta = DateTime.Now - saleDate.ToLocalTime();
        if (delta < TimeSpan.Zero)
        {
            delta = TimeSpan.Zero;
        }
        if (delta.TotalMinutes < 1) return L["Recent:JustNow"];
        if (delta.TotalHours < 1) return L["Recent:MinutesAgo", (int)delta.TotalMinutes];
        return saleDate.ToLocalTime().ToString("t", CultureInfo.CurrentCulture);
    }
}
