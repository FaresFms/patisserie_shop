@using System
@using System.Collections.Generic
@using System.Globalization
@using System.Linq
@using System.Threading.Tasks
@using Microsoft.AspNetCore.Authorization
@using Intelligence.Decisions
@using Intelligence.Localization
@using Intelligence.Permissions
@using Microsoft.Extensions.Localization
@using Operations.Localization
@using Operations.Permissions
@using Operations.StockTransfers
@using Production
@using Production.BranchRequests
@using Production.Localization
@using Production.Permissions
@using patisserie_shop.Blazor.Services
@using Color = MudBlazor.Color
@using Size = MudBlazor.Size
@using Placement = MudBlazor.Placement
@namespace patisserie_shop.Blazor.Components.Layout
@inherits patisserie_shopComponentBase
@implements IDisposable
@inject DecisionNotificationBridge Bridge
@inject TransferNotificationBridge TransferBridge
@inject IDecisionLogAppService DecisionLogAppService
@inject IStockTransferAppService StockTransferAppService
@inject IBranchProductionRequestAppService BranchRequestAppService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IStringLocalizer<IntelligenceResource> IntL
@inject IStringLocalizer<OperationsResource> OpsL
@inject IStringLocalizer<ProductionResource> ProdL

@if (_canView)
{
    <div class="notif-bell">
        <SoftTooltip Text="@L["Notifications"]"
                     Placement="Placement.Bottom"
                     Disabled="@_open">
            <SoftBadge Content="@TotalBadgeCount"
                       Max="99"
                       Color="Color.Error"
                       Overlap="true"
                       Visible="@(TotalBadgeCount > 0)">
                <SoftIconButton Icon="@(_open ? Icons.Material.Filled.Notifications : Icons.Material.Outlined.Notifications)"
                                Color="Color.Inherit"
                                Size="Size.Medium"
                                OnClick="ToggleDropdownAsync" />
            </SoftBadge>
        </SoftTooltip>

        @if (_open)
        {
            <div class="notif-backdrop" @onclick="CloseDropdown"></div>
        }

        <SoftPopover Open="@_open"
                     AnchorOrigin="@NotificationAnchorOrigin"
                     TransformOrigin="@NotificationTransformOrigin"
                     OverflowBehavior="OverflowBehavior.FlipAlways"
                     Paper="false">
            <div class="notif-popover" @onclick:stopPropagation="true">
                <div class="notif-head">
                    <span class="notif-head-title">@L["Notifications"]</span>
                    @if (TotalBadgeCount > 0)
                    {
                        <span class="notif-head-count">@TotalBadgeCount @L["Notifications:Pending"]</span>
                    }
                </div>

                @if (_pendingBranchRequests > 0)
                {
                    <div class="notif-section-head">@ProdL["Menu:Production"]</div>
                    <div class="notif-list">
                        <div class="notif-item" @onclick="GoToBranchRequests">
                            <span class="notif-dot" style="background:#c89c4f;"></span>
                            <div class="notif-item-body">
                                <div class="notif-item-type">@string.Format(ProdL["Notif:RequestsToApprove"], _pendingBranchRequests)</div>
                            </div>
                            <SoftIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" Style="opacity:.5;" />
                        </div>
                    </div>
                }

                @if (TransferRows.Count > 0)
                {
                    <div class="notif-section-head">@OpsL["Notif:TransfersHead"]</div>
                    <div class="notif-list">
                        @foreach (var row in TransferRows)
                        {
                            <div class="notif-item" @onclick="GoToTransfers">
                                <span class="notif-dot" style="background:#4a8e8e;"></span>
                                <div class="notif-item-body">
                                    <div class="notif-item-type">@row</div>
                                </div>
                                <SoftIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" Style="opacity:.5;" />
                            </div>
                        }
                    </div>
                }

                @if (_recent.Count == 0 && TransferRows.Count == 0 && _pendingBranchRequests == 0)
                {
                    <div class="notif-empty">
                        <SoftIcon Icon="@Icons.Material.Outlined.NotificationsNone" Size="Size.Medium" />
                        <span>@L["Notifications:Empty"]</span>
                    </div>
                }
                else if (_recent.Count > 0)
                {
                    @* Always label the decision list so it reads as its own section,
                       matching the Transfers/Production sections (previously the header
                       only showed when transfer rows were also present). *@
                    <div class="notif-section-head">@IntL["DecisionLog"]</div>
                    <div class="notif-list">
                        @foreach (var item in _recent)
                        {
                            <div class="notif-item" @onclick="() => GoToDecisionLog(item.BranchId)">
                                <span class="notif-dot" style="background:@TypeColor(item.DecisionType);"></span>
                                <div class="notif-item-body">
                                    <div class="notif-item-type">
                                        @if (!string.IsNullOrWhiteSpace(item.BranchName))
                                        {
                                            <span class="notif-branch-pill">@item.BranchName</span>
                                        }
                                        @TypeLabel(item.DecisionType)
                                    </div>
                                    <div class="notif-item-text">@NotificationText(item)</div>
                                </div>
                                <span class="notif-item-time">@RelativeTime(item.CreationTime)</span>
                            </div>
                        }
                    </div>
                }

                @if (_canViewDecisions)
                {
                    <div class="notif-foot">
                        <span class="notif-view-all" @onclick="() => GoToDecisionLog()">@L["Notifications:ViewAll"]</span>
                    </div>
                }
            </div>
        </SoftPopover>
    </div>

    <style>
        .notif-bell {
            position: relative;
            display: inline-flex;
            align-items: center;
            margin-inline-end: 2px;
        }

        .notif-backdrop {
            position: fixed;
            inset: 0;
            z-index: 1399;
            background: transparent;
        }

        .notif-popover {
            width: min(340px, calc(100vw - 16px));
            max-height: calc(100dvh - 64px);
            margin-top: 8px;
            background: var(--surface);
            border: 1px solid var(--bd-2);
            border-radius: var(--r-md);
            box-shadow: var(--shadow-md);
            overflow-x: hidden;
            overflow-y: auto;
            overscroll-behavior: contain;
        }

        .notif-head {
            display: flex;
            align-items: baseline;
            justify-content: space-between;
            gap: 8px;
            padding: 10px 14px;
            border-bottom: 1px solid var(--bd-1);
        }

        .notif-head-title {
            font-family: var(--font-serif);
            font-size: 0.95rem;
            font-weight: 600;
            color: var(--fg-1);
        }

        .notif-head-count {
            font-size: 0.72rem;
            color: var(--fg-3);
        }

        .notif-section-head {
            padding: 8px 14px 2px;
            font-size: 0.68rem;
            font-weight: 700;
            letter-spacing: 0.06em;
            text-transform: uppercase;
            color: var(--fg-3);
        }

        .notif-list {
            max-height: 320px;
            overflow-y: auto;
        }

        .notif-item {
            display: flex;
            align-items: flex-start;
            gap: 10px;
            padding: 10px 14px;
            cursor: pointer;
            border-bottom: 1px solid var(--bd-1);
        }

        .notif-item:last-child {
            border-bottom: none;
        }

        .notif-item:hover {
            background: var(--hover);
        }

        .notif-dot {
            flex: 0 0 auto;
            width: 9px;
            height: 9px;
            border-radius: 50%;
            margin-top: 5px;
        }

        .notif-item-body {
            flex: 1 1 auto;
            min-width: 0;
        }

        .notif-item-type {
            font-size: 0.78rem;
            font-weight: 600;
            color: var(--fg-1);
            line-height: 1.3;
        }

        .notif-item-text {
            font-size: 0.74rem;
            color: var(--fg-2);
            line-height: 1.35;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .notif-item-branch {
            color: var(--fg-3);
        }

        .notif-branch-pill {
            display: inline-block;
            font-size: 0.66rem;
            font-weight: 600;
            padding: 1px 7px;
            margin-inline-end: 6px;
            border-radius: 999px;
            background: var(--accent-soft);
            color: var(--accent);
            vertical-align: middle;
        }

        .notif-item-time {
            flex: 0 0 auto;
            font-size: 0.7rem;
            color: var(--fg-4);
            font-variant-numeric: tabular-nums;
            margin-top: 1px;
        }

        .notif-empty {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 6px;
            padding: 26px 14px;
            color: var(--fg-3);
            font-size: 0.8rem;
        }

        .notif-foot {
            padding: 8px 14px;
            border-top: 1px solid var(--bd-1);
            text-align: center;
        }

        .notif-view-all {
            font-size: 0.78rem;
            font-weight: 600;
            color: var(--accent);
            cursor: pointer;
        }

        .notif-view-all:hover {
            color: var(--accent-hover);
            text-decoration: underline;
        }

        @@media (max-width: 600px) {
            .notif-popover {
                width: calc(100vw - 16px);
            }

            .notif-list {
                max-height: none;
                overflow: visible;
            }

            .notif-item {
                gap: 8px;
                padding-inline: 12px;
            }

            .notif-item-text {
                display: -webkit-box;
                overflow: hidden;
                white-space: normal;
                -webkit-box-orient: vertical;
                -webkit-line-clamp: 2;
            }
        }
    </style>
}

@code {
    private const int RecentItemsCount = 8;

    private bool _canView;
    private bool _canViewDecisions;
    private bool _canViewTransfers;
    private bool _canApproveBranchRequests;
    private bool _subscribed;
    private bool _disposed;
    private bool _open;
    private int _pendingCount;
    private int _pendingBranchRequests;
    private List<DecisionLogDto> _recent = new();
    private StockTransferActionSummaryDto? _transferSummary;

    private bool IsRightToLeft => CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
    private Origin NotificationAnchorOrigin => IsRightToLeft ? Origin.BottomLeft : Origin.BottomRight;
    private Origin NotificationTransformOrigin => IsRightToLeft ? Origin.TopLeft : Origin.TopRight;

    private int TotalBadgeCount => _pendingCount + (_transferSummary?.Total ?? 0) + _pendingBranchRequests;

    private List<string> TransferRows
    {
        get
        {
            var rows = new List<string>();
            if (_transferSummary == null)
            {
                return rows;
            }

            if (_transferSummary.PendingToApprove > 0)
                rows.Add(string.Format(OpsL["Notif:ToApprove"], _transferSummary.PendingToApprove));
            if (_transferSummary.ApprovedToShip > 0)
                rows.Add(string.Format(OpsL["Notif:ToShip"], _transferSummary.ApprovedToShip));
            if (_transferSummary.InTransitToReceive > 0)
                rows.Add(string.Format(OpsL["Notif:ToReceive"], _transferSummary.InTransitToReceive));
            if (_transferSummary.DraftsToSubmit > 0)
                rows.Add(string.Format(OpsL["Notif:Drafts"], _transferSummary.DraftsToSubmit));
            return rows;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _canViewDecisions = await AuthorizationService.IsGrantedAsync(IntelligencePermissions.DecisionLogs.Default);
        _canViewTransfers = await AuthorizationService.IsGrantedAsync(OperationsPermissions.Transfers.Default);
        _canApproveBranchRequests = await AuthorizationService.IsGrantedAsync(ProductionPermissions.BranchRequests.Approve);
        _canView = _canViewDecisions || _canViewTransfers || _canApproveBranchRequests;
        if (!_canView)
        {
            return;
        }

        await RefreshAsync();

        if (_disposed)
        {
            return; // Navigated away during the awaits above — never subscribe.
        }

        if (_canViewDecisions)
        {
            Bridge.DecisionMade += OnDecisionMade;
        }
        if (_canViewTransfers)
        {
            TransferBridge.TransferChanged += OnTransferChanged;
        }
        _subscribed = true;
    }

    private async Task RefreshAsync()
    {
        if (_canViewDecisions)
        {
            var summary = await DecisionLogAppService.GetSummaryAsync();

            var pending = await DecisionLogAppService.GetListAsync(new GetDecisionLogsInput
            {
                Status = DecisionLogStatuses.Pending,
                Sorting = "CreationTime desc",
                SkipCount = 0,
                MaxResultCount = RecentItemsCount
            });

            _pendingCount = summary.TotalPending;
            _recent = pending.Items.ToList();
        }

        if (_canViewTransfers)
        {
            _transferSummary = await StockTransferAppService.GetActionSummaryAsync();
        }

        if (_canApproveBranchRequests)
        {
            // Count-only query: submitted branch requests waiting for kitchen approval.
            var pendingRequests = await BranchRequestAppService.GetListAsync(new GetBranchProductionRequestsInput
            {
                Status = BranchProductionRequestStatuses.Submitted,
                MaxResultCount = 1
            });
            _pendingBranchRequests = (int)pendingRequests.TotalCount;
        }
    }

    /// <summary>
    /// Fires on a non-circuit thread (event bus). All UI work is marshalled
    /// through InvokeAsync; visibility is enforced by re-querying the already
    /// branch-scoped app service and only toasting when the new decision shows
    /// up in this user's visible pending list.
    /// </summary>
    private void OnDecisionMade(DecisionNotification notification)
    {
        _ = InvokeAsync(async () =>
        {
            try
            {
                await RefreshAsync();

                var visible = _recent.FirstOrDefault(d => d.Id == notification.DecisionLogId);
                if (visible != null)
                {
                    Snackbar.Add(
                        L["Notifications:NewDecisionToast", TypeLabel(visible.DecisionType), NotificationText(visible)],
                        Severity.Info);
                }

                StateHasChanged();
            }
            catch
            {
                // The circuit may be tearing down — ignore.
            }
        });
    }

    private async Task ToggleDropdownAsync()
    {
        _open = !_open;
        if (_open)
        {
            try
            {
                await RefreshAsync();
            }
            catch
            {
                // Keep the previously loaded items if the refresh fails.
            }
        }
    }

    /// <summary>
    /// Fires on a non-circuit thread when any transfer changes status. Each circuit
    /// re-queries its own branch-scoped action summary; a toast is shown only when
    /// this user's to-do count actually grew (i.e. it is now their turn).
    /// </summary>
    private void OnTransferChanged(TransferNotification notification)
    {
        _ = InvokeAsync(async () =>
        {
            try
            {
                var before = _transferSummary?.Total ?? 0;
                _transferSummary = await StockTransferAppService.GetActionSummaryAsync();

                if (_transferSummary.Total > before)
                {
                    Snackbar.Add(OpsL["Notif:TransferToast"], Severity.Info);
                }

                StateHasChanged();
            }
            catch
            {
                // The circuit may be tearing down — ignore.
            }
        });
    }

    private void CloseDropdown() => _open = false;

    private void GoToDecisionLog(Guid? branchId = null)
    {
        _open = false;
        var url = branchId.HasValue
            ? $"/intelligence/decision-log?branchId={branchId.Value}"
            : "/intelligence/decision-log";
        Navigation.NavigateTo(url);
    }

    private void GoToTransfers()
    {
        _open = false;
        Navigation.NavigateTo("/operations/stock-transfers?view=action", forceLoad: false);
    }

    private void GoToBranchRequests()
    {
        _open = false;
        Navigation.NavigateTo("/production/branch-requests", forceLoad: false);
    }

    private string TypeLabel(string decisionType) => decisionType switch
    {
        DecisionTypes.LowStockAlert => IntL["DecisionType:LowStockAlert"],
        DecisionTypes.ExcessStockAlert => IntL["DecisionType:ExcessStockAlert"],
        DecisionTypes.DeadStockFlag => IntL["DecisionType:DeadStockFlag"],
        DecisionTypes.TransferSuggestion => IntL["DecisionType:TransferSuggestion"],
        DecisionTypes.ReorderSuggestion => IntL["DecisionType:ReorderSuggestion"],
        DecisionTypes.StockoutRisk => IntL["DecisionType:StockoutRisk"],
        DecisionTypes.ExpiryAlert => IntL["DecisionType:ExpiryAlert"],
        DecisionTypes.WasteWriteOff => IntL["DecisionType:WasteWriteOff"],
        DecisionTypes.StockReport => IntL["DecisionType:StockReport"],
        DecisionTypes.CashierVariance => IntL["DecisionType:CashierVariance"],
        DecisionTypes.IngredientShortage => IntL["DecisionType:IngredientShortage"],
        DecisionTypes.ProductionShortageRisk => IntL["DecisionType:ProductionShortageRisk"],
        DecisionTypes.HighKitchenWaste => IntL["DecisionType:HighKitchenWaste"],
        DecisionTypes.ProductionCostVariance => IntL["DecisionType:ProductionCostVariance"],
        DecisionTypes.LateProductionRisk => IntL["DecisionType:LateProductionRisk"],
        DecisionTypes.UnfulfilledBranchRequest => IntL["DecisionType:UnfulfilledBranchRequest"],
        _ => decisionType
    };

    private string NotificationText(DecisionLogDto item)
    {
        if (!string.IsNullOrWhiteSpace(item.ProductName))
        {
            return item.ProductName;
        }

        if (!string.IsNullOrWhiteSpace(item.SuggestedAction))
        {
            return item.SuggestedAction;
        }

        return item.Reasoning;
    }

    // Matches the per-type accent colors used on the Decision Log page cards.
    private static string TypeColor(string decisionType) => decisionType switch
    {
        DecisionTypes.LowStockAlert => "#c89c4f",
        DecisionTypes.ExcessStockAlert => "#4a7da8",
        DecisionTypes.DeadStockFlag => "#b3543a",
        DecisionTypes.TransferSuggestion => "#4a8e8e",
        DecisionTypes.ReorderSuggestion => "var(--accent)",
        DecisionTypes.StockoutRisk => "#9a4f68",
        DecisionTypes.ExpiryAlert => "#8461a6",
        DecisionTypes.WasteWriteOff => "#7a6258",
        DecisionTypes.StockReport => "var(--accent)",
        DecisionTypes.CashierVariance => "#b3543a",
        DecisionTypes.IngredientShortage => "#c89c4f",
        DecisionTypes.ProductionShortageRisk => "#9a4f68",
        DecisionTypes.HighKitchenWaste => "#b3543a",
        DecisionTypes.ProductionCostVariance => "#4a7da8",
        DecisionTypes.LateProductionRisk => "#8461a6",
        DecisionTypes.UnfulfilledBranchRequest => "#4a8e8e",
        _ => "var(--fg-3)"
    };

    private string RelativeTime(DateTime creationTime)
    {
        // CreationTime is a UTC audit timestamp — compare against UtcNow, not local Now,
        // or the "time ago" is off by the machine's UTC offset.
        var delta = DateTime.UtcNow - creationTime.ToUniversalTime();
        if (delta < TimeSpan.Zero)
        {
            delta = TimeSpan.Zero;
        }

        if (delta.TotalMinutes < 1) return L["Notifications:JustNow"];
        if (delta.TotalHours < 1) return L["Notifications:MinutesAgo", (int)delta.TotalMinutes];
        if (delta.TotalDays < 1) return L["Notifications:HoursAgo", (int)delta.TotalHours];
        return L["Notifications:DaysAgo", (int)delta.TotalDays];
    }

    public void Dispose()
    {
        _disposed = true;
        if (_subscribed)
        {
            if (_canViewDecisions)
            {
                Bridge.DecisionMade -= OnDecisionMade;
            }
            if (_canViewTransfers)
            {
                TransferBridge.TransferChanged -= OnTransferChanged;
            }
            _subscribed = false;
        }
    }
}
