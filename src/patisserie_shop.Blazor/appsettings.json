{
  "App": {
    "SelfUrl": "https://localhost:44387",
    "RedirectAllowedUrls": "https://localhost:44387",
    "DisablePII": false,
    "HealthCheckUrl": "/health-status"
  },
  "BackgroundJobs": {
    // How often (minutes) each Intelligence background worker fires. Lower = more
    // responsive demo; production default is 1440 (24h) for the nightly scanners.
    // Set to 0 to fall back to a worker's built-in default.

    // DeadStockScannerService: flags products with no sale for N days (per active
    // DeadStock rule) and raises Pending DeadStockFlag decisions.
    "DeadStockScanIntervalMinutes": 2,

    // TransferSuggestionScannerService: finds branches with excess vs. branches
    // short on the same product and raises Pending TransferSuggestion decisions
    // (executing one creates a DRAFT stock transfer).
    "TransferSuggestionScanIntervalMinutes": 2,

    // VelocityScannerService: recomputes per product×branch sales velocity, ABC
    // class and weekday demand indices (this powers /intelligence/product-velocity),
    // then runs the StockoutRisk sweep that raises reorder decisions.
    "VelocityScanIntervalMinutes": 2,

    // DecisionOutcomeScannerService: 6h is plenty — it judges each decision's
    // outcome ~48h after creation (did acting on / ignoring it pay off), so it
    // only needs to run a few times a day.
    "DecisionOutcomeScanIntervalMinutes": 360,

    // ExpiryScannerService: walks live stock batches — raises ExpiryAlert decisions
    // for batches expiring soon and WasteWriteOff decisions for already-expired
    // stock (the latter feeds /inventory/waste-analytics once a human executes it).
    "ExpiryScanIntervalMinutes": 2
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "Enrich": ["FromLogContext"],
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "File",
              "Args": {
                "path": "Logs/logs.txt"
              }
            }
          ]
        }
      },
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Console"
            }
          ]
        }
      }
    ]
  },
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=patisserie;Username=postgres;Password=Fares@2002;"
  },
  "AuthServer": {
    "Authority": "https://localhost:44387",
    "RequireHttpsMetadata": true,
    "CertificatePassPhrase": "78b0a37e-1c9c-496f-83b0-fbdba4c7b476"
  },
  "StringEncryption": {
    "DefaultPassPhrase": "OaGgDAbqedrUxnB7"
  }
}
