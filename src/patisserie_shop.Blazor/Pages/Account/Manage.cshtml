@page
@using Microsoft.AspNetCore.Mvc.Localization
@using patisserie_shop.Localization
@model patisserie_shop.Blazor.Pages.Account.ManageModel
@inject IHtmlLocalizer<patisserie_shopResource> L
@{
    Layout = "_AccountLayout";
}

<div class="acct-wrap">
    <h1 class="acct-page-title">@L["Account:Title"]</h1>
    <div class="acct-page-sub">@L["Account:Subtitle"]</div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="acct-alert acct-alert--error" role="alert">
            <span class="material-icons-outlined">error_outline</span>
            <div asp-validation-summary="All"></div>
        </div>
    }

    <!-- ===== Profile ===== -->
    <div class="acct-card">
        <div class="acct-card-head">
            <span class="material-icons-outlined">person_outline</span>
            <span class="acct-card-title">@L["Account:Profile"]</span>
        </div>
        <p class="acct-card-sub">@L["Account:ProfileDescription"]</p>

        @if (Model.StatusSection == "profile" && !string.IsNullOrEmpty(Model.StatusMessage))
        {
            <div class="acct-alert acct-alert--success" role="status">
                <span class="material-icons-outlined">check_circle_outline</span>
                <span>@Model.StatusMessage</span>
            </div>
        }

        <form method="post" asp-page-handler="Profile">
            <input asp-for="ProfileInfo.ConcurrencyStamp" type="hidden" />

            <div class="acct-grid">
                <div class="login-field">
                    <label class="login-label" asp-for="ProfileInfo.UserName">@L["Account:UserName"]</label>
                    <input asp-for="ProfileInfo.UserName" type="text" autocomplete="username" dir="auto" />
                    <span class="acct-validation" asp-validation-for="ProfileInfo.UserName"></span>
                </div>

                <div class="login-field">
                    <label class="login-label" asp-for="ProfileInfo.Email">@L["Account:Email"]</label>
                    <input asp-for="ProfileInfo.Email" type="email" autocomplete="email" dir="auto" />
                    <span class="acct-validation" asp-validation-for="ProfileInfo.Email"></span>
                </div>

                <div class="login-field">
                    <label class="login-label" asp-for="ProfileInfo.Name">@L["Account:Name"]</label>
                    <input asp-for="ProfileInfo.Name" type="text" autocomplete="given-name" />
                    <span class="acct-validation" asp-validation-for="ProfileInfo.Name"></span>
                </div>

                <div class="login-field">
                    <label class="login-label" asp-for="ProfileInfo.Surname">@L["Account:Surname"]</label>
                    <input asp-for="ProfileInfo.Surname" type="text" autocomplete="family-name" />
                    <span class="acct-validation" asp-validation-for="ProfileInfo.Surname"></span>
                </div>

                <div class="login-field acct-field-full">
                    <label class="login-label" asp-for="ProfileInfo.PhoneNumber">@L["Account:PhoneNumber"]</label>
                    <input asp-for="ProfileInfo.PhoneNumber" type="tel" autocomplete="tel" dir="ltr" />
                    <span class="acct-validation" asp-validation-for="ProfileInfo.PhoneNumber"></span>
                </div>
            </div>

            <div class="acct-actions">
                <button type="submit" class="login-submit" style="width: auto; padding: 0 22px;">
                    <span class="material-icons-outlined">save</span>
                    @L["Account:SaveProfile"]
                </button>
            </div>
        </form>
    </div>

    <!-- ===== Password ===== -->
    <div class="acct-card">
        <div class="acct-card-head">
            <span class="material-icons-outlined">lock_outline</span>
            <span class="acct-card-title">@L["Account:Password"]</span>
        </div>
        <p class="acct-card-sub">
            @(Model.HasPassword
                ? L["Account:ChangePasswordDescription"]
                : L["Account:SetPasswordDescription"])
        </p>

        @if (Model.StatusSection == "password" && !string.IsNullOrEmpty(Model.StatusMessage))
        {
            <div class="acct-alert acct-alert--success" role="status">
                <span class="material-icons-outlined">check_circle_outline</span>
                <span>@Model.StatusMessage</span>
            </div>
        }

        <form method="post" asp-page-handler="Password">
            <div class="acct-grid">
                @if (Model.HasPassword)
                {
                    <div class="login-field acct-field-full">
                        <label class="login-label" asp-for="PasswordInfo.CurrentPassword">@L["Account:CurrentPassword"]</label>
                        <input asp-for="PasswordInfo.CurrentPassword" type="password" autocomplete="current-password" dir="ltr" />
                        <span class="acct-validation" asp-validation-for="PasswordInfo.CurrentPassword"></span>
                    </div>
                }

                <div class="login-field">
                    <label class="login-label" asp-for="PasswordInfo.NewPassword">@L["Account:NewPassword"]</label>
                    <input asp-for="PasswordInfo.NewPassword" type="password" autocomplete="new-password" dir="ltr" />
                    <span class="acct-validation" asp-validation-for="PasswordInfo.NewPassword"></span>
                </div>

                <div class="login-field">
                    <label class="login-label" asp-for="PasswordInfo.NewPasswordConfirm">@L["Account:ConfirmNewPassword"]</label>
                    <input asp-for="PasswordInfo.NewPasswordConfirm" type="password" autocomplete="new-password" dir="ltr" />
                    <span class="acct-validation" asp-validation-for="PasswordInfo.NewPasswordConfirm"></span>
                </div>
            </div>

            <div class="acct-actions">
                <button type="submit" class="login-submit" style="width: auto; padding: 0 22px;">
                    <span class="material-icons-outlined">key</span>
                    @(Model.HasPassword ? L["Account:ChangePassword"] : L["Account:SetPassword"])
                </button>
            </div>
        </form>
    </div>
</div>
