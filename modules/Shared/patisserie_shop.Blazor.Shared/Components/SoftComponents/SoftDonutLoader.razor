@namespace patisserie_shop.Blazor.Shared.Components.SoftComponents

<div class="@RootClass"
     role="status"
     aria-live="polite"
     aria-label="@EffectiveLabel">
    <div class="soft-donut-loader__stage" aria-hidden="true">
        <svg class="soft-donut-loader__art" viewBox="0 0 100 100" focusable="false">
            <defs>
                <linearGradient id="@_doughGradientId" x1="18" y1="15" x2="82" y2="86" gradientUnits="userSpaceOnUse">
                    <stop offset="0" class="soft-donut-loader__dough-light" />
                    <stop offset="0.52" class="soft-donut-loader__dough-mid" />
                    <stop offset="1" class="soft-donut-loader__dough-dark" />
                </linearGradient>
                <linearGradient id="@_icingGradientId" x1="22" y1="18" x2="78" y2="82" gradientUnits="userSpaceOnUse">
                    <stop offset="0" class="soft-donut-loader__icing-light" />
                    <stop offset="1" class="soft-donut-loader__icing-dark" />
                </linearGradient>
                <mask id="@_maskId" maskUnits="userSpaceOnUse" x="0" y="0" width="100" height="100">
                    <rect width="100" height="100" fill="black" />
                    <circle cx="50" cy="50" r="35" fill="white" />
                    <circle cx="50" cy="50" r="13" fill="black" />
                    <circle class="soft-donut-loader__bite bite-1" cx="75" cy="28" r="16" fill="black" />
                    <circle class="soft-donut-loader__bite bite-2" cx="83" cy="50" r="16" fill="black" />
                    <circle class="soft-donut-loader__bite bite-3" cx="75" cy="72" r="16" fill="black" />
                    <circle class="soft-donut-loader__bite bite-4" cx="50" cy="82" r="16" fill="black" />
                    <circle class="soft-donut-loader__bite bite-5" cx="25" cy="72" r="16" fill="black" />
                    <circle class="soft-donut-loader__bite bite-6" cx="17" cy="50" r="16" fill="black" />
                    <circle class="soft-donut-loader__bite bite-7" cx="25" cy="28" r="16" fill="black" />
                    <circle class="soft-donut-loader__bite bite-8" cx="50" cy="18" r="16" fill="black" />
                </mask>
                <filter id="@_shadowId" x="-40%" y="-40%" width="180%" height="190%">
                    <feDropShadow dx="0" dy="4" stdDeviation="3" flood-color="currentColor" flood-opacity="0.2" />
                </filter>
            </defs>

            <g class="soft-donut-loader__donut"
               mask="@($"url(#{_maskId})")"
               filter="@($"url(#{_shadowId})")">
                <circle cx="50" cy="50" r="35" fill="@($"url(#{_doughGradientId})")" />
                <circle cx="50" cy="48" r="25.5"
                        fill="none"
                        stroke="@($"url(#{_icingGradientId})")"
                        stroke-width="14"
                        stroke-linecap="round" />
                <path class="soft-donut-loader__shine"
                      d="M27 39 C33 25, 50 19, 64 25"
                      fill="none"
                      stroke-linecap="round" />

                <g class="soft-donut-loader__sprinkles">
                    <path d="M35 30 l4 2" />
                    <path d="M52 25 l1 5" />
                    <path d="M67 34 l-4 3" />
                    <path d="M72 51 l-5 0" />
                    <path d="M63 67 l-3 -4" />
                    <path d="M46 72 l1 -5" />
                    <path d="M29 62 l5 -2" />
                    <path d="M27 47 l5 1" />
                </g>
            </g>

            <g class="soft-donut-loader__crumbs">
                <circle cx="87" cy="25" r="2.3" />
                <circle cx="91" cy="34" r="1.6" />
                <circle cx="84" cy="18" r="1.2" />
            </g>
        </svg>
    </div>

    @if (ShowLabel)
    {
        <span class="soft-donut-loader__label">@EffectiveLabel</span>
    }
</div>

@code {
    [Parameter] public string? Label { get; set; }
    [Parameter] public bool Compact { get; set; }
    [Parameter] public bool Fill { get; set; }
    [Parameter] public bool ShowLabel { get; set; } = true;
    [Parameter] public string? Class { get; set; }

    private readonly string _instanceId = Guid.NewGuid().ToString("N");
    private string _maskId => $"soft-donut-mask-{_instanceId}";
    private string _doughGradientId => $"soft-donut-dough-{_instanceId}";
    private string _icingGradientId => $"soft-donut-icing-{_instanceId}";
    private string _shadowId => $"soft-donut-shadow-{_instanceId}";

    private string EffectiveLabel => string.IsNullOrWhiteSpace(Label)
        ? L["Dashboard:Loading"].Value
        : Label;

    private string RootClass => string.Join(" ", new[]
    {
        "soft-donut-loader",
        Compact ? "soft-donut-loader--compact" : null,
        Fill ? "soft-donut-loader--fill" : null,
        Class
    }.Where(value => !string.IsNullOrWhiteSpace(value)));
}
