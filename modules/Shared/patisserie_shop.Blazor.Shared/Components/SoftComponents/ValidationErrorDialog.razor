@using System.ComponentModel.DataAnnotations
@using MudBlazor

<MudDialog Class="glass-modal soft-modal-card validation-error-dialog">
    <TitleContent>
        <div class="d-flex align-center">
            <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Color="MudBlazor.Color.Error" Size="MudBlazor.Size.Medium" Class="mr-2" />
            <MudText Typo="Typo.h6">@Title</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        @if (!string.IsNullOrWhiteSpace(IntroText))
        {
            <MudText Typo="Typo.body2" Class="mb-3">@IntroText</MudText>
        }

        @if (Errors is { Count: > 0 })
        {
            <ul class="validation-error-list">
                @foreach (var err in Errors)
                {
                    <li>
                        @if (!string.IsNullOrWhiteSpace(err.Field))
                        {
                            <strong>@err.Field:</strong>
                            <span>&nbsp;</span>
                        }
                        <span>@err.Message</span>
                    </li>
                }
            </ul>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close" Variant="Variant.Filled" Color="MudBlazor.Color.Primary">
            @CloseText
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public string Title { get; set; } = "Please fix the following";
    [Parameter] public string? IntroText { get; set; }
    [Parameter] public string CloseText { get; set; } = "OK";
    [Parameter] public IReadOnlyList<ValidationErrorItem> Errors { get; set; } = Array.Empty<ValidationErrorItem>();

    private void Close() => MudDialog.Close(DialogResult.Ok(true));

    public record ValidationErrorItem(string? Field, string Message);
}
