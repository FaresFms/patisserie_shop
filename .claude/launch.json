{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "blazor",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run",
        "--project", "src/patisserie_shop.Blazor/patisserie_shop.Blazor.csproj",
        "--no-build",
        "--",
        "--urls", "https://localhost:44390",
        "--environment", "Development",
        "--App:SelfUrl", "https://localhost:44390",
        "--App:RedirectAllowedUrls", "https://localhost:44390",
        "--AuthServer:Authority", "https://localhost:44390"
      ],
      "port": 44390
    }
  ]
}
